   124	    load_star,
   125	)
   126	
   127	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
   128	MATCH_TOL_MAG = 0.25
   129	MATCH_TOL_WIDE = 0.5
   130	PILOT_TARGETS = 10
   131	PILOT_NULLS = 30
   132	SENTINEL = "IN_PROGRESS"
   133	PANDAS_NA_TOKENS = {"#N/A", "#N/A N/A", "#NA", "-1.#IND", "-1.#QNAN", "-NaN", "-nan",
   134	                    "1.#IND", "1.#QNAN", "<NA>", "N/A", "NA", "NULL", "NaN", "None",
   135	                    "n/a", "nan", "null"}
   136	SPOC_REPORT = "spoc_verification/v2_publishedsectors_report.json"
