   127	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None,
   128	               truth_quantum: float = 0.0) -> dict:
   129	    result = json.loads(json_path.read_text(encoding="utf-8"))
   130	    if not result.get("complete"):
   131	        raise SystemExit(f"{json_path} is not complete")
   132	    passes = result["passes"]
   133	    if set(passes) != {"low", "high"}:
   134	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   135	    baseline = float(result["baseline_days"])
   136	    tol = 1.5 / baseline + truth_quantum
   137	    overall = overall_result(result)
   138	
   139	    row: dict = {
   140	        "baseline_days": baseline,
   141	        "n_exp_zg": result["n_exp_zg"],
   142	        "n_exp_zr": result["n_exp_zr"],
   143	        "best_pass": overall["best_pass"],
   144	        "best_status": overall["blind_status"],
   145	        "best_frequency_per_day": overall["best_frequency_per_day"],
   146	        "low_available": passes["low"].get("available", True),
   147	        "high_available": passes["high"].get("available", True),
   148	    }
   149	    any_direct_top = False
   150	    for name in ("low", "high"):
   151	        p = passes[name]
   152	        freq = p.get("frequency_per_day")
   153	        row[f"{name}_status"] = p["status"]
   154	        row[f"{name}_frequency_per_day"] = freq
   155	        row[f"{name}_match"] = (
   156	            classify_match(float(freq), truth_freqs, tol)
   157	            if freq is not None and truth_freqs else "unscored"
   158	        )
   159	        row[f"{name}_match_primary"] = (
   160	            classify_match(float(freq), [primary_freq], tol)
   385	        dominant[sid] = float(best["frequency_per_day"])
   386	        amp_dom[sid] = float(best["amp_tess_ppt"])
   387	    rows = []
   388	    for r in manifest.itertuples(index=False):
   389	        arm, tic, sid = r.arm, int(r.tic), r.campaign_id
   390	        positive = arm in ("A", "B")
   391	        truth = freq_lists.get(sid, []) if positive else []
   392	        rows.append({
   393	            "sid": sid, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   394	            "class_label": f"arm_{arm}", "label_positive": positive,
   395	            "weight": 1.0, "cluster": str(tic) if tic else sid,
   396	            "truth_freqs": truth,
   397	            "primary_freq": dominant.get(sid) if positive else None,
   398	            "amp": float(amp_dom.get(sid, math.nan)),
   399	            "truth_period_days": (1.0 / dominant[sid]) if sid in dominant and positive else math.nan,
   400	            "freq_scorable": positive and bool(truth),
   401	            "arm": arm, "scenario": r.scenario, "template_k": int(r.template_k),
   402	            "pool_index": int(r.pool_index),
   403	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   404	            "phase_draw": int(r.phase_draw), "amp_scale": float(r.amp_scale),
   405	            "dominant_dropped": bool(r.dominant_dropped),
   406	            "dropped_period_s": float(r.dropped_period_s),
   407	            "crowdsap": float(r.crowdsap),
   408	            "cadence_code": int(r.cadence_code), "cadence_s": float(r.cadence_s),
   409	            "n_strata_scheduled": int(r.n_strata_scheduled),
   410	            "null_serial": int(r.null_serial),
   411	            "control_campaign_id": r.control_campaign_id,
   412	            "shard_sha256": r.shard_sha256,
   413	            "median_exp_per_night": float(r.template_exp_per_night),
   414	            "template_status": r.template_status,
   415	        })
   416	    return pd.DataFrame(rows), generation
