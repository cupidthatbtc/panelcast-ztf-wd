   421	def census_lookup_csv(path: Path) -> dict[str, dict]:
   422	    frame = pd.read_csv(path, dtype={"source_id": str})
   423	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   424	    for col in ratio_cols:
   425	        exact = frame[col] == 2.5
   426	        if exact.any():
   427	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   428	    return {
   429	        r["source_id"]: {
   430	            "census_variable": bool(r["census_variable"]),
   431	            "census_g_nightly": bool(r["census_g_nightly"]),
   432	            "median_exp_per_night": float(r["zg_median_exp_per_night"])
   433	            if "zg_median_exp_per_night" in frame.columns else math.nan,
   434	        }
   435	        for _, r in frame.iterrows()
   436	    }
