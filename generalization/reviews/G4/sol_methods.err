import numpy as np
import pandas as pd
exp = pd.read_csv(\"catalog-rebuild/results/2026-08-01_full/data/exposures.csv.gz\", usecols=[\"source_id\",\"band\",\"night_mjd\",\"mag\"], dtype={\"source_id\":str,\"band\":str})
zg = exp[exp.band.eq(\"zg\")]
night = zg.groupby([\"source_id\",\"night_mjd\"], sort=False).size()
stats = zg.groupby(\"source_id\").agg(median_zg=(\"mag\",\"median\"), n_zg=(\"mag\",\"size\")).reset_index()
neff = night.sub(1).clip(lower=0).groupby(\"source_id\").sum().rename(\"n_eff_high\").reset_index()
stats = stats.merge(neff, on=\"source_id\").sort_values(\"source_id\").reset_index(drop=True)
targets = pd.read_csv(\"generalization/data/d2/d2_targets.csv\")
rows=[]
for t in targets.itertuples(index=False):
    delta=(stats.median_zg-float(t.gmag)).abs()
    pool=None; label=\"nearest\"
    for tol, lab in ((.25,\"tol_0.25\"),(.5,\"tol_0.5\")):
        cand=stats[delta<=tol]
        if len(cand)>=3:
            pool=cand; label=lab; break
    if pool is None or len(pool)<3:
        pool=stats.assign(abs_delta=delta).sort_values([\"abs_delta\",\"source_id\"],kind=\"stable\").head(9)
    ordered=pool.sort_values([\"n_eff_high\",\"source_id\"],kind=\"stable\").reset_index(drop=True)
    idx=[min(len(ordered)-1,int(np.round(q*(len(ordered)-1)))) for q in (.1,.5,.9)]
    picks=ordered.iloc[idx]
    vals=picks.n_eff_high.astype(int).tolist()
    rows.append((int(t.tic),len(pool),label,*vals,len(set(vals)),len(set(picks.source_id))))
r=pd.DataFrame(rows,columns=[\"tic\",\"pool_n\",\"match\",\"k0\",\"k1\",\"k2\",\"n_distinct_values\",\"n_distinct_windows\"])
print(\"targets\",len(r))
print(\"K0==K1\",int((r.k0==r.k1).sum()),\"K1==K2\",int((r.k1==r.k2).sum()),\"all values distinct\",int((r.n_distinct_values==3).sum()))
print(\"all windows distinct\",int((r.n_distinct_windows==3).sum()),\"match labels\",r[\"match\"].value_counts().to_dict())
print(\"selected N_eff quantiles by K\")
print(r[[\"k0\",\"k1\",\"k2\"]].quantile([0,.1,.5,.9,1]).to_string())
print(\"targets with tied selected values\")
print(r[r.n_distinct_values<3].to_string(index=False))
