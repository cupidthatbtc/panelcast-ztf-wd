   547	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   548	    scorable = per_star[per_star["freq_scorable"]
   549	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   550	    if len(scorable) < 3:
   551	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   552	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   553	    rates = []
   554	    truth_lists = scorable["truth_freqs"].tolist()
   555	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   556	        perm = rng.permutation(len(truth_lists))
   557	        hits = 0
   558	        for i, row in scorable.iterrows():
   559	            if perm[i] == i:
   560	                continue
   561	            tol = 1.5 / row["baseline_days"]
   562	            if classify_match(float(row["best_frequency_per_day"]),
   563	                              truth_lists[perm[i]], tol) == "direct":
   564	                hits += 1
   565	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   566	        if denom:
   567	            rates.append(hits / denom)
   568	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   569	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   570	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
   571	
   572	
   573	def cp_one_sided_bounds(k: int, n: int) -> tuple[float, float]:
   574	    from scipy.stats import beta
   575	    lower = float(beta.ppf(0.05, k, n - k + 1)) if k > 0 else 0.0
   576	    upper = float(beta.ppf(0.95, k + 1, n - k)) if k < n else 1.0
   577	    return lower, upper
   578	
