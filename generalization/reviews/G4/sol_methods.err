   439	def census_from_shard(shard_path: Path) -> dict:
   440	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   441	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   442	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   443	                           n_variants=0, known_roster=False, wd_class="",
   444	                           paper_variable=None, paper_periodic=None)
   445	    nightly = nightly_panel(frame)
   446	    monthly = monthly_panel(nightly)
   447	    row = census_row(meta, frame, nightly, monthly)
   448	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   449	                for c in ("exposure", "nightly", "monthly")):
   450	        if row.get(key) == 2.5:
   540	            binomtest(min(b, c), b + c, 0.5).pvalue * 1.0
   541	        )
   542	    if dataset == "d2":
   543	        out["mcnemar"] = "prohibited for d2 (cluster structure); use the target-cluster paired-difference bootstrap"
   544	    return out
