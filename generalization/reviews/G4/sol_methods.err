   458	        if "ladder" in arms:
   459	            variants.extend((gi, ri, g, r, (1,), 0, 1.0, False, CROWD_CODE_NONE, N)
   460	                            for gi, ri, g, r in ladder if not (g == NOMINAL_G and r == NOMINAL_RG))
   461	        if "phase" in arms:
