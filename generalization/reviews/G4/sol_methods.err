   421	            raise SystemExit(f"duplicate shard {sid}")
   422	        frame, mag = synthesize(tokens, values, model, sid, gaussian, seed)
   423	        write_shard(path, frame)
   424	        verify_written(path, values, mag, sid)
   425	        for mode in model.modes:
   426	            injected_rows.append({
   427	                "campaign_id": sid, "period_s": mode.period_s,
   428	                "frequency_per_day": mode.frequency_per_day,
   429	                "amp_tess_ppt": mode.amp_tess_ppt, "tess_sinc": mode.tess_sinc,
   430	                "ztf_sinc": mode.ztf_sinc, "amp_g_mag": mode.amp_g_mag,
   431	                "amp_r_mag": mode.amp_r_mag, "phase_rad": mode.phase_rad,
   432	            })
   433	        for rejected in model.rejected:
   434	            rejected_rows.append({"campaign_id": sid, **rejected})
   435	        manifest.append(typed_row(
   436	            campaign_id=sid, n_modes_injected=len(model.modes),
   437	            n_modes_rejected=len(model.rejected), shard_sha256=sha256_file(path),
   438	            **fields))
   439	
   440	    for target in targets.itertuples(index=False):
   441	        tic = int(target.tic)
   442	        star_modes = modes[modes["tic"] == tic]
