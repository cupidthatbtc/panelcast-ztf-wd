   690	                paired["best_status"] == "confirmed")
   691	            diff = (c_only.astype(float) - l_only.astype(float)).groupby(
   692	                paired["cluster"]).mean()
   693	            aligned = diff.reindex(clusters)
   694	            if not aligned.dropna().empty:
   695	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   696	                rows.append({
   697	                    **key, "endpoint": "paired_census_minus_ls_discordance",
   698	                    "denominator": "usable", "n_strata_scheduled": n_strata,
   699	                    "n_targets_in_scenario": len(present), "n_targets": n_targets,
   700	                    "n_targets_zero_usable_strata": len(zero_usable),
   701	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   702	                    "confirmatory": False,
   703	                })
   704	
   705	    # PAIRED contrasts (G3 round-3, both reviewers): every non-nominal arm-B
   706	    # scenario vs nominal K=1 on the IDENTICAL target set, one row per target
   707	    # on each side, ONE common draw matrix for both vectors and their
   708	    # difference; usable denominator = targets usable on BOTH sides;
   709	    # eligible denominator keeps missing rows as failures on both sides
   710	    def boot_mean(vec: pd.Series) -> tuple[float, float, float]:
   711	        values = vec.to_numpy(dtype=float)
   712	        observed = values[~np.isnan(values)]
   713	        if observed.size == 0:
   714	            return math.nan, math.nan, math.nan
   715	        boots = []
   716	        for b in range(BOOTSTRAP_B):
   717	            sample = values[draws[b]]
   718	            sample = sample[~np.isnan(sample)]
   719	            if sample.size:
   720	                boots.append(float(sample.mean()))
   721	        return (float(observed.mean()), float(np.quantile(boots, 0.025)),
   722	                float(np.quantile(boots, 0.975)))
   723	
   724	    contrasts = []
   725	    b_rows = frame[frame["arm"] == "B"]
   726	    nominal_k1 = b_rows[(b_rows["scenario"] == "nominal") & (b_rows["template_k"] == 1)]
   727	    for keys, scenario in b_rows[b_rows["scenario"] != "nominal"].groupby(scenario_cols):
   728	        key = dict(zip(scenario_cols, keys))
   729	        key["dominant_dropped"] = bool(key["dominant_dropped"])
   730	        if scenario["cluster"].duplicated().any():
   731	            raise SystemExit(f"scenario {key['scenario']} holds more than one row per target")
   732	        targets = set(scenario["cluster"])
   733	        nom = nominal_k1[nominal_k1["cluster"].isin(targets)]
   734	        if set(nom["cluster"]) != targets or nom["cluster"].duplicated().any():
   735	            raise SystemExit(f"nominal K=1 rows do not match the {key['scenario']} target set")
