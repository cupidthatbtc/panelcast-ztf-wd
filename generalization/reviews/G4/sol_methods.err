   449	                             "n_published_modes": len(periods)})
   450	            continue
   451	        scheduled_tics.append(tic)
   452	        dominant_amp[tic] = float(max(amps[i] for i in keep))
   453	        picks, match_label = match_templates(stats, float(target.gmag))
   454	        N = CADENCE_CODE_NOMINAL
   455	        variants: list[tuple] = []   # (gi, ri, g, r, ks, phase_draw, amp_scale, drop, crowd, cadence_code)
   456	        if "b" in arms or "a" in arms:
