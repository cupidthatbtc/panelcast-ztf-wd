   139	
   140	
   141	def sha256_file(path: Path) -> str:
   142	    return hashlib.sha256(path.read_bytes()).hexdigest()
   143	
   144	
   145	# ------------------------------------------------------------------ templates
   146	
   147	def read_template(path: Path) -> tuple[pd.DataFrame, pd.DataFrame]:
   148	    """(tokens, values): the shard's original text tokens for every column and
   149	    the numeric values exactly as the frozen loader parses them."""
   150	    with gzip.open(path, "rt", encoding="utf-8") as handle:
   151	        tokens = pd.read_csv(handle, dtype=str, keep_default_na=False)
   152	    values = load_star(path)
   153	    if len(tokens) != len(values) or list(tokens["band"]) != list(values["band"]):
   154	        raise SystemExit(f"{path}: token/value row mismatch")
   155	    missing = [c for c in EXPOSURE_COLUMNS if c not in tokens.columns]
   156	    if missing:
   157	        raise SystemExit(f"{path}: template lacks columns {missing}")
   158	    return tokens, values
   159	
   160	
   161	def load_pool(exposure_stars: Path, catalog_path: Path, expected_pool: int
   162	              ) -> tuple[pd.DataFrame, dict[str, tuple[pd.DataFrame, pd.DataFrame]], dict[str, str]]:
   163	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
   164	    ids = sorted(catalog["source_id"])
   165	    if len(ids) != expected_pool or len(set(ids)) != expected_pool:
   166	        raise SystemExit(f"catalog has {len(ids)} rows ({len(set(ids))} unique), "
   167	                         f"expected {expected_pool} unique")
   168	    status = catalog.set_index("source_id")["blind_status"].to_dict()
   169	    templates: dict[str, tuple[pd.DataFrame, pd.DataFrame]] = {}
   170	    shas: dict[str, str] = {}
   171	    rows = []
   172	    for sid in ids:
   173	        path = exposure_stars / f"{sid}.csv.gz"
   174	        if not path.exists():
   175	            raise SystemExit(f"pool window missing for {sid}: {path}")
   176	        tokens, values = read_template(path)
   177	        zg = values[values["band"] == "zg"]
   178	        if zg.empty:
   179	            raise SystemExit(f"{sid}: no zg window (pool must be complete)")
   180	        templates[sid] = (tokens, values)
   181	        shas[sid] = sha256_file(path)
   182	        rows.append({
   183	            "source_id": sid,
   184	            "median_zg": float(zg["mag"].median()),
   185	            "n_zg": int(len(zg)),
   186	            "exp_per_night": float(zg.groupby("night_mjd").size().median()),
   187	            "blind_status": str(status[sid]),
   188	        })
   189	    stats = pd.DataFrame(rows).sort_values("source_id").reset_index(drop=True)
   190	    stats["pool_index"] = np.arange(len(stats))
   191	    return stats, templates, shas
   192	
   193	
   194	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
   195	    delta = (stats["median_zg"] - gmag).abs()
   196	    label = "nearest"
   197	    pool = stats.iloc[0:0]
   198	    for tol, tol_label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
   199	        candidate = stats[delta <= tol]
   200	        if len(candidate) >= 3:
   201	            pool, label = candidate, tol_label
   202	            break
   203	    if len(pool) < 3:
   204	        ranked = stats.assign(abs_delta=delta).sort_values(
   205	            ["abs_delta", "source_id"], kind="stable")
   206	        pool = ranked.head(9)
   207	    ordered = pool.sort_values(["exp_per_night", "source_id"], kind="stable").reset_index(drop=True)
   208	    picks = [
   209	        str(ordered.iloc[min(len(ordered) - 1, int(np.round(q * (len(ordered) - 1))))]["source_id"])
   210	        for q in (0.10, 0.50, 0.90)
   211	    ]
   212	    return picks, label
   213	
   214	
   215	# ----------------------------------------------------------------- ids/shards
   216	
   217	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   218	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   219	        frame[list(EXPOSURE_COLUMNS)].to_csv(handle, index=False, lineterminator="\n")
   220	
   221	
   222	def synthesize(tokens: pd.DataFrame, values: pd.DataFrame, model, source_id: str,
   223	               gaussian_floor: bool, seed: int) -> tuple[pd.DataFrame, np.ndarray]:
   224	    """Returns (frame to write, computed mag array). Every column except
   225	    source_id and mag is the template's original text token."""
   226	    frame = tokens.copy()
   227	    frame["source_id"] = source_id
   228	    bjd = values["bjd_tdb"].to_numpy(dtype=float)
   229	    band = values["band"].to_numpy()
   230	    mag = values["mag"].to_numpy(dtype=float).copy()
   231	    t_ref = float(bjd.min())
   232	    if gaussian_floor:
   233	        rng = np.random.Generator(np.random.PCG64(seed))
   234	        for name in ("zg", "zr"):
   235	            mask = band == name
   236	            median = float(np.median(mag[mask]))
   237	            noise = rng.normal(0.0, values.loc[mask, "magerr"].to_numpy(dtype=float))
   238	            mag[mask] = median + noise
   239	    for name in ("zg", "zr"):
   240	        mask = band == name
   380	        spoc = json.loads(spoc_report_path.read_text(encoding="utf-8"))
   381	        for entry in spoc.get("targets", []):
   382	            if entry.get("crowdsap_median") is not None and "error" not in entry:
   383	                crowdsap[int(entry["tic"])] = float(entry["crowdsap_median"])
   384	    elif "redilution" in arms:
   385	        raise SystemExit("redilution arm needs the SPOC verification report")
   386	    spoc_v3_path = args.d2_dir / SPOC_V3_REPORT
   387	    mixed_cadence: list[int] = []
   388	    if spoc_v3_path.exists():
   389	        v3 = json.loads(spoc_v3_path.read_text(encoding="utf-8"))
   390	        mixed_cadence = sorted(int(e["tic"]) for e in v3.get("targets", [])
   391	                               if e.get("cadence_switched_from_roster") and "error" not in e)
   392	    elif "cadence_alt" in arms:
   393	        raise SystemExit("cadence_alt arm needs the SPOC v3 verification report")
   394	
   395	    stats, templates, template_shas = load_pool(args.exposure_stars, args.catalog, expected_pool)
   396	    status_of = stats.set_index("source_id")["blind_status"].to_dict()
   397	    epn_of = stats.set_index("source_id")["exp_per_night"].to_dict()
   398	    pool_index_of = stats.set_index("source_id")["pool_index"].to_dict()
   399	
   400	    ladder = [(gi + 1, ri + 1, g, r)
