   580	def d2_cluster_bootstrap(per_star: pd.DataFrame, scheduled_tics: list[int] | None = None,
   581	                         pilot: bool = False) -> tuple[pd.DataFrame, pd.DataFrame]:
   582	    """P4 machinery: per (scenario, endpoint), per-stratum rates and the
   583	    scenario-standardized mean over targets; COMMON RANDOM NUMBERS — one
   584	    resample-index matrix shared by every scenario; degenerate statistics
   585	    fall back to target-level exact CP. Scenario identity is the explicit
   586	    manifest `scenario` code plus every grouping key (G3 methods finding 2);
   587	    the eligible denominator is the scenario's SCHEDULED strata count
   588	    (3 nominal, 1 single-window sensitivities), never a fixed 3; the nominal
   589	    arm-B scenario is the ONLY confirmatory P4 row, and only outside pilots."""
   590	    if "arm" not in per_star or "scenario" not in per_star:
   591	        return pd.DataFrame(), pd.DataFrame()
   592	    frame = per_star[per_star["arm"].isin(["A", "B"])]
   593	    if frame.empty:
   594	        return pd.DataFrame(), pd.DataFrame()
   595	    if scheduled_tics:
   596	        clusters = np.array(sorted(str(int(t)) for t in scheduled_tics))
   597	    else:
   598	        clusters = np.array(sorted(frame["cluster"].unique()))
   599	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   600	    draws = rng.integers(0, len(clusters), size=(BOOTSTRAP_B, len(clusters)))
   601	    rows = []
   602	    endpoints = {
   603	        "detection": lambda f: f["best_status"] == "confirmed",
   604	        "freq_recovery": lambda f: (f["best_status"] == "confirmed")
   605	        & (f["best_candidate_matches_dominant"] == "direct"),
   606	    }
   607	    scenario_cols = ["arm", "scenario", "ratio_g", "ratio_rg", "phase_draw",
   608	                     "amp_scale", "dominant_dropped", "cadence_code"]
   609	
   610	    def bootstrap_stats(aligned: pd.Series) -> tuple[float, float, float, str, int]:
   611	        observed = aligned.dropna()
   612	        point = float(observed.mean())
   613	        values = aligned.to_numpy(dtype=float)
   614	        boots = []
   615	        for b in range(BOOTSTRAP_B):
   616	            sample = values[draws[b]]
   617	            sample = sample[~np.isnan(sample)]
   618	            if sample.size:
   619	                boots.append(float(sample.mean()))
   620	        target_hits = observed.round(6)
   621	        degenerate = (target_hits == 0).all() or (target_hits == 1).all()
   622	        if degenerate:
   623	            k_deg = int((target_hits == 1).sum())
   624	            lo, hi = cp_one_sided_bounds(k_deg, len(observed))
   625	            return point, lo, hi, "cp_one_sided", len(observed)
   790	    # own bin (-1) so the 154 unjoined D3 positives stay in the denominator
   791	    detection = positives["best_status"] == "confirmed"
   792	    out["detection_amplitude"] = pd.DataFrame(
   793	        surface_cells(positives, detection, positives["amp"], amp_edges, "amp_bin"))
   794	    # detection endpoint on (period, amplitude): unknowns fall in bin -1
   795	    p_bins_all = np.where(np.isfinite(positives["truth_period_days"]),
   796	                          np.digitize(positives["truth_period_days"],
   797	                                      PERIOD_EDGES_DAYS), -1)
   798	    a_bins_all = np.where(np.isfinite(positives["amp"]),
   799	                          np.digitize(positives["amp"], amp_edges), -1)
   800	    det_rows = []
   801	    for (pb, ab), idx in positives.groupby([p_bins_all, a_bins_all]).groups.items():
   802	        k = int(detection.loc[idx].sum())
   803	        n = len(idx)
   804	        entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   805	        if n >= MIN_CELL:
   806	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   807	        det_rows.append(entry)
   808	    out["detection_period_amplitude"] = pd.DataFrame(det_rows)
   809	    # frequency-recovery endpoint: scorable AND S_best subset only
   810	    scorable = positives[positives["freq_scorable"]
   811	                         & positives["eligible_any_pass"]]
   812	    if not scorable.empty:
   813	        match_col = "best_candidate_matches_dominant"
   814	        recovery = (scorable["best_status"] == "confirmed") & (
   815	            scorable[match_col] == "direct")
   816	        rows = []
   817	        p_bins = np.digitize(scorable["truth_period_days"], PERIOD_EDGES_DAYS)
   818	        a_bins = np.where(np.isfinite(scorable["amp"]),
   819	                          np.digitize(scorable["amp"], amp_edges), -1)
   820	        for (pb, ab), idx in scorable.groupby([p_bins, a_bins]).groups.items():
   821	            k = int(recovery.loc[idx].sum())
   822	            n = len(idx)
   823	            entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   824	            if n >= MIN_CELL:
   825	                entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   826	            rows.append(entry)
   827	        out["freq_recovery_period_amplitude"] = pd.DataFrame(rows)
   828	        if "median_exp_per_night" in scorable and \
   829	                scorable["median_exp_per_night"].notna().any():
   830	            def epn_amp_cells(frame, success):
   831	                e_bins = np.where(
   832	                    np.isfinite(frame["median_exp_per_night"]),
   833	                    np.digitize(frame["median_exp_per_night"], EXP_PER_NIGHT_EDGES),
   834	                    -1)
   835	                ab = np.where(np.isfinite(frame["amp"]),
   836	                              np.digitize(frame["amp"], amp_edges), -1)
   837	                cells = []
   838	                for (eb, abin), idx in frame.groupby([e_bins, ab]).groups.items():
   839	                    k = int(success.loc[idx].sum())
   840	                    n = len(idx)
   841	                    entry = {"exp_per_night_bin": int(eb), "amp_bin": int(abin),
   842	                             "n": n, "k": k}
   843	                    if n >= MIN_CELL:
   844	                        entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   845	                    cells.append(entry)
   846	                return pd.DataFrame(cells)
   847	
   848	            out["freq_recovery_exposure_amplitude"] = epn_amp_cells(
   849	                scorable, recovery)
   850	        if "median_exp_per_night" in positives and \
   851	                positives["median_exp_per_night"].notna().any():
   852	            e_bins_all = np.where(
   853	                np.isfinite(positives["median_exp_per_night"]),
   854	                np.digitize(positives["median_exp_per_night"],
   855	                            EXP_PER_NIGHT_EDGES), -1)
   856	            det_e_rows = []
   857	            for (eb, abin), idx in positives.groupby(
   858	                    [e_bins_all, a_bins_all]).groups.items():
   859	                k = int(detection.loc[idx].sum())
   860	                n = len(idx)
   861	                entry = {"exp_per_night_bin": int(eb), "amp_bin": int(abin),
   862	                         "n": n, "k": k}
   863	                if n >= MIN_CELL:
   864	                    entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   865	                det_e_rows.append(entry)
   930	    positives = frame[frame["class_label"] == "dsct_flag1"]
   931	    negatives = frame[frame["class_label"] == "dsct_flag0"].reset_index(drop=True)
   932	    boots = []
   933	    for _ in range(BOOTSTRAP_B):
   934	        resampled = negatives.iloc[
   935	            rng.integers(0, len(negatives), size=len(negatives))
   936	        ]
   937	        combined = pd.concat([positives, resampled])
   938	        hit = combined[combined["best_status"] == "confirmed"]
   939	        if hit.empty:
   940	            continue
   941	        w = hit["weight"].to_numpy(dtype=float)
   942	        boots.append(float(
   943	            (w * (hit["class_label"] == "dsct_flag1").to_numpy()).sum() / w.sum()
   944	        ))
   945	    triggered_ambiguous = int(
   946	        (per_star[per_star["class_label"] == "dsct_flag2"]["best_status"]
   947	         == "confirmed").sum()
   948	    )
   949	    # SRSWOR finite-population correction: sampling fraction f = 2314/7292;
   950	    # bootstrap deviations rescaled by sqrt(1 - f) about the point estimate
   951	    fpc = math.sqrt(1.0 - 2314.0 / 7292.0)
   952	    rescaled = [point + fpc * (b - point) for b in boots]
   953	    return {
   954	        "estimand": "frame_specific_label_ppv",
   955	        "p": point,
   956	        "lo": float(np.quantile(rescaled, 0.025)) if rescaled else math.nan,
   957	        "hi": float(np.quantile(rescaled, 0.975)) if rescaled else math.nan,
   958	        "interval": "survey_bootstrap_fpc_rescaled",
   959	        "n_triggered": int(len(triggered)),
   960	        "bootstrap_B_effective": len(boots),
   961	        "dsct2_triggered_reported_separately": triggered_ambiguous,
   962	    }
   963	
   964	
   965	def fp_frequency_distribution(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   966	    if dataset == "d3":
   967	        pool = per_star[per_star["class_label"] == "dsct_flag0"]
   968	    elif dataset == "d2" and "arm" in per_star:
   969	        pool = per_star[per_star["arm"].isin(["gauss_null", "ctrl"])]
   970	    else:
   971	        pool = per_star.iloc[0:0]
   972	    triggered = pool[pool["best_status"].isin(["confirmed", "candidate"])]
   973	    columns = ["sid", "class_label", "arm", "scenario", "best_status", "best_pass",
   974	               "best_frequency_per_day", "baseline_days"]
   975	    return triggered[[c for c in columns if c in triggered.columns]]
   976	
   977	
   978	def sensitivity_table(per_star: pd.DataFrame, dataset: str,
   979	                      crossmatch_qc: pd.DataFrame | None) -> pd.DataFrame:
   980	    rows = []
   981	
   982	    def rate(frame: pd.DataFrame, label: str, variant: str) -> None:
   983	        if frame.empty:
   984	            return
   985	        success = (frame["best_status"] == "confirmed")
   986	        rows.append({"variant": variant, "subset": label,
   987	                     "n": len(frame), "k": int(success.sum()),
   988	                     **dict(zip(("p", "lo", "hi"), wilson(int(success.sum()), len(frame))))})
   989	
   990	    if dataset == "d2" and "arm" in per_star and "scenario" in per_star:
   991	        # common-subset rule: every non-nominal scenario is contrasted with the
   992	        # nominal median-window (K=1) rate recomputed on that scenario's EXACT
   993	        # matched target set (G3 methods round-2 finding 2)
   994	        median_b = per_star[(per_star["arm"] == "B") & (per_star["template_k"] == 1)]
   995	        nominal = median_b[median_b["scenario"] == "nominal"]
   996	        group_cols = ["scenario", "ratio_g", "ratio_rg", "phase_draw", "amp_scale",
   997	                      "dominant_dropped", "cadence_code"]
   998	        for keys, scenario in median_b.groupby(group_cols):
   999	            label = "_".join(f"{c}={v}" for c, v in zip(group_cols, keys))
  1000	            if keys[0] == "nominal":
  1001	                rate(scenario[scenario["best_status"] != "missing"], "arm_b_median_window", label)
  1002	                continue
  1003	            # exact common subset: targets USABLE on both sides (symmetric missingness)
  1004	            usable_s = set(scenario.loc[scenario["best_status"] != "missing", "cluster"])
  1005	            usable_n = set(nominal.loc[nominal["best_status"] != "missing", "cluster"])
  1006	            both = usable_s & usable_n
  1007	            rate(scenario[scenario["cluster"].isin(both)], "arm_b_median_window_common", label)
  1008	            rate(nominal[nominal["cluster"].isin(both)], f"nominal_on_{keys[0]}_targets_common", label)
  1009	    if dataset == "d3":
  1010	        positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
  1011	                             & (per_star["best_status"] != "missing")]
  1012	        if "near_saturation" in positives:
  1013	            rate(positives[positives["near_saturation"] == True], "positives", "near_saturation")  # noqa: E712
  1014	            rate(positives[positives["near_saturation"] == False], "positives", "safe_magnitude")  # noqa: E712
  1015	        if crossmatch_qc is not None:
  1160	        for name in ("shard_manifest.csv", "injected_modes.csv", "rejected_modes.csv",
  1161	                     "excluded_targets.csv", "shard_index.txt", "pilot_shard_index.txt",
  1162	                     "generation_manifest.json"):
  1163	            if (args.shards_dir / name).exists():
  1164	                inputs[str(args.shards_dir / name)] = sha256_file(args.shards_dir / name)
  1165	        for sid, sha in generation.get("shard_sha256", {}).items():
  1166	            inputs[str(args.shards_dir / f"{sid}.csv.gz")] = sha
  1167	        for label, sha in generation.get("inputs_sha256", {}).items():
  1168	            inputs[f"generation_input:{label}"] = sha
  1169	
  1170	    rows = []
  1171	    missing = []
  1172	    for r in truth.itertuples(index=False):
  1173	        json_path = args.stars_dir / f"{r.sid}.json"
  1174	        if not json_path.exists():
  1175	            # eligible roster target with no usable light curve: counts as a
  1176	            # non-detection in the eligible-roster estimand, excluded from the
  1177	            # usable-light-curve estimand (G2 stats finding 2)
  1178	            missing.append(r.sid)
  1179	            if completion is not None:
  1180	                row_ = completion[completion["source_id"] == r.sid]
  1181	                if len(row_) == 1 and row_["status"].iloc[0] == "complete":
  1182	                    raise SystemExit(f"{r.sid}: completion table says complete but no result file")
  1183	            record = {**r._asdict(),
  1184	                      "best_status": "missing", "low_status": "missing",
  1185	                      "high_status": "missing", "best_candidate_matches_any_mode": "unscored",
  1186	                      "best_candidate_matches_dominant": "unscored", "low_match": "unscored",
  1187	                      "high_match": "unscored", "low_eligible": False,
  1188	                      "high_eligible": False, "eligible_any_pass": False,
  1189	                      "best_frequency_per_day": None, "baseline_days": math.nan,
  1190	                      "any_top_peak_matches_any_mode": False,
  1191	                      "prov_valid": False,
  1192	                      "census_variable": census.get(r.sid, {}).get("census_variable")}
  1193	            rows.append(record)
  1194	            continue
  1195	        inputs[str(json_path)] = sha256_file(json_path)
  1196	        if args.dataset in ("d2", "d3"):
  1197	            # provenance sidecar binding (G3 methods finding 6): a result counts
  1198	            # only if its sidecar ties it to THIS shard, attestation, generation
  1199	            prov_path = args.stars_dir / f"{r.sid}.prov.json"
  1200	            if not prov_path.exists():
  1201	                raise SystemExit(f"{r.sid}: result has no provenance sidecar")
  1202	            prov = json.loads(prov_path.read_text(encoding="utf-8"))
  1203	            result_obj = json.loads(json_path.read_text(encoding="utf-8"))
  1204	            problems = []
  1205	            if result_obj.get("source_id") != r.sid:
  1206	                problems.append("result source_id")
