   145	# ------------------------------------------------------------------ templates
   146	
   147	def read_template(path: Path) -> tuple[pd.DataFrame, pd.DataFrame]:
   148	    """(tokens, values): the shard's original text tokens for every column and
   149	    the numeric values exactly as the frozen loader parses them."""
   150	    with gzip.open(path, "rt", encoding="utf-8") as handle:
   151	        tokens = pd.read_csv(handle, dtype=str, keep_default_na=False)
   152	    values = load_star(path)
   153	    if len(tokens) != len(values) or list(tokens["band"]) != list(values["band"]):
   154	        raise SystemExit(f"{path}: token/value row mismatch")
   155	    missing = [c for c in EXPOSURE_COLUMNS if c not in tokens.columns]
   156	    if missing:
   157	        raise SystemExit(f"{path}: template lacks columns {missing}")
   158	    return tokens, values
   159	
   160	
   161	def load_pool(exposure_stars: Path, catalog_path: Path, expected_pool: int
   162	              ) -> tuple[pd.DataFrame, dict[str, tuple[pd.DataFrame, pd.DataFrame]], dict[str, str]]:
   163	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
   164	    ids = sorted(catalog["source_id"])
   165	    if len(ids) != expected_pool or len(set(ids)) != expected_pool:
   166	        raise SystemExit(f"catalog has {len(ids)} rows ({len(set(ids))} unique), "
   167	                         f"expected {expected_pool} unique")
   168	    status = catalog.set_index("source_id")["blind_status"].to_dict()
   169	    templates: dict[str, tuple[pd.DataFrame, pd.DataFrame]] = {}
   170	    shas: dict[str, str] = {}
   171	    rows = []
   172	    for sid in ids:
   173	        path = exposure_stars / f"{sid}.csv.gz"
   174	        if not path.exists():
   175	            raise SystemExit(f"pool window missing for {sid}: {path}")
   176	        tokens, values = read_template(path)
   177	        zg = values[values["band"] == "zg"]
   178	        if zg.empty:
   179	            raise SystemExit(f"{sid}: no zg window (pool must be complete)")
   180	        templates[sid] = (tokens, values)
   240	        mask = band == name
   241	        mag[mask] = mag[mask] + model.evaluate(bjd[mask], name, t_ref)
   242	    frame["mag"] = mag
   243	    return frame, mag
   244	
   245	
   246	def verify_written(path: Path, values: pd.DataFrame, mag: np.ndarray, source_id: str) -> None:
   247	    """Frozen-loader round trip: epochs bitwise identical to the injection
   248	    epochs, mags within a few ulp, both bands, one id, all finite."""
   249	    loaded = load_star(path)
   250	    for column in ("mjd", "bjd_tdb", "night_mjd", "magerr"):
   251	        if not np.array_equal(loaded[column].to_numpy(dtype=float),
   252	                              values[column].to_numpy(dtype=float)):
   253	            raise SystemExit(f"{path}: {column} does not round-trip bitwise through the frozen loader")
   254	    got = loaded["mag"].to_numpy(dtype=float)
   255	    scale = float(np.max(np.abs(mag))) or 1.0
   256	    if not np.all(np.isfinite(got)) or float(np.max(np.abs(got - mag))) > 8.0 * np.finfo(float).eps * scale:
   257	        raise SystemExit(f"{path}: mag does not round-trip within 8 ulp")
   258	    if set(loaded["source_id"]) != {source_id} or set(loaded["band"]) != {"zg", "zr"}:
   259	        raise SystemExit(f"{path}: source_id/band contract violated")
   260	
   261	
   262	def typed_row(**fields) -> dict:
   263	    """A manifest row with EVERY schema column present and typed."""
   264	    defaults = {
   265	        "campaign_id": "", "arm": "", "scenario": "", "tic": 0,
   266	        "template_source_id": "", "template_status": "", "template_k": -1,
   267	        "pool_index": -1, "template_exp_per_night": math.nan,
   268	        "ratio_g": 0.0, "ratio_rg": 0.0, "phase_draw": 0, "amp_scale": 1.0,
   269	        "dominant_dropped": False, "dropped_period_s": math.nan,
   270	        "crowdsap": math.nan, "cadence_code": 0, "cadence_s": 0.0,
   271	        "n_strata_scheduled": 0, "match": "",
   272	        "control_campaign_id": "", "null_serial": -1,
   273	        "n_modes_injected": 0, "n_modes_rejected": 0, "shard_sha256": "",
   274	    }
   275	    unknown = set(fields) - set(defaults)
   276	    if unknown:
   277	        raise ValueError(f"unknown manifest fields {unknown}")
   278	    row = {**defaults, **fields}
   279	    casts = {"str": str, "int": int, "float": float, "bool": bool}
   280	    return {name: casts[kind](row[name]) for name, kind in MANIFEST_COLUMNS}
   281	
   282	
   283	def validate_manifest(frame: pd.DataFrame) -> None:
   284	    validate_manifest_frame(frame)   # schema, uniqueness, typed, per-row semantics
   285	    bad = [sid for sid in frame["campaign_id"] if not campaign_id_ok(sid)]
   286	    if bad:
   287	        raise SystemExit(f"{len(bad)} ids violate the campaign convention: {bad[:3]}")
   288	    # no string cell may be a token pandas' default reader turns into NaN
   289	    for name, kind in MANIFEST_COLUMNS:
   290	        if kind == "str":
   291	            hits = frame[name].isin(PANDAS_NA_TOKENS)
   292	            if hits.any():
   293	                raise SystemExit(f"manifest column {name} holds a pandas NA token: "
   294	                                 f"{frame.loc[hits, name].unique()[:3]}")
   295	
   296	
   297	def pilot_index(frame: pd.DataFrame, dominant_amp: dict[int, float], n_nulls: int) -> list[str]:
   298	    """Deterministic stratified pilot spanning every arm/scenario."""
   299	    chosen: list[str] = []
   300	    nominal_b = frame[(frame["arm"] == "B") & (frame["scenario"] == SCENARIO_NOMINAL)]
   301	    tics = sorted(nominal_b["tic"].unique(), key=lambda t: (dominant_amp.get(int(t), 0.0), t))
   302	    if tics:
   303	        idx = np.unique(np.round(np.linspace(0, len(tics) - 1, min(PILOT_TARGETS, len(tics)))).astype(int))
   304	        pilot_tics = [tics[i] for i in idx]
   305	        for arm in ("B", "A"):
   306	            sub = frame[(frame["arm"] == arm) & (frame["scenario"] == SCENARIO_NOMINAL)
   307	                        & frame["tic"].isin(pilot_tics)]
   308	            chosen.extend(sub["campaign_id"].tolist())
   309	        for scenario, per in frame[frame["arm"] == "B"].groupby("scenario"):
   310	            if scenario == SCENARIO_NOMINAL:
   311	                continue
   312	            take = per[per["tic"].isin(pilot_tics)].sort_values("campaign_id").head(3)
   313	            if take.empty:
   314	                take = per.sort_values("campaign_id").head(3)
   315	            chosen.extend(take["campaign_id"].tolist())
   316	        controls = nominal_b[nominal_b["tic"].isin(pilot_tics)]["control_campaign_id"]
   317	        chosen.extend(sorted({c for c in controls if c})[:10])
   318	    nulls = frame[frame["arm"] == SCENARIO_NULL].sort_values("null_serial")
