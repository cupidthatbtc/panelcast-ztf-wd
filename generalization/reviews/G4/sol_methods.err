   463	        if "ampscale" in arms:
   464	            variants.extend((*nominal, (1,), 0, sc, False, CROWD_CODE_NONE, N) for sc in (0.7, 1.3))
   465	        if "dropout" in arms and len(keep) >= 2:
   466	            variants.append((*nominal, (1,), 0, 1.0, True, CROWD_CODE_NONE, N))
   467	            dropout_eligible.append(tic)
   468	        if "redilution" in arms and tic in crowdsap:
   469	            variants.append((*nominal, (1,), 0, 1.0, False, CROWD_CODE_REDILUTION, N))
   470	            redilution_tics.append(tic)

