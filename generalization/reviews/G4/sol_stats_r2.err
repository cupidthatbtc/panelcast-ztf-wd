  1114	def ppv_d3(per_star: pd.DataFrame) -> dict:
  1115	    """Frame-specific label PPV: weighted fraction of triggered (rule-1, best
  1116	    pass) roster members labeled dSct=1; dSct=2 excluded, reported separately.
  1117	    Survey bootstrap: negatives resampled with replacement, positives fixed."""
  1118	    # the frame keeps every sampled member — a missing light curve cannot
  1119	    # trigger but remains part of the SRS (stats4: preserve all 2,314)
  1120	    frame = per_star[per_star["class_label"].isin(["dsct_flag0", "dsct_flag1"])]
  1121	    triggered = frame[frame["best_status"] == "confirmed"]
  1122	    if triggered.empty:
  1123	        return {"note": "no triggered stars in the PPV frame"}
  1124	    weights = triggered["weight"].to_numpy(dtype=float)
  1125	    is_pos = (triggered["class_label"] == "dsct_flag1").to_numpy()
  1126	    point = float((weights * is_pos).sum() / weights.sum())
  1127	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED + 1))
  1128	    positives = frame[frame["class_label"] == "dsct_flag1"]
  1129	    negatives = frame[frame["class_label"] == "dsct_flag0"].reset_index(drop=True)
  1130	    boots = []
  1131	    for _ in range(BOOTSTRAP_B):
  1132	        resampled = negatives.iloc[
  1133	            rng.integers(0, len(negatives), size=len(negatives))
  1134	        ]
  1135	        combined = pd.concat([positives, resampled])
  1136	        hit = combined[combined["best_status"] == "confirmed"]
  1137	        if hit.empty:
  1138	            continue
  1139	        w = hit["weight"].to_numpy(dtype=float)
  1140	        boots.append(float(
  1141	            (w * (hit["class_label"] == "dsct_flag1").to_numpy()).sum() / w.sum()
  1142	        ))
  1143	    triggered_ambiguous = int(
  1144	        (per_star[per_star["class_label"] == "dsct_flag2"]["best_status"]
  1145	         == "confirmed").sum()
  1146	    )
  1147	    # SRSWOR finite-population correction: sampling fraction f = 2314/7292;
  1148	    # bootstrap deviations rescaled by sqrt(1 - f) about the point estimate
  1149	    fpc = math.sqrt(1.0 - 2314.0 / 7292.0)
  1150	    rescaled = [point + fpc * (b - point) for b in boots]
  1151	    return {
  1152	        "estimand": "frame_specific_label_ppv",
  1153	        "p": point,
  1154	        "lo": float(np.quantile(rescaled, 0.025)) if rescaled else math.nan,
  1155	        "hi": float(np.quantile(rescaled, 0.975)) if rescaled else math.nan,
  1156	        "interval": "survey_bootstrap_fpc_rescaled",
  1157	        "n_triggered": int(len(triggered)),
  1158	        "bootstrap_B_effective": len(boots),
  1159	        "dsct2_triggered_reported_separately": triggered_ambiguous,
  1160	    }
