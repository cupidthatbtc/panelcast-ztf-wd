   103	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
   104	    if not truth:
   105	        return False
   106	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   107	    return any(low <= f <= high for f in truth)
   108	
   109	
   110	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   111	    if status == "missing":
   112	        # no usable light curve: unconditionally a non-detection under every
   113	        # rule in the eligible-roster estimand
   114	        return False
   115	    if rule == "confirmed":
   116	        return status == "confirmed"
   117	    if rule == "confirmed_or_candidate":
   118	        return status in ("confirmed", "candidate")
   119	    if rule == "census":
   120	        return None if census_flag is None else bool(census_flag)
   121	    if rule == "either":
   122	        if census_flag is None:
   123	            return status == "confirmed"
   124	        return status == "confirmed" or bool(census_flag)
   125	    raise ValueError(rule)
