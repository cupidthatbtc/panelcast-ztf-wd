   677	                if aligned.dropna().empty:
   678	                    continue
   679	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   680	                rows.append({
   681	                    **key, "endpoint": endpoint, "denominator": denom,
   682	                    "n_strata_scheduled": n_strata,
   683	                    "n_targets_in_scenario": len(present),
   684	                    "n_targets": n_targets,
   685	                    "n_targets_zero_usable_strata": len(zero_usable),
   686	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   687	                    "prespecified_primary": primary, "confirmatory_decision": False,
   688	                })
   689	        # paired census-vs-LS difference, target-clustered (nominal arm B only)
   690	        if (key["arm"] == "B" and is_nominal
   691	                and "census_variable" in usable_rows
   692	                and usable_rows["census_variable"].notna().any()):
   693	            paired = usable_rows[usable_rows["census_variable"].notna()]
   694	            c_only = paired["census_variable"].astype(bool) & (
   695	                paired["best_status"] != "confirmed")
   696	            l_only = (~paired["census_variable"].astype(bool)) & (
   697	                paired["best_status"] == "confirmed")
   698	            diff = (c_only.astype(float) - l_only.astype(float)).groupby(
   699	                paired["cluster"]).mean()
   700	            aligned = diff.reindex(clusters)
   701	            if not aligned.dropna().empty:
   702	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   703	                rows.append({
   704	                    **key, "endpoint": "paired_census_minus_ls_discordance",
   705	                    "denominator": "usable", "n_strata_scheduled": n_strata,
   706	                    "n_targets_in_scenario": len(present), "n_targets": n_targets,
   707	                    "n_targets_zero_usable_strata": len(zero_usable),
   708	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   709	                    "prespecified_primary": False, "confirmatory_decision": False,
   710	                })
   711	
   712	    # PAIRED contrasts (G3 round-3, both reviewers): every non-nominal arm-B
   713	    # scenario vs nominal K=1 on the IDENTICAL target set, one row per target
   714	    # on each side, ONE common draw matrix for both vectors and their
   715	    # difference; usable denominator = targets usable on BOTH sides;
   716	    # eligible denominator keeps missing rows as failures on both sides
   717	    def boot_mean(vec: pd.Series) -> tuple[float, float, float]:
   718	        values = vec.to_numpy(dtype=float)
   719	        observed = values[~np.isnan(values)]
   720	        if observed.size == 0:
   721	            return math.nan, math.nan, math.nan
   722	        boots = []
   723	        for b in range(BOOTSTRAP_B):
   724	            sample = values[draws[b]]
   725	            sample = sample[~np.isnan(sample)]
   726	            if sample.size:
   727	                boots.append(float(sample.mean()))
   728	        return (float(observed.mean()), float(np.quantile(boots, 0.025)),
   729	                float(np.quantile(boots, 0.975)))
