   671	                    # strata drops from the usable estimand (counted once, below)
   672	                    success = predicate(subset)
   673	                    per_ts = success.groupby(
   674	                        [subset["cluster"], subset["template_k"]]).mean()
   675	                    per_target = per_ts.groupby(level=0).mean()
