   186	def truth_d1() -> pd.DataFrame:
   187	    """Labels from the PUBLISHED master table (19 usable stars; 13
   188	    paper-variable) — the 20-row acquisition roster additionally contains
   189	    sanity controls whose paper_variable flag does not enter the published
   190	    counts. D1 truth frequencies are non-contemporaneous literature
   191	    tabulations (multi-mode DAVs wander between epochs); frequency-recovery
   192	    scoring for D1 is therefore DIAGNOSTIC ONLY (METRICS_SPEC) and D1's
   193	    estimand is detection completeness."""
   194	    master = pd.read_csv(
   195	        REPO_ROOT / "lomb-scargle/results/2026-08-01_full/master_table.csv",
   196	        dtype={"source_id": str},
   197	    )
   198	    lit = pd.read_csv(REPO_ROOT / "data/roster/literature_periods.csv",
   199	                      dtype={"source_id": str})
   200	    freqs = lit.groupby("source_id")["frequency_per_day"].apply(list).to_dict()
   201	    rows = []
   202	    for r in master.itertuples(index=False):
   203	        truth = freqs.get(r.source_id, [])
   204	        # 2833849800205759360 is the frozen pipeline's eclipsing-system sanity
   205	        # control (expected confirmed at 6.1464 / d): a known variable, so it
   206	        # can be neither a paper-constant negative nor a roster positive.
   207	        is_control = r.source_id == "2833849800205759360"
   208	        rows.append({
   209	            "sid": r.source_id, "external_id": r.wdj_name,
   210	            "class_label": "transit_control" if is_control else r.wd_class,
   211	            "label_positive": None if is_control
   212	            else str(r.paper_variable).lower() == "true",
   213	            "weight": 1.0, "cluster": r.source_id,
   214	            "truth_freqs": truth,
   215	            "primary_freq": truth[0] if truth else None,
   216	            "amp": math.nan, "truth_period_days": 1.0 / truth[0] if truth else math.nan,
   217	            "freq_scorable": bool(truth),
   218	        })
   219	    return pd.DataFrame(rows)
