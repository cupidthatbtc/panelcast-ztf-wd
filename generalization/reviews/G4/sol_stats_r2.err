   582	def d2_cluster_bootstrap(per_star: pd.DataFrame, scheduled_tics: list[int] | None = None,
   583	                         pilot: bool = False) -> tuple[pd.DataFrame, pd.DataFrame]:
   584	    """P4 machinery: per (scenario, endpoint), per-stratum rates and the
   585	    scenario-standardized mean over targets; COMMON RANDOM NUMBERS — one
   586	    resample-index matrix shared by every scenario; degenerate statistics
   587	    fall back to target-level exact CP. Scenario identity is the explicit
   588	    manifest `scenario` code plus every grouping key (G3 methods finding 2);
   589	    the eligible denominator is the scenario's SCHEDULED strata count
   590	    (3 nominal, 1 single-window sensitivities), never a fixed 3; the nominal
   591	    arm-B scenario is the ONLY confirmatory P4 row, and only outside pilots."""
