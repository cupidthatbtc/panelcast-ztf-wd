  1186	                     "n": len(frame), "k": int(success.sum()),
  1187	                     "p": p, "lo": max(lo, 0.0), "hi": min(hi, 1.0),
  1188	                     "inference": "descriptive (row-level Wilson); inference lives in the cluster tables"})
  1189	
  1190	    if dataset == "d2" and "arm" in per_star and "scenario" in per_star:
  1191	        # common-subset rule: every non-nominal scenario is contrasted with the
  1192	        # nominal median-window (K=1) rate recomputed on that scenario's EXACT
  1193	        # matched target set (G3 methods round-2 finding 2)
  1194	        median_b = per_star[(per_star["arm"] == "B") & (per_star["template_k"] == 1)]
  1195	        nominal = median_b[median_b["scenario"] == "nominal"]
  1196	        group_cols = ["scenario", "ratio_g", "ratio_rg", "phase_draw", "amp_scale",
  1197	                      "dominant_dropped", "cadence_code"]
  1198	        for keys, scenario in median_b.groupby(group_cols):
  1199	            label = "_".join(f"{c}={v}" for c, v in zip(group_cols, keys))
  1200	            if keys[0] == "nominal":
  1201	                rate(scenario[scenario["best_status"] != "missing"], "arm_b_median_window", label)
  1202	                continue
  1203	            # exact common subset: targets USABLE on both sides (symmetric missingness)
  1204	            usable_s = set(scenario.loc[scenario["best_status"] != "missing", "cluster"])
  1205	            usable_n = set(nominal.loc[nominal["best_status"] != "missing", "cluster"])
  1206	            both = usable_s & usable_n
  1207	            rate(scenario[scenario["cluster"].isin(both)], "arm_b_median_window_common", label)
  1208	            rate(nominal[nominal["cluster"].isin(both)], f"nominal_on_{keys[0]}_targets_common", label)
  1209	    if dataset == "d3":
  1210	        positives = per_star[(per_star["label_positive"] == True)  # noqa: E712

