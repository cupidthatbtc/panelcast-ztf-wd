   358	def production_reasons(arms: set[str], limit, n_nulls: int, expected_pool: int,
   359	                       n_targets_input: int) -> list[str]:
   360	    """Empty list == production generation. Every reason is a hard fact about
   361	    the arguments, never about the outcome."""
   362	    reasons = []
   363	    missing = sorted(set(MANDATORY_PRODUCTION_ARMS) - set(arms))
   364	    if missing:
   365	        reasons.append(f"arms missing {missing}")
   366	    if limit is not None:
   367	        reasons.append("limit")
   368	    if n_nulls != N_NULLS_PRODUCTION:
   369	        reasons.append("n_nulls")
   370	    if expected_pool != POOL_SIZE_PRODUCTION:
   371	        reasons.append("pool")
   372	    if n_targets_input != TARGETS_PRODUCTION:
   373	        reasons.append(f"targets {n_targets_input} != {TARGETS_PRODUCTION}")
   374	    return reasons
