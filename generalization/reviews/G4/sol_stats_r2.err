  1048	        per_t_d = quiet["D_B"].astype(float).groupby(quiet["cluster"]).mean()
  1049	        per_t_r = quiet["R_B"].astype(float).groupby(quiet["cluster"]).mean()
  1050	        row.update({"p_b": float(per_t_d.mean()), "p_b_recovery": float(per_t_r.mean())})
  1051	    summary.append(row)
  1052	    return table, pd.DataFrame(summary)
