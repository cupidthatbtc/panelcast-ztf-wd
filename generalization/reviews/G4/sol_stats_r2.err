  1067	def trigger_rates(per_star: pd.DataFrame, dataset: str, pilot: bool = False) -> pd.DataFrame:
  1068	    rows = []
  1069	    if dataset == "d3":
  1070	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
  1071	        for rule in RULES:
  1072	            fired = negatives.apply(
  1073	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
  1074	                axis=1,
  1075	            )
  1076	            ok = fired.notna()
  1077	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
  1078	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
  1079	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
  1080	    if dataset == "d2" and "arm" in per_star:
  1081	        nulls = per_star[per_star["arm"] == "gauss_null"]
  1082	        if not nulls.empty:
  1083	            valid = (nulls["prov_valid"].astype(bool) if "prov_valid" in nulls
  1084	                     else pd.Series(True, index=nulls.index))
  1085	            completed = nulls[(nulls["best_status"] != "missing") & valid]
  1086	            if "null_serial" in completed and completed["null_serial"].duplicated().any():
  1087	                raise SystemExit("duplicate null serials among completed nulls")
  1088	            x = int((completed["best_status"] == "confirmed").sum())
  1089	            n = len(completed)
  1090	            _, upper = cp_one_sided_bounds(x, n) if n else (math.nan, math.nan)
  1091	            rows.append({
  1092	                "quantity": "fpr_gaussian", "rule": "confirmed",
  1093	                "n_scheduled": len(nulls), "n_completed": n, "k": x,
  1094	                "p": x / n if n else math.nan,
  1095	                "cp_one_sided_95_upper": upper,
  1096	                # the confirmatory decision requires ALL 1000 trials completed
  1097	                "acceptance_u95_leq_0.005": bool(n == 1000 and upper <= 0.005),
  1098	                "n_completed_is_1000": bool(n == 1000),
  1099	                # membership in the prespecified P5 analysis (non-pilot, all 1000
  1100	                # trials completed); P5 is the SOLE confirmatory decision
  1101	                "prespecified_primary": bool((not pilot) and n == 1000),
  1102	                "confirmatory_decision": bool((not pilot) and n == 1000 and upper <= 0.005),
  1103	            })
  1104	        controls = per_star[per_star["arm"] == "ctrl"]
  1105	        if not controls.empty:
  1106	            fired = controls["best_status"] == "confirmed"
  1107	            stats = weighted_wilson(fired.to_numpy(dtype=float),
  1108	                                    np.ones(len(controls)))
  1109	            rows.append({"quantity": "native_trigger_rate", "rule": "confirmed",
  1110	                         **stats})
  1111	    return pd.DataFrame(rows)
