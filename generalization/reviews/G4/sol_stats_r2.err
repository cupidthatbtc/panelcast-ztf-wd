  1180	    def rate(frame: pd.DataFrame, label: str, variant: str) -> None:
  1181	        if frame.empty:
  1182	            return
  1183	        success = (frame["best_status"] == "confirmed")
  1184	        p, lo, hi = wilson(int(success.sum()), len(frame))
