  1061	        raise SystemExit("stars file SHA differs from the run manifest's stars_file_sha256")
  1062	    ids = {line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip()}
  1063	    if ids != selected_ids:
  1064	        raise SystemExit(f"stars file ids ({len(ids)}) != completion table ids ({len(selected_ids)})")
