/bin/zsh -lc "PYTHONDONTWRITEBYTECODE=1 .venv-gen/bin/python -c '
import sys, math
import numpy as np
import pandas as pd
sys.path.insert(0, \"scripts/generalization\")
import metrics_generalization as m

# P4 and degenerate paired contrast.
rows=[]
for t in range(1,6):
    for k in range(3):
        rows.append({\"arm\":\"B\",\"scenario\":\"nominal\",\"ratio_g\":1.7,\"ratio_rg\":.8,\"phase_draw\":0,\"amp_scale\":1.0,\"dominant_dropped\":False,\"cadence_code\":0,\"n_strata_scheduled\":3,\"cluster\":str(t),\"template_k\":k,\"best_status\":\"not_detected\",\"best_candidate_matches_dominant\":\"unmatched\"})
    rows.append({\"arm\":\"B\",\"scenario\":\"phase_1\",\"ratio_g\":1.7,\"ratio_rg\":.8,\"phase_draw\":1,\"amp_scale\":1.0,\"dominant_dropped\":False,\"cadence_code\":0,\"n_strata_scheduled\":1,\"cluster\":str(t),\"template_k\":1,\"best_status\":\"not_detected\",\"best_candidate_matches_dominant\":\"unmatched\"})
p4=pd.DataFrame(rows)
table,contr=m.d2_cluster_bootstrap(p4,[1,2,3,4,5],pilot=False)
primary=table[(table.arm==\"B\")&(table.scenario==\"nominal\")&(table.endpoint==\"recovery\")]
deg=contr[(contr.scenario==\"phase_1\")&(contr.endpoint==\"recovery\")&(contr.denominator==\"eligible\")].iloc[0]
print(\"p4_primary_flags\",primary[[\"denominator\",\"prespecified_primary\",\"confirmatory_decision\"]].to_dict(\"records\"))
print(\"degenerate\",deg[\"interval\"],deg[\"diff\"],deg[\"diff_lo\"],deg[\"diff_hi\"],deg[\"discordance_u95\"])

# P5.
nulls=pd.DataFrame({\"arm\":[\"gauss_null\"]*1000,\"best_status\":[\"not_detected\"]*1000,\"prov_valid\":[True]*1000,\"null_serial\":range(1000)})
p5=m.trigger_rates(nulls,\"d2\",pilot=False).iloc[0]
print(\"p5\",p5[\"cp_one_sided_95_upper\"],p5[\"prespecified_primary\"],p5[\"confirmatory_decision\"])

# Target-equal surface core: one target has 3 successes, four targets one failure each.
surf=pd.DataFrame({\"cluster\":[\"a\",\"a\",\"a\",\"b\",\"c\",\"d\",\"e\"]})
y=pd.Series([1,1,1,0,0,0,0],index=surf.index)
cell=m._target_equal_cells(surf,y,[np.zeros(len(surf),dtype=int)],[\"bin\"]).iloc[0]
print(\"surface_target_equal\",cell[\"n_windows\"],cell[\"n_targets\"],cell[\"p\"],\"pooled\",float(y.mean()),cell[\"interval\"])

# Paired control scoring against partner truth.
pairs=pd.DataFrame([
 {\"sid\":\"b1\",\"arm\":\"B\",\"scenario\":\"nominal\",\"control_campaign_id\":\"c1\",\"cluster\":\"1\",\"template_k\":0,\"best_status\":\"confirmed\",\"best_candidate_matches_dominant\":\"direct\",\"primary_freq\":100.0,\"best_frequency_per_day\":100.0,\"baseline_days\":1000.0},
