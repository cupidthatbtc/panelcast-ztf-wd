    62	def wilson(k: float, n: float) -> tuple[float, float, float]:
    63	    if n <= 0:
    64	        return math.nan, math.nan, math.nan
    65	    z = 1.959963984540054
    66	    p = k / n
    67	    denom = 1.0 + z * z / n
    68	    center = (p + z * z / (2 * n)) / denom
    69	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    70	    return p, max(0.0, center - half), min(1.0, center + half)
    71	
    72	
    73	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    74	    total = float(weights.sum())
    75	    if total <= 0:
    76	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    77	    p = float((weights * successes).sum() / total)
    78	    ess = total * total / float((weights * weights).sum())
    79	    _, lo, hi = wilson(p * ess, ess)
    80	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
