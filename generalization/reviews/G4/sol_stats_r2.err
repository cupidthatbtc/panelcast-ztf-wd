   310	    def progress_payload() -> dict:
   311	        elapsed = time.time() - started
   312	        rate = completed_now / elapsed if elapsed > 0 else 0.0
   313	        return {
   314	            "dataset": args.dataset,
   315	            "total": total,
   316	            "pending_at_start": len(pending),
   317	            "completed_now": completed_now,
