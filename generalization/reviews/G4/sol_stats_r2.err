   499	def test_paired_controls_score_the_control_against_the_partner_truth(generation):
   500	    truth, _ = metrics.truth_d2(generation["out"], pilot=True)
   501	    per_star = truth.copy()
   502	    per_star["best_status"] = "not_detected"
   503	    per_star["best_frequency_per_day"] = np.nan
   504	    per_star["baseline_days"] = 1000.0
   505	    per_star["best_candidate_matches_dominant"] = "unmatched"
   506	    nb = per_star[(per_star["arm"] == "B") & (per_star["scenario"] == SCENARIO_NOMINAL)]
   507	    # B shard of TIC 11, K=0 detects and recovers; its control triggers at the SAME frequency
   508	    b0 = nb[(nb["cluster"] == "11") & (nb["template_k"] == 0)].iloc[0]
   509	    per_star.loc[per_star["sid"] == b0["sid"], ["best_status", "best_candidate_matches_dominant"]] = ["confirmed", "direct"]
   510	    per_star.loc[per_star["sid"] == b0["control_campaign_id"], ["best_status", "best_frequency_per_day"]] = ["confirmed", b0["primary_freq"]]
   511	    table, summary = metrics.d2_paired_controls(per_star)
   512	    row = table[table["b_sid"] == b0["sid"]].iloc[0]
   513	    assert row["D_B"] and row["D_C"] and row["R_B"] and row["R_C"]          # accidental native match caught
   514	    d_row = summary[summary["endpoint"] == "D"].iloc[0]
   515	    assert d_row["both"] == 1 and d_row["n_pairs_scored"] == len(table)
   516	    assert "quiet_control_conditioned" in set(summary["endpoint"])
