   937	def d2_chance_match(primary: pd.DataFrame, n_derangements: int = CHANCE_MATCH_DERANGEMENTS_D2) -> dict:
   938	    """Amendment 4: accidental-match calibration by TARGET-level derangements
   939	    (all K replicates of a target move together), numerators aligned with the
   940	    endpoints: confirmed AND direct match to the permuted target's dominant
   941	    mode; confirmed AND direct match to any of its injected modes."""
   942	    rows = primary[primary["best_frequency_per_day"].notna() & primary["freq_scorable"]]
   943	    targets = sorted(rows["cluster"].unique())
   944	    if len(targets) < 3:
   945	        return {"derangements": 0, "note": "fewer than 3 targets"}
   946	    index = {t: i for i, t in enumerate(targets)}
   947	    dominant = np.array([float(rows.loc[rows["cluster"] == t, "primary_freq"].iloc[0]) for t in targets])
   948	    lists = [list(rows.loc[rows["cluster"] == t, "truth_freqs"].iloc[0]) for t in targets]
   949	    width = max(len(x) for x in lists)
   950	    modes = np.full((len(targets), width), np.nan)
   951	    for i, x in enumerate(lists):
   952	        modes[i, :len(x)] = x
   953	    f = rows["best_frequency_per_day"].to_numpy(dtype=float)
   954	    tol = 1.5 / rows["baseline_days"].to_numpy(dtype=float) + TRUTH_QUANTUM_PER_DAY["d2"]
   955	    confirmed = (rows["best_status"] == "confirmed").to_numpy()
   956	    t_idx = np.array([index[t] for t in rows["cluster"]])
   957	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   958	    rec_rates, any_rates = [], []
   959	    n = len(targets)
   960	    made = 0
   961	    while made < n_derangements:
   962	        perm = rng.permutation(n)
   963	        if (perm == np.arange(n)).any():
   964	            continue
   965	        made += 1
   966	        sigma = perm[t_idx]
   967	        rec = confirmed & (np.abs(f - dominant[sigma]) <= tol)
   968	        anyhit = confirmed & (np.nanmin(np.abs(f[:, None] - modes[sigma]), axis=1) <= tol)
   969	        per_t_rec = pd.Series(rec.astype(float)).groupby(t_idx).mean()
   970	        per_t_any = pd.Series(anyhit.astype(float)).groupby(t_idx).mean()
   971	        rec_rates.append(float(per_t_rec.mean()))
   972	        any_rates.append(float(per_t_any.mean()))
   973	    return {"derangements": n_derangements, "unit": "target-equal mean over nominal arm-B windows",
   974	            "accidental_recovery_rate_mean": float(np.mean(rec_rates)),
   975	            "accidental_recovery_rate_p95": float(np.quantile(rec_rates, 0.95)),
   976	            "accidental_any_mode_rate_mean": float(np.mean(any_rates)),
   977	            "accidental_any_mode_rate_p95": float(np.quantile(any_rates, 0.95))}
