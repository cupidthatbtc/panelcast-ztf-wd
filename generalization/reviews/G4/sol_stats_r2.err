  1163	def fp_frequency_distribution(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
  1164	    if dataset == "d3":
  1165	        pool = per_star[per_star["class_label"] == "dsct_flag0"]
  1166	    elif dataset == "d2" and "arm" in per_star:
