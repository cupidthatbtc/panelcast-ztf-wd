    83	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    84	    """Evaluate EVERY (truth mode, relation) predicate — no short-circuit
    85	    (spec: hits in more than one relation class -> ambiguous)."""
    86	    classes: set[str] = set()
    87	    for f_t in truth:
    88	        if abs(freq - f_t) <= tol:
    89	            classes.add("direct")
    90	        if abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    91	            classes.add("harmonic")
    92	        for k in (1, 2):
    93	            for sign in (1.0, -1.0):
    94	                if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    95	                    classes.add("window_alias")
    96	    if not classes:
    97	        return "unmatched"
    98	    if len(classes) > 1:
    99	        return "ambiguous"
   100	    return classes.pop()
