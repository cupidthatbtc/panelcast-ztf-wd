   485	def test_d2_chance_match_is_target_level(generation):
   486	    truth, _ = metrics.truth_d2(generation["out"], pilot=True)
   487	    primary = truth[(truth["arm"] == "B") & (truth["scenario"] == SCENARIO_NOMINAL)].copy()
   488	    # two targets only -> refuses (needs >= 3); add a third synthetic target by relabelling
   489	    primary["best_status"] = "confirmed"
   490	    primary["best_frequency_per_day"] = primary["primary_freq"]
   491	    primary["baseline_days"] = 1000.0
   492	    three = pd.concat([primary, primary.iloc[:3].assign(cluster="99", primary_freq=123.4,
   493	                                                        truth_freqs=[[123.4]] * 3)])
   494	    out = metrics.d2_chance_match(three, n_derangements=50)
   495	    assert out["derangements"] == 50 and 0.0 <= out["accidental_recovery_rate_mean"] <= 1.0
   496	    assert out["accidental_any_mode_rate_mean"] >= out["accidental_recovery_rate_mean"]
