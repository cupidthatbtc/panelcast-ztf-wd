  1055	def verify_stars_file(path: Path, recorded_sha: str, selected_ids: set[str]) -> None:
  1056	    """Amendment 4 provenance: a subset run's selection file is SHA-bound to the
  1057	    run manifest and must equal the completion table's id set exactly."""
  1058	    if not path.exists():
  1059	        raise SystemExit(f"stars file not found: {path}")
