   630	            lo, hi = cp_one_sided_bounds(k_deg, len(observed))
   631	            return point, lo, hi, "cp_one_sided", len(observed)
   632	        return (point, float(np.quantile(boots, 0.025)),
   633	                float(np.quantile(boots, 0.975)), "cluster_bootstrap", len(observed))
   634	
   635	    for keys, scenario in frame.groupby(scenario_cols):
   636	        key = dict(zip(scenario_cols, keys))
   637	        key["dominant_dropped"] = bool(key["dominant_dropped"])
   638	        strata = scenario["n_strata_scheduled"].unique()
   639	        if len(strata) != 1 or int(strata[0]) < 1:
   640	            raise SystemExit(f"scenario {key} has inconsistent n_strata_scheduled {strata}")
   641	        n_strata = int(strata[0])
   642	        present = set(scenario["cluster"])
   643	        is_nominal = key["scenario"] == "nominal"
   644	        if is_nominal:
   645	            counts = scenario.groupby(["cluster", "template_k"]).size()
   646	            if (counts != 1).any() or set(scenario["template_k"]) != set(range(n_strata)):
   647	                raise SystemExit("nominal scenario must hold exactly one replicate per (target, K)")
   648	            if scheduled_tics and present != set(clusters):
   649	                raise SystemExit("nominal scenario targets != scheduled targets")
   650	        usable_rows = scenario[scenario["best_status"] != "missing"]
   651	        zero_usable = sorted(present - set(usable_rows["cluster"]))
   652	        # `prespecified_primary` = the row IS the prespecified primary P4
   653	        # analysis (recovery endpoint, nominal arm B, non-pilot);
   654	        # `confirmatory_decision` is False for every P4 row — P5 is the sole
   655	        # confirmatory decision (spec)
   656	        for endpoint, predicate in endpoints.items():
   657	            primary = (key["arm"] == "B" and is_nominal and not pilot
   658	                       and endpoint == "recovery")
