   475	def validate_manifest_frame(frame: pd.DataFrame) -> None:
   476	    """Shared by the builder (before publishing) and the metrics reader
   477	    (before consuming): schema, uniqueness, typed columns, and every row's
   478	    semantic invariants. Raises SystemExit with the first offending row."""
   479	    if list(frame.columns) != list(MANIFEST_COLUMN_NAMES):
