   253	def load_d2_manifest(shards_dir: Path) -> pd.DataFrame:
   254	    """Fixed typed manifest schema (d2_truth_model.MANIFEST_COLUMNS); any
   255	    deviation, NaN in an int/bool column, or duplicate id is fatal."""
   256	    from d2_truth_model import MANIFEST_COLUMN_NAMES, MANIFEST_COLUMNS
   257	    path = shards_dir / "shard_manifest.csv"
   258	    header = pd.read_csv(path, nrows=0).columns.tolist()
   259	    if header != list(MANIFEST_COLUMN_NAMES):
   260	        raise SystemExit(f"{path}: columns deviate from the frozen manifest schema")

