   128	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None,
   129	               truth_quantum: float = 0.0) -> dict:
   130	    result = json.loads(json_path.read_text(encoding="utf-8"))
   131	    if not result.get("complete"):
   132	        raise SystemExit(f"{json_path} is not complete")
   133	    passes = result["passes"]
   134	    if set(passes) != {"low", "high"}:
   135	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   136	    baseline = float(result["baseline_days"])
   137	    tol = 1.5 / baseline + truth_quantum
   138	    overall = overall_result(result)
   139	
   140	    row: dict = {
   141	        "baseline_days": baseline,
   142	        "n_exp_zg": result["n_exp_zg"],
   143	        "n_exp_zr": result["n_exp_zr"],
   144	        "best_pass": overall["best_pass"],
   145	        "best_status": overall["blind_status"],
   146	        "best_frequency_per_day": overall["best_frequency_per_day"],
   147	        "low_available": passes["low"].get("available", True),
   148	        "high_available": passes["high"].get("available", True),
   149	    }
   150	    any_direct_top = False
   151	    for name in ("low", "high"):
   152	        p = passes[name]
   153	        freq = p.get("frequency_per_day")
   154	        row[f"{name}_status"] = p["status"]
   155	        row[f"{name}_frequency_per_day"] = freq
   156	        row[f"{name}_match"] = (
   157	            classify_match(float(freq), truth_freqs, tol)
   158	            if freq is not None and truth_freqs else "unscored"
   159	        )
   160	        row[f"{name}_match_primary"] = (
   161	            classify_match(float(freq), [primary_freq], tol)
   162	            if freq is not None and primary_freq is not None else "unscored"
   163	        )
   164	        row[f"{name}_eligible"] = pass_eligible(truth_freqs, name, baseline)
   165	        for peak in p.get("top_peaks", []):
   166	            f_peak = peak.get("frequency_per_day")
   167	            if f_peak is not None and truth_freqs and \
   168	               classify_match(float(f_peak), truth_freqs, tol) == "direct":
   169	                any_direct_top = True
   170	    best_freq = row["best_frequency_per_day"]
   171	    row["best_candidate_matches_any_mode"] = (
   172	        classify_match(float(best_freq), truth_freqs, tol)
   173	        if best_freq is not None and truth_freqs else "unscored"
   174	    )
   175	    row["best_candidate_matches_dominant"] = (
   176	        classify_match(float(best_freq), [primary_freq], tol)
   177	        if best_freq is not None and primary_freq is not None else "unscored"
   178	    )
   179	    row["any_top_peak_matches_any_mode"] = any_direct_top
   180	    row["eligible_any_pass"] = row["low_eligible"] or row["high_eligible"]
   181	    return row
