   147	# ------------------------------------------------------------------ templates
   148	
   149	def read_template(path: Path) -> tuple[pd.DataFrame, pd.DataFrame]:
   150	    """(tokens, values): the shard's original text tokens for every column and
   151	    the numeric values exactly as the frozen loader parses them."""
   152	    with gzip.open(path, "rt", encoding="utf-8") as handle:
   153	        tokens = pd.read_csv(handle, dtype=str, keep_default_na=False)
   154	    values = load_star(path)
   155	    if len(tokens) != len(values) or list(tokens["band"]) != list(values["band"]):
   156	        raise SystemExit(f"{path}: token/value row mismatch")
   157	    missing = [c for c in EXPOSURE_COLUMNS if c not in tokens.columns]
   158	    if missing:
   159	        raise SystemExit(f"{path}: template lacks columns {missing}")
   160	    return tokens, values
   161	
   162	
   163	def load_pool(exposure_stars: Path, catalog_path: Path, expected_pool: int
   164	              ) -> tuple[pd.DataFrame, dict[str, tuple[pd.DataFrame, pd.DataFrame]], dict[str, str]]:
   165	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
   166	    ids = sorted(catalog["source_id"])
   167	    if len(ids) != expected_pool or len(set(ids)) != expected_pool:
   168	        raise SystemExit(f"catalog has {len(ids)} rows ({len(set(ids))} unique), "
   169	                         f"expected {expected_pool} unique")
   170	    status = catalog.set_index("source_id")["blind_status"].to_dict()
   171	    templates: dict[str, tuple[pd.DataFrame, pd.DataFrame]] = {}
   172	    shas: dict[str, str] = {}
   173	    rows = []
   174	    for sid in ids:
   175	        path = exposure_stars / f"{sid}.csv.gz"
   176	        if not path.exists():
   177	            raise SystemExit(f"pool window missing for {sid}: {path}")
   178	        tokens, values = read_template(path)
   179	        zg = values[values["band"] == "zg"]
   180	        if zg.empty:
   181	            raise SystemExit(f"{sid}: no zg window (pool must be complete)")
   182	        templates[sid] = (tokens, values)
   183	        shas[sid] = sha256_file(path)
   184	        per_night = zg.groupby("night_mjd").size()
   185	        rows.append({
   186	            "source_id": sid,
   187	            "median_zg": float(zg["mag"].median()),
   188	            "n_zg": int(len(zg)),
   189	            "exp_per_night": float(per_night.median()),
   190	            # Amendment 4: zg support surviving the frozen nightly-median subtraction
   191	            "wg_contrasts": int((per_night - 1).clip(lower=0).sum()),
   192	            "blind_status": str(status[sid]),
   193	        })
   194	    stats = pd.DataFrame(rows).sort_values("source_id").reset_index(drop=True)
   195	    stats["pool_index"] = np.arange(len(stats))
   196	    return stats, templates, shas
   197	
   198	
   199	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
   200	    delta = (stats["median_zg"] - gmag).abs()
   201	    label = "nearest"
   202	    pool = stats.iloc[0:0]
   203	    for tol, tol_label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
   204	        candidate = stats[delta <= tol]
   205	        if len(candidate) >= 3:
   206	            pool, label = candidate, tol_label
   207	            break
   208	    if len(pool) < 3:
   209	        ranked = stats.assign(abs_delta=delta).sort_values(
   210	            ["abs_delta", "source_id"], kind="stable")
   211	        pool = ranked.head(9)
   212	    ordered = pool.sort_values(["wg_contrasts", "source_id"], kind="stable").reset_index(drop=True)
   213	    picks = [
   214	        str(ordered.iloc[min(len(ordered) - 1, int(np.round(q * (len(ordered) - 1))))]["source_id"])
   215	        for q in (0.10, 0.50, 0.90)
   216	    ]
   217	    return picks, label
