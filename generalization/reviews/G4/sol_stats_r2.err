   222	def truth_d3() -> pd.DataFrame:
   223	    roster = pd.read_csv(REPO_ROOT / "generalization/data/d3/roster_d3.csv",
   224	                         dtype={"source_id": str})
   225	    mo = pd.read_csv(REPO_ROOT / "generalization/data/d3/raw/mo2026_table2.csv")
   226	    mo["freq_per_day"] = mo["Freq"] * 86400.0 / 1e6
   227	    freq_lists = mo.groupby("KIC")["freq_per_day"].apply(list).to_dict()
   228	    rows = []
   229	    for r in roster.itertuples(index=False):
   230	        kic = int(r.KIC)
   231	        truth = freq_lists.get(kic, [])
   232	        label = None if r.dSct == 2 else bool(r.dSct == 1)
   233	        rows.append({
   234	            "sid": r.source_id, "external_id": r.external_id,
   235	            "class_label": r.class_label, "label_positive": label,
   236	            "weight": float(r.sampling_weight), "cluster": r.source_id,
   237	            "truth_freqs": truth,
   238	            "primary_freq": float(r.dom_freq_per_day)
   239	            if np.isfinite(r.dom_freq_per_day) else None,
   240	            "amp": float(r.amp_mmag),
   241	            "truth_period_days": 1.0 / float(r.dom_freq_per_day)
   242	            if np.isfinite(r.dom_freq_per_day) and r.dom_freq_per_day > 0 else math.nan,
   243	            "freq_scorable": bool(truth) and bool(label),
   244	            "stratum": r.stratum, "near_saturation": bool(r.near_saturation),
   245	            "subhour": bool(r.subhour),
   246	        })
   247	    return pd.DataFrame(rows)
