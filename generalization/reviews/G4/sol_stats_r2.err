  1014	    def boot(series: pd.Series) -> tuple[float, float, float]:
  1015	        per_target = series.astype(float).groupby(table.loc[series.index, "cluster"]).mean().reindex(clusters)
  1016	        values = per_target.to_numpy(dtype=float)
