     1	#!/usr/bin/env python3
     2	"""Campaign metrics per METRICS_SPEC.md — the spec's names are binding.
     3	
     4	Reads per-star JSONs directly (never only a summary CSV), scores the match
     5	taxonomy against dataset truth, and emits the spec's output files. Datasets:
     6	
     7	  d1  published 2026-08-01 bundle (19 labeled WDs inside the 928 catalog);
     8	      truth = Jestin roster + literature periods; census = published CSV.
     9	  d3  campaign Kepler dSct run; truth = roster_d3.csv + Mo+2026 frequencies;
    10	      census = build_panels_generic output.
    11	  d2  campaign injection run; truth = shard_manifest.csv + injected_modes.csv
    12	      (the actually-injected post-sinc-rejection mode set, never d2_modes);
    13	      census computed from the shards with frozen functions; the TESS target
    14	      is the cluster (bootstrap over targets).
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import argparse
    20	import gzip
    21	import hashlib
    22	import json
    23	import math
    24	from pathlib import Path
    25	from types import SimpleNamespace
