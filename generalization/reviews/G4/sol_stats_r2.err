   179	        zg = values[values["band"] == "zg"]
   180	        if zg.empty:
   181	            raise SystemExit(f"{sid}: no zg window (pool must be complete)")
   182	        templates[sid] = (tokens, values)
   183	        shas[sid] = sha256_file(path)
   184	        per_night = zg.groupby("night_mjd").size()
   185	        rows.append({
   186	            "source_id": sid,
   187	            "median_zg": float(zg["mag"].median()),
   188	            "n_zg": int(len(zg)),
   189	            "exp_per_night": float(per_night.median()),
   190	            # Amendment 4: zg support surviving the frozen nightly-median subtraction
   191	            "wg_contrasts": int((per_night - 1).clip(lower=0).sum()),
   192	            "blind_status": str(status[sid]),
   193	        })
   194	    stats = pd.DataFrame(rows).sort_values("source_id").reset_index(drop=True)
   195	    stats["pool_index"] = np.arange(len(stats))
   196	    return stats, templates, shas
   197	
   198	
   199	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
   200	    delta = (stats["median_zg"] - gmag).abs()
   201	    label = "nearest"
   202	    pool = stats.iloc[0:0]
   203	    for tol, tol_label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
   204	        candidate = stats[delta <= tol]
   205	        if len(candidate) >= 3:
   206	            pool, label = candidate, tol_label
   207	            break
   208	    if len(pool) < 3:
   209	        ranked = stats.assign(abs_delta=delta).sort_values(
   210	            ["abs_delta", "source_id"], kind="stable")
   211	        pool = ranked.head(9)
   212	    ordered = pool.sort_values(["wg_contrasts", "source_id"], kind="stable").reset_index(drop=True)
   213	    picks = [
   214	        str(ordered.iloc[min(len(ordered) - 1, int(np.round(q * (len(ordered) - 1))))]["source_id"])
   215	        for q in (0.10, 0.50, 0.90)
   216	    ]
   217	    return picks, label
   218	
   219	
   220	# ----------------------------------------------------------------- ids/shards
   221	
   222	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   223	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   224	        frame[list(EXPOSURE_COLUMNS)].to_csv(handle, index=False, lineterminator="\n")
   225	
   226	
   227	def synthesize(tokens: pd.DataFrame, values: pd.DataFrame, model, source_id: str,
   228	               gaussian_floor: bool, seed: int) -> tuple[pd.DataFrame, np.ndarray]:
   229	    """Returns (frame to write, computed mag array). Every column except
   230	    source_id and mag is the template's original text token."""
   231	    frame = tokens.copy()
   232	    frame["source_id"] = source_id
   233	    bjd = values["bjd_tdb"].to_numpy(dtype=float)
   234	    band = values["band"].to_numpy()
   235	    mag = values["mag"].to_numpy(dtype=float).copy()
   236	    t_ref = float(bjd.min())
   237	    if gaussian_floor:
   238	        rng = np.random.Generator(np.random.PCG64(seed))
   239	        for name in ("zg", "zr"):
   240	            mask = band == name
   241	            median = float(np.median(mag[mask]))
   242	            noise = rng.normal(0.0, values.loc[mask, "magerr"].to_numpy(dtype=float))
   243	            mag[mask] = median + noise
   244	    for name in ("zg", "zr"):
   245	        mask = band == name
   246	        mag[mask] = mag[mask] + model.evaluate(bjd[mask], name, t_ref)
   247	    frame["mag"] = mag
   248	    return frame, mag
   249	
   250	
   251	def verify_written(path: Path, values: pd.DataFrame, mag: np.ndarray, source_id: str) -> None:
   252	    """Frozen-loader round trip: epochs bitwise identical to the injection
   253	    epochs, mags within a few ulp, both bands, one id, all finite."""
   254	    loaded = load_star(path)
   255	    for column in ("mjd", "bjd_tdb", "night_mjd", "magerr"):
   256	        if not np.array_equal(loaded[column].to_numpy(dtype=float),
   257	                              values[column].to_numpy(dtype=float)):
   258	            raise SystemExit(f"{path}: {column} does not round-trip bitwise through the frozen loader")
   259	    got = loaded["mag"].to_numpy(dtype=float)
   260	    scale = float(np.max(np.abs(mag))) or 1.0
   261	    if not np.all(np.isfinite(got)) or float(np.max(np.abs(got - mag))) > 8.0 * np.finfo(float).eps * scale:
   262	        raise SystemExit(f"{path}: mag does not round-trip within 8 ulp")
   263	    if set(loaded["source_id"]) != {source_id} or set(loaded["band"]) != {"zg", "zr"}:
   264	        raise SystemExit(f"{path}: source_id/band contract violated")
   265	
   266	
   267	def typed_row(**fields) -> dict:
   268	    """A manifest row with EVERY schema column present and typed."""
   269	    defaults = {
   270	        "campaign_id": "", "arm": "", "scenario": "", "tic": 0,
   271	        "template_source_id": "", "template_status": "", "template_k": -1,
   272	        "pool_index": -1, "template_exp_per_night": math.nan, "template_wg_contrasts": -1,
   273	        "ratio_g": 0.0, "ratio_rg": 0.0, "phase_draw": 0, "amp_scale": 1.0,
   274	        "dominant_dropped": False, "dropped_period_s": math.nan,
   275	        "crowdsap": math.nan, "cadence_code": 0, "cadence_s": 0.0,
   276	        "n_strata_scheduled": 0, "match": "",
   277	        "control_campaign_id": "", "null_serial": -1,
   278	        "n_modes_injected": 0, "n_modes_rejected": 0, "shard_sha256": "",
   279	    }
   280	    unknown = set(fields) - set(defaults)
   281	    if unknown:
   282	        raise ValueError(f"unknown manifest fields {unknown}")
   283	    row = {**defaults, **fields}
   284	    casts = {"str": str, "int": int, "float": float, "bool": bool}
   285	    return {name: casts[kind](row[name]) for name, kind in MANIFEST_COLUMNS}
   286	
   287	
   288	def validate_manifest(frame: pd.DataFrame) -> None:
   289	    validate_manifest_frame(frame)   # schema, uniqueness, typed, per-row semantics
   290	    bad = [sid for sid in frame["campaign_id"] if not campaign_id_ok(sid)]
   291	    if bad:
   292	        raise SystemExit(f"{len(bad)} ids violate the campaign convention: {bad[:3]}")
   293	    # no string cell may be a token pandas' default reader turns into NaN
   294	    for name, kind in MANIFEST_COLUMNS:
   295	        if kind == "str":
   296	            hits = frame[name].isin(PANDAS_NA_TOKENS)
   297	            if hits.any():
   298	                raise SystemExit(f"manifest column {name} holds a pandas NA token: "
   299	                                 f"{frame.loc[hits, name].unique()[:3]}")
   300	

