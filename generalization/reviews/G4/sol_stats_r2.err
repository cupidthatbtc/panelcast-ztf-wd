   338	def campaign_id(arm_prefix: str, tic: int, k: int, g_idx: int, r_idx: int,
   339	                phase_draw: int = 0, amp_code: int = 0,
   340	                crowd_code: int = CROWD_CODE_NONE,
   341	                cadence_code: int = CADENCE_CODE_NOMINAL) -> str:
   342	    """Layout AA TTTTTTTTTT K G R P S C D (D = cadence code, Amendment 3)."""
   343	    sid = (f"{arm_prefix}{tic:010d}{k}{g_idx}{r_idx}"
   344	           f"{phase_draw}{amp_code}{crowd_code}{cadence_code}")
   345	    if len(sid) != 19 or not sid.isdigit():
   346	        raise ValueError(f"malformed campaign id {sid}")
   347	    return sid
