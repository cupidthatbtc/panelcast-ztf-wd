    72	# ----------------------------------------------------------------- contract
    73	# Campaign id layout (19 digits): AA TTTTTTTTTT K GR PS CD
    74	#   AA arm prefix (92 = arm B, 93 = arm A), T zero-padded TIC, K template index
    75	#   (0/1/2), G/R ladder indices (1-3; 22 = nominal), P phase-draw (0-2),
    76	#   S amplitude-scale code (below), C crowding-variant code (0 = PDCSAP as
    77	#   published, 1 = SAP-equivalent re-dilution), D cadence code (0 = frozen
    78	#   rule, 1 = cadence_alt pure-120-s endpoint; Amendment 3).
    79	#   Nulls: 94 + 17-digit serial. Controls: 95 + 17-digit index of the template
    80	#   in the sorted fixed 928-window pool. Self-window diagnostic: 96 prefix.
    81	AMP_SCALE_CODES = {1.0: 0, 0.7: 1, 1.3: 2}
    82	AMP_SCALE_CODE_DROPOUT = 3          # amp_scale 1.0 with the dominant mode dropped
    83	CROWD_CODE_NONE = 0
    84	CROWD_CODE_REDILUTION = 1
