   563	def check_wg_strata(frame: pd.DataFrame, production: bool) -> list[str]:
   564	    """Amendment 4: the three nominal windows of every target must carry
   565	    strictly increasing W_g (K0 < K1 < K2). Production refuses violations;
   566	    otherwise the violating targets are returned for the record."""
   567	    nominal = frame[(frame["arm"].isin(["A", "B"])) & (frame["scenario"] == SCENARIO_NOMINAL)]
   568	    violations = []
   569	    for tic, g in nominal.drop_duplicates(["tic", "template_k"]).groupby("tic"):
   570	        w = g.sort_values("template_k")["template_wg_contrasts"].tolist()
   571	        if len(w) != 3 or not (w[0] < w[1] < w[2]):
   572	            violations.append(f"TIC {tic}: W_g by K = {w}")
   573	    if production and violations:
   574	        raise SystemExit(f"W_g strata not strictly increasing for {len(violations)} targets: {violations[:3]}")
   575	    return violations

