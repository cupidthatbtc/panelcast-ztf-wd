   377	def _row_problem(r) -> str:
   378	    """Semantic invariants of ONE manifest row (G3 methods round-2 new MAJOR):
   379	    enumerations, per-arm defaults, scenario recomputed from its fields, and
   380	    the campaign id recomputed from its fields."""
   381	    if r.arm not in ARMS:
   382	        return f"arm {r.arm!r}"
   383	    if r.scenario not in all_scenarios():
   384	        return f"scenario {r.scenario!r}"
   385	    if not (isinstance(r.shard_sha256, str) and len(r.shard_sha256) == 64):
   386	        return "shard_sha256"
   387	    if r.arm in ("A", "B"):
   388	        if r.tic <= 0 or r.template_k not in (0, 1, 2) or r.pool_index < 0:
   389	            return "tic/template_k/pool_index"
   390	        if r.ratio_g not in BANDPASS_LADDER_G or r.ratio_rg not in BANDPASS_LADDER_RG:
   391	            return "ratios"
   392	        if r.phase_draw not in (0, 1, 2) or r.amp_scale not in AMP_SCALES:
   393	            return "phase_draw/amp_scale"
   394	        # absence is NaN EXACTLY; any present value must be finite and in range
   395	        # (G3 methods round-4: inf must not read as "absent")
   396	        crowd_present = not math.isnan(r.crowdsap)
   397	        if crowd_present and not (math.isfinite(r.crowdsap) and 0.0 < r.crowdsap <= 1.0):
   398	            return "crowdsap must be NaN (absent) or finite in (0, 1]"
   399	        crowd = CROWD_CODE_REDILUTION if crowd_present else CROWD_CODE_NONE
   400	        if r.match not in MATCH_LABELS or r.template_status not in BLIND_STATUSES:
   401	            return "match/template_status vocabulary"
   402	        if r.cadence_code not in (CADENCE_CODE_NOMINAL, CADENCE_CODE_ALT) or r.cadence_s not in CADENCES_S:
   403	            return "cadence_code/cadence_s"
   404	        # sensitivity axes are MUTUALLY EXCLUSIVE: nominal = no axis, every other
   405	        # scenario = exactly one axis (G3 methods round-3: precedence must not
   406	        # hide crossed axes)
   407	        axes = [not (r.ratio_g == NOMINAL_G and r.ratio_rg == NOMINAL_RG),
   408	                r.phase_draw != 0, r.amp_scale != 1.0, bool(r.dominant_dropped),
   409	                crowd == CROWD_CODE_REDILUTION, r.cadence_code == CADENCE_CODE_ALT]
   410	        if sum(axes) != (0 if r.scenario == SCENARIO_NOMINAL else 1):
   411	            return "crossed or missing sensitivity axes for this scenario"
   412	        if r.cadence_code == CADENCE_CODE_ALT and (
   413	                r.cadence_s != CADENCE_ALT_S or r.arm != "B" or crowd != CROWD_CODE_NONE
   414	                or bool(r.dominant_dropped) or r.phase_draw != 0 or r.amp_scale != 1.0
   415	                or r.ratio_g != NOMINAL_G or r.ratio_rg != NOMINAL_RG):
   416	            return "cadence_alt must be arm B, nominal ratios/phase/scale, no dropout/crowding, 120 s"
   417	        if scenario_code(r.ratio_g, r.ratio_rg, r.phase_draw, r.amp_scale,
   418	                         bool(r.dominant_dropped), crowd, r.cadence_code) != r.scenario:
   419	            return "scenario inconsistent with its fields"
   420	        dropped_present = not math.isnan(r.dropped_period_s)
   421	        if dropped_present and not (math.isfinite(r.dropped_period_s) and r.dropped_period_s > 0.0):
   422	            return "dropped_period_s must be NaN (absent) or a finite positive period"
   423	        if bool(r.dominant_dropped) != dropped_present:
   424	            return "dropped_period_s"
   425	        if r.n_strata_scheduled != (3 if r.scenario == SCENARIO_NOMINAL else 1):
   426	            return "n_strata_scheduled"
   427	        if r.template_wg_contrasts < 0:
   428	            return "template_wg_contrasts"
   429	        if r.scenario != SCENARIO_NOMINAL and r.template_k != 1:
   430	            return "sensitivity scenarios run on the median window only"

