   319	            "elapsed_seconds": round(elapsed, 1),
   320	            "stars_per_hour": round(rate * 3600.0, 2),
   321	            "eta_hours": round((len(pending) - completed_now - len(failures)) / (rate * 3600.0), 2)
   322	            if rate > 0
   323	            else None,
   324	            "workers": workers,
   325	        }
   326	
   327	    write_progress(progress_path, progress_payload())
   328	    with ProcessPoolExecutor(max_workers=workers) as executor:
   329	        futures = {
