import pandas as pd
import numpy as np
from pathlib import Path
exp_path=Path(\"catalog-rebuild/results/2026-08-01_full/data/exposures.csv.gz\")
targets=pd.read_csv(\"generalization/data/d2/d2_targets.csv\",dtype={\"tic\":str})
master=pd.read_csv(\"lomb-scargle/results/2026-08-01_full/master_table.csv\",dtype={\"source_id\":str},usecols=[\"source_id\",\"blind_status\"])
e=pd.read_csv(exp_path,dtype={\"source_id\":str},usecols=[\"source_id\",\"band\",\"night_mjd\",\"mag\",\"bjd_tdb\"])
# Window stats: matching mag/cadence covariates are zg; baseline mirrors per_star across both bands.
z=e[e.band.eq(\"zg\")].copy()
night=z.groupby([\"source_id\",\"night_mjd\"],sort=False).size().rename(\"night_n\").reset_index()
multi=night.assign(n_eff=lambda d:d.night_n.where(d.night_n.ge(2),0),multi=lambda d:d.night_n.ge(2).astype(int)).groupby(\"source_id\").agg(n_eff_zg=(\"n_eff\",\"sum\"),n_multi_nights=(\"multi\",\"sum\"),n_zg_nights=(\"night_n\",\"size\"))
zg=z.groupby(\"source_id\").agg(median_zg=(\"mag\",\"median\"),n_zg=(\"mag\",\"size\"),median_exp_per_night=(\"night_mjd\",lambda x:x.value_counts().median()))
baseline=e.groupby(\"source_id\").bjd_tdb.agg(lambda x:x.max()-x.min()).rename(\"baseline_days\")
stats=zg.join(multi).join(baseline).join(master.set_index(\"source_id\"))
stats[\"frac_zg_effective\"]=stats.n_eff_zg/stats.n_zg
print(\"ROWS\",len(e),\"POOL\",len(stats),\"TARGETS\",len(targets))
print(\"\\nPOOL_QUANTILES\")
for c in [\"median_exp_per_night\",\"n_zg\",\"n_eff_zg\",\"n_multi_nights\",\"frac_zg_effective\",\"baseline_days\"]:
    q=stats[c].quantile([0,.1,.25,.5,.75,.9,1])
    print(c, q.round(3).to_dict(), \"unique\",stats[c].nunique())
def choose(cov):
    rows=[]
    for r in targets.itertuples():
        cand=stats[(stats.median_zg-r.gmag).abs().le(.25)].copy()
        if len(cand)<3:
            cand=stats[(stats.median_zg-r.gmag).abs().le(.5)].copy()
        if len(cand)<3:
            cand=stats.assign(delta=(stats.median_zg-r.gmag).abs()).sort_values([\"delta\"],kind=\"stable\").head(9)
        ordered=cand.reset_index().sort_values([cov,\"source_id\"],kind=\"stable\").reset_index(drop=True)
        picks=[min(len(ordered)-1,int(np.round(q*(len(ordered)-1)))) for q in (.1,.5,.9)]
        for k,i in enumerate(picks):
            x=ordered.iloc[i]
            rows.append({\"tic\":r.tic,\"K\":k,\"source_id\":x.source_id,\"value\":x[cov],\"status\":x.blind_status,\"pool_n\":len(cand)})
    return pd.DataFrame(rows)
for cov in [\"median_exp_per_night\",\"n_zg\",\"n_eff_zg\",\"n_multi_nights\",\"baseline_days\"]:
    d=choose(cov)
    piv=d.pivot(index=\"tic\",columns=\"K\",values=\"value\")
    print(\"\\nDESIGN\",cov,\"unique_windows\",d.source_id.nunique(),\"candidate_pool_n\",d.pool_n.quantile([0,.5,1]).to_dict())
    print(\"ties01\",int(piv[0].eq(piv[1]).sum()),\"ties12\",int(piv[1].eq(piv[2]).sum()),\"strict012\",int(((piv[0]<piv[1])&(piv[1]<piv[2])).sum()))
    print(d.groupby(\"K\").value.agg([\"min\",\"median\",\"max\"]).round(3).to_string())
    print(d.groupby([\"K\",\"status\"]).size().to_string())
