import math
def binom_cdf(x,n,p):
    if p==0: return 1.0
    if p==1: return 1.0 if x>=n else 0.0
    term=(1-p)**n
    total=term
    for k in range(x):
        term*=((n-k)/(k+1))*(p/(1-p))
        total+=term
    return total
def cp_upper(x,n,alpha=.05):
    lo,hi=0.0,1.0
    for _ in range(100):
        mid=(lo+hi)/2
        if binom_cdf(x,n,mid)>alpha:
            lo=mid
        else:
            hi=mid
    return (lo+hi)/2
for n in [30,1000]:
    print(\"n\",n)
    for x in range(5):
        u=cp_upper(x,n)
        print(x,u,u<=.005)
nmin=math.ceil(math.log(.05)/math.log(.995))
print(\"n_min_for_x0\",nmin,\"U\",cp_upper(0,nmin))
for p in [.0005,.001,.002,.003,.005]:
    print(\"true_p\",p,\"Pr_accept_x_le_1\",binom_cdf(1,1000,p))
