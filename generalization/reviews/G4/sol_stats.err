import pandas as pd
import numpy as np
p=pd.read_csv(\"generalization/results/2026-08-30_d2_pilot/metrics/per_star.csv\",dtype={\"cluster\":str})
f=p[(p.arm==\"B\")&(p.scenario==\"nominal\")&p.freq_scorable.astype(bool)&p.eligible_any_pass.astype(bool)&p.best_frequency_per_day.notna()].copy()
clusters=sorted(f.cluster.unique())
primary=f.groupby(\"cluster\").primary_freq.first().reindex(clusters)
assert f.groupby(\"cluster\").primary_freq.nunique().max()==1
rng=np.random.Generator(np.random.PCG64(20260829))
all_rates=[]
endpoint_rates=[]
fixed_counts=[]
for _ in range(100):
    perm=rng.permutation(len(clusters))
    mapping={clusters[i]:primary.iloc[perm[i]] for i in range(len(clusters))}
    fixed={clusters[i] for i in range(len(clusters)) if perm[i]==i}
    q=f[~f.cluster.isin(fixed)].copy()
    truth=q.cluster.map(mapping).astype(float)
    direct=(q.best_frequency_per_day-truth).abs().le(1.5/q.baseline_days)
    all_rates.append(direct.mean())
    endpoint_rates.append((direct & q.best_status.eq(\"confirmed\")).mean())
    fixed_counts.append(len(fixed))
print(\"N_ROWS\",len(f),\"N_TARGETS\",len(clusters),\"CONFIRMED\",int(f.best_status.eq(\"confirmed\").sum()),\"OBS_REC\",int((f.best_status.eq(\"confirmed\")&f.best_candidate_matches_dominant.eq(\"direct\")).sum()))
print(\"TARGET_PERM_DOMINANT_DIRECT_ALL mean/p95\",float(np.mean(all_rates)),float(np.quantile(all_rates,.95)))
print(\"TARGET_PERM_DOMINANT_ENDPOINT mean/p95\",float(np.mean(endpoint_rates)),float(np.quantile(endpoint_rates,.95)))
print(\"FIXED_TARGETS mean/max\",float(np.mean(fixed_counts)),max(fixed_counts))
