  1205	            usable_n = set(nominal.loc[nominal["best_status"] != "missing", "cluster"])
  1206	            both = usable_s & usable_n
  1207	            rate(scenario[scenario["cluster"].isin(both)], "arm_b_median_window_common", label)
  1208	            rate(nominal[nominal["cluster"].isin(both)], f"nominal_on_{keys[0]}_targets_common", label)
  1209	    if dataset == "d3":
  1210	        positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
  1211	                             & (per_star["best_status"] != "missing")]
  1212	        if "near_saturation" in positives:
  1213	            rate(positives[positives["near_saturation"] == True], "positives", "near_saturation")  # noqa: E712
  1214	            rate(positives[positives["near_saturation"] == False], "positives", "safe_magnitude")  # noqa: E712
  1215	        if crossmatch_qc is not None:
  1216	            qc = crossmatch_qc.set_index("source_id")
  1217	            joined = positives.join(
  1218	                qc[["nearest_separation_arcsec", "ztf_objects_in_cone"]], on="sid")
  1219	            clean = joined[(joined["nearest_separation_arcsec"] < 1.0)
  1220	                           & (joined["ztf_objects_in_cone"] <= 3)]
  1221	            rate(clean, "positives", "crowding_clean")
  1222	    return pd.DataFrame(rows)
  1223	
