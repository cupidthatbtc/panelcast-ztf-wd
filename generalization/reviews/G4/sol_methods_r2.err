   248	
   249	def build_truth_model(
   250	    tic: int,
   251	    periods_s: list[float],
   252	    amps_ppt: list[float],
   253	    cadence_s: float,
   254	    ratio_g: float = NOMINAL_G,
   255	    ratio_rg: float = NOMINAL_RG,
   256	    crowdsap: float | None = None,
   257	    amplitude_scale: float = 1.0,
   258	    phase_draw: int = 0,
   259	    drop_dominant: bool = False,
   260	) -> TruthModel:
   261	    """amplitude_scale=0.0 builds a zero-amplitude null with the same modes;
   262	    phase_draw in {0, 1, 2} selects the frozen phase assignment (0 = base);
   263	    crowdsap (0 < c <= 1) selects the SAP-equivalent re-dilution variant
   264	    (amplitudes MULTIPLIED by CROWDSAP); drop_dominant removes the
   265	    largest-amplitude RETAINED mode while every survivor keeps its phase."""
   266	    if len(periods_s) != len(amps_ppt):
   267	        raise ValueError("periods and amplitudes must align")
   268	    if phase_draw not in (0, 1, 2):
   269	        raise ValueError("phase_draw must be 0, 1, or 2")
   270	    if crowdsap is not None and not (0.0 < crowdsap <= 1.0):
   271	        raise ValueError(f"CROWDSAP must lie in (0, 1], got {crowdsap}")
   272	    # phases for the COMPLETE published list, in table order, before any
   273	    # rejection or dropout: a mode's phase never depends on other modes
   274	    seed = int(tic) if phase_draw == 0 else int(tic) * 10 + phase_draw
   275	    rng = np.random.Generator(np.random.PCG64(seed))
   276	    phases = rng.uniform(0.0, 2.0 * np.pi, size=len(periods_s))
   277	    keep = retained_modes(periods_s, amps_ppt, cadence_s)
   278	    dropped_period: float | None = None
   279	    if drop_dominant:
   280	        if len(keep) < 2:
   281	            raise ValueError("dominant-mode dropout needs >= 2 retained modes")
   282	        dominant = max(keep, key=lambda i: (amps_ppt[i], -i))
   283	        dropped_period = float(periods_s[dominant])
   284	        keep = [i for i in keep if i != dominant]
   285	    keep_set = set(keep)
   286	    modes: list[TruthMode] = []
   287	    rejected: list[dict] = []
   288	    for index, (period, amp_ppt, phase) in enumerate(zip(periods_s, amps_ppt, phases)):
   289	        tess_sinc = integration_sinc(period, cadence_s)
   290	        if abs(tess_sinc) < SINC_REJECT_BELOW:
   291	            rejected.append(
   292	                {"period_s": period, "amp_ppt": amp_ppt, "tess_sinc": tess_sinc}
   293	            )
   294	            continue
   295	        if index not in keep_set:
   296	            continue  # the dropped dominant mode (recorded in dropped_period_s)
   297	        frac = amp_ppt * PPT_TO_FRAC * amplitude_scale
   298	        if crowdsap is not None:
   299	            frac *= crowdsap  # SAP-equivalent re-dilution (never division)
   300	        intrinsic_frac = frac / tess_sinc  # signed: negative sinc = pi phase flip
   301	        amp_tess_mag = intrinsic_frac * FRAC_TO_MAG
   302	        modes.append(
   303	            TruthMode(
   304	                period_s=period,
   305	                frequency_per_day=86400.0 / period,
   306	                amp_tess_ppt=amp_ppt,
   307	                tess_sinc=tess_sinc,
   308	                amp_g_mag=amp_tess_mag * ratio_g,
   309	                amp_r_mag=amp_tess_mag * ratio_g * ratio_rg,
   310	                ztf_sinc=integration_sinc(period, ZTF_EXPOSURE_S),
   311	                phase_rad=float(phase),
   312	            )
   313	        )
   314	    return TruthModel(
   315	        tic=tic,
   316	        cadence_s=cadence_s,
   317	        ratio_g=ratio_g,
   318	        ratio_rg=ratio_rg,
   319	        crowdsap=crowdsap,
   320	        amplitude_scale=amplitude_scale,
   321	        phase_draw=phase_draw,
   322	        dominant_dropped=drop_dominant,
   323	        dropped_period_s=dropped_period,
   324	        modes=tuple(modes),
   325	        rejected=tuple(rejected),
   326	    )
