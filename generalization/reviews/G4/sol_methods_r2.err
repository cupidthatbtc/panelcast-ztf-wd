   519	def test_stars_file_guard(tmp_path):
   520	    sf = tmp_path / "pilot_shard_index.txt"
   521	    sf.write_text("a\nb\n")
   522	    sha = hashlib.sha256(sf.read_bytes()).hexdigest()
   523	    metrics.verify_stars_file(sf, sha, {"a", "b"})
   524	    with pytest.raises(SystemExit):
   525	        metrics.verify_stars_file(sf, sha, {"a"})
   526	    with pytest.raises(SystemExit):
   527	        metrics.verify_stars_file(sf, "0" * 64, {"a", "b"})

