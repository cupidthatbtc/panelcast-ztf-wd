   169	    assert sid[15] == "0" and sid[16] == str(AMP_SCALE_CODE_DROPOUT) and sid[17] == "0" and sid[18] == "0"
   170	    expected = {SCENARIO_NOMINAL, "dropout", "phase_1", "phase_2", "ampscale_0.7", "ampscale_1.3",
   171	                "redilution", "cadence_alt", "control", "gauss_null"} | {
   172	                    f"ladder_g{g}r{r}" for g in (1, 2, 3) for r in (1, 2, 3) if (g, r) != (2, 2)}
   173	    assert set(manifest["scenario"]) == expected
   174	    injected = pd.read_csv(generation["out"] / "injected_modes.csv", dtype={"campaign_id": str})
   175	    assert set(injected.loc[injected["campaign_id"] == sid, "period_s"]) == {150.0, 300.0, 700.0}
   176	    # cadence_alt (Amendment 3): TIC 11 only, K=1, 120 s, id differs from nominal K=1 at the
   177	    # LAST digit only, the 150-s mode is re-rejected at 120 s, dominance unchanged (500 s)
   178	    alt = manifest[manifest["scenario"] == "cadence_alt"]
   179	    assert alt["tic"].tolist() == [11] and (alt["template_k"] == 1).all()
   180	    assert (alt["cadence_code"] == 1).all() and (alt["cadence_s"] == 120.0).all() and (alt["arm"] == "B").all()
   181	    alt_id = alt["campaign_id"].iloc[0]
