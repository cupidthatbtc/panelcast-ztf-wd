  1055	def verify_stars_file(path: Path, recorded_sha: str, selected_ids: set[str]) -> None:
  1056	    """Amendment 4 provenance: a subset run's selection file is SHA-bound to the
  1057	    run manifest and must equal the completion table's id set exactly."""
  1058	    if not path.exists():
  1059	        raise SystemExit(f"stars file not found: {path}")
  1060	    if sha256_file(path) != recorded_sha:
  1061	        raise SystemExit("stars file SHA differs from the run manifest's stars_file_sha256")
  1062	    ids = {line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip()}
  1063	    if ids != selected_ids:
  1064	        raise SystemExit(f"stars file ids ({len(ids)}) != completion table ids ({len(selected_ids)})")
