  1230	    parser = argparse.ArgumentParser(description=__doc__)
  1231	    parser.add_argument("--dataset", choices=("d1", "d2", "d3"), required=True)
  1232	    parser.add_argument("--stars-dir", type=Path, required=True)
  1233	    parser.add_argument("--census-csv", type=Path, default=None)
  1234	    parser.add_argument("--shards-dir", type=Path, default=None,
  1235	                        help="the shard directory the run consumed (REQUIRED for d2/d3): "
  1236	                             "d2 = the published generation; d3 = <panels>/exposure_stars")
  1237	    parser.add_argument("--stars-file", type=Path, default=None,
  1238	                        help="the --stars-file the run was launched with (default: "
  1239	                             "<shards-dir>/<basename recorded in the run manifest>)")
  1240	    parser.add_argument("--shard-index", type=Path, default=None,
  1241	                        help="shard_index.txt the run was launched with (default: "
  1242	                             "<shards-dir>/shard_index.txt); its SHA must equal the run "
  1243	                             "manifest's shard_index_sha256")
  1244	    parser.add_argument("--out-dir", type=Path, required=True)
  1245	    parser.add_argument("--crossmatch-qc", type=Path, default=None,
  1246	                        help="d3: crossmatch_qc.csv from build_panels_generic "
  1247	                             "(enables the crowding sensitivity subset)")
  1248	    parser.add_argument("--run-manifest", type=Path, default=None,
  1249	                        help="manifest.json written by run_generalization_ls for "
  1250	                             "the stars-dir; REQUIRED for d2/d3 — binds the scored "
  1251	                             "JSONs to their replay attestation and tier")
  1252	    args = parser.parse_args()
  1253	
  1254	    assert_frozen()
  1255	    campaign_shas_start = campaign_file_shas()

