   359	def test_cluster_bootstrap_keeps_scenarios_apart_and_uses_scheduled_strata(generation):
   360	    truth, gen = metrics.truth_d2(generation["out"], pilot=True)
   361	    per_star = truth.copy()
   362	    # synthetic outcomes: nominal B detects K=0,1 for TIC 11 and nothing for TIC 22;
   363	    # dropout (TIC 11, K=1) does NOT detect — pooling it into nominal would change p
   364	    def status(r):
   365	        if r["arm"] == "B" and r["scenario"] == SCENARIO_NOMINAL:
   366	            return "confirmed" if (r["cluster"] == "11" and r["template_k"] in (0, 1)) else "not_detected"
   367	        if r["scenario"] == "dropout":
   368	            return "not_detected"
   369	        return "candidate"
   370	    per_star["best_status"] = per_star.apply(status, axis=1)
   371	    per_star["best_candidate_matches_dominant"] = "direct"
   372	    table, contrasts = metrics.d2_cluster_bootstrap(per_star, gen["scheduled_tics"], pilot=True)
   373	    nominal = table[(table["arm"] == "B") & (table["scenario"] == SCENARIO_NOMINAL)
   374	                    & (table["endpoint"] == "recovery") & (table["denominator"] == "eligible")]
   375	    assert len(nominal) == 1
   376	    assert nominal["n_strata_scheduled"].iloc[0] == 3
   377	    assert abs(nominal["p"].iloc[0] - (2 / 3 + 0) / 2) < 1e-12      # (1/3)*2 for TIC 11, 0 for TIC 22
   378	    assert not nominal["prespecified_primary"].iloc[0]                # pilot
   379	    assert not table["confirmatory_decision"].any()                   # P4 never decides
   380	    # non-pilot: nominal-B RECOVERY rows are the prespecified primary (both
   381	    # denominators); trigger rows and every other scenario never are
   382	    table_np, _ = metrics.d2_cluster_bootstrap(per_star, gen["scheduled_tics"], pilot=False)
   383	    nb = table_np[(table_np["arm"] == "B") & (table_np["scenario"] == SCENARIO_NOMINAL)]
   384	    assert nb.loc[nb["endpoint"] == "recovery", "prespecified_primary"].all()
   385	    assert not nb.loc[nb["endpoint"] == "trigger", "prespecified_primary"].any()
   386	    assert not table_np.loc[table_np["scenario"] == "dropout", "prespecified_primary"].any()
   387	    assert not table_np["confirmatory_decision"].any()
   388	    # pilot semantics: a subset of targets with scheduled_tics=None scores what it ran,
   389	    # while passing the full schedule against a subset must fail closed
   390	    subset = per_star[per_star["cluster"] != "22"]
   391	    sub_table, _ = metrics.d2_cluster_bootstrap(subset, None, pilot=True)
   392	    nb_sub = sub_table[(sub_table["arm"] == "B") & (sub_table["scenario"] == SCENARIO_NOMINAL)
   393	                       & (sub_table["endpoint"] == "recovery") & (sub_table["denominator"] == "eligible")]
   394	    assert nb_sub["n_targets_in_scenario"].iloc[0] == 1 and abs(nb_sub["p"].iloc[0] - 2 / 3) < 1e-12
   395	    with pytest.raises(SystemExit):
   396	        metrics.d2_cluster_bootstrap(subset, gen["scheduled_tics"], pilot=False)
   397	    dropout = table[(table["scenario"] == "dropout") & (table["endpoint"] == "recovery")
   398	                    & (table["denominator"] == "eligible")]
   399	    assert len(dropout) == 1 and dropout["n_strata_scheduled"].iloc[0] == 1
   400	    assert dropout["p"].iloc[0] == 0.0 and dropout["n_targets_in_scenario"].iloc[0] == 1
   401	    alt = table[(table["scenario"] == "cadence_alt") & (table["endpoint"] == "recovery")]
   402	    assert len(alt) == 2 and (alt["cadence_code"] == 1).all() and not alt["prespecified_primary"].any()
   403	    # paired common-draw contrasts: dropout (TIC 11 only) vs nominal K=1 on the SAME target;
   404	    # nominal K=1 for TIC 11 is confirmed, dropout is not -> diff = -1 on one matched target
   405	    c = contrasts[(contrasts["scenario"] == "dropout") & (contrasts["endpoint"] == "recovery")
   406	                  & (contrasts["denominator"] == "eligible")]
   407	    assert len(c) == 1 and c["n_targets_matched"].iloc[0] == 1
   408	    assert c["p_scenario"].iloc[0] == 0.0 and c["p_nominal_k1"].iloc[0] == 1.0 and c["diff"].iloc[0] == -1.0
   409	    assert c["interval"].iloc[0] == "paired_cluster_bootstrap_common_draws" and not c["prespecified_primary"].any()
   410	    # zero observed discordance -> CP discordance bound, never [0, 0] (Amendment 4)
   411	    quiet = per_star.copy()
   412	    quiet["best_status"] = "not_detected"
   413	    _, contrasts_q = metrics.d2_cluster_bootstrap(quiet, gen["scheduled_tics"], pilot=True)
   414	    z = contrasts_q[(contrasts_q["scenario"] == "phase_1") & (contrasts_q["endpoint"] == "recovery")
   415	                    & (contrasts_q["denominator"] == "eligible")]
   416	    assert z["interval"].iloc[0] == "cp_discordance_bound" and z["diff"].iloc[0] == 0.0
   417	    assert z["diff_hi"].iloc[0] > 0.5 and z["discordance_u95"].iloc[0] == z["diff_hi"].iloc[0]
   418	    assert z["diff_lo"].iloc[0] == -z["diff_hi"].iloc[0]
   419	    assert set(contrasts["scenario"]) >= {"dropout", "cadence_alt", "phase_1", "ladder_g1r1", "redilution"}
   420	    # symmetric missingness: mark the nominal K=1 row of TIC 11 missing -> usable contrast for
   421	    # dropout has zero matched targets (dropped), eligible keeps it as a failure on both sides
   422	    per_star2 = per_star.copy()
   423	    nk1 = per_star2.index[(per_star2["arm"] == "B") & (per_star2["scenario"] == SCENARIO_NOMINAL)
   424	                          & (per_star2["template_k"] == 1) & (per_star2["cluster"] == "11")][0]
   425	    per_star2.loc[nk1, "best_status"] = "missing"
   426	    _, contrasts2 = metrics.d2_cluster_bootstrap(per_star2, gen["scheduled_tics"], pilot=True)
   427	    c2 = contrasts2[(contrasts2["scenario"] == "dropout") & (contrasts2["endpoint"] == "recovery")]
   428	    assert c2.loc[c2["denominator"] == "usable"].empty or c2.loc[c2["denominator"] == "usable", "n_targets_matched"].iloc[0] == 0
   429	    assert c2.loc[c2["denominator"] == "eligible", "p_nominal_k1"].iloc[0] == 0.0
   430	    assert {"arm", "scenario", "ratio_g", "ratio_rg", "phase_draw", "amp_scale",
   431	            "dominant_dropped"} <= set(table.columns)
   432	
