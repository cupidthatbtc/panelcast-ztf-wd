   276	def truth_d2(shards_dir: Path, pilot: bool = False) -> tuple[pd.DataFrame, dict]:
   277	    """Truth from injected_modes.csv — the ACTUALLY injected (post-sinc-
   278	    rejection) mode set per shard, never the original mode table (G2 methods
   279	    finding 4). Fail-closed contract checks (G3 methods findings 1, 4):
   280	    published generation only, fixed typed schema, index == manifest == disk,
   281	    per-shard SHA identity against the generation record, A/B <-> injected-row
   282	    bijection, exactly one nominal-B replicate per (scheduled target, K in
   283	    {0,1,2}), exact null serials 0..n-1 (n = 1000 in production)."""
   284	    from d2_truth_model import SCENARIO_NOMINAL
   285	    if (shards_dir / "IN_PROGRESS").exists():
   286	        raise SystemExit(f"{shards_dir} is an unpublished (in-progress) generation")
   287	    generation_path = shards_dir / "generation_manifest.json"
   288	    if not generation_path.exists():
   289	        raise SystemExit(f"{shards_dir} lacks generation_manifest.json (not a published generation)")
   290	    generation = json.loads(generation_path.read_text(encoding="utf-8"))
   291	    from d2_truth_model import (D2_GENERATION_CODE, TARGETS_PRODUCTION, assert_counts,
   292	                                production_reasons)
   293	    if not generation.get("production") and not pilot:
   294	        raise SystemExit(f"non-production generation {generation.get('non_production_reasons')} "
   295	                         f"can only feed a pilot (run manifest pilot=true)")
   296	    # 1. every recorded output file must be byte-identical BEFORE it is read
   297	    expected_outputs = ("shard_manifest.csv", "injected_modes.csv", "rejected_modes.csv",
   298	                        "excluded_targets.csv", "shard_index.txt", "pilot_shard_index.txt")
   299	    recorded_outputs = generation.get("outputs_sha256", {})
   300	    if set(recorded_outputs) != set(expected_outputs):
   301	        raise SystemExit("generation manifest outputs_sha256 lacks the complete truth-file set")
   302	    for name, digest in recorded_outputs.items():
   303	        if sha256_file(shards_dir / name) != digest:
   304	            raise SystemExit(f"{name} differs from the generation record (tampered or mixed)")
   305	    # 2. the generation id must be reproducible from its recorded basis
   306	    basis_keys = ("inputs_sha256", "template_shas", "frozen_sha256", "generation_code_sha256", "args")
   307	    basis = {k: generation.get(k) for k in basis_keys}
   308	    if hashlib.sha256(json.dumps(basis, sort_keys=True).encode()).hexdigest() != generation.get("generation_id"):
   309	        raise SystemExit("generation id does not reproduce from its recorded basis")
   310	    # 3. frozen code and the shard-determining campaign code must be THIS checkout
   311	    if generation.get("frozen_sha256") != frozen_file_shas():
   312	        raise SystemExit("generation was built against different frozen files")
   313	    current_code = {name: campaign_file_shas()[name] for name in D2_GENERATION_CODE}
   314	    if generation.get("generation_code_sha256") != current_code:
   315	        raise SystemExit("generation was built by different shard-determining code "
   316	                         "(build_d2_shards/d2_truth_model/frozen_api); rebuild the generation")
   317	    # 4. production claims are re-derived from the recorded arguments, never trusted
   318	    args_rec = generation.get("args", {})
   319	    reasons = production_reasons(set(args_rec.get("arms", [])), args_rec.get("limit"),
   320	                                 int(args_rec.get("n_nulls", -1)), int(args_rec.get("expected_pool", -1)),
   321	                                 int(generation.get("n_targets_input", -1)))
   322	    if bool(generation.get("production")) != (not reasons):
   323	        raise SystemExit(f"generation production flag inconsistent with its arguments: {reasons}")
   324	    manifest = load_d2_manifest(shards_dir)
   325	    # 5. the realized run matrix must equal the scheduled matrix, unconditionally
   326	    assert_counts(manifest, generation.get("expected_counts", {}))
   327	    if generation.get("production") and int(generation.get("n_targets_input", -1)) != TARGETS_PRODUCTION:
   328	        raise SystemExit("production generation must schedule the canonical 103-target roster")
   329	    index_ids = {line.strip() for line in
   330	                 (shards_dir / "shard_index.txt").read_text(encoding="utf-8").splitlines() if line.strip()}
   331	    disk_ids = {p.name.split(".csv")[0] for p in shards_dir.glob("*.csv.gz")}
   332	    manifest_ids = set(manifest["campaign_id"])
   333	    if not (index_ids == disk_ids == manifest_ids):
   334	        raise SystemExit(f"{shards_dir}: index/disk/manifest id sets differ "
   335	                         f"({len(index_ids)}/{len(disk_ids)}/{len(manifest_ids)})")
   336	    recorded = generation.get("shard_sha256", {})
   337	    if generation.get("n_shards") != len(manifest) or set(recorded) != manifest_ids:
   338	        raise SystemExit("generation manifest does not describe this shard set")
   339	    for row in manifest.itertuples(index=False):
   340	        actual = sha256_file(shards_dir / f"{row.campaign_id}.csv.gz")
   341	        if actual != row.shard_sha256 or actual != recorded[row.campaign_id]:
   342	            raise SystemExit(f"{row.campaign_id}: shard bytes differ from the generation record")
   343	    injected = pd.read_csv(shards_dir / "injected_modes.csv", dtype={"campaign_id": str})
   344	    rejected = pd.read_csv(shards_dir / "rejected_modes.csv", dtype={"campaign_id": str})
   345	    ab = manifest[manifest["arm"].isin(["A", "B"])]
   346	    n_inj = injected.groupby("campaign_id").size()
   347	    n_rej = rejected.groupby("campaign_id").size()
   348	    for row in ab.itertuples(index=False):
   349	        if int(n_inj.get(row.campaign_id, 0)) != row.n_modes_injected or row.n_modes_injected < 1:
   350	            raise SystemExit(f"{row.campaign_id}: injected_modes rows != n_modes_injected (or zero)")
   351	        if int(n_rej.get(row.campaign_id, 0)) != row.n_modes_rejected:
   352	            raise SystemExit(f"{row.campaign_id}: rejected_modes rows != n_modes_rejected")
   353	    if set(injected["campaign_id"]) - set(ab["campaign_id"]):
   354	        raise SystemExit("injected_modes.csv carries control/null ids")
   355	    if set(rejected["campaign_id"]) - set(ab["campaign_id"]):
   356	        raise SystemExit("rejected_modes.csv carries foreign ids")
   357	    scheduled = [int(t) for t in generation.get("scheduled_tics", [])]
   358	    nominal_b = manifest[(manifest["arm"] == "B") & (manifest["scenario"] == SCENARIO_NOMINAL)]
   359	    if not nominal_b.empty:
   360	        per_target = nominal_b.groupby("tic")["template_k"].apply(lambda s: sorted(s.tolist()))
   361	        if (sorted(per_target.index.tolist()) != sorted(scheduled)
   362	                or any(ks != [0, 1, 2] for ks in per_target)):
   363	            raise SystemExit("nominal arm-B rows are not exactly K={0,1,2} for every scheduled target")
   364	        if len(scheduled) != int(generation.get("n_targets_scheduled", -1)):
   365	            raise SystemExit("scheduled target list disagrees with the generation manifest")
   366	    from d2_truth_model import check_cadence_alt_schedule
   367	    if "cadence_alt" in set(args_rec.get("arms", [])):
   368	        alt_sched = [int(t) for t in generation.get("cadence_alt_tics", [])]
   369	        check_cadence_alt_schedule([int(t) for t in generation.get("mixed_cadence_tics_from_v3", [])],
   370	                                   alt_sched, bool(generation.get("production")))
   371	        alt_rows = manifest[manifest["scenario"] == "cadence_alt"]
   372	        if (sorted(alt_rows["tic"].tolist()) != sorted(alt_sched)
   373	                or (alt_rows["template_k"] != 1).any() or (alt_rows["arm"] != "B").any()):
   374	            raise SystemExit("cadence_alt rows != the generation's scheduled cadence_alt targets")
   375	    nulls = manifest[manifest["arm"] == "gauss_null"]
   376	    if not nulls.empty:
   377	        if sorted(nulls["null_serial"].tolist()) != list(range(int(generation.get("n_nulls", -1)))):
   378	            raise SystemExit("null serials are not exactly 0..n_nulls-1")
   379	        if generation.get("production") and int(generation["n_nulls"]) != 1000:
   380	            raise SystemExit("production generation must schedule exactly 1000 nulls")
   381	    freq_lists = injected.groupby("campaign_id")["frequency_per_day"].apply(
   382	        lambda g: sorted(g.tolist())).to_dict()
   383	    dominant, amp_dom = {}, {}
   384	    for sid, group in injected.groupby("campaign_id"):
   385	        best = group.loc[group["amp_tess_ppt"].idxmax()]
   386	        dominant[sid] = float(best["frequency_per_day"])
   387	        amp_dom[sid] = float(best["amp_tess_ppt"])
   388	    rows = []
   389	    for r in manifest.itertuples(index=False):
   390	        arm, tic, sid = r.arm, int(r.tic), r.campaign_id
   391	        positive = arm in ("A", "B")
   392	        truth = freq_lists.get(sid, []) if positive else []
   393	        rows.append({
   394	            "sid": sid, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   395	            "class_label": f"arm_{arm}", "label_positive": positive,
   396	            "weight": 1.0, "cluster": str(tic) if tic else sid,
   397	            "truth_freqs": truth,
   398	            "primary_freq": dominant.get(sid) if positive else None,
   399	            "amp": float(amp_dom.get(sid, math.nan)),
   400	            "truth_period_days": (1.0 / dominant[sid]) if sid in dominant and positive else math.nan,
   401	            "freq_scorable": positive and bool(truth),
   402	            "arm": arm, "scenario": r.scenario, "template_k": int(r.template_k),
   403	            "pool_index": int(r.pool_index),
   404	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   405	            "phase_draw": int(r.phase_draw), "amp_scale": float(r.amp_scale),
   406	            "dominant_dropped": bool(r.dominant_dropped),
   407	            "dropped_period_s": float(r.dropped_period_s),
   408	            "crowdsap": float(r.crowdsap),
   409	            "cadence_code": int(r.cadence_code), "cadence_s": float(r.cadence_s),
   410	            "n_strata_scheduled": int(r.n_strata_scheduled),
   411	            "null_serial": int(r.null_serial),
   412	            "control_campaign_id": r.control_campaign_id,
   413	            "shard_sha256": r.shard_sha256,
   414	            "median_exp_per_night": float(r.template_exp_per_night),
   415	            "wg_contrasts": int(r.template_wg_contrasts),
   416	            "template_status": r.template_status,
   417	        })
   418	    return pd.DataFrame(rows), generation
