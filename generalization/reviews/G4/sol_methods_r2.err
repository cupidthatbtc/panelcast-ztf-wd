   160	
   161	def scenario_code(ratio_g: float, ratio_rg: float, phase_draw: int, amp_scale: float,
   162	                  dominant_dropped: bool, crowd_code: int = CROWD_CODE_NONE,
   163	                  cadence_code: int = CADENCE_CODE_NOMINAL) -> str:
   164	    """Immutable scenario identity (G3 methods finding 2)."""
   165	    nominal_ratios = ratio_g == NOMINAL_G and ratio_rg == NOMINAL_RG
   166	    if cadence_code == CADENCE_CODE_ALT:
   167	        return SCENARIO_CADENCE_ALT
   168	    if crowd_code == CROWD_CODE_REDILUTION:
   169	        return "redilution"
   170	    if dominant_dropped:
   171	        return SCENARIO_DROPOUT
   172	    if not nominal_ratios:
   173	        gi = BANDPASS_LADDER_G.index(ratio_g) + 1
   174	        ri = BANDPASS_LADDER_RG.index(ratio_rg) + 1
   175	        return f"ladder_g{gi}r{ri}"
   176	    if phase_draw != 0:
   177	        return f"phase_{phase_draw}"
   178	    if amp_scale != 1.0:
   179	        return f"ampscale_{amp_scale}"
   180	    return SCENARIO_NOMINAL
   181	
   182	
   183	def integration_sinc(period_s: float, t_int_s: float) -> float:
   184	    """Signed attenuation of a sinusoid amplitude under boxcar integration."""
   185	    x = math.pi * t_int_s / period_s
   186	    return 1.0 if x == 0.0 else math.sin(x) / x
   187	
   188	
   189	def blackbody_dlnB_dlnT(wavelength_nm: float, teff_k: float) -> float:
   190	    x = HC_OVER_K_NM_K / (wavelength_nm * teff_k)
   191	    return x / (1.0 - math.exp(-x))
   192	
   193	
   194	def blackbody_amplitude_ratios(teff_k: float = 11500.0) -> tuple[float, float]:
   195	    """(A_g/A_TESS, A_r/A_g) for pure temperature perturbations."""
   196	    g = blackbody_dlnB_dlnT(LAMBDA_NM["zg"], teff_k)
   197	    r = blackbody_dlnB_dlnT(LAMBDA_NM["zr"], teff_k)
   198	    tess = blackbody_dlnB_dlnT(LAMBDA_NM["tess"], teff_k)
   199	    return g / tess, r / g
   200	
   201	
   202	def retained_modes(periods_s: list[float], amps_ppt: list[float],
   203	                   cadence_s: float) -> list[int]:
   204	    """Indices (published-table order) of modes surviving the |sinc| >= 0.3
   205	    rule — the set over which 'dominant' is defined."""
   206	    return [i for i, p in enumerate(periods_s)
   207	            if abs(integration_sinc(p, cadence_s)) >= SINC_REJECT_BELOW]
   208	
   209	
   210	@dataclass(frozen=True)
   211	class TruthMode:
   212	    period_s: float
   213	    frequency_per_day: float
   214	    amp_tess_ppt: float
   215	    tess_sinc: float
   216	    amp_g_mag: float          # intrinsic zg amplitude after ladder, before ZTF sinc
   217	    amp_r_mag: float
   218	    ztf_sinc: float
   219	    phase_rad: float
   220	
   221	
   222	@dataclass(frozen=True)
   223	class TruthModel:
   224	    tic: int
   225	    cadence_s: float
   226	    ratio_g: float
   227	    ratio_rg: float
   228	    crowdsap: float | None
   229	    amplitude_scale: float
   230	    phase_draw: int
   231	    dominant_dropped: bool
   232	    dropped_period_s: float | None
   233	    modes: tuple[TruthMode, ...]
   234	    rejected: tuple[dict, ...] = field(default=())
   235	
   236	    def evaluate(self, bjd_tdb: np.ndarray, band: str, t_ref: float) -> np.ndarray:
   237	        """Delta-mag time series at the template's real epochs (days)."""
   238	        if band not in ("zg", "zr"):
   239	            raise ValueError(band)
   240	        delta = np.zeros_like(np.asarray(bjd_tdb, dtype=float))
   241	        for mode in self.modes:
   242	            amp = mode.amp_g_mag if band == "zg" else mode.amp_r_mag
   243	            amp *= mode.ztf_sinc
   244	            phase = 2.0 * np.pi * mode.frequency_per_day * (bjd_tdb - t_ref)
   245	            delta += amp * np.cos(phase + mode.phase_rad)
   246	        return delta
   247	
   248	
   249	def build_truth_model(
   250	    tic: int,
   251	    periods_s: list[float],
   252	    amps_ppt: list[float],
   253	    cadence_s: float,
   254	    ratio_g: float = NOMINAL_G,
   255	    ratio_rg: float = NOMINAL_RG,
   256	    crowdsap: float | None = None,
   257	    amplitude_scale: float = 1.0,
   258	    phase_draw: int = 0,
   259	    drop_dominant: bool = False,
   260	) -> TruthModel:
   261	    """amplitude_scale=0.0 builds a zero-amplitude null with the same modes;
   262	    phase_draw in {0, 1, 2} selects the frozen phase assignment (0 = base);
   263	    crowdsap (0 < c <= 1) selects the SAP-equivalent re-dilution variant
   264	    (amplitudes MULTIPLIED by CROWDSAP); drop_dominant removes the
   265	    largest-amplitude RETAINED mode while every survivor keeps its phase."""
   266	    if len(periods_s) != len(amps_ppt):
   267	        raise ValueError("periods and amplitudes must align")
   268	    if phase_draw not in (0, 1, 2):
   269	        raise ValueError("phase_draw must be 0, 1, or 2")
   270	    if crowdsap is not None and not (0.0 < crowdsap <= 1.0):
   271	        raise ValueError(f"CROWDSAP must lie in (0, 1], got {crowdsap}")
   272	    # phases for the COMPLETE published list, in table order, before any
   273	    # rejection or dropout: a mode's phase never depends on other modes
   274	    seed = int(tic) if phase_draw == 0 else int(tic) * 10 + phase_draw
   275	    rng = np.random.Generator(np.random.PCG64(seed))
   276	    phases = rng.uniform(0.0, 2.0 * np.pi, size=len(periods_s))
   277	    keep = retained_modes(periods_s, amps_ppt, cadence_s)
   278	    dropped_period: float | None = None
   279	    if drop_dominant:
   280	        if len(keep) < 2:
   281	            raise ValueError("dominant-mode dropout needs >= 2 retained modes")
   282	        dominant = max(keep, key=lambda i: (amps_ppt[i], -i))
   283	        dropped_period = float(periods_s[dominant])
   284	        keep = [i for i in keep if i != dominant]
   285	    keep_set = set(keep)
   286	    modes: list[TruthMode] = []
   287	    rejected: list[dict] = []
   288	    for index, (period, amp_ppt, phase) in enumerate(zip(periods_s, amps_ppt, phases)):
   289	        tess_sinc = integration_sinc(period, cadence_s)
   290	        if abs(tess_sinc) < SINC_REJECT_BELOW:
   291	            rejected.append(
   292	                {"period_s": period, "amp_ppt": amp_ppt, "tess_sinc": tess_sinc}
   293	            )
   294	            continue
   295	        if index not in keep_set:
   296	            continue  # the dropped dominant mode (recorded in dropped_period_s)
   297	        frac = amp_ppt * PPT_TO_FRAC * amplitude_scale
   298	        if crowdsap is not None:
   299	            frac *= crowdsap  # SAP-equivalent re-dilution (never division)
   300	        intrinsic_frac = frac / tess_sinc  # signed: negative sinc = pi phase flip
   301	        amp_tess_mag = intrinsic_frac * FRAC_TO_MAG
   302	        modes.append(
   303	            TruthMode(
   304	                period_s=period,
   305	                frequency_per_day=86400.0 / period,
   306	                amp_tess_ppt=amp_ppt,
   307	                tess_sinc=tess_sinc,
   308	                amp_g_mag=amp_tess_mag * ratio_g,
   309	                amp_r_mag=amp_tess_mag * ratio_g * ratio_rg,
   310	                ztf_sinc=integration_sinc(period, ZTF_EXPOSURE_S),
   311	                phase_rad=float(phase),
   312	            )
   313	        )
   314	    return TruthModel(
   315	        tic=tic,
   316	        cadence_s=cadence_s,
   317	        ratio_g=ratio_g,
   318	        ratio_rg=ratio_rg,
   319	        crowdsap=crowdsap,
   320	        amplitude_scale=amplitude_scale,
   321	        phase_draw=phase_draw,
   322	        dominant_dropped=drop_dominant,
   323	        dropped_period_s=dropped_period,
   324	        modes=tuple(modes),
   325	        rejected=tuple(rejected),
   326	    )
   327	
