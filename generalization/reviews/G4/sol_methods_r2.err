   914	def d2_surfaces(primary: pd.DataFrame, wg_edges: list[int]) -> dict[str, pd.DataFrame]:
   915	    """Nominal arm-B surfaces on (W_g, amplitude) and (period, amplitude) for
   916	    the recovery (primary) and trigger (secondary) endpoints; amplitude is the
   917	    scenario-invariant published dominant amplitude."""
   918	    out: dict[str, pd.DataFrame] = {}
   919	    if primary.empty:
   920	        return out
   921	    amp_edges = AMP_EDGES["d2"]
   922	    amp_bins = np.where(np.isfinite(primary["amp"]), np.digitize(primary["amp"], amp_edges), -1)
   923	    wg_bins = np.digitize(primary["wg_contrasts"].to_numpy(dtype=float), list(wg_edges))
   924	    period_bins = np.where(np.isfinite(primary["truth_period_days"]),
   925	                           np.digitize(primary["truth_period_days"], PERIOD_EDGES_DAYS), -1)
   926	    endpoints = {
   927	        "recovery": (primary["best_status"] == "confirmed") & (primary["best_candidate_matches_dominant"] == "direct"),
   928	        "trigger": primary["best_status"] == "confirmed",
   929	    }
   930	    for name, success in endpoints.items():
   931	        out[f"{name}_wg_amplitude"] = _target_equal_cells(primary, success, [wg_bins, amp_bins], ["wg_bin", "amp_bin"])
   932	        out[f"{name}_period_amplitude"] = _target_equal_cells(primary, success, [period_bins, amp_bins], ["period_bin", "amp_bin"])
   933	        out[f"{name}_amplitude"] = _target_equal_cells(primary, success, [amp_bins], ["amp_bin"])
   934	    return out
