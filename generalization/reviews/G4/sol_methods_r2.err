   549	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   550	    scorable = per_star[per_star["freq_scorable"]
   551	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   552	    if len(scorable) < 3:
   553	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   554	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   555	    rates = []
   556	    truth_lists = scorable["truth_freqs"].tolist()
   557	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   558	        perm = rng.permutation(len(truth_lists))
   559	        hits = 0
   560	        for i, row in scorable.iterrows():
   561	            if perm[i] == i:
   562	                continue
   563	            tol = 1.5 / row["baseline_days"]
   564	            if classify_match(float(row["best_frequency_per_day"]),
   565	                              truth_lists[perm[i]], tol) == "direct":
   566	                hits += 1
   567	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   568	        if denom:
   569	            rates.append(hits / denom)
   570	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   571	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   572	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
   573	
   574	
   575	def cp_one_sided_bounds(k: int, n: int) -> tuple[float, float]:
   576	    from scipy.stats import beta
   577	    lower = float(beta.ppf(0.05, k, n - k + 1)) if k > 0 else 0.0
   578	    upper = float(beta.ppf(0.95, k + 1, n - k)) if k < n else 1.0
   579	    return lower, upper
