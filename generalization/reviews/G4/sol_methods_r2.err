   252	
   253	def load_d2_manifest(shards_dir: Path) -> pd.DataFrame:
   254	    """Fixed typed manifest schema (d2_truth_model.MANIFEST_COLUMNS); any
   255	    deviation, NaN in an int/bool column, or duplicate id is fatal."""
   256	    from d2_truth_model import MANIFEST_COLUMN_NAMES, MANIFEST_COLUMNS
   257	    path = shards_dir / "shard_manifest.csv"
   258	    header = pd.read_csv(path, nrows=0).columns.tolist()
   259	    if header != list(MANIFEST_COLUMN_NAMES):
   260	        raise SystemExit(f"{path}: columns deviate from the frozen manifest schema")
   261	    dtype = {name: D2_DTYPES[kind] for name, kind in MANIFEST_COLUMNS}
   262	    try:
   263	        manifest = pd.read_csv(path, dtype=dtype)
   264	    except (ValueError, TypeError) as exc:
   265	        raise SystemExit(f"{path}: manifest violates its typed schema: {exc}")
   266	    for name, kind in MANIFEST_COLUMNS:
   267	        if kind == "str":
   268	            manifest[name] = manifest[name].fillna("")
   269	        elif kind in ("int", "bool") and manifest[name].isna().any():
   270	            raise SystemExit(f"{path}: NaN in typed column {name}")
   271	    from d2_truth_model import validate_manifest_frame
   272	    validate_manifest_frame(manifest)   # uniqueness + per-row semantic invariants
   273	    return manifest
   274	
