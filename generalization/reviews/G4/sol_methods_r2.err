   134	MANDATORY_PRODUCTION_ARMS = ("b", "ctrl", "a", "ladder", "phase", "ampscale", "dropout",
   135	                             "cadence_alt", "nulls")
   136	MIXED_CADENCE_TARGETS_PRODUCTION = 33   # SPOC v3: targets whose solution mixes 20-s and 120-s sectors
   137	TARGETS_PRODUCTION = 103
