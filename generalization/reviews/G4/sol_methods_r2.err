   287	
   288	def validate_manifest(frame: pd.DataFrame) -> None:
   289	    validate_manifest_frame(frame)   # schema, uniqueness, typed, per-row semantics
   290	    bad = [sid for sid in frame["campaign_id"] if not campaign_id_ok(sid)]
   291	    if bad:
   292	        raise SystemExit(f"{len(bad)} ids violate the campaign convention: {bad[:3]}")
   293	    # no string cell may be a token pandas' default reader turns into NaN
   294	    for name, kind in MANIFEST_COLUMNS:
   295	        if kind == "str":
   296	            hits = frame[name].isin(PANDAS_NA_TOKENS)
   297	            if hits.any():
   298	                raise SystemExit(f"manifest column {name} holds a pandas NA token: "
   299	                                 f"{frame.loc[hits, name].unique()[:3]}")
   300	
   301	
   302	def pilot_index(frame: pd.DataFrame, dominant_amp: dict[int, float], n_nulls: int) -> list[str]:
   303	    """Deterministic stratified pilot spanning every arm/scenario."""
   304	    chosen: list[str] = []
   305	    nominal_b = frame[(frame["arm"] == "B") & (frame["scenario"] == SCENARIO_NOMINAL)]
   306	    tics = sorted(nominal_b["tic"].unique(), key=lambda t: (dominant_amp.get(int(t), 0.0), t))
   307	    if tics:
   308	        idx = np.unique(np.round(np.linspace(0, len(tics) - 1, min(PILOT_TARGETS, len(tics)))).astype(int))
   309	        pilot_tics = [tics[i] for i in idx]
   310	        for arm in ("B", "A"):
   311	            sub = frame[(frame["arm"] == arm) & (frame["scenario"] == SCENARIO_NOMINAL)
   312	                        & frame["tic"].isin(pilot_tics)]
   313	            chosen.extend(sub["campaign_id"].tolist())
   314	        for scenario, per in frame[frame["arm"] == "B"].groupby("scenario"):
   315	            if scenario == SCENARIO_NOMINAL:
   316	                continue
   317	            take = per[per["tic"].isin(pilot_tics)].sort_values("campaign_id").head(3)
   318	            if take.empty:
   319	                take = per.sort_values("campaign_id").head(3)
   320	            chosen.extend(take["campaign_id"].tolist())
   321	        controls = nominal_b[nominal_b["tic"].isin(pilot_tics)]["control_campaign_id"]
   322	        chosen.extend(sorted({c for c in controls if c})[:10])
   323	    nulls = frame[frame["arm"] == SCENARIO_NULL].sort_values("null_serial")
   324	    if not nulls.empty:
   325	        idx = np.unique(np.round(np.linspace(0, len(nulls) - 1, min(PILOT_NULLS, len(nulls)))).astype(int))
   326	        chosen.extend(nulls.iloc[idx]["campaign_id"].tolist())
   327	    return sorted(set(chosen))
