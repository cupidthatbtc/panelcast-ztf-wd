   199	    diff = [i for i in range(19) if redil.campaign_id[i] != nominal_k1.campaign_id[i]]
   200	    assert diff == [17] and redil.campaign_id[17] == "1" and redil.crowdsap == 0.19
   201	    amp_nom = injected[injected["campaign_id"] == nominal_k1.campaign_id].set_index("period_s")["amp_g_mag"]
   202	    amp_red = injected[injected["campaign_id"] == redil.campaign_id].set_index("period_s")["amp_g_mag"]
   203	    assert np.allclose(amp_red.sort_index().to_numpy(), 0.19 * amp_nom.sort_index().to_numpy(), rtol=1e-12)
