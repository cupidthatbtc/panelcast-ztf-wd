     2	"""D2 truth model: analytic DAV signals for injection into real ZTF windows.
     3	
     4	Why a truth model and not interpolation: DAV periods reach below twice the
     5	TESS 120-s cadence (super-Nyquist) and below the first sinc null; interpolated
     6	TESS photometry is undefined there. The published mode solution (period,
     7	amplitude) IS the measurement — we evaluate it analytically at the template's
     8	real BJD_TDB epochs.
     9	
    10	Amplitude chain (GENERALIZATION_PLAN.md, D2):
    11	  A_ppt (published, TESS-integrated, PDCSAP = already crowding-corrected —
    12	         Romero+2022 and Romero+2025 both state their amplitudes are
    13	         dilution-corrected)
    14	    -> fractional flux (x 1e-3)
    15	    -> crowding sensitivity (G3 numerics finding 4): the prespecified variant
    16	       is the SAP-EQUIVALENT RE-DILUTION, A_variant = A_PDCSAP x CROWDSAP
    17	       (multiplication; dividing PDCSAP by CROWDSAP again would inflate the
    18	       injected amplitude ~5x at the median CROWDSAP of 0.19). OFF by default
    19	       (crowdsap=None); scheduled only for SPOC-verified stars.
    20	    -> de-integrate the TESS exposure: divide by sinc(pi f T_cad);
    21	       REJECT modes with |sinc| < 0.3 (do not amplify model error > 3.3x).
    22	       At T=120 s this cutoff is P < ~160.0 s; at 20 s, P < ~26.7 s.
    23	    -> magnitudes (x 1.0857)
    24	    -> bandpass ladder: A_g = R_g * A_TESS_intrinsic, A_r = R_rg * A_g with
    25	       R_g in {1.4, 1.7, 2.1}, R_rg in {0.70, 0.80, 0.90}; blackbody T-derivative
    26	       ratios at Teff ~ 11,500 K give (1.43, 0.80) — the ladder's low rung;
    27	       empirical DAV multi-band ratios (limb darkening + nonadiabatic boost in
    28	       the blue) motivate the upper rungs. Nominal (1.7, 0.80). Headline
    29	       numbers are quoted as the band across the ladder.
    30	    -> re-integrate the ZTF 30-s exposure: multiply by sinc(pi f 30s).
    31	
    32	Phase protocol (frozen): each mode of the COMPLETE published mode list gets
    33	ONE independent phase, drawn in published-table order BEFORE sinc rejection
    34	and before any dropout, so a mode's phase is a function of (TIC, phase_draw,
    35	table position) only. The base assignment (phase_draw=0) seeds PCG64(TIC) and
    36	is shared across bands and across every bandpass/crowding/amplitude-scale/
    37	dropout variant (variant-stable). The two phase-draw sensitivity variants
    38	d in {1, 2} seed PCG64(TIC*10 + d) — the ONLY thing that changes between phase
    39	draws is the phase vector. A shared t_ref keeps the two-band evidence rule
    40	meaningful.
    41	
    42	Dominant-mode dropout (G3 numerics finding 3): the dropped mode is the
    43	largest-amplitude RETAINED (post-sinc) mode; every surviving mode keeps the
    44	phase it has in the nominal model; dropout is defined only when >= 2 modes are
    45	retained (the builder checks `retained_modes` first).
    46	
    47	This module also owns the D2 manifest CONTRACT (column schema + scenario
    48	codes) so the shard builder and the metrics program cannot drift apart.
    49	"""
    50	
    51	from __future__ import annotations
    52	
    53	import math
    54	from dataclasses import dataclass, field
    55	
    56	import numpy as np
    57	import pandas as pd
    58	
    59	PPT_TO_FRAC = 1.0e-3
    60	FRAC_TO_MAG = 1.0857
    61	ZTF_EXPOSURE_S = 30.0
    62	SINC_REJECT_BELOW = 0.3
    63	BANDPASS_LADDER_G = (1.4, 1.7, 2.1)
    64	BANDPASS_LADDER_RG = (0.70, 0.80, 0.90)
    65	NOMINAL_G = 1.7
    66	NOMINAL_RG = 0.80
    67	
    68	# band-effective wavelengths [nm] for the blackbody-derivative check
    69	LAMBDA_NM = {"zg": 472.0, "zr": 642.0, "tess": 786.0}
    70	HC_OVER_K_NM_K = 1.43877688e7  # h c / k_B in nm*K
    71	
    72	# ----------------------------------------------------------------- contract
    73	# Campaign id layout (19 digits): AA TTTTTTTTTT K GR PS CD
    74	#   AA arm prefix (92 = arm B, 93 = arm A), T zero-padded TIC, K template index
    75	#   (0/1/2), G/R ladder indices (1-3; 22 = nominal), P phase-draw (0-2),
    76	#   S amplitude-scale code (below), C crowding-variant code (0 = PDCSAP as
    77	#   published, 1 = SAP-equivalent re-dilution), D cadence code (0 = frozen
    78	#   rule, 1 = cadence_alt pure-120-s endpoint; Amendment 3).
    79	#   Nulls: 94 + 17-digit serial. Controls: 95 + 17-digit index of the template
    80	#   in the sorted fixed 928-window pool. Self-window diagnostic: 96 prefix.
    81	AMP_SCALE_CODES = {1.0: 0, 0.7: 1, 1.3: 2}
    82	AMP_SCALE_CODE_DROPOUT = 3          # amp_scale 1.0 with the dominant mode dropped
    83	CROWD_CODE_NONE = 0
    84	CROWD_CODE_REDILUTION = 1
    85	# Amendment 3 (G3 round-3 ADOPT-A): trailing id digit D = cadence code;
    86	# cadence_alt = the conservative pure-120-s endpoint for targets whose
    87	# published solution mixes 20-s and 120-s sectors (never pooled with nominal)
    88	CADENCE_CODE_NOMINAL = 0
    89	CADENCE_CODE_ALT = 1
    90	CADENCE_ALT_S = 120.0
    91	CADENCES_S = (20.0, 120.0)
    92	
    93	SCENARIO_NOMINAL = "nominal"
    94	SCENARIO_CADENCE_ALT = "cadence_alt"
    95	SCENARIO_CONTROL = "control"
    96	SCENARIO_NULL = "gauss_null"   # never the token "null": pandas parses it as NaN
    97	SCENARIO_DROPOUT = "dropout"
    98	
    99	# Fixed manifest schema: EVERY row of EVERY arm carries EVERY column with a
   100	# typed value (G3 methods finding 1) — no NaN in int/bool columns, ever.
   101	MANIFEST_COLUMNS: tuple[tuple[str, str], ...] = (
   102	    ("campaign_id", "str"),
   103	    ("arm", "str"),                 # A | B | ctrl | gauss_null (never "null": a pandas NA token)
   104	    ("scenario", "str"),            # nominal | ladder_g{i}r{j} | phase_{d} | ampscale_{s} | dropout | redilution | control | gauss_null
   105	    ("tic", "int"),                 # 0 for ctrl/null
   106	    ("template_source_id", "str"),
   107	    ("template_status", "str"),     # published blind_status of the window (metadata only)
   108	    ("template_k", "int"),          # 0/1/2 for A/B; -1 for ctrl/null
   109	    ("pool_index", "int"),          # index of the window in the sorted 928 pool
   110	    ("template_exp_per_night", "float"),
   111	    ("template_wg_contrasts", "int"),   # W_g = sum_nights max(n_zg,night - 1, 0): zg support surviving the frozen nightly-median subtraction (Amendment 4)
   112	    ("ratio_g", "float"),           # 0.0 for ctrl/null
   113	    ("ratio_rg", "float"),
   114	    ("phase_draw", "int"),          # 0 for ctrl/null
   115	    ("amp_scale", "float"),         # 1.0 for A/B unless ampscale scenario; 0.0 for null; 1.0 ctrl
   116	    ("dominant_dropped", "bool"),
   117	    ("dropped_period_s", "float"),  # nan unless dominant_dropped
   118	    ("crowdsap", "float"),          # nan unless redilution scenario
   119	    ("cadence_code", "int"),        # 0 nominal rule (20 iff any f sector) | 1 cadence_alt (120 s)
   120	    ("cadence_s", "float"),         # integration time used by the truth model; 0.0 ctrl/null
   121	    ("n_strata_scheduled", "int"),  # 3 nominal A/B, 1 sensitivity scenarios, 0 ctrl/null
   122	    ("match", "str"),               # tol_0.25 | tol_0.5 | nearest | ""
   123	    ("control_campaign_id", "str"), # paired control for arm B; "" otherwise
