   522	def contingency(per_star: pd.DataFrame, dataset: str = "d1") -> dict:
   523	    from scipy.stats import binomtest
   524	    frame = per_star[(per_star["label_positive"] == True)  # noqa: E712
   525	                     & per_star["census_variable"].notna()
   526	                     & (per_star["best_status"] != "missing")]
   527	    C = frame["census_variable"].astype(bool)
   528	    L = frame["best_status"] == "confirmed"
   529	    a, b = int((C & L).sum()), int((C & ~L).sum())
   530	    c, d = int((~C & L).sum()), int((~C & ~L).sum())
   531	    n = len(frame)
   532	    union_p, union_lo, union_hi = wilson(a + b + c, n) if n else (math.nan,) * 3
   533	    out = {
   534	        "n_positives_scored": n,
   535	        "table": {"census_and_ls": a, "census_only": b, "ls_only": c, "neither": d},
   536	        "union_completeness": {"p": union_p, "lo": union_lo, "hi": union_hi},
   537	        "incremental_census_only": dict(zip(("p", "lo", "hi"), wilson(b, n))) if n else {},
   538	        "incremental_ls_only": dict(zip(("p", "lo", "hi"), wilson(c, n))) if n else {},
   539	    }
   540	    if b + c and dataset != "d2":
   541	        out["mcnemar_exact_p_secondary"] = float(
   542	            binomtest(min(b, c), b + c, 0.5).pvalue * 1.0
   543	        )
   544	    if dataset == "d2":
   545	        out["mcnemar"] = "prohibited for d2 (cluster structure); use the target-cluster paired-difference bootstrap"
   546	    return out
