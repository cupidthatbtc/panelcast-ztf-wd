   980	def d2_paired_controls(per_star: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
   981	    """Amendment 4: every nominal arm-B shard is scored against its paired
   982	    uninjected control — for detection (D) and strict recovery (R), where the
   983	    control's candidate frequency is matched against the B target's dominant
   984	    injected mode. Returns (pair table, summary table). Controls are contextual:
   985	    the primary denominator is never conditioned on control status."""
   986	    nominal_b = per_star[(per_star["arm"] == "B") & (per_star["scenario"] == "nominal")]
   987	    controls = per_star[per_star["arm"] == "ctrl"].set_index("sid")
   988	    pairs = []
   989	    for r in nominal_b.itertuples(index=False):
   990	        cid = r.control_campaign_id
   991	        if not cid or cid not in controls.index:
   992	            continue
   993	        c = controls.loc[cid]
   994	        c_usable = c["best_status"] != "missing"
   995	        c_freq = c.get("best_frequency_per_day")
   996	        tol = 1.5 / float(c["baseline_days"]) + TRUTH_QUANTUM_PER_DAY["d2"] if np.isfinite(float(c.get("baseline_days", np.nan))) else np.nan
   997	        r_c = bool(c["best_status"] == "confirmed" and c_freq is not None and np.isfinite(float(c_freq))
   998	                   and r.primary_freq is not None and np.isfinite(tol)
   999	                   and classify_match(float(c_freq), [float(r.primary_freq)], tol) == "direct")
  1000	        pairs.append({
  1001	            "b_sid": r.sid, "control_sid": cid, "cluster": r.cluster, "template_k": int(r.template_k),
  1002	            "b_status": r.best_status, "control_status": c["best_status"], "control_usable": bool(c_usable),
  1003	            "D_B": bool(r.best_status == "confirmed"), "D_C": bool(c["best_status"] == "confirmed"),
  1004	            "R_B": bool(r.best_status == "confirmed" and r.best_candidate_matches_dominant == "direct"),
  1005	            "R_C": r_c,
  1006	        })
  1007	    table = pd.DataFrame(pairs)
  1008	    if table.empty:
  1009	        return table, pd.DataFrame()
  1010	    clusters = np.array(sorted(table["cluster"].unique()))
  1011	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
  1012	    draws = rng.integers(0, len(clusters), size=(BOOTSTRAP_B, len(clusters)))
  1013	
  1014	    def boot(series: pd.Series) -> tuple[float, float, float]:
  1015	        per_target = series.astype(float).groupby(table.loc[series.index, "cluster"]).mean().reindex(clusters)
  1016	        values = per_target.to_numpy(dtype=float)
  1017	        boots = []
  1018	        for b in range(BOOTSTRAP_B):
  1019	            sample = values[draws[b]]
  1020	            sample = sample[~np.isnan(sample)]
  1021	            if sample.size:
  1022	                boots.append(float(sample.mean()))
  1023	        obs = values[~np.isnan(values)]
  1024	        return (float(obs.mean()) if obs.size else math.nan,
  1025	                float(np.quantile(boots, 0.025)) if boots else math.nan,
  1026	                float(np.quantile(boots, 0.975)) if boots else math.nan)
  1027	
  1028	    summary = []
  1029	    usable = table[table["control_usable"]]
  1030	    for endpoint in ("D", "R"):
  1031	        b, c = usable[f"{endpoint}_B"], usable[f"{endpoint}_C"]
  1032	        row = {"endpoint": endpoint, "n_pairs_scored": int(len(usable)),
  1033	               "n_targets": int(usable["cluster"].nunique()),
  1034	               "n_unique_windows": int(usable["control_sid"].nunique()),
  1035	               "both": int((b & c).sum()), "b_only": int((b & ~c).sum()),
  1036	               "c_only": int((~b & c).sum()), "neither": int((~b & ~c).sum()),
  1037	               "union": int((b | c).sum())}
  1038	        for label, series in (("p_b", b), ("p_c", c), ("paired_diff_b_minus_c", b.astype(float) - c.astype(float)),
  1039	                              ("p_b_and_not_c", b & ~c)):
  1040	            p, lo, hi = boot(series)
  1041	            row.update({label: p, f"{label}_lo": lo, f"{label}_hi": hi})
  1042	        summary.append(row)
  1043	    # quiet-control-conditioned SECONDARY estimand: pairs whose control is usable and not_detected
  1044	    quiet = usable[usable["control_status"] == "not_detected"]
  1045	    row = {"endpoint": "quiet_control_conditioned", "n_pairs_scored": int(len(quiet)),
  1046	           "n_targets": int(quiet["cluster"].nunique()), "n_unique_windows": int(quiet["control_sid"].nunique())}
  1047	    if not quiet.empty:
  1048	        per_t_d = quiet["D_B"].astype(float).groupby(quiet["cluster"]).mean()
  1049	        per_t_r = quiet["R_B"].astype(float).groupby(quiet["cluster"]).mean()
  1050	        row.update({"p_b": float(per_t_d.mean()), "p_b_recovery": float(per_t_r.mean())})
  1051	    summary.append(row)
  1052	    return table, pd.DataFrame(summary)
