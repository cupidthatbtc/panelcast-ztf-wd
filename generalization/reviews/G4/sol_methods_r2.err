    61	
    62	def wilson(k: float, n: float) -> tuple[float, float, float]:
    63	    if n <= 0:
    64	        return math.nan, math.nan, math.nan
    65	    z = 1.959963984540054
    66	    p = k / n
    67	    denom = 1.0 + z * z / n
    68	    center = (p + z * z / (2 * n)) / denom
    69	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    70	    return p, max(0.0, center - half), min(1.0, center + half)
    71	
    72	
    73	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    74	    total = float(weights.sum())
    75	    if total <= 0:
    76	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    77	    p = float((weights * successes).sum() / total)
    78	    ess = total * total / float((weights * weights).sum())
    79	    _, lo, hi = wilson(p * ess, ess)
    80	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
    81	
    82	
    83	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    84	    """Evaluate EVERY (truth mode, relation) predicate — no short-circuit
    85	    (spec: hits in more than one relation class -> ambiguous)."""
    86	    classes: set[str] = set()
    87	    for f_t in truth:
    88	        if abs(freq - f_t) <= tol:
    89	            classes.add("direct")
    90	        if abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    91	            classes.add("harmonic")
    92	        for k in (1, 2):
    93	            for sign in (1.0, -1.0):
    94	                if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    95	                    classes.add("window_alias")
    96	    if not classes:
    97	        return "unmatched"
    98	    if len(classes) > 1:
    99	        return "ambiguous"
   100	    return classes.pop()
   101	
   102	
   103	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
   104	    if not truth:
   105	        return False
   106	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   107	    return any(low <= f <= high for f in truth)
   108	
   109	
   110	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   111	    if status == "missing":
   112	        # no usable light curve: unconditionally a non-detection under every
   113	        # rule in the eligible-roster estimand
   114	        return False
   115	    if rule == "confirmed":
   116	        return status == "confirmed"
   117	    if rule == "confirmed_or_candidate":
   118	        return status in ("confirmed", "candidate")
   119	    if rule == "census":
   120	        return None if census_flag is None else bool(census_flag)
   121	    if rule == "either":
   122	        if census_flag is None:
   123	            return status == "confirmed"
   124	        return status == "confirmed" or bool(census_flag)
   125	    raise ValueError(rule)
