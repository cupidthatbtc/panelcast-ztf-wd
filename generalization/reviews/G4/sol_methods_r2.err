   183	                             & (manifest["tic"] == 11) & (manifest["template_k"] == 1)]["campaign_id"].iloc[0]
   184	    assert [i for i in range(19) if alt_id[i] != nominal_k1_id[i]] == [18] and alt_id[18] == "1"
   185	    assert set(injected.loc[injected["campaign_id"] == alt_id, "period_s"]) == {300.0, 500.0, 700.0}
   186	    rejected = pd.read_csv(generation["out"] / "rejected_modes.csv", dtype={"campaign_id": str})
   187	    assert rejected.loc[rejected["campaign_id"] == alt_id, "period_s"].tolist() == [150.0]
   188	    assert int(alt["n_modes_injected"].iloc[0]) == 3 and int(alt["n_modes_rejected"].iloc[0]) == 1
   189	    nominal_k1 = manifest[manifest["campaign_id"] == nominal_k1_id].iloc[0]
   190	    assert int(nominal_k1["n_modes_injected"]) == 4 and (manifest.loc[manifest["campaign_id"] == nominal_k1_id, "cadence_s"] == 20.0).all()
   191	    # phases are shared between nominal and cadence_alt for the surviving modes
   192	    ph_nom = injected[injected["campaign_id"] == nominal_k1_id].set_index("period_s")["phase_rad"]
