   102	def shard_sha256(path: Path) -> str:
   103	    return hashlib.sha256(path.read_bytes()).hexdigest()
   104	
   105	
   106	def env_digest() -> str:
   107	    return hashlib.sha256(
   108	        json.dumps(env_versions(), sort_keys=True).encode()
   109	    ).hexdigest()
   110	
   111	
   112	def provenance_path(star_dir: Path, source_id: str) -> Path:
   113	    return star_dir / f"{source_id}.prov.json"
   114	
   115	
   116	def write_provenance(star_dir: Path, source_id: str, shard: Path,
   117	                     passes: tuple[str, ...], binding: dict) -> None:
   118	    """Sidecar binding a result to its shard bytes, environment, pass set,
   119	    frozen/campaign code snapshot, replay attestation and shard generation
   120	    (G3 methods finding 6); the result file's own SHA closes the loop."""
   121	    result_path = star_dir / f"{source_id}.json"
   122	    provenance_path(star_dir, source_id).write_text(
   123	        json.dumps({
   124	            "source_id": source_id,
   125	            "passes": list(passes),
   126	            "shard_sha256": shard_sha256(shard),
   127	            "result_sha256": shard_sha256(result_path),
   128	            "env_digest": env_digest(),
   129	            "driver": "run_generalization_ls.py",
   130	            **binding,
   131	        }, indent=2) + "\n",
   132	        encoding="utf-8",
   133	    )
   134	
   135	
   136	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
   137	                 only: set[str] | None, limit: int | None,
   138	                 binding: dict) -> tuple[list[str], list[str]]:
   139	    """A completed result is reused ONLY when its provenance sidecar matches
   140	    the current shard content, environment, pass set, result bytes, and the
   141	    frozen/campaign/attestation/generation binding (G1 methods finding 8, G3
   142	    methods finding 6); stale results are DELETED so analyze_star's internal
   143	    early-return cannot resurrect them. Returns (pending, all source ids)."""
   144	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
   145	    if only is not None:
   146	        missing = only - set(source_ids)
   147	        if missing:
   148	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
   149	        source_ids = [sid for sid in source_ids if sid in only]
   150	    if limit is not None:
   151	        source_ids = source_ids[:limit]
   152	    current_env = env_digest()
   153	    pending = []
   154	    for source_id in source_ids:
   155	        result_path = star_dir / f"{source_id}.json"
   156	        prov_file = provenance_path(star_dir, source_id)
   157	        if result_path.exists() and prov_file.exists():
   158	            try:
   159	                result = json.loads(result_path.read_text(encoding="utf-8"))
   160	                prov = json.loads(prov_file.read_text(encoding="utf-8"))
   161	                if (
   162	                    result.get("complete")
   163	                    and result.get("source_id") == source_id
   164	                    and set(result.get("passes", {})) >= set(passes)
   165	                    and prov.get("source_id") == source_id
   166	                    and set(prov.get("passes", [])) == set(passes)
   167	                    and prov.get("shard_sha256")
   168	                    == shard_sha256(shard_dir / f"{source_id}.csv.gz")
   169	                    and prov.get("result_sha256") == shard_sha256(result_path)
   170	                    and prov.get("env_digest") == current_env
   171	                    and all(prov.get(key) == value for key, value in binding.items())
   172	                ):
   173	                    continue
   174	            except json.JSONDecodeError:
   175	                pass
   176	        result_path.unlink(missing_ok=True)
   177	        prov_file.unlink(missing_ok=True)
   178	        pending.append(source_id)
   179	    return pending, source_ids
   180	
   181	
   182	def write_progress(path: Path, payload: dict) -> None:
   183	    temporary = path.with_suffix(".json.part")
   184	    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
   185	    temporary.replace(path)
   186	
   187	
   188	def main() -> None:
   189	    parser = argparse.ArgumentParser(description=__doc__)
   190	    parser.add_argument("--shard-dir", type=Path, required=True)
   191	    parser.add_argument("--out-dir", type=Path, required=True)
   192	    parser.add_argument("--work-root", type=Path, default=None,
   193	                        help="scratch for periodogram memmaps; put on local NVMe "
   194	                             "or a RAM disk, NEVER inside a synced folder")
   195	    parser.add_argument("--dataset", required=True,
   196	                        help="manifest label, e.g. d3-kepler-dsct or d2-tess-dav")
   197	    parser.add_argument("--workers", type=int, default=None)
   198	    parser.add_argument("--passes", default="low,high")
   199	    parser.add_argument("--stars-file", type=Path, default=None,
   200	                        help="optional newline-separated campaign_id subset (a shard)")
   201	    parser.add_argument("--limit", type=int, default=None,
   202	                        help="DEBUG subset: first N shard ids in lexicographic order — NOT a "
   203	                             "representative pilot (use --stars-file with the builder's "
   204	                             "pilot_shard_index.txt); marks the run pilot=true")
   205	    parser.add_argument("--expect-count", type=int, default=None,
   206	                        help="assert the shard dir holds exactly N shards "
   207	                             "(stale-directory guard)")
   208	    parser.add_argument("--shard-index", type=Path, default=None,
   209	                        help="newline-separated campaign_id list the shard dir "
   210	                             "must match EXACTLY (builders emit shard_index.txt); "
   211	                             "required for production runs")
   212	    parser.add_argument("--allow-nonstandard-ids", action="store_true",
   213	                        help="permit non-campaign source_ids (replay/debug only)")
   214	    parser.add_argument("--replay-report", type=Path, required=True,
   215	                        help="replay_report.json from a PASSING replay_gate run "
   216	                             "on THIS machine+env; campaign runs refuse to start "
   217	                             "without one (G1 methods finding 1)")
   218	    args = parser.parse_args()
   219	
   220	    assert_frozen()
   221	    campaign_shas_start = campaign_file_shas()
   222	    attestation = validate_attestation(args.replay_report)
   223	    passes = tuple(args.passes.split(","))
   224	    if passes != ("low", "high") and not args.allow_nonstandard_ids:
   225	        raise SystemExit("production runs use exactly low,high (the frozen CLI's "
   226	                         "pass set); pass --allow-nonstandard-ids for debug runs")
   227	    if (args.shard_dir / "IN_PROGRESS").exists():
   228	        raise SystemExit(f"{args.shard_dir} is an unpublished shard generation (IN_PROGRESS sentinel)")
   229	    generation_path = args.shard_dir / "generation_manifest.json"
   230	    generation = (json.loads(generation_path.read_text(encoding="utf-8"))
   231	                  if generation_path.exists() else {})
   232	    if args.dataset.startswith("d2") and not generation and not args.allow_nonstandard_ids:
   233	        raise SystemExit("d2 runs require a published shard generation (generation_manifest.json)")
   234	    pilot = args.limit is not None or args.stars_file is not None
   235	    if generation and not generation.get("production", False) and not pilot:
   236	        raise SystemExit("non-production shard generation: only --limit/--stars-file pilot runs allowed")
   237	    binding = {
   238	        "generation_id": generation.get("generation_id", ""),
   239	        "attestation_sha256": hashlib.sha256(args.replay_report.read_bytes()).hexdigest(),
   240	        "frozen_digest": hashlib.sha256(
   241	            json.dumps(frozen_file_shas(), sort_keys=True).encode()).hexdigest(),
   242	        "campaign_digest": hashlib.sha256(
   243	            json.dumps(campaign_shas_start, sort_keys=True).encode()).hexdigest(),
   244	    }
   245	    star_dir = args.out_dir / "stars"
   246	    work_root = args.work_root or (args.out_dir / "work")
   247	    star_dir.mkdir(parents=True, exist_ok=True)
   248	    work_root.mkdir(parents=True, exist_ok=True)
   249	
   250	    if args.expect_count is not None:
   251	        found = len(list(args.shard_dir.glob("*.csv.gz")))
   252	        if found != args.expect_count:
   253	            raise SystemExit(
   254	                f"shard dir holds {found} shards, expected {args.expect_count} "
   255	                f"— stale or incomplete directory"
   256	            )
   257	    if args.shard_index is None and not args.allow_nonstandard_ids:
   258	        raise SystemExit("production runs require --shard-index (builders emit "
   259	                         "shard_index.txt); --allow-nonstandard-ids for debug")
   260	    if args.shard_index is not None:
   261	        index_ids = {line.strip() for line in
   262	                     args.shard_index.read_text().splitlines() if line.strip()}
   263	        disk_ids = {path.name.split(".csv")[0]
   264	                    for path in args.shard_dir.glob("*.csv.gz")}
   265	        if disk_ids != index_ids:
   266	            extra = sorted(disk_ids - index_ids)[:3]
   267	            gone = sorted(index_ids - disk_ids)[:3]
   268	            raise SystemExit(
   269	                f"shard dir does not match the index: {len(disk_ids - index_ids)} "
   270	                f"extra (e.g. {extra}), {len(index_ids - disk_ids)} missing "
   271	                f"(e.g. {gone})"
   272	            )
   273	    only = None
   274	    if args.stars_file:
   275	        only = {line.strip() for line in args.stars_file.read_text().splitlines() if line.strip()}
   276	    pending, source_ids = scan_pending(args.shard_dir, star_dir, passes, only, args.limit, binding)
   277	    total = len(source_ids)
   278	
   279	    if not args.allow_nonstandard_ids:
   280	        bad = [sid for sid in pending if not campaign_id_ok(sid)]
   281	        if bad:
   282	            raise SystemExit(
   283	                f"{len(bad)} shard ids violate the campaign 19-digit prefix "
   284	                f"convention (first: {bad[:3]}); refusing to run"
   285	            )
   286	
   287	    workers, free_gb = preflight_workers(args.workers, work_root)
   288	    print(
   289	        f"[{args.dataset}] sources={total:,} pending={len(pending):,} "
   290	        f"workers={workers} (free {free_gb:.0f} GB on scratch)",
   291	        flush=True,
   292	    )
   293	
   294	    progress_path = args.out_dir / "progress.json"
   295	    started = time.time()
   296	    started_utc = datetime.datetime.now(datetime.timezone.utc).isoformat()
   297	
   298	    def git_state() -> dict:
   299	        try:
   300	            head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO_ROOT, capture_output=True,
   301	                                  text=True, timeout=30).stdout.strip()
   302	            dirty = subprocess.run(["git", "status", "--porcelain", "--untracked-files=no"], cwd=REPO_ROOT,
   303	                                   capture_output=True, text=True, timeout=30).stdout.strip()
   304	            return {"git_commit": head, "git_dirty": bool(dirty)}
   305	        except Exception as exc:  # noqa: BLE001
   306	            return {"git_commit": "", "git_dirty": None, "git_error": repr(exc)}
   307	    failures: dict[str, str] = {}
   308	    completed_now = 0
   309	
   310	    def progress_payload() -> dict:
   311	        elapsed = time.time() - started
   312	        rate = completed_now / elapsed if elapsed > 0 else 0.0
   313	        return {
   314	            "dataset": args.dataset,
   315	            "total": total,
   316	            "pending_at_start": len(pending),
   317	            "completed_now": completed_now,
   318	            "failed": len(failures),
   319	            "elapsed_seconds": round(elapsed, 1),
   320	            "stars_per_hour": round(rate * 3600.0, 2),
   321	            "eta_hours": round((len(pending) - completed_now - len(failures)) / (rate * 3600.0), 2)
   322	            if rate > 0
   323	            else None,
   324	            "workers": workers,
   325	        }
   326	
   327	    write_progress(progress_path, progress_payload())
   328	    with ProcessPoolExecutor(max_workers=workers) as executor:
   329	        futures = {
   330	            executor.submit(
   331	                analyze_star,
   332	                source_id,
   333	                str(args.shard_dir / f"{source_id}.csv.gz"),
   334	                str(star_dir / f"{source_id}.json"),
   335	                str(work_root),
   336	                passes,
   337	            ): source_id
   338	            for source_id in pending
   339	        }
   340	        for future in as_completed(futures):
   341	            source_id = futures[future]
   342	            try:
   343	                future.result()
   344	                write_provenance(star_dir, source_id,
   345	                                 args.shard_dir / f"{source_id}.csv.gz", passes, binding)
   346	                completed_now += 1
   347	            except Exception as exc:
   348	                failures[source_id] = repr(exc)
   349	                print(f"[{args.dataset}] FAILED {source_id}: {exc}", flush=True)
   350	            if completed_now % 10 == 0 or completed_now + len(failures) == len(pending):
   351	                write_progress(progress_path, progress_payload())
   352	                print(
   353	                    f"[{args.dataset}] {completed_now:,}/{len(pending):,} "
   354	                    f"({progress_payload()['stars_per_hour']}/h)",
   355	                    flush=True,
   356	                )
   357	
   358	    manifest = {
   359	        "dataset": args.dataset,
   360	        "driver": "run_generalization_ls.py",
   361	        "source_count": total,
   362	        "pending_at_start": len(pending),
   363	        "completed_now": completed_now,
   364	        "failures": failures,
   365	        "passes": list(passes),
   366	        "workers": workers,
   367	        "wall_seconds": round(time.time() - started, 1),
   368	        "shard_dir": str(args.shard_dir),
   369	        "shard_index": str(args.shard_index) if args.shard_index else "",
   370	        "shard_index_sha256": (hashlib.sha256(args.shard_index.read_bytes()).hexdigest()
   371	                               if args.shard_index else ""),
   372	        "stars_file_sha256": (hashlib.sha256(args.stars_file.read_bytes()).hexdigest()
   373	                              if args.stars_file else ""),
   374	        "argv": sys.argv,
   375	        "started_utc": started_utc,
   376	        "finished_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
   377	        **git_state(),
   378	        "generation_id": binding["generation_id"],
   379	        "pilot": pilot,
   380	        "limit": args.limit,
   381	        "stars_file": str(args.stars_file) if args.stars_file else "",
   382	        "env": env_versions(),
   383	        "frozen_sha256": assert_frozen(),
   384	        "campaign_sha256": campaign_file_shas(),
   385	        "binding": binding,
   386	        "replay_attestation": {
   387	            "path": str(args.replay_report),
   388	            "sha256": binding["attestation_sha256"],
   389	            "wall_seconds": attestation.get("wall_seconds"),
   390	            "verdict_counts": attestation.get("verdict_counts"),
   391	        },
   392	    }
   393	    # per-id completion table (G3 methods finding 6): metrics verifies it
   394	    completion_rows = []
   395	    for source_id in source_ids:
   396	        result_path = star_dir / f"{source_id}.json"
   397	        prov_file = provenance_path(star_dir, source_id)
   398	        if source_id in failures:
   399	            status = "failed"
   400	        elif result_path.exists() and prov_file.exists():
   401	            status = "complete"
   402	        else:
   403	            status = "pending"
   404	        completion_rows.append({
   405	            "source_id": source_id, "status": status,
   406	            "result_sha256": shard_sha256(result_path) if result_path.exists() else "",
   407	        })
   408	    pd.DataFrame(completion_rows, columns=["source_id", "status", "result_sha256"]).to_csv(
   409	        args.out_dir / "completion.csv", index=False, lineterminator="\n")
   410	    if campaign_file_shas() != campaign_shas_start:
   411	        raise SystemExit("campaign code changed mid-run — results void")
   412	    (args.out_dir / "manifest.json").write_text(
   413	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   414	    )
   415	    write_progress(progress_path, progress_payload())
   416	    print(f"[{args.dataset}] done: {completed_now:,} completed, {len(failures)} failed", flush=True)
   417	    if failures:
   418	        raise SystemExit(1)
   419	
   420	
   421	if __name__ == "__main__":
   422	    main()

