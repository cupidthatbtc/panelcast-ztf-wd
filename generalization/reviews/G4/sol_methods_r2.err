   125	    ("n_modes_injected", "int"),
   126	    ("n_modes_rejected", "int"),
   127	    ("shard_sha256", "str"),
   128	)
   129	MANIFEST_COLUMN_NAMES = tuple(name for name, _ in MANIFEST_COLUMNS)
   130	ARMS = ("A", "B", "ctrl", "gauss_null")
