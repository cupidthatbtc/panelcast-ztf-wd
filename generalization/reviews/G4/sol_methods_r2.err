    40	def validate_attestation(report_path: Path) -> dict:
    41	    report = json.loads(report_path.read_text(encoding="utf-8"))
    42	    if report.get("gate") != "replay_gate":
    43	        raise SystemExit(f"{report_path} is not a replay_gate report")
    44	    if report.get("passed") is not True:
    45	        raise SystemExit(f"replay attestation {report_path} is not a PASS")
    46	    if not report.get("stars"):
    47	        raise SystemExit(f"replay attestation {report_path} has an empty roster")
    48	    current = env_versions()
    49	    # the FULL environment fingerprint must match (G2 methods finding 1)
    50	    mismatched = [
    51	        key for key in current
    52	        if report["env"].get(key) != current.get(key)
    53	    ]
    54	    if mismatched:
    55	        raise SystemExit(
    56	            f"replay attestation env differs from this run: {mismatched} "
    57	            f"(attested {[report['env'].get(k) for k in mismatched]} vs "
    58	            f"current {[current.get(k) for k in mismatched]})"
    59	        )
    60	    if report.get("frozen_sha256") != frozen_file_shas():
    61	        raise SystemExit("replay attestation frozen SHAs differ from this checkout")
    62	    unique = {record["source_id"] for record in report["stars"]}
    63	    if len(unique) != 928 or len(report["stars"]) != 928:
    64	        raise SystemExit(
    65	            f"production runs require the FULL 928-UNIQUE-star baseline "
    66	            f"attestation; this report covers {len(unique)} unique of "
    67	            f"{len(report['stars'])} records"
    68	        )
    69	    catalog = pd.read_csv(
    70	        REPO_ROOT / "catalog-rebuild/results/2026-08-01_full/catalog/ls_full_catalog.csv",
    71	        dtype={"source_id": str},
    72	    )
    73	    expected = set(catalog["source_id"])
    74	    if unique != expected:
    75	        raise SystemExit(
    76	            f"attested roster is not the published 928-star catalog set: "
    77	            f"{len(unique - expected)} foreign, {len(expected - unique)} missing"
    78	        )
    79	    return report
    80	
    81	# One in-flight star holds two full-resolution float32 periodogram memmaps plus
    82	# the multiband combination on scratch; the worst published-catalog baseline
    83	# needs 0.471 GB for the three high-pass memmaps, so 0.52 adds ~10% headroom
    84	# for longer campaign baselines. Disk, not wall time, binds worker count.
    85	SCRATCH_GB_PER_WORKER = 0.52
    86	
    87	
    88	def preflight_workers(requested: int | None, work_root: Path) -> tuple[int, float]:
    89	    if requested is not None and requested < 1:
    90	        raise SystemExit(f"invalid --workers {requested}")
    91	    free_gb = shutil.disk_usage(work_root).free / 1e9
    92	    ceiling = int(free_gb * 0.5 / SCRATCH_GB_PER_WORKER)
    93	    if ceiling < 1:
    94	        raise SystemExit(
    95	            f"scratch {work_root} has {free_gb:.1f} GB free — below one worker's "
    96	            f"{SCRATCH_GB_PER_WORKER} GB requirement"
    97	        )
    98	    workers = min(requested or physical_workers(), physical_workers(), ceiling)
    99	    return workers, free_gb
