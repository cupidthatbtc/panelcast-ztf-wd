  1122	    if triggered.empty:
  1123	        return {"note": "no triggered stars in the PPV frame"}
  1124	    weights = triggered["weight"].to_numpy(dtype=float)
  1125	    is_pos = (triggered["class_label"] == "dsct_flag1").to_numpy()

