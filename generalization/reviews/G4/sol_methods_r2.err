   331	def all_scenarios() -> set[str]:
   332	    ladder = {f"ladder_g{gi}r{ri}" for gi in (1, 2, 3) for ri in (1, 2, 3)} - {"ladder_g2r2"}
   333	    return ({SCENARIO_NOMINAL, SCENARIO_DROPOUT, "redilution", SCENARIO_CADENCE_ALT,
   334	             "phase_1", "phase_2", "ampscale_0.7", "ampscale_1.3",
   335	             SCENARIO_CONTROL, SCENARIO_NULL} | ladder)
