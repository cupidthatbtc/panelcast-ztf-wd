   460	def completeness_tables(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   461	    # primary frequency-match column: D3 scores the DOMINANT Mo mode (any-mode
   462	    # is secondary/diagnostic); D2 scores the exact injected list; D1 is
   463	    # diagnostic-only either way (spec).
   464	    use_dominant = True  # headline = best_candidate_matches_dominant (spec)
   465	    rows = []
   466	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   467	    usable = positives[(positives["best_status"] != "missing")
   468	                       & positives["low_available"].fillna(False)
   469	                       & positives["high_available"].fillna(False)]
   470	    for pass_name in PASSES:
   471	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   472	        match_col = ("best_candidate_matches_dominant" if pass_name == "best"
   473	                     else f"{pass_name}_match_primary")
   474	        for rule in RULES:
   475	            for scope, frame in (
   476	                ("detection_eligible_roster", positives),
   477	                ("detection_usable_lightcurve", usable),
   478	                ("freq_recovery_scorable", usable[
   479	                    usable["freq_scorable"]
   480	                    & (usable["eligible_any_pass"] if pass_name == "best"
   481	                       else usable[f"{pass_name}_eligible"])
   482	                ]),
   483	            ):
   484	                if scope == "freq_recovery_scorable" and rule in ("census", "either"):
   485	                    continue  # frequency outcomes exist only for L-S rules
   486	                if frame.empty:
   487	                    rows.append({"pass": pass_name, "rule": rule, "scope": scope,
   488	                                 "n": 0, "ess": 0.0, "p": math.nan,
   489	                                 "lo": math.nan, "hi": math.nan})
   490	                    continue
   491	                fired = frame.apply(
   492	                    lambda r: rule_fired(rule, r[status_col], r.get("census_variable")),
   493	                    axis=1,
   494	                )
   495	                ok = fired.notna()
   496	                success = fired[ok].astype(bool)
   497	                if scope == "freq_recovery_scorable":
   498	                    success = success & (frame.loc[ok, match_col] == "direct")
   499	                stats = weighted_wilson(
   500	                    success.to_numpy(dtype=float),
   501	                    frame.loc[ok, "weight"].to_numpy(dtype=float),
   502	                )
   503	                rows.append({"pass": pass_name, "rule": rule, "scope": scope, **stats})
   504	        # correct-frequency fraction among detected positives (spec):
   505	        # P(match dominant | rule-1 fired, Y=1, F=1, S_p=1)
   506	        scorable = usable[usable["freq_scorable"]
   507	                          & (usable["eligible_any_pass"] if pass_name == "best"
   508	                             else usable[f"{pass_name}_eligible"])]
   509	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   510	        detected = scorable[scorable[status_col] == "confirmed"]
   511	        if len(detected):
   512	            correct = (detected[match_col] == "direct")
   513	            stats = weighted_wilson(correct.to_numpy(dtype=float),
   514	                                    detected["weight"].to_numpy(dtype=float))
   515	        else:
   516	            stats = {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
   517	        rows.append({"pass": pass_name, "rule": "confirmed",
   518	                     "scope": "correct_frequency_fraction_detected", **stats})
   519	    return pd.DataFrame(rows)
   520	

