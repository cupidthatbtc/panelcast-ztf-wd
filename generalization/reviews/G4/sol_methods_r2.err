   119	def test_publish_is_atomic_and_described(generation):
   120	    out = generation["out"]
   121	    assert out.exists() and not (out / "IN_PROGRESS").exists()
   122	    assert not (out.parent / (out.name + ".staging")).exists()
   123	    gen = json.loads((out / "generation_manifest.json").read_text())
   124	    assert gen["production"] is False
   125	    assert {"n_nulls", "pool"} <= set(gen["non_production_reasons"])
   126	    assert any(r.startswith("targets") for r in gen["non_production_reasons"])
   127	    assert gen["expected_counts"]["B:nominal"] == 6 and gen["expected_counts"]["B:dropout"] == 1
   128	    assert gen["expected_counts"]["B:redilution"] == 1 and gen["redilution_tics"] == [11]
   129	    assert gen["expected_counts"]["B:cadence_alt"] == 1 and gen["cadence_alt_tics"] == [11]
   130	    assert gen["n_targets_scheduled"] == 2 and gen["scheduled_tics"] == [11, 22]
   131	    assert [e["tic"] for e in gen["excluded_targets"]] == [33]
   132	    disk = {p.name.split(".csv")[0] for p in out.glob("*.csv.gz")}
   133	    assert set(gen["shard_sha256"]) == disk
   134	    for sid, digest in gen["shard_sha256"].items():
   135	        assert sha(out / f"{sid}.csv.gz") == digest
   136	    index = set((out / "shard_index.txt").read_text().split())
   137	    assert index == disk
