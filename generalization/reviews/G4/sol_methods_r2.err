   889	def _target_equal_cells(frame: pd.DataFrame, success: pd.Series, keys: list[np.ndarray],
   890	                        names: list[str]) -> pd.DataFrame:
   891	    """D2 surface cells at TARGET level (Amendment 4): n_windows, n_targets,
   892	    target-equal point estimate, target-cluster bootstrap interval when the
   893	    cell holds >= MIN_CELL targets, counts only otherwise."""
   894	    rows = []
   895	    for cell, idx in frame.groupby(keys).groups.items():
   896	        cell = cell if isinstance(cell, tuple) else (cell,)
   897	        sub = frame.loc[idx]
   898	        y = success.loc[idx].astype(float)
   899	        per_target = y.groupby(sub["cluster"]).mean()
   900	        entry = {**{n: int(c) for n, c in zip(names, cell)},
   901	                 "n_windows": int(len(sub)), "k_windows": int(y.sum()),
   902	                 "n_targets": int(len(per_target))}
   903	        if len(per_target) >= MIN_CELL:
   904	            values = per_target.to_numpy(dtype=float)
   905	            rng = np.random.Generator(np.random.PCG64([BOOTSTRAP_SEED, *[int(c) + 7 for c in cell]]))
   906	            draws = rng.integers(0, len(values), size=(BOOTSTRAP_B, len(values)))
   907	            boots = values[draws].mean(axis=1)
   908	            entry.update({"p": float(values.mean()), "lo": float(np.quantile(boots, 0.025)),
   909	                          "hi": float(np.quantile(boots, 0.975)), "interval": "target_cluster_bootstrap"})
   910	        rows.append(entry)
   911	    return pd.DataFrame(rows)
