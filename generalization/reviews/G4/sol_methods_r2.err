   423	def census_lookup_csv(path: Path) -> dict[str, dict]:
   424	    frame = pd.read_csv(path, dtype={"source_id": str})
   425	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   426	    for col in ratio_cols:
   427	        exact = frame[col] == 2.5
   428	        if exact.any():
   429	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   430	    return {
   431	        r["source_id"]: {
   432	            "census_variable": bool(r["census_variable"]),
   433	            "census_g_nightly": bool(r["census_g_nightly"]),
   434	            "median_exp_per_night": float(r["zg_median_exp_per_night"])
   435	            if "zg_median_exp_per_night" in frame.columns else math.nan,
   436	        }
   437	        for _, r in frame.iterrows()
   438	    }
