   808	    # detection endpoint: ALL positives; unknown-amplitude stars form their
   809	    # own bin (-1) so the 154 unjoined D3 positives stay in the denominator
   810	    detection = positives["best_status"] == "confirmed"
   811	    out["detection_amplitude"] = pd.DataFrame(
   812	        surface_cells(positives, detection, positives["amp"], amp_edges, "amp_bin"))
   813	    # detection endpoint on (period, amplitude): unknowns fall in bin -1
   814	    p_bins_all = np.where(np.isfinite(positives["truth_period_days"]),
   815	                          np.digitize(positives["truth_period_days"],
   816	                                      PERIOD_EDGES_DAYS), -1)
   817	    a_bins_all = np.where(np.isfinite(positives["amp"]),
   818	                          np.digitize(positives["amp"], amp_edges), -1)
   819	    det_rows = []
   820	    for (pb, ab), idx in positives.groupby([p_bins_all, a_bins_all]).groups.items():

