   581	
   582	def d2_cluster_bootstrap(per_star: pd.DataFrame, scheduled_tics: list[int] | None = None,
   583	                         pilot: bool = False) -> tuple[pd.DataFrame, pd.DataFrame]:
   584	    """P4 machinery: per (scenario, endpoint), per-stratum rates and the
   585	    scenario-standardized mean over targets; COMMON RANDOM NUMBERS — one
   586	    resample-index matrix shared by every scenario; degenerate statistics
   587	    fall back to target-level exact CP. Scenario identity is the explicit
   588	    manifest `scenario` code plus every grouping key (G3 methods finding 2);
   589	    the eligible denominator is the scenario's SCHEDULED strata count
   590	    (3 nominal, 1 single-window sensitivities), never a fixed 3; the nominal
   591	    arm-B scenario is the ONLY confirmatory P4 row, and only outside pilots."""
   592	    if "arm" not in per_star or "scenario" not in per_star:
   593	        return pd.DataFrame(), pd.DataFrame()
   594	    frame = per_star[per_star["arm"].isin(["A", "B"])]
   595	    if frame.empty:
   596	        return pd.DataFrame(), pd.DataFrame()
   597	    if scheduled_tics:
   598	        clusters = np.array(sorted(str(int(t)) for t in scheduled_tics))
   599	    else:
   600	        clusters = np.array(sorted(frame["cluster"].unique()))
   601	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   602	    draws = rng.integers(0, len(clusters), size=(BOOTSTRAP_B, len(clusters)))
   603	    rows = []
   604	    # Amendment 4 (G4): PRIMARY P4 = injected-signal RECOVERY (rule-1 confirmed
   605	    # AND the best candidate directly matches the largest-amplitude retained
   606	    # injected mode); detection-only is the secondary "post-injection trigger
   607	    # rate" and carries no completeness interpretation
   608	    endpoints = {
   609	        "recovery": lambda f: (f["best_status"] == "confirmed")
   610	        & (f["best_candidate_matches_dominant"] == "direct"),
   611	        "trigger": lambda f: f["best_status"] == "confirmed",
   612	    }
   613	    scenario_cols = ["arm", "scenario", "ratio_g", "ratio_rg", "phase_draw",
   614	                     "amp_scale", "dominant_dropped", "cadence_code"]
   615	
   616	    def bootstrap_stats(aligned: pd.Series) -> tuple[float, float, float, str, int]:
   617	        observed = aligned.dropna()
   618	        point = float(observed.mean())
   619	        values = aligned.to_numpy(dtype=float)
   620	        boots = []
   621	        for b in range(BOOTSTRAP_B):
   622	            sample = values[draws[b]]
   623	            sample = sample[~np.isnan(sample)]
   624	            if sample.size:
   625	                boots.append(float(sample.mean()))
   626	        target_hits = observed.round(6)
   627	        degenerate = (target_hits == 0).all() or (target_hits == 1).all()
   628	        if degenerate:
   629	            k_deg = int((target_hits == 1).sum())
   630	            lo, hi = cp_one_sided_bounds(k_deg, len(observed))
   631	            return point, lo, hi, "cp_one_sided", len(observed)
   632	        return (point, float(np.quantile(boots, 0.025)),
   633	                float(np.quantile(boots, 0.975)), "cluster_bootstrap", len(observed))
   634	
   635	    for keys, scenario in frame.groupby(scenario_cols):
   636	        key = dict(zip(scenario_cols, keys))
   637	        key["dominant_dropped"] = bool(key["dominant_dropped"])
   638	        strata = scenario["n_strata_scheduled"].unique()
   639	        if len(strata) != 1 or int(strata[0]) < 1:
   640	            raise SystemExit(f"scenario {key} has inconsistent n_strata_scheduled {strata}")
   641	        n_strata = int(strata[0])
   642	        present = set(scenario["cluster"])
   643	        is_nominal = key["scenario"] == "nominal"
   644	        if is_nominal:
   645	            counts = scenario.groupby(["cluster", "template_k"]).size()
   646	            if (counts != 1).any() or set(scenario["template_k"]) != set(range(n_strata)):
   647	                raise SystemExit("nominal scenario must hold exactly one replicate per (target, K)")
   648	            if scheduled_tics and present != set(clusters):
   649	                raise SystemExit("nominal scenario targets != scheduled targets")
   650	        usable_rows = scenario[scenario["best_status"] != "missing"]
   651	        zero_usable = sorted(present - set(usable_rows["cluster"]))
   652	        # `prespecified_primary` = the row IS the prespecified primary P4
   653	        # analysis (recovery endpoint, nominal arm B, non-pilot);
   654	        # `confirmatory_decision` is False for every P4 row — P5 is the sole
   655	        # confirmatory decision (spec)
   656	        for endpoint, predicate in endpoints.items():
   657	            primary = (key["arm"] == "B" and is_nominal and not pilot
   658	                       and endpoint == "recovery")
   659	            for denom in ("usable", "eligible"):
   660	                subset = usable_rows if denom == "usable" else scenario
   661	                if subset.empty:
   662	                    continue
   663	                if denom == "eligible":
   664	                    # missing replicate = failure; fixed |K_t| = scheduled strata (spec P4)
   665	                    success = predicate(subset) & (subset["best_status"] != "missing")
   666	                    per_ts = success.groupby(
   667	                        [subset["cluster"], subset["template_k"]]).mean()
   668	                    per_target = per_ts.groupby(level=0).sum() / float(n_strata)
   669	                else:
   670	                    # renormalize over usable strata; a target with ZERO usable
   671	                    # strata drops from the usable estimand (counted once, below)
   672	                    success = predicate(subset)
   673	                    per_ts = success.groupby(
   674	                        [subset["cluster"], subset["template_k"]]).mean()
   675	                    per_target = per_ts.groupby(level=0).mean()
   676	                aligned = per_target.reindex(clusters)
   677	                if aligned.dropna().empty:
   678	                    continue
   679	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   680	                rows.append({
   681	                    **key, "endpoint": endpoint, "denominator": denom,
   682	                    "n_strata_scheduled": n_strata,
   683	                    "n_targets_in_scenario": len(present),
   684	                    "n_targets": n_targets,
   685	                    "n_targets_zero_usable_strata": len(zero_usable),
   686	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   687	                    "prespecified_primary": primary, "confirmatory_decision": False,
   688	                })
   689	        # paired census-vs-LS difference, target-clustered (nominal arm B only)
   690	        if (key["arm"] == "B" and is_nominal
   691	                and "census_variable" in usable_rows
   692	                and usable_rows["census_variable"].notna().any()):
   693	            paired = usable_rows[usable_rows["census_variable"].notna()]
   694	            c_only = paired["census_variable"].astype(bool) & (
   695	                paired["best_status"] != "confirmed")
   696	            l_only = (~paired["census_variable"].astype(bool)) & (
   697	                paired["best_status"] == "confirmed")
   698	            diff = (c_only.astype(float) - l_only.astype(float)).groupby(
   699	                paired["cluster"]).mean()
   700	            aligned = diff.reindex(clusters)
   701	            if not aligned.dropna().empty:
   702	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   703	                rows.append({
   704	                    **key, "endpoint": "paired_census_minus_ls_discordance",
   705	                    "denominator": "usable", "n_strata_scheduled": n_strata,
   706	                    "n_targets_in_scenario": len(present), "n_targets": n_targets,
   707	                    "n_targets_zero_usable_strata": len(zero_usable),
   708	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   709	                    "prespecified_primary": False, "confirmatory_decision": False,
   710	                })
   711	
   712	    # PAIRED contrasts (G3 round-3, both reviewers): every non-nominal arm-B
   713	    # scenario vs nominal K=1 on the IDENTICAL target set, one row per target
   714	    # on each side, ONE common draw matrix for both vectors and their
   715	    # difference; usable denominator = targets usable on BOTH sides;
   716	    # eligible denominator keeps missing rows as failures on both sides
   717	    def boot_mean(vec: pd.Series) -> tuple[float, float, float]:
   718	        values = vec.to_numpy(dtype=float)
   719	        observed = values[~np.isnan(values)]
   720	        if observed.size == 0:
   721	            return math.nan, math.nan, math.nan
   722	        boots = []
   723	        for b in range(BOOTSTRAP_B):
   724	            sample = values[draws[b]]
   725	            sample = sample[~np.isnan(sample)]
   726	            if sample.size:
   727	                boots.append(float(sample.mean()))
   728	        return (float(observed.mean()), float(np.quantile(boots, 0.025)),
   729	                float(np.quantile(boots, 0.975)))
   730	
   731	    contrasts = []
   732	    b_rows = frame[frame["arm"] == "B"]
   733	    nominal_k1 = b_rows[(b_rows["scenario"] == "nominal") & (b_rows["template_k"] == 1)]
   734	    for keys, scenario in b_rows[b_rows["scenario"] != "nominal"].groupby(scenario_cols):
   735	        key = dict(zip(scenario_cols, keys))
   736	        key["dominant_dropped"] = bool(key["dominant_dropped"])
   737	        if scenario["cluster"].duplicated().any():
   738	            raise SystemExit(f"scenario {key['scenario']} holds more than one row per target")
   739	        targets = set(scenario["cluster"])
   740	        nom = nominal_k1[nominal_k1["cluster"].isin(targets)]
   741	        if set(nom["cluster"]) != targets or nom["cluster"].duplicated().any():
   742	            raise SystemExit(f"nominal K=1 rows do not match the {key['scenario']} target set")
   743	        for endpoint, predicate in endpoints.items():
   744	            for denom in ("usable", "eligible"):
   745	                if denom == "usable":
   746	                    both = (set(scenario.loc[scenario["best_status"] != "missing", "cluster"])
   747	                            & set(nom.loc[nom["best_status"] != "missing", "cluster"]))
   748	                    s_, n_ = scenario[scenario["cluster"].isin(both)], nom[nom["cluster"].isin(both)]
   749	                else:
   750	                    s_, n_ = scenario, nom
   751	                if s_.empty:
   752	                    continue
   753	                ys = (predicate(s_) & (s_["best_status"] != "missing")).astype(float) \
   754	                    .groupby(s_["cluster"]).mean().reindex(clusters)
   755	                yn = (predicate(n_) & (n_["best_status"] != "missing")).astype(float) \
   756	                    .groupby(n_["cluster"]).mean().reindex(clusters)
   757	                ps, lo_s, hi_s = boot_mean(ys)
   758	                pn, lo_n, hi_n = boot_mean(yn)
   759	                diff_vec = ys - yn
   760	                pd_, lo_d, hi_d = boot_mean(diff_vec)
   761	                observed = diff_vec.dropna()
   762	                interval = "paired_cluster_bootstrap_common_draws"
   763	                discordance_u95 = math.nan
   764	                if len(observed) and (observed == 0).all():
   765	                    # Amendment 4: zero observed discordances is NOT evidence of
   766	                    # equivalence — report the exact one-sided CP bound on the
   767	                    # discordance probability and the conservative effect bound
   768	                    _, discordance_u95 = cp_one_sided_bounds(0, len(observed))
   769	                    lo_d, hi_d = -discordance_u95, discordance_u95
   770	                    interval = "cp_discordance_bound"
   771	                contrasts.append({
   772	                    **key, "endpoint": endpoint, "denominator": denom,
   773	                    "contrast": "scenario_minus_nominal_k1",
   774	                    "n_targets_matched": int(ys.notna().sum()),
   775	                    "p_scenario": ps, "lo_scenario": lo_s, "hi_scenario": hi_s,
   776	                    "p_nominal_k1": pn, "lo_nominal_k1": lo_n, "hi_nominal_k1": hi_n,
   777	                    "diff": pd_, "diff_lo": lo_d, "diff_hi": hi_d,
   778	                    "discordance_u95": discordance_u95,
   779	                    "interval": interval,
   780	                    "prespecified_primary": False, "confirmatory_decision": False,
   781	                })
   782	    return pd.DataFrame(rows), pd.DataFrame(contrasts)
