   733	    nominal_k1 = b_rows[(b_rows["scenario"] == "nominal") & (b_rows["template_k"] == 1)]
   734	    for keys, scenario in b_rows[b_rows["scenario"] != "nominal"].groupby(scenario_cols):
   735	        key = dict(zip(scenario_cols, keys))
   736	        key["dominant_dropped"] = bool(key["dominant_dropped"])
   737	        if scenario["cluster"].duplicated().any():
   738	            raise SystemExit(f"scenario {key['scenario']} holds more than one row per target")
   739	        targets = set(scenario["cluster"])
   740	        nom = nominal_k1[nominal_k1["cluster"].isin(targets)]
   741	        if set(nom["cluster"]) != targets or nom["cluster"].duplicated().any():
   742	            raise SystemExit(f"nominal K=1 rows do not match the {key['scenario']} target set")
   743	        for endpoint, predicate in endpoints.items():
   744	            for denom in ("usable", "eligible"):
   745	                if denom == "usable":
   746	                    both = (set(scenario.loc[scenario["best_status"] != "missing", "cluster"])
   747	                            & set(nom.loc[nom["best_status"] != "missing", "cluster"]))
   748	                    s_, n_ = scenario[scenario["cluster"].isin(both)], nom[nom["cluster"].isin(both)]
   749	                else:
   750	                    s_, n_ = scenario, nom
   751	                if s_.empty:
   752	                    continue
   753	                ys = (predicate(s_) & (s_["best_status"] != "missing")).astype(float) \
   754	                    .groupby(s_["cluster"]).mean().reindex(clusters)
   755	                yn = (predicate(n_) & (n_["best_status"] != "missing")).astype(float) \
   756	                    .groupby(n_["cluster"]).mean().reindex(clusters)
   757	                ps, lo_s, hi_s = boot_mean(ys)
   758	                pn, lo_n, hi_n = boot_mean(yn)
   759	                diff_vec = ys - yn
   760	                pd_, lo_d, hi_d = boot_mean(diff_vec)
   761	                observed = diff_vec.dropna()
   762	                interval = "paired_cluster_bootstrap_common_draws"
   763	                discordance_u95 = math.nan
   764	                if len(observed) and (observed == 0).all():
   765	                    # Amendment 4: zero observed discordances is NOT evidence of
   766	                    # equivalence — report the exact one-sided CP bound on the
   767	                    # discordance probability and the conservative effect bound
   768	                    _, discordance_u95 = cp_one_sided_bounds(0, len(observed))
   769	                    lo_d, hi_d = -discordance_u95, discordance_u95
   770	                    interval = "cp_discordance_bound"
   771	                contrasts.append({
   772	                    **key, "endpoint": endpoint, "denominator": denom,
   773	                    "contrast": "scenario_minus_nominal_k1",
   774	                    "n_targets_matched": int(ys.notna().sum()),
   775	                    "p_scenario": ps, "lo_scenario": lo_s, "hi_scenario": hi_s,
   776	                    "p_nominal_k1": pn, "lo_nominal_k1": lo_n, "hi_nominal_k1": hi_n,
   777	                    "diff": pd_, "diff_lo": lo_d, "diff_hi": hi_d,
   778	                    "discordance_u95": discordance_u95,
   779	                    "interval": interval,
   780	                    "prespecified_primary": False, "confirmatory_decision": False,
   781	                })
   782	    return pd.DataFrame(rows), pd.DataFrame(contrasts)
   783	
   784	
   785	def surface_cells(frame: pd.DataFrame, success: pd.Series,
   786	                  x_values: pd.Series, edges: list[float],
   787	                  x_name: str) -> list[dict]:
   788	    """Half-open [lo, hi) bins; bin 0 = underflow, bin len(edges) = overflow;
   789	    NaN x -> bin -1 ("unknown"). Cells below MIN_CELL: counts only."""
   790	    bins = np.where(np.isfinite(x_values), np.digitize(x_values, edges), -1)
   791	    rows = []
   792	    for b, idx in frame.groupby(bins).groups.items():
   793	        k = int(success.loc[idx].sum())
   794	        n = len(idx)
   795	        entry = {x_name: int(b), "n": n, "k": k}
   796	        if n >= MIN_CELL:
   797	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   798	        rows.append(entry)
   799	    return rows
   800	
   801	
   802	def surfaces(per_star: pd.DataFrame, dataset: str) -> dict[str, pd.DataFrame]:
   803	    if dataset == "d1":
   804	        return {}  # no amplitude axis for D1 (spec)
   805	    out: dict[str, pd.DataFrame] = {}

