   206	def test_epochs_round_trip_bitwise_through_frozen_loader(generation):
   207	    manifest = pd.read_csv(generation["out"] / "shard_manifest.csv", dtype={"campaign_id": str})
   208	    row = manifest[(manifest["arm"] == "B") & (manifest["scenario"] == SCENARIO_NOMINAL)].iloc[0]
   209	    template = load_star(generation["stars"] / f"{row.template_source_id}.csv.gz")
   210	    shard = load_star(generation["out"] / f"{row.campaign_id}.csv.gz")
   211	    for column in ("mjd", "bjd_tdb", "night_mjd", "magerr"):
   212	        assert np.array_equal(template[column].to_numpy(), shard[column].to_numpy()), column
   213	    assert not np.array_equal(template["mag"].to_numpy(), shard["mag"].to_numpy())
   214	    with gzip.open(generation["out"] / f"{row.campaign_id}.csv.gz", "rt") as handle:
   215	        header = handle.readline().strip().split(",")
   216	    assert header == list(EXPOSURE_COLUMNS)
