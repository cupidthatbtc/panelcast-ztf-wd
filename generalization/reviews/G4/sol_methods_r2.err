   219	def test_truth_d2_consumes_default_manifest_and_refuses_tampering(generation, tmp_path):
   220	    out = generation["out"]
   221	    with pytest.raises(SystemExit):
   222	        metrics.truth_d2(out, pilot=False)           # non-production needs a pilot
   223	    truth, gen = metrics.truth_d2(out, pilot=True)
   224	    assert len(truth) == gen["n_shards"]
   225	    for column in ("scenario", "dominant_dropped", "n_strata_scheduled", "null_serial",
   226	                   "phase_draw", "amp_scale", "shard_sha256"):
   227	        assert column in truth
   228	    ab = truth[truth["label_positive"]]
   229	    assert ab["freq_scorable"].all() and ab["primary_freq"].notna().all()
   230	    assert (truth.loc[truth["arm"] == "gauss_null", "null_serial"] >= 0).all()
   231	    # tamper: copy the generation and flip one byte of one shard
   232	    import shutil
   233	    copy = tmp_path / "tampered"
   234	    shutil.copytree(out, copy)
   235	    victim = next(copy.glob("92*.csv.gz"))
   236	    data = bytearray(victim.read_bytes())
   237	    data[-1] ^= 0x01
   238	    victim.write_bytes(bytes(data))
   239	    with pytest.raises(SystemExit):
   240	        metrics.truth_d2(copy, pilot=True)
   241	    # sentinel refusal
   242	    sentinel = tmp_path / "inprogress"
   243	    shutil.copytree(out, sentinel)
   244	    (sentinel / "IN_PROGRESS").write_text("x")
   245	    with pytest.raises(SystemExit):
   246	        metrics.truth_d2(sentinel, pilot=True)
   247	
