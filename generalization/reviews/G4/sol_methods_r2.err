   329	# ------------------------------------------------------- ids + row semantics
   330	
   331	def all_scenarios() -> set[str]:
   332	    ladder = {f"ladder_g{gi}r{ri}" for gi in (1, 2, 3) for ri in (1, 2, 3)} - {"ladder_g2r2"}
   333	    return ({SCENARIO_NOMINAL, SCENARIO_DROPOUT, "redilution", SCENARIO_CADENCE_ALT,
   334	             "phase_1", "phase_2", "ampscale_0.7", "ampscale_1.3",
   335	             SCENARIO_CONTROL, SCENARIO_NULL} | ladder)
   336	
   337	
   338	def campaign_id(arm_prefix: str, tic: int, k: int, g_idx: int, r_idx: int,
   339	                phase_draw: int = 0, amp_code: int = 0,
   340	                crowd_code: int = CROWD_CODE_NONE,
   341	                cadence_code: int = CADENCE_CODE_NOMINAL) -> str:
   342	    """Layout AA TTTTTTTTTT K G R P S C D (D = cadence code, Amendment 3)."""
   343	    sid = (f"{arm_prefix}{tic:010d}{k}{g_idx}{r_idx}"
   344	           f"{phase_draw}{amp_code}{crowd_code}{cadence_code}")
   345	    if len(sid) != 19 or not sid.isdigit():
   346	        raise ValueError(f"malformed campaign id {sid}")
   347	    return sid
   348	
   349	
   350	def control_id(pool_index: int) -> str:
   351	    return "95" + str(int(pool_index)).zfill(17)
   352	
   353	
   354	def null_id(serial: int) -> str:
   355	    return "94" + str(int(serial)).zfill(17)
   356	
   357	
   358	def production_reasons(arms: set[str], limit, n_nulls: int, expected_pool: int,
   359	                       n_targets_input: int) -> list[str]:
   360	    """Empty list == production generation. Every reason is a hard fact about
   361	    the arguments, never about the outcome."""
   362	    reasons = []
   363	    missing = sorted(set(MANDATORY_PRODUCTION_ARMS) - set(arms))
   364	    if missing:
   365	        reasons.append(f"arms missing {missing}")
   366	    if limit is not None:
   367	        reasons.append("limit")
   368	    if n_nulls != N_NULLS_PRODUCTION:
   369	        reasons.append("n_nulls")
   370	    if expected_pool != POOL_SIZE_PRODUCTION:
   371	        reasons.append("pool")
   372	    if n_targets_input != TARGETS_PRODUCTION:
   373	        reasons.append(f"targets {n_targets_input} != {TARGETS_PRODUCTION}")
   374	    return reasons
   375	
   376	
   377	def _row_problem(r) -> str:
   378	    """Semantic invariants of ONE manifest row (G3 methods round-2 new MAJOR):
   379	    enumerations, per-arm defaults, scenario recomputed from its fields, and
   380	    the campaign id recomputed from its fields."""
   381	    if r.arm not in ARMS:
   382	        return f"arm {r.arm!r}"
   383	    if r.scenario not in all_scenarios():
   384	        return f"scenario {r.scenario!r}"
   385	    if not (isinstance(r.shard_sha256, str) and len(r.shard_sha256) == 64):
   386	        return "shard_sha256"
   387	    if r.arm in ("A", "B"):
   388	        if r.tic <= 0 or r.template_k not in (0, 1, 2) or r.pool_index < 0:
   389	            return "tic/template_k/pool_index"
   390	        if r.ratio_g not in BANDPASS_LADDER_G or r.ratio_rg not in BANDPASS_LADDER_RG:
   391	            return "ratios"
   392	        if r.phase_draw not in (0, 1, 2) or r.amp_scale not in AMP_SCALES:
   393	            return "phase_draw/amp_scale"
   394	        # absence is NaN EXACTLY; any present value must be finite and in range
   395	        # (G3 methods round-4: inf must not read as "absent")
   396	        crowd_present = not math.isnan(r.crowdsap)
   397	        if crowd_present and not (math.isfinite(r.crowdsap) and 0.0 < r.crowdsap <= 1.0):
   398	            return "crowdsap must be NaN (absent) or finite in (0, 1]"
   399	        crowd = CROWD_CODE_REDILUTION if crowd_present else CROWD_CODE_NONE
   400	        if r.match not in MATCH_LABELS or r.template_status not in BLIND_STATUSES:
   401	            return "match/template_status vocabulary"
   402	        if r.cadence_code not in (CADENCE_CODE_NOMINAL, CADENCE_CODE_ALT) or r.cadence_s not in CADENCES_S:
   403	            return "cadence_code/cadence_s"
   404	        # sensitivity axes are MUTUALLY EXCLUSIVE: nominal = no axis, every other
   405	        # scenario = exactly one axis (G3 methods round-3: precedence must not
   406	        # hide crossed axes)
   407	        axes = [not (r.ratio_g == NOMINAL_G and r.ratio_rg == NOMINAL_RG),
   408	                r.phase_draw != 0, r.amp_scale != 1.0, bool(r.dominant_dropped),
   409	                crowd == CROWD_CODE_REDILUTION, r.cadence_code == CADENCE_CODE_ALT]
   410	        if sum(axes) != (0 if r.scenario == SCENARIO_NOMINAL else 1):
   411	            return "crossed or missing sensitivity axes for this scenario"
   412	        if r.cadence_code == CADENCE_CODE_ALT and (
   413	                r.cadence_s != CADENCE_ALT_S or r.arm != "B" or crowd != CROWD_CODE_NONE
   414	                or bool(r.dominant_dropped) or r.phase_draw != 0 or r.amp_scale != 1.0
   415	                or r.ratio_g != NOMINAL_G or r.ratio_rg != NOMINAL_RG):
   416	            return "cadence_alt must be arm B, nominal ratios/phase/scale, no dropout/crowding, 120 s"
   417	        if scenario_code(r.ratio_g, r.ratio_rg, r.phase_draw, r.amp_scale,
   418	                         bool(r.dominant_dropped), crowd, r.cadence_code) != r.scenario:
   419	            return "scenario inconsistent with its fields"
   420	        dropped_present = not math.isnan(r.dropped_period_s)
   421	        if dropped_present and not (math.isfinite(r.dropped_period_s) and r.dropped_period_s > 0.0):
   422	            return "dropped_period_s must be NaN (absent) or a finite positive period"
   423	        if bool(r.dominant_dropped) != dropped_present:
   424	            return "dropped_period_s"
   425	        if r.n_strata_scheduled != (3 if r.scenario == SCENARIO_NOMINAL else 1):
   426	            return "n_strata_scheduled"
   427	        if r.template_wg_contrasts < 0:
   428	            return "template_wg_contrasts"
   429	        if r.scenario != SCENARIO_NOMINAL and r.template_k != 1:
   430	            return "sensitivity scenarios run on the median window only"
   431	        if r.arm == "A" and r.scenario != SCENARIO_NOMINAL:
   432	            return "arm A is nominal-only"
   433	        if (r.arm == "B") != bool(r.control_campaign_id):
   434	            return "control_campaign_id"
   435	        if r.arm == "B" and r.control_campaign_id != control_id(r.pool_index):
   436	            return "control_campaign_id value"
   437	        if r.null_serial != -1 or r.n_modes_injected < 1:
   438	            return "null_serial/n_modes_injected"
   439	        amp_code = AMP_SCALE_CODE_DROPOUT if r.dominant_dropped else AMP_SCALE_CODES[r.amp_scale]
   440	        expected = campaign_id("92" if r.arm == "B" else "93", int(r.tic), int(r.template_k),
   441	                               BANDPASS_LADDER_G.index(r.ratio_g) + 1,
   442	                               BANDPASS_LADDER_RG.index(r.ratio_rg) + 1,
   443	                               int(r.phase_draw), amp_code, crowd, int(r.cadence_code))
   444	        if r.campaign_id != expected:
   445	            return f"campaign_id {r.campaign_id} != {expected}"
   446	        return ""
   447	    # controls and Gaussian nulls
   448	    if r.tic != 0 or r.template_k != -1 or r.pool_index < 0:
   449	        return "ctrl/null tic/template_k/pool_index"
   450	    if r.template_wg_contrasts < 0:
   451	        return "ctrl/null template_wg_contrasts"
   452	    if r.match != "" or r.template_status not in BLIND_STATUSES:
   453	        return "ctrl/null match/template_status"
   454	    if r.ratio_g != 0.0 or r.ratio_rg != 0.0 or r.phase_draw != 0 or bool(r.dominant_dropped):
   455	        return "ctrl/null defaults"
   456	    if r.n_strata_scheduled != 0 or r.n_modes_injected != 0 or r.n_modes_rejected != 0:
   457	        return "ctrl/null counts"
   458	    if r.control_campaign_id != "" or not math.isnan(r.crowdsap) or not math.isnan(r.dropped_period_s):
   459	        return "ctrl/null empties (absent floats must be NaN exactly)"
   460	    if r.cadence_code != 0 or r.cadence_s != 0.0:
   461	        return "ctrl/null cadence fields"
   462	    if r.arm == "ctrl":
   463	        if r.scenario != SCENARIO_CONTROL or r.amp_scale != 1.0 or r.null_serial != -1:
   464	            return "control fields"
   465	        if r.campaign_id != control_id(r.pool_index):
   466	            return "control id"
   467	    else:
   468	        if r.scenario != SCENARIO_NULL or r.amp_scale != 0.0 or r.null_serial < 0:
   469	            return "null fields"
   470	        if r.campaign_id != null_id(r.null_serial):
   471	            return "null id"
   472	    return ""
