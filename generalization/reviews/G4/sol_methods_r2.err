    51	def fake_window(sid: str, seed: int, gmag: float, exp_per_night: int) -> pd.DataFrame:
    52	    rng = np.random.default_rng(seed)
    53	    rows = []
    54	    for band, offset in (("zg", 0.0), ("zr", 0.31)):
    55	        for night in range(24):
    56	            for k in range(exp_per_night if night % 2 else 1):
    57	                mjd = 58200.0 + night * 3.3 + k * 0.0123456789 + rng.uniform(0, 0.01)
    58	                rows.append({
    59	                    "source_id": sid, "band": band, "oid": 500000000000000 + seed,
    60	                    "mjd": mjd, "bjd_tdb": mjd + 2400000.5 + 0.0049876543 + offset * 1e-5,
    61	                    "night_mjd": int(mjd), "mag": gmag + offset + rng.normal(0, 0.02),
    62	                    "magerr": 0.015 + rng.uniform(0, 0.01), "chi": 0.93,
    63	                    "ra": 50.2877149, "dec": 14.1822509,
    64	                })
    65	    frame = pd.DataFrame(rows).sort_values(["band", "bjd_tdb"]).reset_index(drop=True)
    66	    return frame[list(EXPOSURE_COLUMNS)]
