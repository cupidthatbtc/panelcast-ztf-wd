   441	def census_from_shard(shard_path: Path) -> dict:
   442	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   443	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   444	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   445	                           n_variants=0, known_roster=False, wd_class="",
   446	                           paper_variable=None, paper_periodic=None)
   447	    nightly = nightly_panel(frame)
   448	    monthly = monthly_panel(nightly)
   449	    row = census_row(meta, frame, nightly, monthly)
   450	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   451	                for c in ("exposure", "nightly", "monthly")):
   452	        if row.get(key) == 2.5:
   453	            raise SystemExit(f"census ratio exactly 2.5 for {shard_path} — spec guard")
   454	    return {"census_variable": bool(row["census_variable"]),
   455	            "census_g_nightly": bool(row["census_g_nightly"])}
