   249	@pytest.mark.parametrize("victim,edit", [
   250	    ("shard_manifest.csv", lambda t: t.replace(",dropout,", ",nominal,", 1)),
   251	    ("injected_modes.csv", lambda t: t.replace("\n", "\n", 1)[:-1] + "1\n"),   # perturb the last frequency digit
   252	    ("rejected_modes.csv", lambda t: t + "9200000000110220000,999.0,1.0,0.5\n"),
   253	    ("shard_index.txt", lambda t: t + "9200000000990220000\n"),
   254	    ("excluded_targets.csv", lambda t: t + "44,made up,1\n"),
   255	])
   256	def test_truth_tables_are_sha_bound(generation, tmp_path, victim, edit):
   257	    import shutil
   258	    copy = tmp_path / ("tamper_" + victim.replace(".", "_"))
   259	    shutil.copytree(generation["out"], copy)
   260	    text = (copy / victim).read_text()
   261	    (copy / victim).write_text(edit(text))
   262	    with pytest.raises(SystemExit):
   263	        metrics.truth_d2(copy, pilot=True)
