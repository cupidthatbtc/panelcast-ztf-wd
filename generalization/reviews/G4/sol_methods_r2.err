   474	
   475	def validate_manifest_frame(frame: pd.DataFrame) -> None:
   476	    """Shared by the builder (before publishing) and the metrics reader
   477	    (before consuming): schema, uniqueness, typed columns, and every row's
   478	    semantic invariants. Raises SystemExit with the first offending row."""
   479	    if list(frame.columns) != list(MANIFEST_COLUMN_NAMES):
   480	        raise SystemExit("manifest columns deviate from MANIFEST_COLUMNS")
   481	    if frame.empty:
   482	        raise SystemExit("empty manifest")
   483	    if frame["campaign_id"].duplicated().any():
   484	        dup = frame.loc[frame["campaign_id"].duplicated(), "campaign_id"].head(3).tolist()
   485	        raise SystemExit(f"duplicate campaign ids {dup}")
   486	    for name, kind in MANIFEST_COLUMNS:
   487	        if kind in ("int", "bool") and frame[name].isna().any():
   488	            raise SystemExit(f"manifest column {name} has NaN")
   489	    for r in frame.itertuples(index=False):
   490	        problem = _row_problem(r)
   491	        if problem:
   492	            raise SystemExit(f"manifest row {r.campaign_id}: {problem}")
   493	    nulls = frame[frame["arm"] == SCENARIO_NULL]
   494	    if not nulls.empty and sorted(nulls["null_serial"].tolist()) != list(range(len(nulls))):
   495	        raise SystemExit("null serials are not exactly 0..N-1")
   496	
   497	
   498	def expected_counts(frame: pd.DataFrame, scheduled_tics: list[int],
   499	                    dropout_eligible: list[int], redilution_tics: list[int],
   500	                    n_nulls: int, arms: set[str],
   501	                    cadence_alt_tics: list[int] | None = None) -> dict[str, int]:
   502	    """The run-matrix counts a generation MUST realize, from the schedule
   503	    alone (never from the outcome); asserted by builder and metrics."""
   504	    n = len(scheduled_tics)
   505	    counts: dict[str, int] = {}
   506	    if "b" in arms:
   507	        counts["B:nominal"] = 3 * n
   508	    if "a" in arms:
   509	        counts["A:nominal"] = 3 * n
   510	    if "ladder" in arms:
   511	        for gi in (1, 2, 3):
   512	            for ri in (1, 2, 3):
   513	                if (gi, ri) != (2, 2):
   514	                    counts[f"B:ladder_g{gi}r{ri}"] = n
   515	    if "phase" in arms:
   516	        counts["B:phase_1"] = n
   517	        counts["B:phase_2"] = n
   518	    if "ampscale" in arms:
   519	        counts["B:ampscale_0.7"] = n
   520	        counts["B:ampscale_1.3"] = n
   521	    if "dropout" in arms:
   522	        counts["B:dropout"] = len(dropout_eligible)
   523	    if "redilution" in arms:
   524	        counts["B:redilution"] = len(redilution_tics)
   525	    if "cadence_alt" in arms:
   526	        counts["B:cadence_alt"] = len(cadence_alt_tics or [])
   527	    if "ctrl" in arms:
   528	        counts["ctrl:control"] = int(frame.loc[frame["arm"] == "B", "template_source_id"].nunique())
   529	    if "nulls" in arms:
   530	        counts["gauss_null:gauss_null"] = n_nulls
   531	    return counts
   532	
   533	
   534	def assert_counts(frame: pd.DataFrame, counts: dict[str, int]) -> None:
   535	    realized = frame.groupby(["arm", "scenario"]).size()
   536	    realized = {f"{a}:{sc}": int(v) for (a, sc), v in realized.items()}
   537	    if realized != counts:
   538	        missing = {k: v for k, v in counts.items() if realized.get(k) != v}
   539	        extra = {k: v for k, v in realized.items() if k not in counts}
   540	        raise SystemExit(f"run matrix mismatch: expected-but-different {missing}; unexpected {extra}")
   541	
   542	
   543	def check_cadence_alt_schedule(mixed_from_v3: list[int], scheduled_alt: list[int],
   544	                               production: bool) -> None:
   545	    """Amendment 3 cardinality/identity (G3 round-3, both reviewers): in
   546	    production the realized cadence_alt target set must equal the SPOC v3
   547	    mixed-cadence set and count exactly MIXED_CADENCE_TARGETS_PRODUCTION;
   548	    outside production it must still be a subset."""
   549	    mixed, alt = set(int(t) for t in mixed_from_v3), set(int(t) for t in scheduled_alt)
   550	    if len(alt) != len(list(scheduled_alt)):
   551	        raise SystemExit("duplicate cadence_alt targets")
   552	    if not alt <= mixed:
   553	        raise SystemExit(f"cadence_alt scheduled for non-mixed targets {sorted(alt - mixed)[:3]}")
   554	    if production:
   555	        if len(mixed) != MIXED_CADENCE_TARGETS_PRODUCTION or len(list(mixed_from_v3)) != len(mixed):
   556	            raise SystemExit(f"SPOC v3 lists {len(mixed)} unique mixed-cadence targets, "
   557	                             f"expected {MIXED_CADENCE_TARGETS_PRODUCTION}")
   558	        if alt != mixed:
   559	            raise SystemExit(f"production requires every mixed-cadence target scheduled in "
   560	                             f"cadence_alt: missing {sorted(mixed - alt)[:3]}")
   561	
   562	
   563	def check_wg_strata(frame: pd.DataFrame, production: bool) -> list[str]:
   564	    """Amendment 4: the three nominal windows of every target must carry
   565	    strictly increasing W_g (K0 < K1 < K2). Production refuses violations;
   566	    otherwise the violating targets are returned for the record."""
   567	    nominal = frame[(frame["arm"].isin(["A", "B"])) & (frame["scenario"] == SCENARIO_NOMINAL)]
   568	    violations = []
   569	    for tic, g in nominal.drop_duplicates(["tic", "template_k"]).groupby("tic"):
   570	        w = g.sort_values("template_k")["template_wg_contrasts"].tolist()
   571	        if len(w) != 3 or not (w[0] < w[1] < w[2]):
   572	            violations.append(f"TIC {tic}: W_g by K = {w}")
   573	    if production and violations:
   574	        raise SystemExit(f"W_g strata not strictly increasing for {len(violations)} targets: {violations[:3]}")
   575	    return violations

