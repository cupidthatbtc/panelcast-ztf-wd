   266	def test_manifest_semantics_are_enforced(generation):
   267	    manifest = metrics.load_d2_manifest(generation["out"])
   268	    validate_manifest_frame(manifest)                       # the real one passes
   269	    bad = manifest.copy()
   270	    bad.loc[bad.index[0], "scenario"] = "garbage"
   271	    with pytest.raises(SystemExit):
   272	        validate_manifest_frame(bad)
   273	    bad = manifest.copy()
   274	    idx = bad.index[(bad["arm"] == "B") & (bad["scenario"] == "dropout")][0]
   275	    bad.loc[idx, "dominant_dropped"] = False                 # dropout row claiming not dropped
   276	    with pytest.raises(SystemExit):
   277	        validate_manifest_frame(bad)
   278	    bad = manifest.copy()
   279	    idx = bad.index[(bad["arm"] == "B") & (bad["scenario"] == SCENARIO_NOMINAL)][0]
   280	    bad.loc[idx, "n_strata_scheduled"] = 99
   281	    with pytest.raises(SystemExit):
   282	        validate_manifest_frame(bad)
   283	    bad = manifest.copy()
   284	    idx = bad.index[bad["arm"] == "gauss_null"][0]
   285	    bad.loc[idx, "amp_scale"] = 1.0                          # a null with amplitude
   286	    with pytest.raises(SystemExit):
   287	        validate_manifest_frame(bad)
   288	    # crossed sensitivity axes with a self-consistent id and scenario must still be refused
   289	    bad = manifest.copy()
   290	    idx = bad.index[(bad["arm"] == "B") & (bad["scenario"] == "ladder_g3r1")][0]
   291	    bad.loc[idx, "phase_draw"] = 1
   292	    bad.loc[idx, "amp_scale"] = 0.7
   293	    bad.loc[idx, "campaign_id"] = campaign_id("92", int(bad.loc[idx, "tic"]), 1, 3, 1, 1, 1, 0, 0)
   294	    with pytest.raises(SystemExit):
   295	        validate_manifest_frame(bad)
   296	    bad = manifest.copy()
   297	    idx = bad.index[bad["scenario"] == "redilution"][0]
   298	    bad.loc[idx, "crowdsap"] = 1.5
   299	    with pytest.raises(SystemExit):
   300	        validate_manifest_frame(bad)
   301	    # non-finite sentinels never read as "absent" (round-4 MAJOR)
   302	    for column, victim_query in (("crowdsap", (manifest["scenario"] == SCENARIO_NOMINAL) & (manifest["arm"] == "B")),
   303	                                 ("dropped_period_s", manifest["scenario"] == SCENARIO_NOMINAL),
   304	                                 ("crowdsap", manifest["arm"] == "ctrl"),
   305	                                 ("dropped_period_s", manifest["arm"] == "gauss_null")):
   306	        for sentinel in (float("inf"), float("-inf")):
   307	            bad = manifest.copy()
   308	            bad.loc[bad.index[victim_query][0], column] = sentinel
   309	            with pytest.raises(SystemExit):
   310	                validate_manifest_frame(bad)
   311	    bad = manifest.copy()
   312	    idx = bad.index[bad["scenario"] == "dropout"][0]
   313	    bad.loc[idx, "dropped_period_s"] = float("nan")          # dropout row claiming absence
   314	    with pytest.raises(SystemExit):
   315	        validate_manifest_frame(bad)
   316	    bad = manifest.copy()
   317	    idx = bad.index[bad["scenario"] == "redilution"][0]
   318	    bad.loc[idx, "crowdsap"] = float("nan")                  # redilution row claiming absence
   319	    with pytest.raises(SystemExit):
   320	        validate_manifest_frame(bad)
