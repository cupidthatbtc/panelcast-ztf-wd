    45	CHANCE_MATCH_SEED = 20260829
    46	BOOTSTRAP_B = 2000
    47	BOOTSTRAP_SEED = 20260830
    48	MIN_CELL = 5
    49	PERIOD_EDGES_DAYS = [100 / 86400, 200 / 86400, 500 / 86400, 1000 / 86400,
    50	                     2000 / 86400, 0.05, 0.2, 1.0, 10.0, 100.0]
    51	AMP_EDGES = {"d1": [0.5, 1, 2, 5, 10, 20, 50, 200],
    52	             "d3": [0.5, 1, 2, 5, 10, 20, 50, 200],
    53	             "d2": [0.5, 2, 5, 10, 30, 100]}
