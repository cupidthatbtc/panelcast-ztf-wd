import pandas as pd
from pathlib import Path
p=Path(\".\")
targets=pd.read_csv(p/\"generalization/data/d2/d2_targets.csv\")
cat=pd.read_csv(p/\"catalog-rebuild/results/2026-08-01_full/catalog/ls_full_catalog.csv\",dtype={\"source_id\":str})
ex=pd.read_csv(p/\"catalog-rebuild/results/2026-08-01_full/data/exposures.csv.gz\",dtype={\"source_id\":str,\"band\":str},usecols=[\"source_id\",\"band\",\"mag\",\"night_mjd\"])
ex=ex[ex.source_id.isin(set(cat.source_id))]
zg=ex[ex.band==\"zg\"]
stats=zg.groupby(\"source_id\").agg(median_zg=(\"mag\",\"median\"))
epn=zg.groupby([\"source_id\",\"night_mjd\"]).size().groupby(\"source_id\").median().rename(\"exp_per_night\")
stats=stats.join(epn).reset_index()
def picks(gmag):
    pool=stats[(stats.median_zg-gmag).abs()<=.25]
    if len(pool)<3: pool=stats[(stats.median_zg-gmag).abs()<=.5]
    if len(pool)<3: pool=stats.iloc[(stats.median_zg-gmag).abs().argsort()[:9]]
    o=pool.sort_values([\"exp_per_night\",\"source_id\"]).reset_index(drop=True)
    return [o.iloc[min(len(o)-1,int(round(q*(len(o)-1))))].source_id for q in (.1,.5,.9)]
a=pd.DataFrame([(int(r.tic),k,sid) for r in targets.itertuples() for k,sid in enumerate(picks(float(r.gmag)))],columns=[\"tic\",\"k\",\"sid\"])
reuse=a.groupby(\"sid\").tic.nunique()
