   399	def surfaces(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   400	    positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   401	                         & per_star["freq_scorable"]]
   402	    if positives.empty:
   403	        return pd.DataFrame()
   404	    amp_edges = AMP_EDGES[dataset]
   405	    rows = []
   406	    p_bins = np.digitize(positives["truth_period_days"], PERIOD_EDGES_DAYS)
   407	    a_bins = np.digitize(positives["amp"], amp_edges)
   408	    success = (positives["best_status"] == "confirmed") & (positives["best_match"] == "direct")
   409	    for (pb, ab), idx in positives.groupby([p_bins, a_bins]).groups.items():
   410	        cell = positives.loc[idx]
   411	        k = int(success.loc[idx].sum())
   412	        n = len(cell)
   413	        entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   414	        if n >= MIN_CELL:
   415	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   416	        rows.append(entry)
   417	    return pd.DataFrame(rows)
