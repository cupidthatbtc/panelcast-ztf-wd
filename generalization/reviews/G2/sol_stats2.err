    55	
    56	def wilson(k: float, n: float) -> tuple[float, float, float]:
    57	    if n <= 0:
    58	        return math.nan, math.nan, math.nan
    59	    z = 1.959963984540054
    60	    p = k / n
    61	    denom = 1.0 + z * z / n
    62	    center = (p + z * z / (2 * n)) / denom
    63	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    64	    return p, max(0.0, center - half), min(1.0, center + half)
    65	
    66	
    67	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    68	    total = float(weights.sum())
    69	    if total <= 0:
    70	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    71	    p = float((weights * successes).sum() / total)
    72	    ess = total * total / float((weights * weights).sum())
    73	    _, lo, hi = wilson(p * ess, ess)
    74	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
    75	
    76	
    77	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    78	    classes: set[str] = set()
    79	    for f_t in truth:
    80	        if abs(freq - f_t) <= tol:
    81	            classes.add("direct")
    82	        elif abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    83	            classes.add("harmonic")
    84	        else:
    85	            for k in (1, 2):
    86	                for sign in (1.0, -1.0):
    87	                    if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    88	                        classes.add("window_alias")
    89	    if not classes:
    90	        return "unmatched"
    91	    if len(classes) > 1:
    92	        return "ambiguous"
    93	    return classes.pop()
    94	
    95	
    96	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
    97	    if not truth:
    98	        return False
    99	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   100	    return any(low <= f <= high for f in truth)
   101	
   102	
   103	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   104	    if rule == "confirmed":
   105	        return status == "confirmed"
   106	    if rule == "confirmed_or_candidate":
   107	        return status in ("confirmed", "candidate")
   108	    if rule == "census":
   109	        return None if census_flag is None else bool(census_flag)
   110	    if rule == "either":
   111	        if census_flag is None:
   112	            return status == "confirmed"
   113	        return status == "confirmed" or bool(census_flag)
   114	    raise ValueError(rule)
   115	
   116	
   117	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None) -> dict:
   118	    result = json.loads(json_path.read_text(encoding="utf-8"))
   119	    if not result.get("complete"):
   120	        raise SystemExit(f"{json_path} is not complete")
   121	    passes = result["passes"]
   122	    if set(passes) != {"low", "high"}:
   123	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   124	    baseline = float(result["baseline_days"])
   125	    tol = 1.5 / baseline
   126	    overall = overall_result(result)
   127	
   128	    row: dict = {
   129	        "baseline_days": baseline,
   130	        "n_exp_zg": result["n_exp_zg"],
   131	        "n_exp_zr": result["n_exp_zr"],
   132	        "best_pass": overall["best_pass"],
   133	        "best_status": overall["blind_status"],
   134	        "best_frequency_per_day": overall["best_frequency_per_day"],
   135	        "low_available": passes["low"].get("available", True),
   136	        "high_available": passes["high"].get("available", True),
   137	    }
   138	    any_direct_top = False
   139	    for name in ("low", "high"):
   140	        p = passes[name]
   141	        freq = p.get("frequency_per_day")
   142	        row[f"{name}_status"] = p["status"]
   143	        row[f"{name}_frequency_per_day"] = freq
   144	        row[f"{name}_match"] = (
   145	            classify_match(float(freq), truth_freqs, tol)
   146	            if freq is not None and truth_freqs else "unscored"
   147	        )
   148	        row[f"{name}_eligible"] = pass_eligible(truth_freqs, name, baseline)
   149	        for peak in p.get("top_peaks", []):
   150	            f_peak = peak.get("frequency_per_day")
   151	            if f_peak is not None and truth_freqs and \
   152	               classify_match(float(f_peak), truth_freqs, tol) == "direct":
   153	                any_direct_top = True
   154	    best_freq = row["best_frequency_per_day"]
   155	    row["best_match"] = (
   156	        classify_match(float(best_freq), truth_freqs, tol)
   157	        if best_freq is not None and truth_freqs else "unscored"
   158	    )
   159	    row["best_match_primary"] = (
   160	        classify_match(float(best_freq), [primary_freq], tol)
   161	        if best_freq is not None and primary_freq is not None else "unscored"
   162	    )
   163	    row["matched_any_mode_diagnostic"] = any_direct_top
   164	    row["eligible_any_pass"] = row["low_eligible"] or row["high_eligible"]
   165	    return row
   166	
   167	
   168	# ---------------------------------------------------------------- truth loaders
   169	
   170	def truth_d1() -> pd.DataFrame:
   171	    roster = pd.read_csv(REPO_ROOT / "data/roster/jestin2026_roster.csv",
   172	                         dtype={"source_id": str})
   173	    lit = pd.read_csv(REPO_ROOT / "data/roster/literature_periods.csv",
   174	                      dtype={"source_id": str})
   175	    freqs = lit.groupby("source_id")["frequency_per_day"].apply(list).to_dict()
   176	    rows = []
   177	    for r in roster.itertuples(index=False):
   178	        truth = freqs.get(r.source_id, [])
   179	        rows.append({
   180	            "sid": r.source_id, "external_id": r.wdj_name,
   181	            "class_label": r.wd_class,
   182	            "label_positive": bool(r.paper_variable),
   183	            "weight": 1.0, "cluster": r.source_id,
   184	            "truth_freqs": truth,
   185	            "primary_freq": truth[0] if truth else None,
   186	            "amp": math.nan, "truth_period_days": 1.0 / truth[0] if truth else math.nan,
   187	            "freq_scorable": bool(truth),
   188	        })
   189	    return pd.DataFrame(rows)
   190	
   191	
   192	def truth_d3() -> pd.DataFrame:
   193	    roster = pd.read_csv(REPO_ROOT / "generalization/data/d3/roster_d3.csv",
   194	                         dtype={"source_id": str})
   195	    mo = pd.read_csv(REPO_ROOT / "generalization/data/d3/raw/mo2026_table2.csv")
   196	    mo["freq_per_day"] = mo["Freq"] * 86400.0 / 1e6
   197	    freq_lists = mo.groupby("KIC")["freq_per_day"].apply(list).to_dict()
   198	    rows = []
   199	    for r in roster.itertuples(index=False):
   200	        kic = int(r.KIC)
   201	        truth = freq_lists.get(kic, [])
   202	        label = None if r.dSct == 2 else bool(r.dSct == 1)
   203	        rows.append({
   204	            "sid": r.source_id, "external_id": r.external_id,
   205	            "class_label": r.class_label, "label_positive": label,
   206	            "weight": float(r.sampling_weight), "cluster": r.source_id,
   207	            "truth_freqs": truth,
   208	            "primary_freq": float(r.dom_freq_per_day)
   209	            if np.isfinite(r.dom_freq_per_day) else None,
   210	            "amp": float(r.amp_mmag),
   211	            "truth_period_days": 1.0 / float(r.dom_freq_per_day)
   212	            if np.isfinite(r.dom_freq_per_day) and r.dom_freq_per_day > 0 else math.nan,
   213	            "freq_scorable": bool(truth) and bool(label),
   214	            "stratum": r.stratum, "near_saturation": bool(r.near_saturation),
   215	            "subhour": bool(r.subhour),
   216	        })
   217	    return pd.DataFrame(rows)
   218	
   219	
   220	def truth_d2(shards_dir: Path) -> pd.DataFrame:
   221	    manifest = pd.read_csv(shards_dir / "shard_manifest.csv",
   222	                           dtype={"campaign_id": str, "template_source_id": str})
   223	    modes = pd.read_csv(REPO_ROOT / "generalization/data/d2/d2_modes.csv")
   224	    freq_lists = (86400.0 / modes.groupby("tic")["period_s"].apply(list).apply(np.array)
   225	                  ).apply(list).to_dict() if False else {
   226	        tic: sorted((86400.0 / np.asarray(group["period_s"])).tolist())
   227	        for tic, group in modes.groupby("tic")
   228	    }
   229	    amp_max = modes.groupby("tic")["amp_ppt"].max().to_dict()
   230	    dominant = {
   231	        tic: float(86400.0 / group.loc[group["amp_ppt"].idxmax(), "period_s"])
   232	        for tic, group in modes.groupby("tic")
   233	    }
   234	    rows = []
   235	    for r in manifest.itertuples(index=False):
   236	        arm = r.arm
   237	        tic = int(r.tic)
   238	        truth = freq_lists.get(tic, []) if arm in ("A", "B") else []
   239	        rows.append({
   240	            "sid": r.campaign_id, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   241	            "class_label": f"arm_{arm}",
   242	            "label_positive": arm in ("A", "B"),
   243	            "weight": 1.0, "cluster": str(tic) if tic else r.campaign_id,
   244	            "truth_freqs": truth,
   245	            "primary_freq": dominant.get(tic) if arm in ("A", "B") else None,
   246	            "amp": float(amp_max.get(tic, math.nan)),
   247	            "truth_period_days": (1.0 / dominant[tic]) if tic in dominant and arm in ("A", "B") else math.nan,
   248	            "freq_scorable": arm in ("A", "B") and bool(truth),
   249	            "arm": arm, "template_k": r.template_k,
   250	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   251	            "template_status": getattr(r, "template_status", ""),
   252	        })
   253	    return pd.DataFrame(rows)
   254	
   255	
   256	# ---------------------------------------------------------- census providers
   257	
   258	def census_lookup_csv(path: Path) -> dict[str, dict]:
   259	    frame = pd.read_csv(path, dtype={"source_id": str})
   260	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   261	    for col in ratio_cols:
   262	        exact = frame[col] == 2.5
   263	        if exact.any():
   264	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   265	    return {
   266	        r["source_id"]: {"census_variable": bool(r["census_variable"]),
   267	                         "census_g_nightly": bool(r["census_g_nightly"])}
   268	        for _, r in frame.iterrows()
   269	    }
   270	
   271	
   272	def census_from_shard(shard_path: Path) -> dict:
   273	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   274	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   275	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   276	                           n_variants=0, known_roster=False, wd_class="",
   277	                           paper_variable=None, paper_periodic=None)
   278	    nightly = nightly_panel(frame)
   279	    monthly = monthly_panel(nightly)
   280	    row = census_row(meta, frame, nightly, monthly)
   281	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   282	                for c in ("exposure", "nightly", "monthly")):
   283	        if row.get(key) == 2.5:
   284	            raise SystemExit(f"census ratio exactly 2.5 for {shard_path} — spec guard")
   285	    return {"census_variable": bool(row["census_variable"]),
   286	            "census_g_nightly": bool(row["census_g_nightly"])}
