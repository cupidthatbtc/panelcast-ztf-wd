   449	def main() -> None:
   450	    parser = argparse.ArgumentParser(description=__doc__)
   451	    parser.add_argument("--dataset", choices=("d1", "d2", "d3"), required=True)
   452	    parser.add_argument("--stars-dir", type=Path, required=True)
   453	    parser.add_argument("--census-csv", type=Path, default=None)
   454	    parser.add_argument("--shards-dir", type=Path, default=None,
   455	                        help="d2: shard dir with shard_manifest.csv; census "
   456	                             "computed from shards when --census-csv absent")
   457	    parser.add_argument("--out-dir", type=Path, required=True)
   458	    args = parser.parse_args()
   459	
   460	    assert_frozen()
   461	    if args.dataset == "d1":
   462	        truth = truth_d1()
   463	    elif args.dataset == "d3":
   464	        truth = truth_d3()
   465	    else:
   466	        if args.shards_dir is None:
   467	            raise SystemExit("d2 needs --shards-dir")
   468	        truth = truth_d2(args.shards_dir)
   469	
   470	    census = census_lookup_csv(args.census_csv) if args.census_csv else {}
   471	    inputs: dict[str, str] = {}
   472	    if args.census_csv:
   473	        inputs[str(args.census_csv)] = sha256_file(args.census_csv)
   474	
   475	    rows = []
   476	    missing = []
   477	    for r in truth.itertuples(index=False):
   478	        json_path = args.stars_dir / f"{r.sid}.json"
   479	        if not json_path.exists():
   480	            missing.append(r.sid)
   481	            continue
   482	        inputs[str(json_path)] = sha256_file(json_path)
   483	        scored = score_star(json_path, list(r.truth_freqs), r.primary_freq)
   484	        record = {**r._asdict(), **scored}
   485	        if r.sid in census:
   486	            record.update(census[r.sid])
   487	        elif args.dataset == "d2" and args.shards_dir is not None:
   488	            record.update(census_from_shard(args.shards_dir / f"{r.sid}.csv.gz"))
   489	        else:
   490	            record["census_variable"] = None
   491	        rows.append(record)
   492	    per_star = pd.DataFrame(rows)
   493	    if per_star.empty:
   494	        raise SystemExit("no stars scored")
   495	
   496	    args.out_dir.mkdir(parents=True, exist_ok=True)
   497	    per_star.drop(columns=["truth_freqs"]).to_csv(
   498	        args.out_dir / "per_star.csv", index=False)
   499	    completeness_tables(per_star, args.dataset).to_csv(
   500	        args.out_dir / "completeness_by_class_pass_rule.csv", index=False)
   501	    (args.out_dir / "contingency_complementarity.json").write_text(
   502	        json.dumps(contingency(per_star), indent=2) + "\n", encoding="utf-8")
   503	    trigger_rates(per_star, args.dataset).to_csv(
   504	        args.out_dir / "trigger_rates.csv", index=False)
   505	    (args.out_dir / "chance_match.json").write_text(
   506	        json.dumps(chance_match_rate(per_star), indent=2) + "\n", encoding="utf-8")
   507	    surface = surfaces(per_star, args.dataset)
   508	    (args.out_dir / "surfaces").mkdir(exist_ok=True)
   509	    surface.to_csv(args.out_dir / "surfaces" / "period_amplitude.csv", index=False)
   510	    if args.dataset == "d2":
   511	        d2_cluster_bootstrap(per_star).to_csv(
   512	            args.out_dir / "d2_cluster_completeness.csv", index=False)
   513	
   514	    attrition = {
   515	        "roster": len(truth),
   516	        "scored": len(per_star),
   517	        "missing_star_json": len(missing),
