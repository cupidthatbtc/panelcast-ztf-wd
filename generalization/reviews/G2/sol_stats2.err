   291	def completeness_tables(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   292	    rows = []
   293	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   294	    for pass_name in PASSES:
   295	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   296	        match_col = "best_match" if pass_name == "best" else f"{pass_name}_match"
   297	        for rule in RULES:
   298	            for scope, frame in (
   299	                ("detection_all_positives", positives),
   300	                ("freq_recovery_scorable", positives[
   301	                    positives["freq_scorable"]
   302	                    & (positives["eligible_any_pass"] if pass_name == "best"
   303	                       else positives[f"{pass_name}_eligible"])
   304	                ]),
   305	            ):
   306	                if frame.empty:
   307	                    rows.append({"pass": pass_name, "rule": rule, "scope": scope,
   308	                                 "n": 0, "ess": 0.0, "p": math.nan,
   309	                                 "lo": math.nan, "hi": math.nan})
   310	                    continue
   311	                fired = frame.apply(
   312	                    lambda r: rule_fired(rule, r[status_col], r.get("census_variable")),
   313	                    axis=1,
   314	                )
   315	                ok = fired.notna()
   316	                success = fired[ok].astype(bool)
   317	                if scope == "freq_recovery_scorable" and rule in (
   318	                        "confirmed", "confirmed_or_candidate", "either"):
   319	                    success = success & (frame.loc[ok, match_col] == "direct")
   320	                stats = weighted_wilson(
   321	                    success.to_numpy(dtype=float),
   322	                    frame.loc[ok, "weight"].to_numpy(dtype=float),
   323	                )
   324	                rows.append({"pass": pass_name, "rule": rule, "scope": scope, **stats})
   325	    return pd.DataFrame(rows)
