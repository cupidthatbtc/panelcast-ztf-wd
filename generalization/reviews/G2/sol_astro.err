    43	
    44	TAP_SYNC = "https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync"
    45	PPT_TO_MMAG = 1.0857  # dm = -2.5 log10(1 + dF/F) ~= 1.0857 (dF/F); 1 ppt -> 1.0857 mmag
    46	UHZ_TO_PER_DAY = 86400.0 / 1e6
    47	KEPLER_LC_NYQUIST_UHZ = 283.2
    48	NEGATIVE_SAMPLE_SEED = 20260828
    49	
    50	QUERIES = {
    51	    "murphy2019_table1.csv": 'SELECT KIC, GaiaDR2, gmag, Teff, logg, dSct, _RA, _DE '
    52	                             'FROM "J/MNRAS/485/2380/table1"',
    53	    "mo2026_table2.csv": 'SELECT KIC, Freq, Amp FROM "J/A+A/710/A245/table2"',
    54	    "mo2026_table1.csv": 'SELECT KIC, Freq, Amp, fR, C, SC FROM "J/A+A/710/A245/table1"',
    55	}
    56	
    57	
    58	def tap_fetch(query: str, retries: int = 4) -> str:
    59	    payload = urllib.parse.urlencode(
    60	        {"REQUEST": "doQuery", "LANG": "ADQL", "FORMAT": "csv", "QUERY": query}
    61	    ).encode()
    62	    for attempt in range(retries + 1):
    63	        try:
    64	            request = urllib.request.Request(TAP_SYNC, data=payload)
    65	            with urllib.request.urlopen(request, timeout=300) as response:
    66	                text = response.read().decode("utf-8")
    67	            if text.lstrip().startswith("<?xml"):
    68	                raise RuntimeError(f"TAP error response: {text[:300]}")
    69	            return text
    70	        except Exception:
    71	            if attempt == retries:
    72	                raise
    73	            time.sleep(5.0 * (attempt + 1))
    74	    raise RuntimeError("unreachable")
    75	
    76	
    77	def cached_pull(raw_dir: Path, name: str, provenance: dict) -> pd.DataFrame:
    78	    path = raw_dir / name
    79	    if not path.exists():
    80	        text = tap_fetch(QUERIES[name])
    81	        path.write_text(text, encoding="utf-8", newline="")
    82	    raw = path.read_bytes()
    83	    provenance[name] = {
    84	        "query": QUERIES[name],
    85	        "sha256": hashlib.sha256(raw).hexdigest(),
    86	        "bytes": len(raw),
    87	    }
    88	    return pd.read_csv(io.BytesIO(raw))
    89	
    90	
    91	def campaign_id_for_kic(kic: int) -> str:
    92	    return "90" + str(int(kic)).zfill(17)
    93	
    94	
    95	def amp_ladder_stratum(amp_mmag: float, subhour: bool) -> str:
    96	    if subhour:
    97	        return "subhour"
    98	    if not np.isfinite(amp_mmag):
    99	        return "amp_unknown"
   100	    if amp_mmag > 10.0:
   101	        return "amp_gt10"
   102	    if amp_mmag >= 1.0:
   103	        edges = np.logspace(0.0, 1.0, 7)  # six log bins across 1-10 mmag
   104	        return f"amp_ladder_{np.searchsorted(edges, amp_mmag, side='right')}"
   105	    return "amp_lt1"
   106	
   107	
   108	def main() -> None:
   109	    parser = argparse.ArgumentParser(description=__doc__)
   110	    parser.add_argument("--out-dir", type=Path,
   111	                        default=REPO_ROOT / "generalization/data/d3")
   112	    parser.add_argument("--total", type=int, default=3000)
   113	    parser.add_argument("--mag-cut", type=float, default=13.2)
   114	    args = parser.parse_args()
   115	
   116	    assert_frozen()
   117	    raw_dir = args.out_dir / "raw"
   118	    raw_dir.mkdir(parents=True, exist_ok=True)
   119	    provenance: dict[str, dict] = {}
   120	
   121	    murphy = cached_pull(raw_dir, "murphy2019_table1.csv", provenance)
   122	    freqs = cached_pull(raw_dir, "mo2026_table2.csv", provenance)
   123	    snf = cached_pull(raw_dir, "mo2026_table1.csv", provenance)
   124	
   125	    if len(murphy) != 14330:
   126	        raise SystemExit(f"Murphy table has {len(murphy)} rows, expected 14330")
   127	    if len(freqs) != 259883:
   128	        raise SystemExit(f"Mo table2 has {len(freqs)} rows, expected 259883")
   129	    if len(snf) != 15265:
   130	        raise SystemExit(f"Mo table1 has {len(snf)} rows, expected 15265")
   131	
   132	    dominant = freqs.loc[freqs.groupby("KIC")["Amp"].idxmax()]
   133	    dominant = dominant.rename(columns={"Freq": "dom_freq_uhz", "Amp": "dom_amp_ppt"})
   134	    subhour_kics = set(snf.loc[snf["C"] == 0, "KIC"].astype(int))
   135	
   136	    stars = murphy.merge(dominant[["KIC", "dom_freq_uhz", "dom_amp_ppt"]], on="KIC", how="left")
   137	    stars["amp_mmag"] = stars["dom_amp_ppt"] * PPT_TO_MMAG
   138	    stars["dom_freq_per_day"] = stars["dom_freq_uhz"] * UHZ_TO_PER_DAY
   139	    stars["subhour"] = stars["KIC"].astype(int).isin(subhour_kics)
   140	    stars = stars[stars["gmag"] >= args.mag_cut].copy()
   141	    if (stars["_DE"] < -28.0).any():
   142	        raise SystemExit("targets below the ZTF footprint; Kepler field expected")
   143	
   144	    positives = stars[stars["dSct"] == 1].sort_values("KIC")
   145	    ambiguous = stars[stars["dSct"] == 2].sort_values("KIC")
   146	    negatives_pool = stars[stars["dSct"] == 0].sort_values("KIC").reset_index(drop=True)
   147	    n_negatives = max(0, args.total - len(positives) - len(ambiguous))
   148	    # frozen-seed simple random sample (G1 referee finding 15: KIC-order stride
   149	    # correlates with sky position/coverage); inclusion probability recorded so
   150	    # population rates can be reweighted
   151	    rng = np.random.Generator(np.random.PCG64(NEGATIVE_SAMPLE_SEED))
   152	    chosen = np.sort(rng.choice(len(negatives_pool), size=n_negatives, replace=False))
   153	    negatives = negatives_pool.iloc[chosen]
   154	
   155	    roster = pd.concat([positives, ambiguous, negatives], ignore_index=True)
   156	    roster["source_id"] = [campaign_id_for_kic(k) for k in roster["KIC"]]
   157	    roster["external_id"] = ["KIC " + str(int(k)) for k in roster["KIC"]]
   158	    roster["ra"] = roster["_RA"]
   159	    roster["dec"] = roster["_DE"]
   160	    roster["class_label"] = ["dsct_flag" + str(int(f)) for f in roster["dSct"]]
   161	    roster["label_variable"] = roster["dSct"].map({0: False, 1: True, 2: None})
   162	    roster["label_periodic"] = roster["label_variable"]
   163	    roster["near_saturation"] = roster["gmag"] < 14.0
   164	    roster["sampling_weight"] = [
   165	        (len(negatives_pool) / len(negatives)) if flag == 0 else 1.0
   166	        for flag in roster["dSct"]
   167	    ]
   168	    roster["stratum"] = [
   169	        amp_ladder_stratum(a, s) if flag == 1 else f"class_{flag}"
   170	        for a, s, flag in zip(roster["amp_mmag"], roster["subhour"], roster["dSct"])
   171	    ]
   172	    bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
