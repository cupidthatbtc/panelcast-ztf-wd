     1	#!/usr/bin/env python3
     2	"""Build the D3 roster: ZTF x Kepler delta Scuti with external truth labels.
     3	
     4	Sources (VizieR, cached under generalization/data/d3/raw with SHA-256 recorded):
     5	  Murphy+2019  J/MNRAS/485/2380/table1  14,330 Kepler A/F stars; dSct flag
     6	               0 = not delta Sct (labeled negative class), 1 = delta Sct,
     7	               2 = ambiguous (kept as its own class, excluded from headline
     8	               completeness/FPR); gmag; positions.
     9	  Mo+2026      J/A+A/710/A245/table2    259,883 extracted frequencies (SNR>8)
    10	               for 1,838 Kepler delta Sct stars; per-star dominant amplitude
    11	               (ppt) and its frequency (uHz).
    12	  Mo+2026      J/A+A/710/A245/table1    15,265 confirmed super-Nyquist
    13	               frequencies in 1,309 stars; any confirmed SNF implies a real
    14	               mode above the Kepler LC Nyquist (283.2 uHz), i.e. P < 59 min
    15	               -> the sub-hour stratum.
    16	
    17	Selection:
    18	  gmag >= 13.2 (ZTF saturation; gmag is the Murphy/KIC g magnitude); ALL
    19	  dSct=1 (610) and dSct=2 (76) survivors; dSct=0 negatives drawn as a
    20	  frozen-seed simple random sample (seed 20260828) with the inclusion
    21	  probability recorded and a sampling_weight column carried into metrics.
    22	
    23	Labels are obtained independently of the frozen ZTF pipeline. Negatives are
    24	"not a delta Sct", not "constant": the D3 negative-class result is a TRIGGER
    25	RATE, never an FPR (GENERALIZATION_PLAN.md risk 5; estimand names in
    26	METRICS_SPEC.md are binding).
    27	"""
    28	
    29	from __future__ import annotations
    30	
    31	import argparse
    32	import hashlib
    33	import io
    34	import json
    35	import time
    36	import urllib.parse
    37	import urllib.request
    38	from pathlib import Path
    39	
    40	import numpy as np
    41	import pandas as pd
    42	
    43	from frozen_api import REPO_ROOT, assert_frozen, campaign_id_ok
    44	
    45	TAP_SYNC = "https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync"
    46	PPT_TO_MMAG = 1.0857  # dm = -2.5 log10(1 + dF/F) ~= 1.0857 (dF/F); 1 ppt -> 1.0857 mmag
    47	UHZ_TO_PER_DAY = 86400.0 / 1e6
    48	KEPLER_LC_NYQUIST_UHZ = 283.2
    49	NEGATIVE_SAMPLE_SEED = 20260828
    50	
    51	QUERIES = {
    52	    "murphy2019_table1.csv": 'SELECT KIC, GaiaDR2, gmag, Teff, logg, dSct, _RA, _DE '
    53	                             'FROM "J/MNRAS/485/2380/table1"',
    54	    "mo2026_table2.csv": 'SELECT KIC, Freq, Amp FROM "J/A+A/710/A245/table2"',
    55	    "mo2026_table1.csv": 'SELECT KIC, Freq, Amp, fR, C, SC FROM "J/A+A/710/A245/table1"',
    56	}
    57	
    58	
    59	def tap_fetch(query: str, retries: int = 4) -> str:
    60	    payload = urllib.parse.urlencode(
    61	        {"REQUEST": "doQuery", "LANG": "ADQL", "FORMAT": "csv", "QUERY": query}
    62	    ).encode()
    63	    for attempt in range(retries + 1):
    64	        try:
    65	            request = urllib.request.Request(TAP_SYNC, data=payload)
    66	            with urllib.request.urlopen(request, timeout=300) as response:
    67	                text = response.read().decode("utf-8")
    68	            if text.lstrip().startswith("<?xml"):
    69	                raise RuntimeError(f"TAP error response: {text[:300]}")
    70	            return text
    71	        except Exception:
    72	            if attempt == retries:
    73	                raise
    74	            time.sleep(5.0 * (attempt + 1))
    75	    raise RuntimeError("unreachable")
    76	
    77	
    78	def cached_pull(raw_dir: Path, name: str, provenance: dict) -> pd.DataFrame:
    79	    path = raw_dir / name
    80	    if not path.exists():
    81	        text = tap_fetch(QUERIES[name])
    82	        path.write_text(text, encoding="utf-8", newline="")
    83	    raw = path.read_bytes()
    84	    provenance[name] = {
    85	        "query": QUERIES[name],
    86	        "sha256": hashlib.sha256(raw).hexdigest(),
    87	        "bytes": len(raw),
    88	    }
    89	    return pd.read_csv(io.BytesIO(raw))
    90	
    91	
    92	def campaign_id_for_kic(kic: int) -> str:
    93	    return "90" + str(int(kic)).zfill(17)
    94	
    95	
    96	def amp_ladder_stratum(amp_mmag: float, subhour: bool) -> str:
    97	    if subhour:
    98	        return "subhour"
    99	    if not np.isfinite(amp_mmag):
   100	        return "amp_unknown"
   101	    if amp_mmag > 10.0:
   102	        return "amp_gt10"
   103	    if amp_mmag >= 1.0:
   104	        edges = np.logspace(0.0, 1.0, 7)  # six log bins across 1-10 mmag
   105	        return f"amp_ladder_{np.searchsorted(edges, amp_mmag, side='right')}"
   106	    return "amp_lt1"
   107	
   108	
   109	def main() -> None:
   110	    parser = argparse.ArgumentParser(description=__doc__)
   111	    parser.add_argument("--out-dir", type=Path,
   112	                        default=REPO_ROOT / "generalization/data/d3")
   113	    parser.add_argument("--total", type=int, default=3000)
   114	    parser.add_argument("--mag-cut", type=float, default=13.2)
   115	    args = parser.parse_args()
   116	
   117	    assert_frozen()
   118	    raw_dir = args.out_dir / "raw"
   119	    raw_dir.mkdir(parents=True, exist_ok=True)
   120	    provenance: dict[str, dict] = {}
   121	
   122	    murphy = cached_pull(raw_dir, "murphy2019_table1.csv", provenance)
   123	    freqs = cached_pull(raw_dir, "mo2026_table2.csv", provenance)
   124	    snf = cached_pull(raw_dir, "mo2026_table1.csv", provenance)
   125	
   126	    if len(murphy) != 14330:
   127	        raise SystemExit(f"Murphy table has {len(murphy)} rows, expected 14330")
   128	    if len(freqs) != 259883:
   129	        raise SystemExit(f"Mo table2 has {len(freqs)} rows, expected 259883")
   130	    if len(snf) != 15265:
   131	        raise SystemExit(f"Mo table1 has {len(snf)} rows, expected 15265")
   132	
   133	    dominant = freqs.loc[freqs.groupby("KIC")["Amp"].idxmax()]
   134	    dominant = dominant.rename(columns={"Freq": "dom_freq_uhz", "Amp": "dom_amp_ppt"})
   135	    subhour_kics = set(snf.loc[snf["C"] == 0, "KIC"].astype(int))
   136	
   137	    stars = murphy.merge(dominant[["KIC", "dom_freq_uhz", "dom_amp_ppt"]], on="KIC", how="left")
   138	    stars["amp_mmag"] = stars["dom_amp_ppt"] * PPT_TO_MMAG
   139	    stars["dom_freq_per_day"] = stars["dom_freq_uhz"] * UHZ_TO_PER_DAY
   140	    stars["subhour"] = stars["KIC"].astype(int).isin(subhour_kics)
   141	    stars = stars[stars["gmag"] >= args.mag_cut].copy()
   142	    if (stars["_DE"] < -28.0).any():
   143	        raise SystemExit("targets below the ZTF footprint; Kepler field expected")
   144	
   145	    positives = stars[stars["dSct"] == 1].sort_values("KIC")
   146	    ambiguous = stars[stars["dSct"] == 2].sort_values("KIC")
   147	    negatives_pool = stars[stars["dSct"] == 0].sort_values("KIC").reset_index(drop=True)
   148	    n_negatives = max(0, args.total - len(positives) - len(ambiguous))
   149	    # frozen-seed simple random sample (G1 referee finding 15: KIC-order stride
   150	    # correlates with sky position/coverage); inclusion probability recorded so
   151	    # population rates can be reweighted
   152	    rng = np.random.Generator(np.random.PCG64(NEGATIVE_SAMPLE_SEED))
   153	    chosen = np.sort(rng.choice(len(negatives_pool), size=n_negatives, replace=False))
   154	    negatives = negatives_pool.iloc[chosen]
   155	
   156	    roster = pd.concat([positives, ambiguous, negatives], ignore_index=True)
   157	    roster["source_id"] = [campaign_id_for_kic(k) for k in roster["KIC"]]
   158	    roster["external_id"] = ["KIC " + str(int(k)) for k in roster["KIC"]]
   159	    roster["ra"] = roster["_RA"]
   160	    roster["dec"] = roster["_DE"]
   161	    roster["class_label"] = ["dsct_flag" + str(int(f)) for f in roster["dSct"]]
   162	    roster["label_variable"] = roster["dSct"].map({0: False, 1: True, 2: None})
   163	    roster["label_periodic"] = roster["label_variable"]
   164	    roster["near_saturation"] = roster["gmag"] < 14.0
   165	    roster["sampling_weight"] = [
   166	        (len(negatives_pool) / len(negatives)) if flag == 0 else 1.0
   167	        for flag in roster["dSct"]
   168	    ]
   169	    roster["stratum"] = [
   170	        amp_ladder_stratum(a, s) if flag == 1 else f"class_{flag}"
   171	        for a, s, flag in zip(roster["amp_mmag"], roster["subhour"], roster["dSct"])
   172	    ]
   173	    bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
   174	    if bad:
   175	        raise SystemExit(f"generated invalid campaign ids: {bad[:3]}")
   176	    if roster["source_id"].duplicated().any():
   177	        raise SystemExit("duplicate campaign ids")
   178	
   179	    columns = [
   180	        "source_id", "external_id", "ra", "dec", "class_label",
   181	        "label_variable", "label_periodic", "gaia_g_mag",
   182	        "KIC", "gmag", "Teff", "logg", "dSct", "dom_freq_uhz",
   183	        "dom_freq_per_day", "dom_amp_ppt", "amp_mmag", "subhour",
   184	        "near_saturation", "stratum", "sampling_weight",
   185	    ]
   186	    roster["gaia_g_mag"] = ""
   187	    roster_path = args.out_dir / "roster_d3.csv"
   188	    roster[columns].to_csv(roster_path, index=False)
   189	
   190	    pos_amp = positives["amp_mmag"]
   191	    report = {
   192	        "roster": str(roster_path),
   193	        "mag_cut": args.mag_cut,
   194	        "counts": {
   195	            "total": len(roster),
   196	            "positives_dsct1": len(positives),
   197	            "ambiguous_dsct2": len(ambiguous),
   198	            "negatives_dsct0": len(negatives),
   199	            "negatives_pool": len(negatives_pool),
   200	            "negative_sample_seed": NEGATIVE_SAMPLE_SEED,
   201	            "negative_inclusion_probability": n_negatives / len(negatives_pool),
   202	        },
   203	        "positives_amplitude_mmag": {
   204	            "with_amplitude": int(np.isfinite(pos_amp).sum()),
   205	            "without_amplitude": int((~np.isfinite(pos_amp)).sum()),
   206	            "gt10": int((pos_amp > 10).sum()),
   207	            "1to10": int(((pos_amp >= 1) & (pos_amp <= 10)).sum()),
   208	            "lt1": int((pos_amp < 1).sum()),
   209	            "subhour": int(positives["subhour"].sum()),
   210	            "quantiles": {
   211	                q: round(float(np.nanquantile(pos_amp, float(q))), 3)
   212	                for q in ("0.05", "0.25", "0.5", "0.75", "0.95")
   213	            },
   214	        },
   215	        "strata": roster["stratum"].value_counts().to_dict(),
   216	        "provenance": provenance,
   217	        "conversions": {"ppt_to_mmag": PPT_TO_MMAG, "uhz_to_per_day": UHZ_TO_PER_DAY,
   218	                        "kepler_lc_nyquist_uhz": KEPLER_LC_NYQUIST_UHZ},
   219	    }
   220	    (args.out_dir / "roster_report.json").write_text(
   221	        json.dumps(report, indent=2) + "\n", encoding="utf-8"
   222	    )
   223	    print(json.dumps({k: report[k] for k in ("counts", "positives_amplitude_mmag")}, indent=2))
   224	
   225	
   226	if __name__ == "__main__":
   227	    main()

