print('snf SC',s['SC'].value_counts(dropna=False).head().to_dict())
print('snf fR range',s['fR'].min(),s['fR'].max(),'Freq range',s['Freq'].min(),s['Freq'].max())
d=f.loc[f.groupby('KIC')['Amp'].idxmax(),['KIC','Freq','Amp']].copy()
d=d.rename(columns={'Freq':'domFreq','Amp':'domAmp'})
pos=m[(m.dSct==1)&(m.gmag>=13.2)].merge(d,on='KIC',how='left')
print('positives',len(pos),'joined',pos.domFreq.notna().sum())
for thresh in [5/0.0864, 283.2]:
 print('domFreq <',thresh,int((pos.domFreq<thresh).sum()),'of joined')
print('domFreq quantiles uHz',pos.domFreq.quantile([0,.05,.25,.5,.75,.95,1]).to_dict())
# match dominant table2 peak to SNF observed peak, tolerance exact-ish
j=pos.dropna(subset=['domFreq']).merge(s[['KIC','Freq','fR','C','SC','Amp']],on='KIC',how='left',suffixes=('_dom','_snf'))
j['match']=(j.domFreq-j.Freq).abs()<1e-5
matched=j[j.match]
print('dominant is catalogued SNF',matched.KIC.nunique(),'rows',len(matched),'independent',matched.loc[matched.C==0,'KIC'].nunique(),'combination',matched.loc[matched.C==1,'KIC'].nunique())
print('dominant SNF fR examples',matched[['KIC','domFreq','fR','C']].head(10).to_string(index=False))
# nearest match in case precision differs
mins=[]
for x in pos.dropna(subset=['domFreq']).itertuples():
 q=s[s.KIC==x.KIC]
 if len(q):
  i=(q.Freq-x.domFreq).abs().idxmin(); mins.append((x.KIC,x.domFreq,q.loc[i,'Freq'],q.loc[i,'fR'],q.loc[i,'C'],abs(q.loc[i,'Freq']-x.domFreq)))
mn=pd.DataFrame(mins,columns=['KIC','domFreq','Freq','fR','C','sep'])
print('nearest SNF < 1e-3',int((mn.sep<1e-3).sum()),'ind',int(((mn.sep<1e-3)&(mn.C==0)).sum()),'comb',int(((mn.sep<1e-3)&(mn.C==1)).sum()))
# magnitude edge counts all roster classes and positives
for lo,hi in [(13.0,13.2),(13.2,13.5),(13.2,14),(14,14.5),(14.5,15),(15,16),(16,99)]:
 print(f'g [{lo},{hi}) roster',int(((r.gmag>=lo)&(r.gmag<hi)).sum()),'pos',int(((r.gmag>=lo)&(r.gmag<hi)&(r.dSct==1)).sum()))
# missingness joined vs g
pos['joined']=pos.domFreq.notna()
print(pos.groupby(pd.cut(pos.gmag,[13.2,14,15,16,17,18,99],right=False),observed=True).joined.agg(['count','sum','mean']).to_string())
