     1	#!/usr/bin/env python3
     2	"""Build the D2 truth roster from the Romero TESS DAV papers.
     3	
     4	Parses the published per-mode tables (period [s], amplitude [ppt]) from the
     5	arXiv LaTeX sources cached in generalization/data/d2/raw:
     6	  Romero+2022  arXiv:2201.04158 (MNRAS 511, 1574)  74 new DAVs, Cycles 1-3
     7	  Romero+2025  arXiv:2407.07260 (ApJ 984, 112)     32 new DAVs, Cycles 4-5
     8	               + Table "old": revised mode lists for re-observed 2022 DAVs,
     9	               including NOV retractions.
    10	
    11	Supersede policy (prespecified): the latest published solution per TIC wins —
    12	2025 "old" table over 2022; NOV objects are dropped from the roster entirely.
    13	
    14	The LaTeX tables contain human typos (comma decimals `356,09`, stray unit
    15	`503.99s`, one missing close-paren, missing list commas). The parser
    16	normalizes these mechanically and then enforces hard range/count asserts;
    17	G3 reviews the parsed output against the paper PDFs.
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	import argparse
    23	import hashlib
    24	import json
    25	import re
    26	from pathlib import Path
    27	
    28	import pandas as pd
    29	
    30	from frozen_api import REPO_ROOT, assert_frozen
    31	
    32	RAW = REPO_ROOT / "generalization/data/d2/raw"
    33	NOV_TICS = {261400271, 804835539, 317620456}
    34	# TIC 683837451 is in the 2022 mode table but its Table-1 row is commented out
    35	# in the arXiv source (NewTess.tex line ~260: "%0683837451 & 045827.11 &
    36	# $-$654003.4 & 17.40 & ..."); values transcribed from that commented row.
    37	CURATED_META = {
    38	    683837451: {
    39	        "ra": 15.0 * (4.0 + 58.0 / 60.0 + 27.11 / 3600.0),
    40	        "dec": -(65.0 + 40.0 / 60.0 + 3.4 / 3600.0),
    41	        "gmag": 17.40,
    42	    }
    43	}
    44	MODE_PAIR = re.compile(r"(\d+\.\d+)\s*s?\s*\(\s*(\d+\.?\d*)\s*[)}]?")
    45	
    46	
    47	def strip_row(line: str) -> str:
    48	    # drop unescaped % comments, row terminator, italics markup, math mode
    49	    out = []
    50	    for index, char in enumerate(line):
    51	        if char == "%" and (index == 0 or line[index - 1] != "\\"):
    52	            break
    53	        out.append(char)
    54	    text = "".join(out)
    55	    text = text.replace("\\\\", "").replace("{\\it", " ").replace("\\textit{", " ")
    56	    text = text.replace("{", " ").replace("}", " ").replace("$", "")
    57	    return text.strip()
    58	
    59	
    60	def table_rows(source: str, header_pattern: str, count: int = 1) -> list[list[str]]:
    61	    """All `&`-separated rows from tables whose header matches header_pattern."""
    62	    rows: list[list[str]] = []
    63	    seen = 0
    64	    for block in re.split(r"\\begin\{table\*?\}", source)[1:]:
    65	        body = block.split("\\end{table")[0]
    66	        if not re.search(header_pattern, body):
    67	            continue
    68	        seen += 1
    69	        for line in body.splitlines():
    70	            if "&" not in line or "\\hline" in line:
    71	                continue
    72	            cleaned = strip_row(line)
    73	            if not cleaned or re.search(header_pattern, line):
    74	                continue
    75	            rows.append([cell.strip() for cell in cleaned.split("&")])
    76	    if seen < count:
    77	        raise SystemExit(f"found {seen} tables matching {header_pattern!r}, expected >= {count}")
    78	    return rows
    79	
    80	
    81	def merge_continuations(rows: list[list[str]]) -> dict[int, list[list[str]]]:
    82	    """Group rows by TIC; a leading-cdots row continues the previous TIC."""
    83	    grouped: dict[int, list[list[str]]] = {}
    84	    current: int | None = None
    85	    for row in rows:
    86	        first = row[0].replace("\\cdots", "").strip()
    87	        if first.isdigit():
    88	            current = int(first)
    89	            grouped.setdefault(current, []).append(row)
    90	        elif current is not None:
    91	            grouped[current].append(row)
    92	    return grouped
    93	
    94	
    95	def parse_modes(cells: list[str]) -> list[tuple[float, float]]:
    96	    text = " , ".join(cells)
    97	    text = re.sub(r"(\d),(\d)", r"\1.\2", text)  # comma decimals -> dots
    98	    return [(float(p), float(a)) for p, a in MODE_PAIR.findall(text)]
    99	
   100	
   101	def parse_mode_table(source: str, paper: str) -> tuple[pd.DataFrame, pd.DataFrame]:
   102	    rows = table_rows(source, r"FAP\(1/1000\)\s*\[ppt\]")
   103	    modes: list[dict] = []
   104	    stars: list[dict] = []
   105	    for tic, group in merge_continuations(rows).items():
   106	        sectors = group[0][1]
   107	        fap_text = group[0][2].strip()
   108	        mode_cells = [row[3] for row in group if len(row) > 3]
   109	        extra_sectors = [
   110	            row[1] for row in group[1:]
   111	            if len(row) > 1 and re.search(r"\d", row[1].replace("\\cdots", ""))
   112	        ]
   113	        if extra_sectors:
   114	            sectors = sectors.rstrip(", ") + "," + ",".join(extra_sectors)
   115	        is_nov = any("NOV" in cell for cell in mode_cells)
   116	        pairs = [] if is_nov else parse_modes(mode_cells)
   117	        if not is_nov and not pairs:
   118	            raise SystemExit(f"{paper} TIC {tic}: no modes parsed from {mode_cells!r}")
   119	        stars.append(
   120	            {
   121	                "tic": tic,
   122	                "paper": paper,
   123	                "sectors": re.sub(r"\s+", "", sectors),
   124	                "fap_ppt": float(fap_text),
   125	                "cadence_s": 20 if "f" in sectors else 120,
   126	                "nov": is_nov,
   127	                "n_modes": len(pairs),
   128	            }
   129	        )
   130	        for period, amp in pairs:
   131	            modes.append({"tic": tic, "paper": paper, "period_s": period, "amp_ppt": amp})
   132	    return pd.DataFrame(stars), pd.DataFrame(modes)
   133	
   134	
   135	def sexagesimal_to_deg(ra_text: str, dec_text: str) -> tuple[float, float]:
   136	    ra_text = ra_text.replace("\\", "").strip()
   137	    dec_text = dec_text.replace("\\", "").replace("−", "-").strip()
   138	    def split3(text: str) -> list[float]:
   139	        parts = text.split(":")
   140	        if len(parts) == 4:  # paper typo: colon used as the decimal point
   141	            parts = parts[:2] + [parts[2] + "." + parts[3]]
   142	        return [float(x) for x in parts]
   143	
   144	    if ":" in ra_text:
   145	        h, m, s = split3(ra_text)
   146	        dd, dm, ds = split3(dec_text.replace("+", ""))
   147	        sign = -1.0 if dec_text.lstrip().startswith("-") else 1.0
   148	    else:
   149	        h, m, s = float(ra_text[0:2]), float(ra_text[2:4]), float(ra_text[4:])
   150	        stripped = dec_text.lstrip("+-")
   151	        dd, dm, ds = float(stripped[0:2]), float(stripped[2:4]), float(stripped[4:])
   152	        sign = -1.0 if dec_text.startswith("-") else 1.0
   153	    return 15.0 * (h + m / 60.0 + s / 3600.0), sign * (abs(dd) + dm / 60.0 + ds / 3600.0)
   154	
   155	
   156	def parse_star_table(source: str, paper: str) -> pd.DataFrame:
   157	    rows = table_rows(source, r"RA\s*&\s*DEC")
   158	    records = []
   159	    for tic, group in merge_continuations(rows).items():
   160	        row = group[0]
   161	        ra, dec = sexagesimal_to_deg(row[1], row[2])
   162	        records.append(
   163	            {"tic": tic, "paper": paper, "ra": ra, "dec": dec, "gmag": float(row[3])}
   164	        )
   165	    return pd.DataFrame(records)
   166	
   167	
   168	def main() -> None:
   169	    parser = argparse.ArgumentParser(description=__doc__)
   170	    parser.add_argument("--out-dir", type=Path, default=REPO_ROOT / "generalization/data/d2")
   171	    args = parser.parse_args()
   172	    assert_frozen()
   173	
   174	    provenance = {
   175	        name: hashlib.sha256((RAW / name).read_bytes()).hexdigest()
   176	        for name in ("romero2022_src.tar.gz", "romero2025_src.tar.gz")
   177	    }
   178	    src2022 = (RAW / "romero2022_src/NewTess.tex").read_text(encoding="utf-8", errors="replace")
   179	    src2025 = (RAW / "romero2025_src/NewTESS.tex").read_text(encoding="utf-8", errors="replace")
   180	
   181	    # the 2025 file holds two mode tables: "new" (32) then "old" (revised
   182	    # R22); slice at the old table's begin marker (its caption sits inside
   183	    # the block, so slicing at the caption text would orphan the rows)
   184	    old_caption = src2025.find("showing a change in the period list")
   185	    if old_caption < 0:
   186	        raise SystemExit("2025 old-table caption not found")
   187	    old_start = src2025.rfind("\\begin{table", 0, old_caption)
   188	    stars22, modes22 = parse_mode_table(src2022, "romero2022")
   189	    stars25, modes25 = parse_mode_table(src2025[:old_start], "romero2025")
   190	    stars25old, modes25old = parse_mode_table(src2025[old_start:], "romero2025old")
   191	
   192	    if len(stars22) != 74:
