   391	            sample = rng.choice(clusters, size=len(clusters), replace=True)
   392	            boots.append(float(per_target.loc[sample].mean()))
   393	        rows.append({"arm": arm, "template_k": int(k), "n_targets": len(clusters),
   394	                     "p": point, "lo": float(np.quantile(boots, 0.025)),
   395	                     "hi": float(np.quantile(boots, 0.975))})
   396	    return pd.DataFrame(rows)
