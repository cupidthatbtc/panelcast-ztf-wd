     1	#!/usr/bin/env python3
     2	"""Synthesize D2 exposure shards: DAV truth signals in real ZTF windows.
     3	
     4	Template pool: ALL 928 stars of the published 2026-08-01 catalog — NOT the
     5	510 not-detected subset (G1 referee finding 1: conditioning templates on the
     6	pipeline's own non-detection is a circularity path). Native variability is
     7	handled by frequency-matched scoring plus paired controls. Every shard
     8	preserves the template's real epochs (bjd_tdb), real cadence structure and
     9	real magerr; arms differ in what carries the noise:
    10	
    11	  arm B (92…)  signal added to the REAL ZTF magnitudes — the headline arm
    12	               ("TESS-truth signals injected into real ZTF photometry").
    13	  ctrl (95…)   paired uninjected copy of every unique arm-B template window —
    14	               identifies windows that trigger natively (real variables in
    15	               the pool), so injected-recovery is scored against its own
    16	               window's baseline behavior.
    17	  arm A (93…)  signal added to a synthetic Gaussian floor (median mag +
    18	               N(0, magerr_i)) — diagnostic; separates window effects from
    19	               real-noise effects.
    20	  nulls (94…)  arm-A construction with amplitude_scale = 0 — 1,000 shards
    21	               cycling the 928 windows with distinct noise seeds (windows
    22	               repeat, noise does not). This measures the GAUSSIAN-NULL
    23	               false-alarm rate, not a real-sky FPR (G1 stats finding 11).
    24	
    25	Template matching per target: |median zg mag − target G| <= 0.25 (widened to
    26	0.5, then nearest-K, when the pool is thin — flagged in the manifest);
    27	K=3 at the 10/50/90th percentiles of median-exposures-per-night, because 75%
    28	of zg nights are single-exposure and per-night median subtraction is the
    29	pre-registered dominant penalty (plan risk 3).
    30	
    31	Run matrix (plan): nominal (1.7, 0.80) on K=3 for arms A+B; the other 8
    32	ladder points on the median template only; 1,000 nulls.
    33	
    34	Campaign id layout (19 digits): AA TTTTTTTTTT K GR 0000
    35	  AA arm prefix (92/93), T zero-padded TIC, K template index (0/1/2),
    36	  G/R ladder indices (1-3) into {1.4,1.7,2.1} x {0.70,0.80,0.90}, 22=nominal.
    37	  Nulls: 94 + 17-digit serial. Full mapping in shard_manifest.csv.
    38	"""
    39	
    40	from __future__ import annotations
    41	
    42	import argparse
    43	import gzip
    44	import json
    45	from pathlib import Path
    46	
    47	import numpy as np
    48	import pandas as pd
    49	
    50	from d2_truth_model import (
    51	    BANDPASS_LADDER_G,
    52	    BANDPASS_LADDER_RG,
    53	    NOMINAL_G,
    54	    NOMINAL_RG,
    55	    build_truth_model,
    56	)
    57	from frozen_api import EXPOSURE_COLUMNS, REPO_ROOT, assert_frozen, campaign_id_ok
    58	
    59	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
    60	MATCH_TOL_MAG = 0.25
    61	MATCH_TOL_WIDE = 0.5
    62	N_NULLS = 1000
    63	
    64	
    65	def load_templates(exposures_path: Path, catalog_path: Path) -> tuple[pd.DataFrame, dict]:
    66	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
    67	    if len(catalog) != 928:
    68	        raise SystemExit(f"published catalog has {len(catalog)} rows, expected 928")
    69	    pool_ids = set(catalog["source_id"])
    70	    status = catalog.set_index("source_id")["blind_status"].to_dict()
    71	    exposures = pd.read_csv(
    72	        exposures_path,
    73	        dtype={"source_id": str, "band": str},
    74	        usecols=EXPOSURE_COLUMNS,
    75	    )
    76	    exposures = exposures[exposures["source_id"].isin(pool_ids)]
    77	    zg = exposures[exposures["band"] == "zg"]
    78	    stats = zg.groupby("source_id").agg(
    79	        median_zg=("mag", "median"),
    80	        n_zg=("mag", "size"),
    81	    )
    82	    epn = (
    83	        zg.groupby(["source_id", "night_mjd"]).size().groupby("source_id").median()
    84	        .rename("exp_per_night")
    85	    )
    86	    stats = stats.join(epn)
    87	    stats["blind_status"] = [status[sid] for sid in stats.index]
    88	    frames = {sid: frame for sid, frame in exposures.groupby("source_id")}
    89	    return stats.reset_index(), frames
    90	
    91	
    92	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
    93	    for tol, label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
    94	        pool = stats[(stats["median_zg"] - gmag).abs() <= tol]
    95	        if len(pool) >= 3:
    96	            break
    97	    else:
    98	        label = "nearest"
    99	    if len(pool) < 3:
   100	        pool = stats.iloc[(stats["median_zg"] - gmag).abs().argsort()[:9]]
   101	    ordered = pool.sort_values(["exp_per_night", "source_id"]).reset_index(drop=True)
   102	    picks = [
   103	        ordered.iloc[min(len(ordered) - 1, int(round(q * (len(ordered) - 1))))]["source_id"]
   104	        for q in (0.10, 0.50, 0.90)
   105	    ]
   106	    return picks, label
   107	
   108	
   109	def campaign_id(arm_prefix: str, tic: int, k: int, g_idx: int, r_idx: int) -> str:
   110	    return f"{arm_prefix}{tic:010d}{k}{g_idx}{r_idx}0000"
   111	
   112	
   113	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   114	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   115	        frame[EXPOSURE_COLUMNS].to_csv(handle, index=False, lineterminator="\n")
   116	
   117	
   118	def synthesize(
   119	    template: pd.DataFrame,
   120	    model,
   121	    source_id: str,
   122	    gaussian_floor: bool,
   123	    seed: int,
   124	) -> pd.DataFrame:
   125	    frame = template.copy()
   126	    frame["source_id"] = source_id
   127	    t_ref = float(frame["bjd_tdb"].min())
   128	    if gaussian_floor:
   129	        rng = np.random.Generator(np.random.PCG64(seed))
   130	        for band in ("zg", "zr"):
   131	            mask = frame["band"] == band
   132	            median = float(frame.loc[mask, "mag"].median())
   133	            noise = rng.normal(0.0, frame.loc[mask, "magerr"].to_numpy(dtype=float))
   134	            frame.loc[mask, "mag"] = median + noise
   135	    for band in ("zg", "zr"):
   136	        mask = frame["band"] == band
   137	        frame.loc[mask, "mag"] = frame.loc[mask, "mag"] + model.evaluate(
   138	            frame.loc[mask, "bjd_tdb"].to_numpy(dtype=float), band, t_ref
   139	        )
   140	    return frame
   141	
   142	
   143	def main() -> None:
   144	    parser = argparse.ArgumentParser(description=__doc__)
   145	    parser.add_argument("--d2-dir", type=Path, default=REPO_ROOT / "generalization/data/d2")
   146	    parser.add_argument("--out-dir", type=Path,
   147	                        default=REPO_ROOT / "generalization/data/d2/shards")
   148	    parser.add_argument("--exposures", type=Path, default=PUBLISHED / "data/exposures.csv.gz")
   149	    parser.add_argument("--catalog", type=Path,
   150	                        default=PUBLISHED / "catalog/ls_full_catalog.csv")
   151	    parser.add_argument("--arms", default="b,ctrl,a,ladder,nulls")
   152	    parser.add_argument("--limit", type=int, default=None, help="pilot: first N targets")
   153	    args = parser.parse_args()
   154	
   155	    assert_frozen()
   156	    arms = set(args.arms.split(","))
   157	    args.out_dir.mkdir(parents=True, exist_ok=True)
   158	    targets = pd.read_csv(args.d2_dir / "d2_targets.csv")
   159	    modes = pd.read_csv(args.d2_dir / "d2_modes.csv")
   160	    if args.limit:
   161	        targets = targets.head(args.limit)
   162	    stats, frames = load_templates(args.exposures, args.catalog)
   163	
   164	    ladder = [
   165	        (gi + 1, ri + 1, g, r)
   166	        for gi, g in enumerate(BANDPASS_LADDER_G)
   167	        for ri, r in enumerate(BANDPASS_LADDER_RG)
   168	    ]
   169	    nominal = next(
   170	        (gi, ri, g, r) for gi, ri, g, r in ladder if g == NOMINAL_G and r == NOMINAL_RG
   171	    )
   172	    manifest: list[dict] = []
   173	
   174	    for target in targets.itertuples(index=False):
   175	        star_modes = modes[modes["tic"] == target.tic]
   176	        periods = star_modes["period_s"].tolist()
   177	        amps = star_modes["amp_ppt"].tolist()
   178	        picks, match_label = match_templates(stats, float(target.gmag))
   179	        variants = []
   180	        if "b" in arms or "a" in arms:
   181	            variants.append((*nominal, (0, 1, 2)))
   182	        if "ladder" in arms:
   183	            variants.extend((gi, ri, g, r, (1,)) for gi, ri, g, r in ladder
   184	                            if not (g == NOMINAL_G and r == NOMINAL_RG))
   185	        for gi, ri, g, r, template_ks in variants:
   186	            model = build_truth_model(
   187	                int(target.tic), periods, amps, float(target.cadence_s),
   188	                ratio_g=g, ratio_rg=r,
   189	            )
   190	            for k in template_ks:
   191	                template_id = picks[k]
   192	                template = frames[template_id]
   193	                arm_list = []
   194	                if g == NOMINAL_G and r == NOMINAL_RG:
   195	                    if "b" in arms:
   196	                        arm_list.append(("92", False))
   197	                    if "a" in arms:
   198	                        arm_list.append(("93", True))
   199	                else:
   200	                    arm_list.append(("92", False))
   201	                for prefix, gaussian in arm_list:
   202	                    sid = campaign_id(prefix, int(target.tic), k, gi, ri)
   203	                    if not campaign_id_ok(sid):
   204	                        raise SystemExit(f"bad campaign id {sid}")
   205	                    shard = synthesize(template, model, sid, gaussian, seed=int(sid[2:]))
   206	                    write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   207	                    manifest.append({
   208	                        "campaign_id": sid, "arm": "A" if gaussian else "B",
   209	                        "tic": int(target.tic), "template_source_id": template_id,
   210	                        "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   211	                        "template_k": k, "ratio_g": g, "ratio_rg": r,
   212	                        "match": match_label,
   213	                        "n_modes_injected": len(model.modes),
   214	                        "n_modes_rejected": len(model.rejected),
   215	                    })
   216	        print(f"[d2-shards] TIC {target.tic}: {len(manifest)} shards so far", flush=True)
   217	
   218	    if "ctrl" in arms:
   219	        used = sorted({
   220	            row["template_source_id"] for row in manifest if row["arm"] == "B"
   221	        })
   222	        null_model = build_truth_model(0, [], [], 120.0)
   223	        for serial, template_id in enumerate(used):
   224	            sid = "95" + str(serial).zfill(17)
   225	            shard = frames[template_id].copy()
   226	            shard["source_id"] = sid
   227	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   228	            manifest.append({
   229	                "campaign_id": sid, "arm": "ctrl", "tic": 0,
   230	                "template_source_id": template_id,
   231	                "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   232	                "template_k": -1, "ratio_g": 0.0, "ratio_rg": 0.0, "match": "",
   233	                "n_modes_injected": 0, "n_modes_rejected": 0,
   234	            })
   235	        print(f"[d2-shards] {len(used)} paired controls", flush=True)
   236	
   237	    if "nulls" in arms:
   238	        pool = stats.sort_values("source_id")["source_id"].tolist()
   239	        null_model = build_truth_model(0, [], [], 120.0)
   240	        for serial in range(N_NULLS):
   241	            template_id = pool[serial % len(pool)]
   242	            sid = "94" + str(serial).zfill(17)
   243	            shard = synthesize(frames[template_id], null_model, sid, True, seed=serial)
   244	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   245	            manifest.append({
   246	                "campaign_id": sid, "arm": "null", "tic": 0,
   247	                "template_source_id": template_id,
   248	                "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   249	                "template_k": serial % len(pool),
   250	                "ratio_g": 0.0, "ratio_rg": 0.0, "match": "",
   251	                "n_modes_injected": 0, "n_modes_rejected": 0,
   252	            })
   253	            if (serial + 1) % 200 == 0:
   254	                print(f"[d2-shards] nulls {serial + 1}/{N_NULLS}", flush=True)
   255	
   256	    frame = pd.DataFrame(manifest)
   257	    frame.to_csv(args.out_dir / "shard_manifest.csv", index=False)
   258	    summary = {
   259	        "shards": len(frame),
   260	        "by_arm": frame["arm"].value_counts().to_dict(),
   261	        "match_labels": frame["match"].value_counts().to_dict(),
   262	        "targets": int(frame.loc[frame["arm"] != "null", "tic"].nunique()),
   263	        "total_rejected_modes": int(frame["n_modes_rejected"].sum()),
   264	    }
   265	    (args.out_dir / "shard_summary.json").write_text(
   266	        json.dumps(summary, indent=2) + "\n", encoding="utf-8"
   267	    )
   268	    print(json.dumps(summary, indent=2))
   269	
   270	
   271	if __name__ == "__main__":
   272	    main()

