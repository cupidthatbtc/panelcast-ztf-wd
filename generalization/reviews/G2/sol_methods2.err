   378	def d2_cluster_bootstrap(per_star: pd.DataFrame) -> pd.DataFrame:
   379	    frame = per_star[per_star.get("arm").isin(["A", "B"])] if "arm" in per_star else per_star.iloc[0:0]
   380	    if frame.empty:
   381	        return pd.DataFrame()
   382	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   383	    rows = []
   384	    for (arm, k), stratum in frame.groupby(["arm", "template_k"]):
   385	        success = (stratum["best_status"] == "confirmed") & (stratum["best_match"] == "direct")
   386	        per_target = success.groupby(stratum["cluster"]).mean()
   387	        point = float(per_target.mean())
   388	        clusters = per_target.index.to_numpy()
