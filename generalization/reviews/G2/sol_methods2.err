   495	
   496	    args.out_dir.mkdir(parents=True, exist_ok=True)
   497	    per_star.drop(columns=["truth_freqs"]).to_csv(
   498	        args.out_dir / "per_star.csv", index=False)
   499	    completeness_tables(per_star, args.dataset).to_csv(
