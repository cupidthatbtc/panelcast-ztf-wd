   411	        k = int(success.loc[idx].sum())
   412	        n = len(cell)
   413	        entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   414	        if n >= MIN_CELL:
   415	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   416	        rows.append(entry)
   417	    return pd.DataFrame(rows)
