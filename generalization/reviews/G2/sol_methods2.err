   419	
   420	def trigger_rates(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   421	    rows = []
   422	    if dataset == "d3":
   423	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
   424	        for rule in RULES:
   425	            fired = negatives.apply(
   426	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
   427	                axis=1,
   428	            )
   429	            ok = fired.notna()
   430	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
   431	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
   432	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
   433	    if dataset == "d2" and "arm" in per_star:
   434	        for arm, name in (("null", "fpr_gaussian"), ("ctrl", "native_trigger_rate")):
   435	            subset = per_star[per_star["arm"] == arm]
   436	            if subset.empty:
   437	                continue
   438	            fired = subset["best_status"] == "confirmed"
   439	            stats = weighted_wilson(fired.to_numpy(dtype=float),
   440	                                    np.ones(len(subset)))
   441	            rows.append({"quantity": name, "rule": "confirmed", **stats})
   442	    return pd.DataFrame(rows)
   443	
   444	
   445	def sha256_file(path: Path) -> str:
   446	    return hashlib.sha256(path.read_bytes()).hexdigest()
   447	
   448	
   449	def main() -> None:
   450	    parser = argparse.ArgumentParser(description=__doc__)
   451	    parser.add_argument("--dataset", choices=("d1", "d2", "d3"), required=True)
   452	    parser.add_argument("--stars-dir", type=Path, required=True)
   453	    parser.add_argument("--census-csv", type=Path, default=None)
