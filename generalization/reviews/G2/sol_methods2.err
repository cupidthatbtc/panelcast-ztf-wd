   328	def contingency(per_star: pd.DataFrame) -> dict:
   329	    from scipy.stats import binomtest
   330	    frame = per_star[(per_star["label_positive"] == True)  # noqa: E712
   331	                     & per_star["census_variable"].notna()]
   332	    C = frame["census_variable"].astype(bool)
   333	    L = frame["best_status"] == "confirmed"
   334	    a, b = int((C & L).sum()), int((C & ~L).sum())
   335	    c, d = int((~C & L).sum()), int((~C & ~L).sum())
   336	    n = len(frame)
   337	    union_p, union_lo, union_hi = wilson(a + b + c, n) if n else (math.nan,) * 3
   338	    out = {
   339	        "n_positives_scored": n,
   340	        "table": {"census_and_ls": a, "census_only": b, "ls_only": c, "neither": d},
   341	        "union_completeness": {"p": union_p, "lo": union_lo, "hi": union_hi},
   342	        "incremental_census_only": dict(zip(("p", "lo", "hi"), wilson(b, n))) if n else {},
   343	        "incremental_ls_only": dict(zip(("p", "lo", "hi"), wilson(c, n))) if n else {},
   344	    }
   345	    if b + c:
   346	        out["mcnemar_exact_p_secondary"] = float(
   347	            binomtest(min(b, c), b + c, 0.5).pvalue * 1.0
   348	        )
   349	    return out
   350	
   351	
   352	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   353	    scorable = per_star[per_star["freq_scorable"]
   354	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   355	    if len(scorable) < 3:
   356	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   357	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   358	    rates = []
   359	    truth_lists = scorable["truth_freqs"].tolist()
   360	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   361	        perm = rng.permutation(len(truth_lists))
   362	        hits = 0
   363	        for i, row in scorable.iterrows():
   364	            if perm[i] == i:
   365	                continue
   366	            tol = 1.5 / row["baseline_days"]
   367	            if classify_match(float(row["best_frequency_per_day"]),
   368	                              truth_lists[perm[i]], tol) == "direct":
   369	                hits += 1
   370	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   371	        if denom:
   372	            rates.append(hits / denom)
   373	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   374	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   375	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
