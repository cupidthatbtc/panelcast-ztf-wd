    78	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
    79	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
    80	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
    81	    if only is not None:
    82	        missing = only - set(source_ids)
    83	        if missing:
    84	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
    85	        source_ids = [sid for sid in source_ids if sid in only]
