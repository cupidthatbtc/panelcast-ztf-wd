     1	#!/usr/bin/env python3
     2	"""Generic panel/census builder: frozen QC chain over a campaign roster.
     3	
     4	Re-implements ONLY the roster/paths plumbing of build_catalog_panels.main();
     5	every scientific operation (nearest-cluster crossmatch, row QC, BJD_TDB
     6	conversion, nightly/monthly binning, 2.5-ratio census) is the frozen function
     7	imported through frozen_api, applied verbatim.
     8	
     9	Roster CSV contract (build_d3_roster.py writes this):
    10	  source_id     19-digit campaign id (prefix 90/92/93/94)
    11	  external_id   upstream name (e.g. KIC 8462852)
    12	  ra, dec       ICRS degrees for the ZTF cone
    13	  class_label   truth class (e.g. dsct_flag1, notdsct_flag0)
    14	  label_variable, label_periodic   truth booleans (may be empty)
    15	  gaia_g_mag    optional; empty allowed
    16	Census output maps the frozen column names onto campaign semantics:
    17	wdj_name<-external_id, wd_class<-class_label, paper_variable<-label_variable,
    18	paper_periodic<-label_periodic, known_roster<-False, in_core<-True,
    19	n_variants<-0, bp_rp<-NaN unless provided.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import argparse
    25	import json
    26	import math
    27	from pathlib import Path
    28	from types import SimpleNamespace
    29	
    30	import pandas as pd
    31	from astropy.utils import iers
    32	
    33	# BJD generation must not depend on a live IERS download (G1 methods finding 6);
    34	# the pinned astropy-iers-data package supplies the table, recorded in the
    35	# manifest via env_versions().
    36	iers.conf.auto_download = False
    37	
    38	from frozen_api import (
    39	    BANDS,
    40	    EXPOSURE_COLUMNS,
    41	    MIN_EXPOSURES_PER_BAND,
    42	    MONTHLY_COLUMNS,
    43	    NIGHTLY_COLUMNS,
    44	    add_bjd,
    45	    assert_frozen,
    46	    campaign_id_ok,
    47	    census_row,
    48	    clean_rows,
    49	    env_versions,
    50	    frozen_file_shas,
    51	    monthly_panel,
    52	    nightly_panel,
    53	    read_cache,
    54	    select_nearest_source,
    55	)
    56	
    57	
    58	def roster_meta(row: pd.Series) -> SimpleNamespace:
    59	    def opt_float(name: str) -> float:
    60	        value = row.get(name)
    61	        try:
    62	            return float(value)
    63	        except (TypeError, ValueError):
    64	            return math.nan
    65	
    66	    def opt_bool(name: str):
    67	        value = row.get(name)
    68	        if pd.isna(value) or value == "":
    69	            return None
    70	        if isinstance(value, str):
    71	            return value.lower() == "true"
    72	        return bool(value)
    73	
    74	    return SimpleNamespace(
    75	        source_id=str(row["source_id"]),
    76	        wdj_name=str(row.get("external_id", "")),
    77	        gaia_g_mag=opt_float("gaia_g_mag"),
    78	        bp_rp=opt_float("bp_rp"),
    79	        in_core=True,
    80	        n_variants=0,
    81	        known_roster=False,
    82	        wd_class=str(row.get("class_label", "")),
    83	        paper_variable=opt_bool("label_variable"),
    84	        paper_periodic=opt_bool("label_periodic"),
    85	    )
    86	
    87	
    88	def main() -> None:
    89	    parser = argparse.ArgumentParser(description=__doc__)
    90	    parser.add_argument("--roster", type=Path, required=True)
    91	    parser.add_argument("--cache-dir", type=Path, required=True,
    92	                        help="IRSA response cache: <source_id>.csv per target")
    93	    parser.add_argument("--out-dir", type=Path, required=True)
    94	    parser.add_argument("--allow-nonstandard-ids", action="store_true")
    95	    args = parser.parse_args()
    96	
    97	    assert_frozen()
    98	    args.out_dir.mkdir(parents=True, exist_ok=True)
    99	    exposure_star_dir = args.out_dir / "exposure_stars"
   100	    exposure_star_dir.mkdir(parents=True, exist_ok=True)
   101	
   102	    roster = pd.read_csv(args.roster, dtype={"source_id": str})
   103	    if not args.allow_nonstandard_ids:
   104	        bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
   105	        if bad:
   106	            raise SystemExit(f"{len(bad)} roster ids violate the campaign convention: {bad[:3]}")
   107	
   108	    qc_rows: list[dict[str, object]] = []
   109	    census_rows: list[dict[str, object]] = []
   110	    crossmatched = 0
   111	
   112	    for index, (_, row) in enumerate(roster.iterrows(), 1):
   113	        meta = roster_meta(row)
   114	        cache_path = args.cache_dir / f"{meta.source_id}.csv"
   115	        qc: dict[str, object] = {
   116	            "source_id": meta.source_id,
   117	            "external_id": meta.wdj_name,
   118	            "class_label": meta.wd_class,
   119	            "cache_present": cache_path.exists() and cache_path.stat().st_size > 0,
   120	            "read_status": "ok",
   121	        }
   122	        if not qc["cache_present"]:
   123	            qc["read_status"] = "missing"
   124	            qc_rows.append(qc)
   125	            continue
   126	        try:
   127	            raw = read_cache(cache_path)
   128	            qc["raw_rows"] = len(raw)
   129	            selected, separation, n_objects, n_selected = select_nearest_source(
   130	                raw, float(row["ra"]), float(row["dec"])
   131	            )
   132	            clean, drop_counts = clean_rows(selected)
   133	            qc.update(drop_counts)
   134	            qc["nearest_separation_arcsec"] = separation
   135	            qc["ztf_objects_in_cone"] = n_objects
   136	            qc["selected_ztf_objects"] = n_selected
   137	        except Exception as exc:
   138	            qc["read_status"] = "error"
   139	            qc["error"] = repr(exc)
   140	            qc_rows.append(qc)
   141	            continue
   142	
   143	        for band in BANDS:
   144	            qc[f"{band}_raw_rows"] = int((raw["filtercode"] == band).sum())
   145	            qc[f"{band}_clean_rows"] = int((clean["band"] == band).sum())
   146	        is_crossmatched = all(
   147	            qc[f"{band}_clean_rows"] >= MIN_EXPOSURES_PER_BAND for band in BANDS
   148	        )
   149	        qc["crossmatched"] = is_crossmatched
   150	        qc_rows.append(qc)
   151	        if not is_crossmatched:
   152	            continue
   153	
   154	        crossmatched += 1
   155	        clean["source_id"] = meta.source_id
   156	        clean = add_bjd(clean, float(row["ra"]), float(row["dec"]))
   157	        clean = clean.sort_values(["band", "bjd_tdb"])
   158	        clean[EXPOSURE_COLUMNS].to_csv(
   159	            exposure_star_dir / f"{meta.source_id}.csv.gz", index=False
   160	        )
   161	        nightly = nightly_panel(clean)
   162	        monthly = monthly_panel(nightly)
   163	        census_rows.append(census_row(meta, clean, nightly, monthly))
   164	        if index % 50 == 0 or index == len(roster):
   165	            print(f"[panels-generic] {index:,}/{len(roster):,}; crossmatched={crossmatched:,}",
   166	                  flush=True)
   167	
   168	    pd.DataFrame(qc_rows).to_csv(args.out_dir / "crossmatch_qc.csv", index=False)
   169	    pd.DataFrame(census_rows).to_csv(args.out_dir / "census_generic.csv", index=False)
   170	    manifest = {
   171	        "builder": "build_panels_generic.py",
   172	        "roster": str(args.roster),
   173	        "roster_rows": len(roster),
   174	        "crossmatched_count": crossmatched,
   175	        "crossmatch_rule": "frozen: nearest ZTF coordinate cluster; "
   176	                           f">={MIN_EXPOSURES_PER_BAND} QC-passing exposures in zg and zr",
   177	        "row_qc": "frozen: catflags == 0; finite mag; finite magerr > 0; chi < 4; finite MJD",
   178	        "census_threshold": 2.5,
   179	        "env": env_versions(),
   180	        "frozen_sha256": frozen_file_shas(),
   181	    }
   182	    (args.out_dir / "panels_manifest.json").write_text(
   183	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   184	    )
   185	    print(f"[panels-generic] crossmatched {crossmatched:,}/{len(roster):,}")
   186	
   187	
   188	if __name__ == "__main__":
   189	    main()

