    55	
    56	def wilson(k: float, n: float) -> tuple[float, float, float]:
    57	    if n <= 0:
    58	        return math.nan, math.nan, math.nan
    59	    z = 1.959963984540054
    60	    p = k / n
    61	    denom = 1.0 + z * z / n
    62	    center = (p + z * z / (2 * n)) / denom
    63	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    64	    return p, max(0.0, center - half), min(1.0, center + half)
    65	
    66	
    67	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    68	    total = float(weights.sum())
    69	    if total <= 0:
    70	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    71	    p = float((weights * successes).sum() / total)
    72	    ess = total * total / float((weights * weights).sum())
    73	    _, lo, hi = wilson(p * ess, ess)
    74	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
    75	
    76	
    77	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    78	    classes: set[str] = set()
    79	    for f_t in truth:
    80	        if abs(freq - f_t) <= tol:
    81	            classes.add("direct")
    82	        elif abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    83	            classes.add("harmonic")
    84	        else:
    85	            for k in (1, 2):
    86	                for sign in (1.0, -1.0):
    87	                    if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    88	                        classes.add("window_alias")
    89	    if not classes:
    90	        return "unmatched"
    91	    if len(classes) > 1:
    92	        return "ambiguous"
    93	    return classes.pop()
    94	
    95	
    96	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
    97	    if not truth:
    98	        return False
    99	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   100	    return any(low <= f <= high for f in truth)
   101	
   102	
   103	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   104	    if rule == "confirmed":
   105	        return status == "confirmed"
   106	    if rule == "confirmed_or_candidate":
   107	        return status in ("confirmed", "candidate")
   108	    if rule == "census":
   109	        return None if census_flag is None else bool(census_flag)
   110	    if rule == "either":
   111	        if census_flag is None:
   112	            return status == "confirmed"
   113	        return status == "confirmed" or bool(census_flag)
   114	    raise ValueError(rule)
   115	
