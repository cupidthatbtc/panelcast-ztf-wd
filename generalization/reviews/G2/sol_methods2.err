     1	#!/usr/bin/env python3
     2	"""CLI-identity gate: the campaign import path is the frozen code path.
     3	
     4	Runs the same shard twice:
     5	  A. analyze_star imported through frozen_api (exactly what the campaign
     6	     driver does), in this process;
     7	  B. analyze_star imported directly from scripts/ in a FRESH interpreter with
     8	     frozen_api never imported (exactly what the frozen CLI does internally).
     9	Byte-compares the two result files, then repeats arm A to prove determinism.
    10	
    11	This is the honest substitute for "run the frozen CLI on campaign shards":
    12	the CLI's main() cannot run on campaign data because it merges against the WD
    13	roster and rewrites the published catalog table.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import argparse
    19	import json
    20	import subprocess
    21	import sys
    22	from pathlib import Path
    23	
    24	from frozen_api import SCRIPTS_DIR, analyze_star, assert_frozen, env_versions
    25	
    26	DIRECT_RUNNER = """
    27	import sys
    28	sys.path.insert(0, {scripts_dir!r})
    29	from run_catalog_lomb_scargle import analyze_star
    30	analyze_star({source_id!r}, {shard!r}, {result!r}, {work!r}, ("low", "high"))
    31	"""
    32	
    33	
    34	def main() -> None:
    35	    parser = argparse.ArgumentParser(description=__doc__)
    36	    parser.add_argument("--shard", type=Path, required=True,
    37	                        help="one <source_id>.csv.gz exposure shard")
    38	    parser.add_argument("--out-dir", type=Path, required=True)
    39	    args = parser.parse_args()
    40	
    41	    assert_frozen()
    42	    source_id = args.shard.name.split(".csv")[0]
    43	    args.out_dir.mkdir(parents=True, exist_ok=True)
    44	    paths = {
    45	        arm: args.out_dir / f"{source_id}.{arm}.json" for arm in ("api", "cli", "api2")
    46	    }
    47	    for path in paths.values():
    48	        path.unlink(missing_ok=True)
    49	
    50	    analyze_star(source_id, str(args.shard), str(paths["api"]),
    51	                 str(args.out_dir / "work_api"), ("low", "high"))
    52	    script = DIRECT_RUNNER.format(
    53	        scripts_dir=str(SCRIPTS_DIR),
    54	        source_id=source_id,
    55	        shard=str(args.shard),
    56	        result=str(paths["cli"]),
    57	        work=str(args.out_dir / "work_cli"),
    58	    )
    59	    subprocess.run([sys.executable, "-c", script], check=True)
    60	    analyze_star(source_id, str(args.shard), str(paths["api2"]),
    61	                 str(args.out_dir / "work_api2"), ("low", "high"))
    62	
    63	    api, cli, api2 = (paths[arm].read_bytes() for arm in ("api", "cli", "api2"))
    64	    report = {
    65	        "gate": "verify_cli_identity",
    66	        "source_id": source_id,
    67	        "api_equals_cli": api == cli,
    68	        "deterministic": api == api2,
    69	        "passed": api == cli == api2,
    70	        "env": env_versions(),
    71	    }
    72	    report_path = args.out_dir / f"{source_id}.identity_report.json"
    73	    report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    74	    print(json.dumps(report, indent=2))
    75	    raise SystemExit(0 if report["passed"] else 1)
    76	
    77	
    78	if __name__ == "__main__":
    79	    main()

