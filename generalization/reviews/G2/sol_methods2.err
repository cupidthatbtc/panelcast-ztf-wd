     1	#!/usr/bin/env python3
     2	"""Replay gate: reproduce published 2026-08-01 per-star results byte-for-byte.
     3	
     4	Re-runs the frozen `analyze_star` (imported through frozen_api, exactly as the
     5	campaign driver will) on a deterministic sample of published stars and compares
     6	the fresh output against the committed bundle files.
     7	
     8	Comparison tiers, strongest first:
     9	  identical                  raw bytes equal
    10	  identical_newline          equal after CRLF->LF normalization (git stored the
    11	                             bundle newline-normalized; Windows writes CRLF)
    12	  identical_v1_schema        equal after the documented v1->v2 schema transform:
    13	                             the run that produced 921/928 published files
    14	                             predates commit fa16d7f, which added the
    15	                             `available`/`unavailable_reason` keys and bumped
    16	                             schema_version 1->2 while changing no numeric path.
    17	                             The replayed output is re-serialized with
    18	                             schema_version=1 and those two keys dropped, then
    19	                             byte-compared against the published file.
    20	  MISMATCH                   anything else; the first differing JSON path is
    21	                             reported. The gate FAILS.
    22	
    23	The gate passes only if every sampled star lands in one of the identical tiers
    24	AND at least one schema-v2 star reproduces with no transform (proving full-byte
    25	reproduction of the final script's output). Campaign L-S runs are valid only on
    26	machine+env combinations where this gate has passed.
    27	"""
    28	
    29	from __future__ import annotations
    30	
    31	import argparse
    32	import json
    33	import time
    34	from concurrent.futures import ProcessPoolExecutor, as_completed
    35	from pathlib import Path
    36	
    37	from frozen_api import (
    38	    REPO_ROOT,
    39	    analyze_star,
    40	    assert_frozen,
    41	    env_versions,
    42	    json_ready,
    43	    physical_workers,
    44	)
    45	
    46	PUBLISHED_STARS = (
    47	    REPO_ROOT / "catalog-rebuild/results/2026-08-01_full/lomb-scargle/stars"
    48	)
    49	
    50	
    51	def normalize(raw: bytes) -> bytes:
    52	    return raw.replace(b"\r\n", b"\n")
    53	
    54	
    55	def schema_v1_bytes(replayed: dict) -> bytes:
    56	    downgraded = dict(replayed)
    57	    downgraded["schema_version"] = 1
    58	    downgraded["passes"] = {
    59	        name: {
    60	            key: value
    61	            for key, value in pass_result.items()
    62	            if key not in ("available", "unavailable_reason")
    63	        }
    64	        for name, pass_result in replayed["passes"].items()
    65	    }
    66	    text = json.dumps(downgraded, indent=2, default=json_ready) + "\n"
    67	    return text.encode("utf-8")
    68	
    69	
    70	def first_difference(published: object, replayed: object, path: str = "$") -> str:
    71	    if type(published) is not type(replayed):
    72	        return f"{path}: type {type(published).__name__} != {type(replayed).__name__}"
    73	    if isinstance(published, dict):
    74	        for key in sorted(set(published) | set(replayed)):
    75	            if key not in published:
    76	                return f"{path}.{key}: only in replay"
    77	            if key not in replayed:
    78	                return f"{path}.{key}: only in published"
    79	            diff = first_difference(published[key], replayed[key], f"{path}.{key}")
    80	            if diff:
    81	                return diff
    82	        return ""
    83	    if isinstance(published, list):
    84	        if len(published) != len(replayed):
    85	            return f"{path}: length {len(published)} != {len(replayed)}"
    86	        for index, (left, right) in enumerate(zip(published, replayed)):
    87	            diff = first_difference(left, right, f"{path}[{index}]")
    88	            if diff:
    89	                return diff
    90	        return ""
    91	    if published != replayed:
    92	        return f"{path}: {published!r} != {replayed!r}"
    93	    return ""
    94	
    95	
    96	def published_schema_version(path: Path) -> int:
    97	    return int(json.loads(path.read_text(encoding="utf-8"))["schema_version"])
    98	
    99	
   100	def select_stars(published_dir: Path, shard_dir: Path, count: int) -> list[str]:
   101	    available = {
   102	        path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz")
   103	    }
   104	    stars = sorted(
   105	        path.stem
   106	        for path in published_dir.glob("*.json")
   107	        if not path.name.endswith(".error.json") and path.stem in available
   108	    )
   109	    if not stars:
   110	        raise SystemExit(f"no published stars have shards in {shard_dir}")
   111	    v2 = [star for star in stars if published_schema_version(published_dir / f"{star}.json") == 2]
   112	    v1 = [star for star in stars if star not in set(v2)]
   113	    selected = list(v2)[:count]
   114	    remaining = count - len(selected)
   115	    if remaining > 0 and v1:
   116	        stride = max(1, len(v1) // remaining)
   117	        selected.extend(v1[::stride][:remaining])
   118	    return sorted(selected)
   119	
   120	
   121	def compare_star(star: str, published_dir: Path, replay_dir: Path) -> dict[str, object]:
   122	    published_path = published_dir / f"{star}.json"
   123	    replay_path = replay_dir / f"{star}.json"
   124	    published_raw = published_path.read_bytes()
   125	    replay_raw = replay_path.read_bytes()
   126	    record: dict[str, object] = {
   127	        "source_id": star,
   128	        "published_schema_version": published_schema_version(published_path),
   129	    }
   130	    if published_raw == replay_raw:
   131	        record["verdict"] = "identical"
   132	        return record
   133	    published_norm = normalize(published_raw)
   134	    replay_norm = normalize(replay_raw)
   135	    if published_norm == replay_norm:
   136	        record["verdict"] = "identical_newline"
   137	        return record
   138	    replayed = json.loads(replay_norm.decode("utf-8"))
   139	    if normalize(schema_v1_bytes(replayed)) == published_norm:
   140	        record["verdict"] = "identical_v1_schema"
   141	        return record
   142	    record["verdict"] = "MISMATCH"
   143	    record["first_difference"] = first_difference(
   144	        json.loads(published_norm.decode("utf-8")), replayed
   145	    )
   146	    return record
   147	
   148	
   149	def main() -> None:
   150	    parser = argparse.ArgumentParser(description=__doc__)
   151	    parser.add_argument("--shard-dir", type=Path, required=True,
   152	                        help="directory of <source_id>.csv.gz exposure shards")
   153	    parser.add_argument("--published-stars", type=Path, default=PUBLISHED_STARS)
   154	    parser.add_argument("--out-dir", type=Path,
   155	                        default=REPO_ROOT / "outputs/generalization/replay_gate")
   156	    parser.add_argument("--count", type=int, default=25)
   157	    parser.add_argument("--stars", nargs="*", help="explicit star list (overrides --count)")
   158	    parser.add_argument("--workers", type=int, default=None)
   159	    args = parser.parse_args()
   160	
   161	    assert_frozen()
   162	    workers = args.workers or physical_workers()
   163	    replay_dir = args.out_dir / "stars"
   164	    work_dir = args.out_dir / "work"
   165	    replay_dir.mkdir(parents=True, exist_ok=True)
   166	    work_dir.mkdir(parents=True, exist_ok=True)
   167	
   168	    stars = args.stars or select_stars(args.published_stars, args.shard_dir, args.count)
   169	    missing = [s for s in stars if not (args.shard_dir / f"{s}.csv.gz").exists()]
   170	    if missing:
   171	        raise SystemExit(f"missing shards for: {missing}")
   172	    for star in stars:
   173	        (replay_dir / f"{star}.json").unlink(missing_ok=True)
   174	
   175	    print(f"[replay] {len(stars)} stars, workers={workers}", flush=True)
   176	    started = time.time()
   177	    durations: dict[str, float] = {}
   178	    with ProcessPoolExecutor(max_workers=workers) as executor:
   179	        futures = {
   180	            executor.submit(
   181	                analyze_star,
   182	                star,
   183	                str(args.shard_dir / f"{star}.csv.gz"),
   184	                str(replay_dir / f"{star}.json"),
   185	                str(work_dir),
   186	                ("low", "high"),
   187	            ): (star, time.time())
   188	            for star in stars
   189	        }
   190	        for future in as_completed(futures):
   191	            star, _ = futures[future]
   192	            future.result()
   193	            durations[star] = round(time.time() - started, 1)
   194	            print(f"[replay] finished {star} (+{durations[star]}s)", flush=True)
   195	
   196	    records = [compare_star(star, args.published_stars, replay_dir) for star in stars]
   197	    verdicts = {record["source_id"]: record["verdict"] for record in records}
   198	    counts: dict[str, int] = {}
   199	    for verdict in verdicts.values():
   200	        counts[verdict] = counts.get(verdict, 0) + 1
   201	    if not records:
   202	        raise SystemExit("empty replay roster — the gate cannot pass vacuously")
   203	    strict_v2 = any(
   204	        record["verdict"] in ("identical", "identical_newline")
   205	        and record["published_schema_version"] == 2
   206	        for record in records
   207	    )
   208	    # strict_v2 is unconditional (G1 methods finding 2): a schema-v2 star that
   209	    # reproduces with no transform is the proof of full-byte reproduction, and
   210	    # the published bundle contains 7 of them — a roster without one is invalid.
   211	    passed = all(record["verdict"] != "MISMATCH" for record in records) and strict_v2
   212	
   213	    report = {
   214	        "gate": "replay_gate",
   215	        "passed": passed,
   216	        "verdict_counts": counts,
   217	        "stars": records,
   218	        "wall_seconds": round(time.time() - started, 1),
   219	        "completion_offsets_seconds": durations,
   220	        "workers": workers,
   221	        "env": env_versions(),
   222	        "frozen_sha256": assert_frozen(),
   223	    }
   224	    report_path = args.out_dir / "replay_report.json"
   225	    report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
   226	    print(f"[replay] {'PASS' if passed else 'FAIL'} {counts} -> {report_path}", flush=True)
   227	    raise SystemExit(0 if passed else 1)
   228	
   229	
   230	if __name__ == "__main__":
   231	    main()

