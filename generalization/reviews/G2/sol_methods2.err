   117	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None) -> dict:
   118	    result = json.loads(json_path.read_text(encoding="utf-8"))
   119	    if not result.get("complete"):
   120	        raise SystemExit(f"{json_path} is not complete")
   121	    passes = result["passes"]
   122	    if set(passes) != {"low", "high"}:
   123	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   124	    baseline = float(result["baseline_days"])
   125	    tol = 1.5 / baseline
   126	    overall = overall_result(result)
   127	
   128	    row: dict = {
   129	        "baseline_days": baseline,
   130	        "n_exp_zg": result["n_exp_zg"],
   131	        "n_exp_zr": result["n_exp_zr"],
   132	        "best_pass": overall["best_pass"],
   133	        "best_status": overall["blind_status"],
   134	        "best_frequency_per_day": overall["best_frequency_per_day"],
   135	        "low_available": passes["low"].get("available", True),
   136	        "high_available": passes["high"].get("available", True),
   137	    }
   138	    any_direct_top = False
   139	    for name in ("low", "high"):
   140	        p = passes[name]
   141	        freq = p.get("frequency_per_day")
   142	        row[f"{name}_status"] = p["status"]
   143	        row[f"{name}_frequency_per_day"] = freq
   144	        row[f"{name}_match"] = (
   145	            classify_match(float(freq), truth_freqs, tol)
   146	            if freq is not None and truth_freqs else "unscored"
   147	        )
   148	        row[f"{name}_eligible"] = pass_eligible(truth_freqs, name, baseline)
   149	        for peak in p.get("top_peaks", []):
   150	            f_peak = peak.get("frequency_per_day")
   151	            if f_peak is not None and truth_freqs and \
   152	               classify_match(float(f_peak), truth_freqs, tol) == "direct":
   153	                any_direct_top = True
   154	    best_freq = row["best_frequency_per_day"]
   155	    row["best_match"] = (
   156	        classify_match(float(best_freq), truth_freqs, tol)
   157	        if best_freq is not None and truth_freqs else "unscored"
   158	    )
   159	    row["best_match_primary"] = (
   160	        classify_match(float(best_freq), [primary_freq], tol)
   161	        if best_freq is not None and primary_freq is not None else "unscored"
   162	    )
   163	    row["matched_any_mode_diagnostic"] = any_direct_top
   164	    row["eligible_any_pass"] = row["low_eligible"] or row["high_eligible"]
   165	    return row
