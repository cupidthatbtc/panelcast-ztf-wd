    89	def main() -> None:
    90	    parser = argparse.ArgumentParser(description=__doc__)
    91	    parser.add_argument("--roster", type=Path, required=True)
    92	    parser.add_argument("--cache-dir", type=Path, required=True,
    93	                        help="IRSA response cache: <source_id>.csv per target")
    94	    parser.add_argument("--out-dir", type=Path, required=True)
    95	    parser.add_argument("--allow-nonstandard-ids", action="store_true")
    96	    parser.add_argument("--panel-report", type=Path, default=None,
    97	                        help="panel_golden_report.json from a PASSING "
    98	                             "panel_golden_gate run on THIS machine+env; "
    99	                             "required unless --allow-nonstandard-ids")
   100	    args = parser.parse_args()
   101	
   102	    assert_frozen()
   103	    campaign_start = campaign_file_shas()
   104	    if args.panel_report is None and not args.allow_nonstandard_ids:
   105	        raise SystemExit("campaign panel builds require --panel-report "
   106	                         "(panel_golden_gate PASS on this machine)")
   107	    if args.panel_report is not None:
   108	        gate = json.loads(args.panel_report.read_text(encoding="utf-8"))
   109	        if gate.get("gate") != "panel_golden_gate" or gate.get("passed") is not True:
   110	            raise SystemExit(f"{args.panel_report} is not a panel-gate PASS")
   111	        current = env_versions()
   112	        mismatched = [k for k in current if gate["env"].get(k) != current.get(k)]
   113	        if mismatched:
   114	            raise SystemExit(f"panel attestation env differs: {mismatched}")
   115	    args.out_dir.mkdir(parents=True, exist_ok=True)
   116	    exposure_star_dir = args.out_dir / "exposure_stars"
   117	    exposure_star_dir.mkdir(parents=True, exist_ok=True)
   118	
   119	    roster = pd.read_csv(args.roster, dtype={"source_id": str})
   120	    if not args.allow_nonstandard_ids:
   121	        bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
   122	        if bad:
   123	            raise SystemExit(f"{len(bad)} roster ids violate the campaign convention: {bad[:3]}")
   124	
   125	    qc_rows: list[dict[str, object]] = []
   126	    census_rows: list[dict[str, object]] = []
   127	    crossmatched = 0
   128	
   129	    for index, (_, row) in enumerate(roster.iterrows(), 1):
   130	        meta = roster_meta(row)
   131	        cache_path = args.cache_dir / f"{meta.source_id}.csv"
   132	        qc: dict[str, object] = {
   133	            "source_id": meta.source_id,
   134	            "external_id": meta.wdj_name,
   135	            "class_label": meta.wd_class,
   136	            "cache_present": cache_path.exists() and cache_path.stat().st_size > 0,
   137	            "read_status": "ok",
   138	        }
   139	        if not qc["cache_present"]:
   140	            qc["read_status"] = "missing"
   141	            qc_rows.append(qc)
   142	            continue
   143	        try:
   144	            raw = read_cache(cache_path)
   145	            qc["raw_rows"] = len(raw)
   146	            selected, separation, n_objects, n_selected = select_nearest_source(
   147	                raw, float(row["ra"]), float(row["dec"])
   148	            )
   149	            clean, drop_counts = clean_rows(selected)
   150	            qc.update(drop_counts)
   151	            qc["nearest_separation_arcsec"] = separation
   152	            qc["ztf_objects_in_cone"] = n_objects
   153	            qc["selected_ztf_objects"] = n_selected
   154	        except Exception as exc:
   155	            qc["read_status"] = "error"
   156	            qc["error"] = repr(exc)
   157	            qc_rows.append(qc)
   158	            continue
   159	
   160	        for band in BANDS:
   161	            qc[f"{band}_raw_rows"] = int((raw["filtercode"] == band).sum())
   162	            qc[f"{band}_clean_rows"] = int((clean["band"] == band).sum())
   163	        is_crossmatched = all(
   164	            qc[f"{band}_clean_rows"] >= MIN_EXPOSURES_PER_BAND for band in BANDS
   165	        )
   166	        qc["crossmatched"] = is_crossmatched
   167	        qc_rows.append(qc)
   168	        if not is_crossmatched:
   169	            continue
   170	
   171	        crossmatched += 1
   172	        clean["source_id"] = meta.source_id
