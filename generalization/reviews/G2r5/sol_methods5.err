   326	                "n_modes_injected": 0, "n_modes_rejected": 0,
   327	            })
   328	            if (serial + 1) % 200 == 0:
   329	                print(f"[d2-shards] nulls {serial + 1}/{N_NULLS}", flush=True)
   330	
   331	    frame = pd.DataFrame(manifest)
   332	    frame.to_csv(args.out_dir / "shard_manifest.csv", index=False)
   333	    (args.out_dir / "shard_index.txt").write_text(
