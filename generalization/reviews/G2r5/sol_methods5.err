     1	#!/usr/bin/env python3
     2	"""Resumable, shardable campaign driver over the frozen analyze_star.
     3	
     4	This is the ONLY way campaign Lomb-Scargle searches run. It imports
     5	analyze_star through frozen_api (SHA-gated) and never invokes the frozen CLI,
     6	whose main() would merge against the WD roster and rewrite the published
     7	catalog table. Per-star JSONs are the product; no roster merge, no CSV — the
     8	campaign metrics read the JSONs directly (METRICS_SPEC.md).
     9	
    10	Resumability is inherited from analyze_star: a complete result file is
    11	returned untouched, so re-running after a crash or shard split is safe.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import argparse
    17	import hashlib
    18	import json
    19	import shutil
    20	import time
    21	from concurrent.futures import ProcessPoolExecutor, as_completed
    22	from pathlib import Path
    23	
    24	from frozen_api import (
    25	    analyze_star,
    26	    assert_frozen,
    27	    campaign_file_shas,
    28	    campaign_id_ok,
    29	    env_versions,
    30	    frozen_file_shas,
    31	    physical_workers,
    32	)
    33	
    34	def validate_attestation(report_path: Path) -> dict:
    35	    report = json.loads(report_path.read_text(encoding="utf-8"))
    36	    if report.get("gate") != "replay_gate":
    37	        raise SystemExit(f"{report_path} is not a replay_gate report")
    38	    if report.get("passed") is not True:
    39	        raise SystemExit(f"replay attestation {report_path} is not a PASS")
    40	    if not report.get("stars"):
    41	        raise SystemExit(f"replay attestation {report_path} has an empty roster")
    42	    current = env_versions()
    43	    # the FULL environment fingerprint must match (G2 methods finding 1)
    44	    mismatched = [
    45	        key for key in current
    46	        if report["env"].get(key) != current.get(key)
    47	    ]
    48	    if mismatched:
    49	        raise SystemExit(
    50	            f"replay attestation env differs from this run: {mismatched} "
    51	            f"(attested {[report['env'].get(k) for k in mismatched]} vs "
    52	            f"current {[current.get(k) for k in mismatched]})"
    53	        )
    54	    if report.get("frozen_sha256") != frozen_file_shas():
    55	        raise SystemExit("replay attestation frozen SHAs differ from this checkout")
    56	    unique = {record["source_id"] for record in report["stars"]}
    57	    if len(unique) != 928 or len(report["stars"]) != 928:
    58	        raise SystemExit(
    59	            f"production runs require the FULL 928-UNIQUE-star baseline "
    60	            f"attestation; this report covers {len(unique)} unique of "
    61	            f"{len(report['stars'])} records"
    62	        )
    63	    return report
    64	
    65	# One in-flight star holds two full-resolution float32 periodogram memmaps plus
    66	# the multiband combination on scratch; the worst published-catalog baseline
    67	# needs 0.471 GB for the three high-pass memmaps, so 0.52 adds ~10% headroom
    68	# for longer campaign baselines. Disk, not wall time, binds worker count.
    69	SCRATCH_GB_PER_WORKER = 0.52
    70	
    71	
    72	def preflight_workers(requested: int | None, work_root: Path) -> tuple[int, float]:
    73	    if requested is not None and requested < 1:
    74	        raise SystemExit(f"invalid --workers {requested}")
    75	    free_gb = shutil.disk_usage(work_root).free / 1e9
    76	    ceiling = int(free_gb * 0.5 / SCRATCH_GB_PER_WORKER)
    77	    if ceiling < 1:
    78	        raise SystemExit(
    79	            f"scratch {work_root} has {free_gb:.1f} GB free — below one worker's "
    80	            f"{SCRATCH_GB_PER_WORKER} GB requirement"
    81	        )
    82	    workers = min(requested or physical_workers(), physical_workers(), ceiling)
    83	    return workers, free_gb
