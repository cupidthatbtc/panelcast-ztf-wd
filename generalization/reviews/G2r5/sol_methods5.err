    86	def shard_sha256(path: Path) -> str:
    87	    return hashlib.sha256(path.read_bytes()).hexdigest()
    88	
    89	
    90	def env_digest() -> str:
    91	    return hashlib.sha256(
    92	        json.dumps(env_versions(), sort_keys=True).encode()
    93	    ).hexdigest()
