   100	def write_provenance(star_dir: Path, source_id: str, shard: Path) -> None:
   101	    provenance_path(star_dir, source_id).write_text(
   102	        json.dumps({
   103	            "shard_sha256": shard_sha256(shard),
   104	            "env_digest": env_digest(),
   105	            "driver": "run_generalization_ls.py",
   106	        }, indent=2) + "\n",
   107	        encoding="utf-8",
