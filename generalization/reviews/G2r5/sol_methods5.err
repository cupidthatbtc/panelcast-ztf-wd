     1	#!/usr/bin/env python3
     2	"""Single import surface for the frozen 2026-08-01 pipeline.
     3	
     4	The generalization campaign (branch generalization/campaign-1) never edits the
     5	scripts that produced the published 2026-08-01_full bundle. Campaign code
     6	imports frozen callables ONLY through this module, which verifies the SHA-256
     7	of every frozen file against the values recorded at tag `frozen-2026-08-01`
     8	before any import happens. `assert_frozen()` is also called explicitly at the
     9	top of every campaign script.
    10	
    11	Referee defense: `git diff frozen-2026-08-01 -- <frozen files>` is empty, and
    12	scripts/generalization/replay_gate.py reproduces published per-star results
    13	under these imports.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import hashlib
    19	import os
    20	import platform
    21	import sys
    22	from pathlib import Path
    23	
    24	REPO_ROOT = Path(
    25	    os.environ.get("GENERALIZATION_REPO_ROOT", Path(__file__).resolve().parents[2])
    26	)
    27	SCRIPTS_DIR = REPO_ROOT / "scripts"
    28	
    29	FROZEN_TAG = "frozen-2026-08-01"
    30	
    31	# SHA-256 of every frozen file at tag frozen-2026-08-01 (== branch point of
    32	# generalization/campaign-1). Recorded 2026-08-28; never update these values —
    33	# a mismatch means the frozen pipeline was edited and all campaign results are void.
    34	FROZEN_SHA256 = {
    35	    "scripts/run_catalog_lomb_scargle.py": "34a4de5d234cab07dc3231e5671f4220f5c4ab1bdd4b3d92183bb7e443da6c46",
    36	    "scripts/run_lomb_scargle.py": "ce9211254949969b5d2e7a93f350eb387014aaf0a15f939753c599c1261a4e78",
    37	    "scripts/lomb_scargle_common.py": "5ed3983e6a9b91f86b4ba2afc37025ba97fee4ef8a0086259140618927bfef7d",
    38	    "scripts/build_catalog_panels.py": "1fb659cfdf6997751bc7589b70bdd26fa0d210f49e0e9da5da82bcbb1a5d9794",
    39	    "scripts/fetch_catalog_lightcurves.py": "e28f4ade76fedf78e056b26b62549a4c5dfc1e0c76d5d127876cce7b3cb3ed82",
    40	}
    41	
    42	# Campaign source_id convention: 19-digit numeric strings, dataset-prefixed.
    43	# All prefixes chosen so ids cannot collide with real Gaia DR3 source_ids used
    44	# in the 2026-08-01 run and so int(source_id[-9:]) (the frozen bootstrap's seed
    45	# convention) is always a valid int.
    46	CAMPAIGN_ID_PREFIXES = {
    47	    "90": "D3 ZTF x Kepler delta Scuti (real ZTF light curves)",
    48	    "92": "D2 arm B (TESS-truth signal + real ZTF photometry)",
    49	    "93": "D2 arm A (TESS-truth signal + synthetic Gaussian floor)",
    50	    "94": "D2 Gaussian nulls (zero amplitude, arm-A floor)",
    51	    "95": "D2 paired real-window controls (uninjected template windows)",
    52	    "96": "D2 self-window templates (real ZTF at Romero positions; diagnostic)",
    53	}
    54	
    55	
    56	class FrozenIntegrityError(RuntimeError):
    57	    """A frozen file's content no longer matches tag frozen-2026-08-01."""
    58	
    59	
    60	def frozen_file_shas() -> dict[str, str]:
    61	    shas: dict[str, str] = {}
    62	    for rel in FROZEN_SHA256:
    63	        path = REPO_ROOT / rel
    64	        shas[rel] = hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "MISSING"
    65	    return shas
    66	
    67	
    68	def assert_frozen() -> dict[str, str]:
    69	    actual = frozen_file_shas()
    70	    mismatches = [
    71	        f"{rel}: expected {expected[:12]}..., found {actual[rel][:12]}..."
    72	        for rel, expected in FROZEN_SHA256.items()
    73	        if actual[rel] != expected
    74	    ]
    75	    if mismatches:
    76	        raise FrozenIntegrityError(
    77	            "frozen pipeline files modified since tag "
    78	            f"{FROZEN_TAG}:\n" + "\n".join(mismatches)
    79	        )
    80	    return actual
    81	
    82	
    83	def env_versions() -> dict[str, str]:
    84	    import astropy
    85	    import astropy_iers_data
    86	    import erfa
    87	    import numpy
    88	    import pandas
    89	    import scipy
    90	
    91	    blas = ""
    92	    try:
    93	        config = numpy.__config__.CONFIG["Build Dependencies"]["blas"]
    94	        blas = f"{config.get('name', '')} {config.get('version', '')}".strip()
    95	    except Exception:
    96	        pass
    97	    return {
    98	        "python": platform.python_version(),
    99	        "platform": platform.platform(),
   100	        "machine": platform.node(),
   101	        "numpy": numpy.__version__,
   102	        "numpy_blas": blas,
   103	        "scipy": scipy.__version__,
   104	        "astropy": astropy.__version__,
   105	        "astropy_iers_data": astropy_iers_data.__version__,
   106	        "pyerfa": erfa.__version__,
   107	        "pandas": pandas.__version__,
   108	        "omp_num_threads": os.environ.get("OMP_NUM_THREADS", ""),
   109	        "openblas_num_threads": os.environ.get("OPENBLAS_NUM_THREADS", ""),
   110	    }
   111	
   112	
   113	def campaign_file_shas() -> dict[str, str]:
   114	    """SHA-256 of every campaign script + spec, recorded in every manifest so
   115	    adapter-shell drift is visible (G1 methods finding 9)."""
   116	    shas: dict[str, str] = {}
   117	    for path in sorted((REPO_ROOT / "scripts/generalization").glob("*.py")):
   118	        shas[f"scripts/generalization/{path.name}"] = hashlib.sha256(
   119	            path.read_bytes()
   120	        ).hexdigest()
   121	    for rel in ("generalization/GENERALIZATION_PLAN.md", "generalization/METRICS_SPEC.md"):
   122	        path = REPO_ROOT / rel
   123	        if path.exists():
   124	            shas[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
   125	    return shas
   126	
   127	
   128	def campaign_id_ok(source_id: str) -> bool:
   129	    return (
   130	        isinstance(source_id, str)
   131	        and len(source_id) == 19
   132	        and source_id.isdigit()
   133	        and source_id[:2] in CAMPAIGN_ID_PREFIXES
   134	    )
   135	
   136	
   137	assert_frozen()
   138	_FROZEN_MODULES = (
   139	    "run_catalog_lomb_scargle",
   140	    "run_lomb_scargle",
   141	    "lomb_scargle_common",
   142	    "build_catalog_panels",
   143	)
   144	for _name in _FROZEN_MODULES:
   145	    if _name in sys.modules:
   146	        raise FrozenIntegrityError(
   147	            f"{_name} was imported before frozen_api verified it"
   148	        )
   149	sys.path.insert(0, str(SCRIPTS_DIR))
   150	
   151	from build_catalog_panels import (  # noqa: E402
   152	    BANDS,
   153	    EXPOSURE_COLUMNS,
   154	    MIN_EXPOSURES_PER_BAND,
   155	    MONTHLY_COLUMNS,
   156	    NIGHTLY_COLUMNS,
   157	    OID_CLUSTER_ARCSEC,
   158	    PALOMAR,
   159	    add_bjd,
   160	    angular_separation_arcsec,
   161	    census_row,
   162	    clean_rows,
   163	    monthly_panel,
   164	    nightly_panel,
