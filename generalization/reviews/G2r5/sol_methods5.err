     1	#!/usr/bin/env python3
     2	"""Synthesize D2 exposure shards: DAV truth signals in real ZTF windows.
     3	
     4	Template pool: ALL 928 stars of the published 2026-08-01 catalog — NOT the
     5	510 not-detected subset (G1 referee finding 1: conditioning templates on the
     6	pipeline's own non-detection is a circularity path). Native variability is
     7	handled by frequency-matched scoring plus paired controls. Every shard
     8	preserves the template's real epochs (bjd_tdb), real cadence structure and
     9	real magerr; arms differ in what carries the noise:
    10	
    11	  arm B (92…)  signal added to the REAL ZTF magnitudes — the headline arm
    12	               ("TESS-truth signals injected into real ZTF photometry").
    13	  ctrl (95…)   paired uninjected copy of every unique arm-B template window —
    14	               identifies windows that trigger natively (real variables in
    15	               the pool), so injected-recovery is scored against its own
    16	               window's baseline behavior.
    17	  arm A (93…)  signal added to a synthetic Gaussian floor (median mag +
    18	               N(0, magerr_i)) — diagnostic; separates window effects from
    19	               real-noise effects.
    20	  nulls (94…)  arm-A construction with amplitude_scale = 0 — 1,000 shards
    21	               cycling the 928 windows with distinct noise seeds (windows
    22	               repeat, noise does not). This measures the GAUSSIAN-NULL
    23	               false-alarm rate, not a real-sky FPR (G1 stats finding 11).
    24	
    25	Template matching per target: |median zg mag − target G| <= 0.25 (widened to
    26	0.5, then nearest-K, when the pool is thin — flagged in the manifest);
    27	K=3 at the 10/50/90th percentiles of median-exposures-per-night, because 75%
    28	of zg nights are single-exposure and per-night median subtraction is the
    29	pre-registered dominant penalty (plan risk 3).
    30	
    31	Run matrix (plan): nominal (1.7, 0.80) on K=3 for arms A+B; the other 8
    32	ladder points on the median template only; 1,000 nulls.
    33	
    34	Campaign id layout (19 digits): AA TTTTTTTTTT K GR PS 00
    35	  AA arm prefix (92/93), T zero-padded TIC, K template index (0/1/2),
    36	  G/R ladder indices (1-3) into {1.4,1.7,2.1} x {0.70,0.80,0.90} (22 =
    37	  nominal), P phase-draw (0-2), S amplitude-scale code (0 = 1.0, 1 = 0.7,
    38	  2 = 1.3).
    39	  Nulls: 94 + 17-digit serial. Controls: 95 + 17-digit index of the template
    40	  in the SORTED FIXED 928-window pool — stable across invocations and roster
    41	  subsets (G2 methods finding 3). Full mapping in shard_manifest.csv.
    42	
    43	Truth preservation (G2 methods finding 4): every shard's actually-injected
    44	modes (post sinc rejection, with signed factors and phases) go to
    45	injected_modes.csv and the rejected ones to rejected_modes.csv; the metrics
    46	scorer consumes injected_modes.csv, never the original mode table.
    47	"""
    48	
    49	from __future__ import annotations
    50	
    51	import argparse
    52	import gzip
    53	import json
    54	from pathlib import Path
    55	
    56	import numpy as np
    57	import pandas as pd
    58	
    59	from d2_truth_model import (
    60	    BANDPASS_LADDER_G,
    61	    BANDPASS_LADDER_RG,
    62	    NOMINAL_G,
    63	    NOMINAL_RG,
    64	    build_truth_model,
    65	)
    66	from frozen_api import (
    67	    EXPOSURE_COLUMNS,
    68	    REPO_ROOT,
    69	    assert_frozen,
    70	    campaign_file_shas,
    71	    campaign_id_ok,
    72	)
    73	
    74	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
    75	MATCH_TOL_MAG = 0.25
    76	MATCH_TOL_WIDE = 0.5
    77	N_NULLS = 1000
    78	
    79	
    80	def load_templates(exposures_path: Path, catalog_path: Path) -> tuple[pd.DataFrame, dict]:
    81	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
    82	    if len(catalog) != 928:
    83	        raise SystemExit(f"published catalog has {len(catalog)} rows, expected 928")
    84	    pool_ids = set(catalog["source_id"])
    85	    status = catalog.set_index("source_id")["blind_status"].to_dict()
    86	    exposures = pd.read_csv(
    87	        exposures_path,
    88	        dtype={"source_id": str, "band": str},
    89	        usecols=EXPOSURE_COLUMNS,
    90	    )
    91	    exposures = exposures[exposures["source_id"].isin(pool_ids)]
    92	    zg = exposures[exposures["band"] == "zg"]
    93	    stats = zg.groupby("source_id").agg(
    94	        median_zg=("mag", "median"),
    95	        n_zg=("mag", "size"),
    96	    )
    97	    epn = (
    98	        zg.groupby(["source_id", "night_mjd"]).size().groupby("source_id").median()
    99	        .rename("exp_per_night")
   100	    )
   101	    stats = stats.join(epn)
   102	    stats["blind_status"] = [status[sid] for sid in stats.index]
   103	    frames = {sid: frame for sid, frame in exposures.groupby("source_id")}
   104	    return stats.reset_index(), frames
   105	
   106	
   107	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
   108	    for tol, label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
   109	        pool = stats[(stats["median_zg"] - gmag).abs() <= tol]
   110	        if len(pool) >= 3:
   111	            break
   112	    else:
   113	        label = "nearest"
   114	    if len(pool) < 3:
   115	        pool = stats.iloc[(stats["median_zg"] - gmag).abs().argsort()[:9]]
   116	    ordered = pool.sort_values(["exp_per_night", "source_id"]).reset_index(drop=True)
   117	    picks = [
   118	        ordered.iloc[min(len(ordered) - 1, int(round(q * (len(ordered) - 1))))]["source_id"]
   119	        for q in (0.10, 0.50, 0.90)
   120	    ]
   121	    return picks, label
   122	
   123	
   124	AMP_SCALE_CODES = {1.0: 0, 0.7: 1, 1.3: 2, "drop": 3}
   125	
   126	
   127	def campaign_id(arm_prefix: str, tic: int, k: int, g_idx: int, r_idx: int,
   128	                phase_draw: int = 0, amp_scale: float = 1.0) -> str:
   129	    return (f"{arm_prefix}{tic:010d}{k}{g_idx}{r_idx}"
   130	            f"{phase_draw}{AMP_SCALE_CODES[amp_scale]}00")
   131	
   132	
   133	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   134	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   135	        frame[EXPOSURE_COLUMNS].to_csv(handle, index=False, lineterminator="\n")
   136	
   137	
   138	def synthesize(
   139	    template: pd.DataFrame,
   140	    model,
   141	    source_id: str,
   142	    gaussian_floor: bool,
   143	    seed: int,
   144	) -> pd.DataFrame:
   145	    frame = template.copy()
   146	    frame["source_id"] = source_id
   147	    t_ref = float(frame["bjd_tdb"].min())
   148	    if gaussian_floor:
   149	        rng = np.random.Generator(np.random.PCG64(seed))
   150	        for band in ("zg", "zr"):
   151	            mask = frame["band"] == band
   152	            median = float(frame.loc[mask, "mag"].median())
   153	            noise = rng.normal(0.0, frame.loc[mask, "magerr"].to_numpy(dtype=float))
   154	            frame.loc[mask, "mag"] = median + noise
   155	    for band in ("zg", "zr"):
   156	        mask = frame["band"] == band
   157	        frame.loc[mask, "mag"] = frame.loc[mask, "mag"] + model.evaluate(
   158	            frame.loc[mask, "bjd_tdb"].to_numpy(dtype=float), band, t_ref
   159	        )
   160	    return frame
   161	
