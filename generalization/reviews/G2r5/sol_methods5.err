   207	    )
   208	    manifest: list[dict] = []
   209	
   210	    for target in targets.itertuples(index=False):
   211	        star_modes = modes[modes["tic"] == target.tic]
   212	        periods = star_modes["period_s"].tolist()
   213	        amps = star_modes["amp_ppt"].tolist()
   214	        picks, match_label = match_templates(stats, float(target.gmag))
   215	        variants = []
   216	        if "b" in arms or "a" in arms:
   217	            variants.append((*nominal, (0, 1, 2)))
   218	        if "ladder" in arms:
   219	            variants.extend((gi, ri, g, r, (1,)) for gi, ri, g, r in ladder
   220	                            if not (g == NOMINAL_G and r == NOMINAL_RG))
   221	        if "phase" in arms:
   222	            variants.extend((nominal[0], nominal[1], nominal[2], nominal[3], (1,),
   223	                             d, 1.0) for d in (1, 2))
   224	        if "ampscale" in arms:
   225	            variants.extend((nominal[0], nominal[1], nominal[2], nominal[3], (1,),
   226	                             0, sc) for sc in (0.7, 1.3))
   227	        if "dropout" in arms and len(periods) > 1:
   228	            variants.append((nominal[0], nominal[1], nominal[2], nominal[3], (1,),
   229	                             0, "drop"))
   230	        for entry in variants:
   231	            gi, ri, g, r, template_ks = entry[:5]
   232	            phase_draw = entry[5] if len(entry) > 5 else 0
