   335	    pd.DataFrame(injected_rows).to_csv(args.out_dir / "injected_modes.csv", index=False)
   336	    pd.DataFrame(rejected_rows).to_csv(args.out_dir / "rejected_modes.csv", index=False)
   337	    unique_rejected = {
