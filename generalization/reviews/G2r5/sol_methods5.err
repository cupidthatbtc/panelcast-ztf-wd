   183	                             "without one (G1 methods finding 1)")
   184	    args = parser.parse_args()
   185	
   186	    assert_frozen()
   187	    campaign_shas_start = campaign_file_shas()
   188	    attestation = validate_attestation(args.replay_report)
   189	    passes = tuple(args.passes.split(","))
   190	    if passes != ("low", "high") and not args.allow_nonstandard_ids:
   191	        raise SystemExit("production runs use exactly low,high (the frozen CLI's "
   192	                         "pass set); pass --allow-nonstandard-ids for debug runs")
   193	    star_dir = args.out_dir / "stars"
   194	    work_root = args.work_root or (args.out_dir / "work")
   195	    star_dir.mkdir(parents=True, exist_ok=True)
   196	    work_root.mkdir(parents=True, exist_ok=True)
   197	
   198	    if args.expect_count is not None:
   199	        found = len(list(args.shard_dir.glob("*.csv.gz")))
   200	        if found != args.expect_count:
   201	            raise SystemExit(
   202	                f"shard dir holds {found} shards, expected {args.expect_count} "
   203	                f"— stale or incomplete directory"
   204	            )
   205	    if args.shard_index is None and not args.allow_nonstandard_ids:
   206	        raise SystemExit("production runs require --shard-index (builders emit "
   207	                         "shard_index.txt); --allow-nonstandard-ids for debug")
   208	    if args.shard_index is not None:
   209	        index_ids = {line.strip() for line in
   210	                     args.shard_index.read_text().splitlines() if line.strip()}
   211	        disk_ids = {path.name.split(".csv")[0]
   212	                    for path in args.shard_dir.glob("*.csv.gz")}
   213	        if disk_ids != index_ids:
   214	            extra = sorted(disk_ids - index_ids)[:3]
   215	            gone = sorted(index_ids - disk_ids)[:3]
   216	            raise SystemExit(
   217	                f"shard dir does not match the index: {len(disk_ids - index_ids)} "
   218	                f"extra (e.g. {extra}), {len(index_ids - disk_ids)} missing "
   219	                f"(e.g. {gone})"
   220	            )
   221	    only = None
   222	    if args.stars_file:
   223	        only = {line.strip() for line in args.stars_file.read_text().splitlines() if line.strip()}
   224	    pending, total = scan_pending(args.shard_dir, star_dir, passes, only, args.limit)
   225	
   226	    if not args.allow_nonstandard_ids:
   227	        bad = [sid for sid in pending if not campaign_id_ok(sid)]
   228	        if bad:
   229	            raise SystemExit(
   230	                f"{len(bad)} shard ids violate the campaign 19-digit prefix "
   231	                f"convention (first: {bad[:3]}); refusing to run"
   232	            )
   233	
   234	    workers, free_gb = preflight_workers(args.workers, work_root)
   235	    print(
   236	        f"[{args.dataset}] sources={total:,} pending={len(pending):,} "
   237	        f"workers={workers} (free {free_gb:.0f} GB on scratch)",
   238	        flush=True,
   239	    )
   240	
   241	    progress_path = args.out_dir / "progress.json"
   242	    started = time.time()
   243	    failures: dict[str, str] = {}
   244	    completed_now = 0
   245	
   246	    def progress_payload() -> dict:
   247	        elapsed = time.time() - started
   248	        rate = completed_now / elapsed if elapsed > 0 else 0.0
   249	        return {
   250	            "dataset": args.dataset,
   251	            "total": total,
   252	            "pending_at_start": len(pending),
   253	            "completed_now": completed_now,
   254	            "failed": len(failures),
   255	            "elapsed_seconds": round(elapsed, 1),
   256	            "stars_per_hour": round(rate * 3600.0, 2),
   257	            "eta_hours": round((len(pending) - completed_now - len(failures)) / (rate * 3600.0), 2)
   258	            if rate > 0
   259	            else None,
   260	            "workers": workers,
   261	        }
   262	
   263	    write_progress(progress_path, progress_payload())
   264	    with ProcessPoolExecutor(max_workers=workers) as executor:
   265	        futures = {
   266	            executor.submit(
   267	                analyze_star,
   268	                source_id,
   269	                str(args.shard_dir / f"{source_id}.csv.gz"),
   270	                str(star_dir / f"{source_id}.json"),
   271	                str(work_root),
   272	                passes,
   273	            ): source_id
   274	            for source_id in pending
   275	        }
   276	        for future in as_completed(futures):
   277	            source_id = futures[future]
   278	            try:
   279	                future.result()
   280	                write_provenance(star_dir, source_id,
   281	                                 args.shard_dir / f"{source_id}.csv.gz")
   282	                completed_now += 1
   283	            except Exception as exc:
   284	                failures[source_id] = repr(exc)
   285	                print(f"[{args.dataset}] FAILED {source_id}: {exc}", flush=True)
   286	            if completed_now % 10 == 0 or completed_now + len(failures) == len(pending):
   287	                write_progress(progress_path, progress_payload())
   288	                print(
   289	                    f"[{args.dataset}] {completed_now:,}/{len(pending):,} "
   290	                    f"({progress_payload()['stars_per_hour']}/h)",
   291	                    flush=True,
   292	                )
   293	
   294	    manifest = {
   295	        "dataset": args.dataset,
   296	        "driver": "run_generalization_ls.py",
   297	        "source_count": total,
   298	        "pending_at_start": len(pending),
   299	        "completed_now": completed_now,
   300	        "failures": failures,
   301	        "passes": list(passes),
   302	        "workers": workers,
   303	        "wall_seconds": round(time.time() - started, 1),
   304	        "shard_dir": str(args.shard_dir),
   305	        "env": env_versions(),
   306	        "frozen_sha256": assert_frozen(),
   307	        "campaign_sha256": campaign_file_shas(),
   308	        "replay_attestation": {
   309	            "path": str(args.replay_report),
   310	            "wall_seconds": attestation.get("wall_seconds"),
   311	            "verdict_counts": attestation.get("verdict_counts"),
   312	        },
   313	    }
   314	    if campaign_file_shas() != campaign_shas_start:
   315	        raise SystemExit("campaign code changed mid-run — results void")
   316	    (args.out_dir / "manifest.json").write_text(
   317	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   318	    )
   319	    write_progress(progress_path, progress_payload())
   320	    print(f"[{args.dataset}] done: {completed_now:,} completed, {len(failures)} failed", flush=True)
   321	    if failures:
   322	        raise SystemExit(1)
   323	
   324	
   325	if __name__ == "__main__":
   326	    main()

