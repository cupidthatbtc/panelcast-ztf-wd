   274	                        rejected_rows.append({"campaign_id": sid, **rejected})
   275	                    manifest.append({
   276	                        "campaign_id": sid, "arm": "A" if gaussian else "B",
   277	                        "tic": int(target.tic), "template_source_id": template_id,
   278	                        "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   279	                        "template_exp_per_night": float(
