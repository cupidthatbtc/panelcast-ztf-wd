    85	
    86	def shard_sha256(path: Path) -> str:
    87	    return hashlib.sha256(path.read_bytes()).hexdigest()
    88	
    89	
    90	def env_digest() -> str:
    91	    return hashlib.sha256(
    92	        json.dumps(env_versions(), sort_keys=True).encode()
    93	    ).hexdigest()
    94	
    95	
    96	def provenance_path(star_dir: Path, source_id: str) -> Path:
    97	    return star_dir / f"{source_id}.prov.json"
    98	
    99	
   100	def write_provenance(star_dir: Path, source_id: str, shard: Path) -> None:
   101	    provenance_path(star_dir, source_id).write_text(
   102	        json.dumps({
   103	            "shard_sha256": shard_sha256(shard),
   104	            "env_digest": env_digest(),
   105	            "driver": "run_generalization_ls.py",
   106	        }, indent=2) + "\n",
   107	        encoding="utf-8",
   108	    )
   109	
   110	
   111	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
   112	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
   113	    """A completed result is reused ONLY when its provenance sidecar matches
   114	    the current shard content and environment (G1 methods finding 8); stale
   115	    results are DELETED so analyze_star's internal early-return cannot
   116	    resurrect them."""
   117	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
   118	    if only is not None:
   119	        missing = only - set(source_ids)
   120	        if missing:
   121	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
   122	        source_ids = [sid for sid in source_ids if sid in only]
   123	    if limit is not None:
   124	        source_ids = source_ids[:limit]
   125	    current_env = env_digest()
   126	    pending = []
   127	    for source_id in source_ids:
   128	        result_path = star_dir / f"{source_id}.json"
   129	        prov_file = provenance_path(star_dir, source_id)
   130	        if result_path.exists() and prov_file.exists():
   131	            try:
   132	                result = json.loads(result_path.read_text(encoding="utf-8"))
   133	                prov = json.loads(prov_file.read_text(encoding="utf-8"))
   134	                if (
   135	                    result.get("complete")
   136	                    and set(result.get("passes", {})) >= set(passes)
   137	                    and prov.get("shard_sha256")
   138	                    == shard_sha256(shard_dir / f"{source_id}.csv.gz")
   139	                    and prov.get("env_digest") == current_env
   140	                ):
   141	                    continue
   142	            except json.JSONDecodeError:
   143	                pass
   144	        result_path.unlink(missing_ok=True)
   145	        prov_file.unlink(missing_ok=True)
   146	        pending.append(source_id)
   147	    return pending, len(source_ids)
   148	
   149	
   150	def write_progress(path: Path, payload: dict) -> None:
   151	    temporary = path.with_suffix(".json.part")
   152	    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
   153	    temporary.replace(path)
   154	
   155	
   156	def main() -> None:
   157	    parser = argparse.ArgumentParser(description=__doc__)
   158	    parser.add_argument("--shard-dir", type=Path, required=True)
   159	    parser.add_argument("--out-dir", type=Path, required=True)
   160	    parser.add_argument("--work-root", type=Path, default=None,
   161	                        help="scratch for periodogram memmaps; put on local NVMe "
   162	                             "or a RAM disk, NEVER inside a synced folder")
   163	    parser.add_argument("--dataset", required=True,
   164	                        help="manifest label, e.g. d3-kepler-dsct or d2-tess-dav")
   165	    parser.add_argument("--workers", type=int, default=None)
   166	    parser.add_argument("--passes", default="low,high")
   167	    parser.add_argument("--stars-file", type=Path, default=None,
   168	                        help="optional newline-separated campaign_id subset (a shard)")
   169	    parser.add_argument("--limit", type=int, default=None,
   170	                        help="pilot mode: first N stars only")
   171	    parser.add_argument("--expect-count", type=int, default=None,
   172	                        help="assert the shard dir holds exactly N shards "
   173	                             "(stale-directory guard)")
   174	    parser.add_argument("--shard-index", type=Path, default=None,
   175	                        help="newline-separated campaign_id list the shard dir "
   176	                             "must match EXACTLY (builders emit shard_index.txt); "
   177	                             "required for production runs")
   178	    parser.add_argument("--allow-nonstandard-ids", action="store_true",
   179	                        help="permit non-campaign source_ids (replay/debug only)")
   180	    parser.add_argument("--replay-report", type=Path, required=True,
   181	                        help="replay_report.json from a PASSING replay_gate run "
   182	                             "on THIS machine+env; campaign runs refuse to start "
   183	                             "without one (G1 methods finding 1)")
   184	    args = parser.parse_args()
   185	
   186	    assert_frozen()
   187	    campaign_shas_start = campaign_file_shas()
   188	    attestation = validate_attestation(args.replay_report)
   189	    passes = tuple(args.passes.split(","))
   190	    if passes != ("low", "high") and not args.allow_nonstandard_ids:
   191	        raise SystemExit("production runs use exactly low,high (the frozen CLI's "
   192	                         "pass set); pass --allow-nonstandard-ids for debug runs")
   193	    star_dir = args.out_dir / "stars"
   194	    work_root = args.work_root or (args.out_dir / "work")
   195	    star_dir.mkdir(parents=True, exist_ok=True)
   196	    work_root.mkdir(parents=True, exist_ok=True)
   197	
   198	    if args.expect_count is not None:
   199	        found = len(list(args.shard_dir.glob("*.csv.gz")))
   200	        if found != args.expect_count:
   201	            raise SystemExit(
