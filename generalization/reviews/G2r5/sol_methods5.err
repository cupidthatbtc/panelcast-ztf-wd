   111	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
   112	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
   113	    """A completed result is reused ONLY when its provenance sidecar matches
   114	    the current shard content and environment (G1 methods finding 8); stale
   115	    results are DELETED so analyze_star's internal early-return cannot
   116	    resurrect them."""
   117	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
   118	    if only is not None:
   119	        missing = only - set(source_ids)
   120	        if missing:
   121	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
   122	        source_ids = [sid for sid in source_ids if sid in only]
   123	    if limit is not None:
   124	        source_ids = source_ids[:limit]
   125	    current_env = env_digest()
   126	    pending = []
   127	    for source_id in source_ids:
   128	        result_path = star_dir / f"{source_id}.json"
   129	        prov_file = provenance_path(star_dir, source_id)
   130	        if result_path.exists() and prov_file.exists():
   131	            try:
   132	                result = json.loads(result_path.read_text(encoding="utf-8"))
   133	                prov = json.loads(prov_file.read_text(encoding="utf-8"))
   134	                if (
   135	                    result.get("complete")
   136	                    and set(result.get("passes", {})) >= set(passes)
   137	                    and prov.get("shard_sha256")
   138	                    == shard_sha256(shard_dir / f"{source_id}.csv.gz")
   139	                    and prov.get("env_digest") == current_env
   140	                ):
   141	                    continue
   142	            except json.JSONDecodeError:
   143	                pass
   144	        result_path.unlink(missing_ok=True)
   145	        prov_file.unlink(missing_ok=True)
   146	        pending.append(source_id)
   147	    return pending, len(source_ids)
