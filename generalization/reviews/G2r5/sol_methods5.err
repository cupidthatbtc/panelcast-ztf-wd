   277	                        "tic": int(target.tic), "template_source_id": template_id,
   278	                        "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   279	                        "template_exp_per_night": float(
   280	                            stats.set_index("source_id")["exp_per_night"].get(
   281	                                template_id, float("nan"))),
   282	                        "template_k": k, "ratio_g": g, "ratio_rg": r,
   283	                        "phase_draw": phase_draw,
   284	                        "amp_scale": 1.0 if drop else amp_scale,
   285	                        "dominant_dropped": drop,
   286	                        "match": match_label,
   287	                        "control_campaign_id": control_id(template_id) if not gaussian else "",
   288	                        "n_modes_injected": len(model.modes),
   289	                        "n_modes_rejected": len(model.rejected),
   290	                    })
   291	        print(f"[d2-shards] TIC {target.tic}: {len(manifest)} shards so far", flush=True)
   292	
   293	    if "ctrl" in arms:
   294	        used = sorted({
   295	            row["template_source_id"] for row in manifest if row["arm"] == "B"
   296	        })
   297	        null_model = build_truth_model(0, [], [], 120.0)
   298	        for template_id in used:
   299	            sid = control_id(template_id)
   300	            shard = frames[template_id].copy()
   301	            shard["source_id"] = sid
   302	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   303	            manifest.append({
   304	                "campaign_id": sid, "arm": "ctrl", "tic": 0,
   305	                "template_source_id": template_id,
   306	                "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   307	                "template_k": -1, "ratio_g": 0.0, "ratio_rg": 0.0, "match": "",
   308	                "n_modes_injected": 0, "n_modes_rejected": 0,
   309	            })
   310	        print(f"[d2-shards] {len(used)} paired controls", flush=True)
   311	
   312	    if "nulls" in arms:
   313	        pool = stats.sort_values("source_id")["source_id"].tolist()
   314	        null_model = build_truth_model(0, [], [], 120.0)
   315	        for serial in range(N_NULLS):
   316	            template_id = pool[serial % len(pool)]
   317	            sid = "94" + str(serial).zfill(17)
   318	            shard = synthesize(frames[template_id], null_model, sid, True, seed=serial)
   319	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   320	            manifest.append({
