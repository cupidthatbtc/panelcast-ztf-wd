     1	#!/usr/bin/env python3
     2	"""Panel-stage golden gate: the frozen crossmatch/QC/BJD chain reproduces the
     3	published exposure panel on THIS machine and environment.
     4	
     5	The L-S replay gate consumes already-generated bjd_tdb, so it cannot detect
     6	drift in the panel stage (astropy Time/light_travel_time, IERS tables, ERFA
     7	build — G1 methods finding 6). This gate closes that hole: it re-derives the
     8	exposure rows for sampled stars from the PUBLISHED raw IRSA cache using the
     9	frozen functions exactly as build_catalog_panels.main() does (IERS
    10	auto-download disabled; the pinned astropy-iers-data package supplies the
    11	table) and compares against the published exposures.csv.gz:
    12	
    13	  SCIENCE columns except bjd_tdb (source_id, band, mjd, night_mjd, mag,
    14	  magerr) must be BYTE-identical; bjd_tdb is compared at <= 1 ulp (~40 us):
    15	  the barycentric chain sits at double rounding boundaries, so any ns-level
    16	  IERS-state difference since build time flips the last bit — measured on
    17	  the production machine itself (2026-08-28). 1 ulp is 7e-7 cycles at the
    18	  shortest searched period; the campaign pins IERS via astropy-iers-data
    19	  with auto_download disabled and records the max ulp deviation. Carried
    20	  metadata (oid, ra, dec, chi) is compared at <= 1 ulp, because the archived
    21	  cache tarball is a re-serialization of the fetch-time responses (17-digit
    22	  float strings) whose parse can differ from the original short strings by
    23	  one ulp. chi additionally must not sit within 1e-9 of the QC boundary 4.0.
    24	"""
    25	
    26	from __future__ import annotations
    27	
    28	import argparse
    29	import gzip
    30	import io
    31	import json
    32	import tarfile
    33	from pathlib import Path
    34	
    35	import pandas as pd
    36	from astropy.utils import iers
    37	
    38	iers.conf.auto_download = False
    39	
    40	from frozen_api import (  # noqa: E402
    41	    EXPOSURE_COLUMNS,
    42	    REPO_ROOT,
    43	    add_bjd,
    44	    assert_frozen,
    45	    campaign_file_shas,
    46	    clean_rows,
    47	    env_versions,
    48	    frozen_file_shas,
    49	    read_cache,
    50	    select_nearest_source,
    51	)
    52	
    53	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
    54	
    55	
    56	SCIENCE_COLUMNS = ["source_id", "band", "mjd", "night_mjd", "mag", "magerr"]
    57	META_COLUMNS = ["ra", "dec", "chi"]
    58	
    59	
    60	def rebuild_star(cache_bytes: bytes, ra: float, dec: float, source_id: str) -> pd.DataFrame:
    61	    raw = read_cache(io.BytesIO(cache_bytes))
    62	    selected, _, _, _ = select_nearest_source(raw, ra, dec)
    63	    clean, _ = clean_rows(selected)
    64	    clean["source_id"] = source_id
    65	    clean = add_bjd(clean, ra, dec)
    66	    clean = clean.sort_values(["band", "bjd_tdb"])
    67	    return clean[EXPOSURE_COLUMNS].reset_index(drop=True)
    68	
    69	
    70	def compare_star(rebuilt: pd.DataFrame, reference: pd.DataFrame) -> dict:
    71	    import numpy as _np
    72	    if len(rebuilt) != len(reference):
    73	        return {"verdict": "MISMATCH", "reason": f"row count {len(rebuilt)} != {len(reference)}"}
    74	    for col in ("mjd", "night_mjd", "mag", "magerr"):
    75	        for side, frame in (("rebuilt", rebuilt), ("published", reference)):
    76	            if not _np.isfinite(frame[col].to_numpy(dtype=float)).all():
    77	                return {"verdict": "MISMATCH", "reason": f"nonfinite {col} ({side})"}
    78	    sci_a = rebuilt[SCIENCE_COLUMNS].to_csv(index=False, lineterminator="\n")
    79	    sci_b = reference[SCIENCE_COLUMNS].to_csv(index=False, lineterminator="\n")
    80	    if sci_a != sci_b:
    81	        for line_no, (a, b) in enumerate(zip(sci_a.splitlines(), sci_b.splitlines())):
    82	            if a != b:
    83	                return {"verdict": "MISMATCH", "reason": "science columns differ",
    84	                        "first_diff_line": line_no, "rebuilt": a[:160], "published": b[:160]}
    85	    import numpy as np
    86	    bjd_a = rebuilt["bjd_tdb"].to_numpy(dtype=float)
    87	    bjd_b = reference["bjd_tdb"].to_numpy(dtype=float)
    88	    if not (np.isfinite(bjd_a).all() and np.isfinite(bjd_b).all()):
    89	        return {"verdict": "MISMATCH", "reason": "nonfinite bjd_tdb"}
    90	    bjd_ulp = np.abs(bjd_a - bjd_b) / np.spacing(np.abs(bjd_b))
    91	    if (bjd_ulp > 1.0).any():
    92	        worst = int(np.argmax(bjd_ulp))
    93	        return {"verdict": "MISMATCH", "reason": "bjd_tdb beyond 1 ulp",
    94	                "row": worst, "max_ulp": float(bjd_ulp.max())}
    95	    if not (rebuilt["oid"].astype(str) == reference["oid"].astype(str)).all():
    96	        return {"verdict": "MISMATCH", "reason": "oid differs"}
    97	    chi = reference["chi"].to_numpy(dtype=float)
    98	    if (abs(chi - 4.0) < 1e-9).any():
    99	        return {"verdict": "MISMATCH", "reason": "chi within 1e-9 of QC boundary 4.0"}
   100	    for col in META_COLUMNS:
   101	        a = rebuilt[col].to_numpy(dtype=float)
   102	        b = reference[col].to_numpy(dtype=float)
   103	        if not (np.isfinite(a).all() and np.isfinite(b).all()):
   104	            return {"verdict": "MISMATCH", "reason": f"nonfinite {col}"}
   105	        ulp = np.spacing(np.abs(b))
   106	        if (np.abs(a - b) > ulp).any():
   107	            worst = int(np.argmax(np.abs(a - b) / np.maximum(ulp, 1e-300)))
   108	            return {"verdict": "MISMATCH", "reason": f"{col} beyond 1 ulp",
   109	                    "row": worst, "rebuilt": float(a[worst]), "published": float(b[worst])}
   110	    all_exact = (bjd_ulp == 0.0).all() and all(
   111	        (rebuilt[c].to_numpy(dtype=float) == reference[c].to_numpy(dtype=float)).all()
   112	        for c in ("ra", "dec", "chi")
   113	    )
   114	    return {"verdict": "identical" if all_exact else "identical_1ulp",
   115	            "bjd_max_ulp": float(bjd_ulp.max()),
   116	            "bjd_rows_off_by_1ulp": int((bjd_ulp > 0).sum())}
   117	
   118	
   119	def main() -> None:
   120	    parser = argparse.ArgumentParser(description=__doc__)
   121	    parser.add_argument("--count", type=int, default=5,
   122	                        help="stars to replay (>= 1 enforced)")
   123	    parser.add_argument("--out", type=Path,
   124	                        default=REPO_ROOT / "outputs/generalization/panel_golden_report.json")
   125	    args = parser.parse_args()
   126	    if args.count < 1:
   127	        raise SystemExit("--count must be >= 1 (a vacuous gate cannot pass)")
   128	    assert_frozen()
   129	    campaign_start = campaign_file_shas()
   130	
   131	    roster = pd.read_csv(REPO_ROOT / "data/roster/jestin2026_rebuilt_candidates.csv",
   132	                         dtype={"source_id": str})
   133	    coords = roster.set_index("source_id")[["ra", "dec"]]
   134	
   135	    published = pd.read_csv(PUBLISHED / "data/exposures.csv.gz",
   136	                            dtype={"source_id": str, "band": str})
   137	    star_ids = sorted(published["source_id"].unique())
   138	    stride = max(1, len(star_ids) // args.count)
   139	    sample = star_ids[::stride][: args.count]
   140	
   141	    records = []
   142	    with tarfile.open(PUBLISHED / "data/irsa_raw_cache.tar.gz") as archive:
   143	        for source_id in sample:
   144	            member = archive.extractfile(f"catalog_lc_cache/{source_id}.csv")
   145	            if member is None:
   146	                records.append({"source_id": source_id, "verdict": "MISSING_CACHE"})
   147	                continue
   148	            rebuilt = rebuild_star(
   149	                member.read(),
   150	                float(coords.loc[source_id, "ra"]),
   151	                float(coords.loc[source_id, "dec"]),
   152	                source_id,
   153	            )
   154	            reference = published[published["source_id"] == source_id][
   155	                EXPOSURE_COLUMNS
   156	            ].reset_index(drop=True)
   157	            record = {"source_id": source_id, "rows": len(reference),
   158	                      **compare_star(rebuilt, reference)}
   159	            records.append(record)
   160	            print(f"[panel-golden] {source_id}: {record['verdict']}", flush=True)
   161	
   162	    ids = [r["source_id"] for r in records]
   163	    if not records or len(set(ids)) != len(ids):
   164	        raise SystemExit("empty or duplicated star sample — gate invalid")
   165	    passed = all(
   166	        r["verdict"] in ("identical", "identical_1ulp") for r in records
   167	    ) and len(records) >= args.count
   168	    import hashlib
   169	    if campaign_file_shas() != campaign_start:
   170	        raise SystemExit("campaign code changed while the gate ran — report void")
   171	    report = {"gate": "panel_golden_gate", "passed": passed, "stars": records,
   172	              "env": env_versions(),
   173	              "frozen_sha256": frozen_file_shas(),
   174	              "campaign_sha256": campaign_start,
   175	              "inputs": {
   176	                  "exposures_sha256": hashlib.sha256(
   177	                      (PUBLISHED / "data/exposures.csv.gz").read_bytes()).hexdigest(),
   178	                  "raw_cache_sha256": hashlib.sha256(
   179	                      (PUBLISHED / "data/irsa_raw_cache.tar.gz").read_bytes()).hexdigest(),
   180	                  "roster_sha256": hashlib.sha256(
   181	                      (REPO_ROOT / "data/roster/jestin2026_rebuilt_candidates.csv"
   182	                       ).read_bytes()).hexdigest(),
   183	              }}
   184	    args.out.parent.mkdir(parents=True, exist_ok=True)
   185	    args.out.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
   186	    print(f"[panel-golden] {'PASS' if passed else 'FAIL'} -> {args.out}")
   187	    raise SystemExit(0 if passed else 1)
   188	
   189	
   190	if __name__ == "__main__":
   191	    main()
     1	#!/usr/bin/env python3
     2	"""Generic panel/census builder: frozen QC chain over a campaign roster.
     3	
     4	Re-implements ONLY the roster/paths plumbing of build_catalog_panels.main();
     5	every scientific operation (nearest-cluster crossmatch, row QC, BJD_TDB
     6	conversion, nightly/monthly binning, 2.5-ratio census) is the frozen function
     7	imported through frozen_api, applied verbatim.
     8	
     9	Roster CSV contract (build_d3_roster.py writes this):
    10	  source_id     19-digit campaign id (prefix 90/92/93/94)
    11	  external_id   upstream name (e.g. KIC 8462852)
    12	  ra, dec       ICRS degrees for the ZTF cone
    13	  class_label   truth class (e.g. dsct_flag1, notdsct_flag0)
    14	  label_variable, label_periodic   truth booleans (may be empty)
    15	  gaia_g_mag    optional; empty allowed
    16	Census output maps the frozen column names onto campaign semantics:
    17	wdj_name<-external_id, wd_class<-class_label, paper_variable<-label_variable,
    18	paper_periodic<-label_periodic, known_roster<-False, in_core<-True,
    19	n_variants<-0, bp_rp<-NaN unless provided.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import argparse
    25	import json
    26	import math
    27	from pathlib import Path
    28	from types import SimpleNamespace
    29	
    30	import pandas as pd
    31	from astropy.utils import iers
    32	
    33	# BJD generation must not depend on a live IERS download (G1 methods finding 6);
    34	# the pinned astropy-iers-data package supplies the table, recorded in the
    35	# manifest via env_versions().
    36	iers.conf.auto_download = False
    37	
    38	from frozen_api import (
    39	    BANDS,
    40	    campaign_file_shas,
    41	    EXPOSURE_COLUMNS,
    42	    MIN_EXPOSURES_PER_BAND,
    43	    MONTHLY_COLUMNS,
    44	    NIGHTLY_COLUMNS,
    45	    add_bjd,
    46	    assert_frozen,
    47	    campaign_id_ok,
    48	    census_row,
    49	    clean_rows,
    50	    env_versions,
    51	    frozen_file_shas,
    52	    monthly_panel,
    53	    nightly_panel,
    54	    read_cache,
    55	    select_nearest_source,
    56	)
    57	
    58	
    59	def roster_meta(row: pd.Series) -> SimpleNamespace:
    60	    def opt_float(name: str) -> float:
    61	        value = row.get(name)
    62	        try:
    63	            return float(value)
    64	        except (TypeError, ValueError):
    65	            return math.nan
    66	
    67	    def opt_bool(name: str):
    68	        value = row.get(name)
    69	        if pd.isna(value) or value == "":
    70	            return None
    71	        if isinstance(value, str):
    72	            return value.lower() == "true"
    73	        return bool(value)
    74	
    75	    return SimpleNamespace(
    76	        source_id=str(row["source_id"]),
    77	        wdj_name=str(row.get("external_id", "")),
    78	        gaia_g_mag=opt_float("gaia_g_mag"),
    79	        bp_rp=opt_float("bp_rp"),
    80	        in_core=True,
    81	        n_variants=0,
    82	        known_roster=False,
    83	        wd_class=str(row.get("class_label", "")),
    84	        paper_variable=opt_bool("label_variable"),
    85	        paper_periodic=opt_bool("label_periodic"),
    86	    )
    87	
    88	
    89	def main() -> None:
    90	    parser = argparse.ArgumentParser(description=__doc__)
    91	    parser.add_argument("--roster", type=Path, required=True)
    92	    parser.add_argument("--cache-dir", type=Path, required=True,
    93	                        help="IRSA response cache: <source_id>.csv per target")
    94	    parser.add_argument("--out-dir", type=Path, required=True)
    95	    parser.add_argument("--allow-nonstandard-ids", action="store_true")
    96	    parser.add_argument("--panel-report", type=Path, default=None,
    97	                        help="panel_golden_report.json from a PASSING "
    98	                             "panel_golden_gate run on THIS machine+env; "
    99	                             "required unless --allow-nonstandard-ids")
   100	    args = parser.parse_args()
   101	
   102	    assert_frozen()
   103	    campaign_start = campaign_file_shas()
   104	    if args.panel_report is None and not args.allow_nonstandard_ids:
   105	        raise SystemExit("campaign panel builds require --panel-report "
   106	                         "(panel_golden_gate PASS on this machine)")
   107	    if args.panel_report is not None:
   108	        gate = json.loads(args.panel_report.read_text(encoding="utf-8"))
   109	        if gate.get("gate") != "panel_golden_gate" or gate.get("passed") is not True:
   110	            raise SystemExit(f"{args.panel_report} is not a panel-gate PASS")
   111	        current = env_versions()
   112	        mismatched = [k for k in current if gate["env"].get(k) != current.get(k)]
   113	        if mismatched:
   114	            raise SystemExit(f"panel attestation env differs: {mismatched}")
   115	    args.out_dir.mkdir(parents=True, exist_ok=True)
   116	    exposure_star_dir = args.out_dir / "exposure_stars"
   117	    exposure_star_dir.mkdir(parents=True, exist_ok=True)
   118	
   119	    roster = pd.read_csv(args.roster, dtype={"source_id": str})
   120	    if not args.allow_nonstandard_ids:
   121	        bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
   122	        if bad:
   123	            raise SystemExit(f"{len(bad)} roster ids violate the campaign convention: {bad[:3]}")
   124	
   125	    qc_rows: list[dict[str, object]] = []
   126	    census_rows: list[dict[str, object]] = []
   127	    crossmatched = 0
   128	
   129	    for index, (_, row) in enumerate(roster.iterrows(), 1):
   130	        meta = roster_meta(row)
   131	        cache_path = args.cache_dir / f"{meta.source_id}.csv"
   132	        qc: dict[str, object] = {
   133	            "source_id": meta.source_id,
   134	            "external_id": meta.wdj_name,
   135	            "class_label": meta.wd_class,
   136	            "cache_present": cache_path.exists() and cache_path.stat().st_size > 0,
   137	            "read_status": "ok",
   138	        }
   139	        if not qc["cache_present"]:
   140	            qc["read_status"] = "missing"
   141	            qc_rows.append(qc)
   142	            continue
   143	        try:
   144	            raw = read_cache(cache_path)
   145	            qc["raw_rows"] = len(raw)
   146	            selected, separation, n_objects, n_selected = select_nearest_source(
   147	                raw, float(row["ra"]), float(row["dec"])
   148	            )
   149	            clean, drop_counts = clean_rows(selected)
   150	            qc.update(drop_counts)
   151	            qc["nearest_separation_arcsec"] = separation
   152	            qc["ztf_objects_in_cone"] = n_objects
   153	            qc["selected_ztf_objects"] = n_selected
   154	        except Exception as exc:
   155	            qc["read_status"] = "error"
   156	            qc["error"] = repr(exc)
   157	            qc_rows.append(qc)
   158	            continue
   159	
   160	        for band in BANDS:
   161	            qc[f"{band}_raw_rows"] = int((raw["filtercode"] == band).sum())
   162	            qc[f"{band}_clean_rows"] = int((clean["band"] == band).sum())
   163	        is_crossmatched = all(
   164	            qc[f"{band}_clean_rows"] >= MIN_EXPOSURES_PER_BAND for band in BANDS
   165	        )
   166	        qc["crossmatched"] = is_crossmatched
   167	        qc_rows.append(qc)
   168	        if not is_crossmatched:
   169	            continue
   170	
   171	        crossmatched += 1
   172	        clean["source_id"] = meta.source_id
   173	        clean = add_bjd(clean, float(row["ra"]), float(row["dec"]))
   174	        clean = clean.sort_values(["band", "bjd_tdb"])
   175	        clean[EXPOSURE_COLUMNS].to_csv(
   176	            exposure_star_dir / f"{meta.source_id}.csv.gz", index=False
   177	        )
   178	        nightly = nightly_panel(clean)
   179	        monthly = monthly_panel(nightly)
   180	        row = census_row(meta, clean, nightly, monthly)
   181	        zg_nightly = nightly[nightly["band"] == "zg"]
   182	        row["zg_median_exp_per_night"] = (
   183	            float(zg_nightly["n_exp"].median()) if len(zg_nightly) else float("nan"))
   184	        census_rows.append(row)
   185	        if index % 50 == 0 or index == len(roster):
   186	            print(f"[panels-generic] {index:,}/{len(roster):,}; crossmatched={crossmatched:,}",
   187	                  flush=True)
   188	
   189	    pd.DataFrame(qc_rows).to_csv(args.out_dir / "crossmatch_qc.csv", index=False)
   190	    pd.DataFrame(census_rows).to_csv(args.out_dir / "census_generic.csv", index=False)
   191	    shard_ids = sorted(
   192	        path.name.split(".csv")[0] for path in exposure_star_dir.glob("*.csv.gz"))
   193	    (args.out_dir / "shard_index.txt").write_text(
   194	        "\n".join(shard_ids) + "\n", encoding="utf-8")
   195	    manifest = {
   196	        "builder": "build_panels_generic.py",
   197	        "roster": str(args.roster),
   198	        "roster_rows": len(roster),
   199	        "crossmatched_count": crossmatched,
   200	        "crossmatch_rule": "frozen: nearest ZTF coordinate cluster; "
   201	                           f">={MIN_EXPOSURES_PER_BAND} QC-passing exposures in zg and zr",
   202	        "row_qc": "frozen: catflags == 0; finite mag; finite magerr > 0; chi < 4; finite MJD",
   203	        "census_threshold": 2.5,
   204	        "env": env_versions(),
   205	        "frozen_sha256": frozen_file_shas(),
   206	        "campaign_sha256": campaign_start,
   207	        "panel_attestation": str(args.panel_report) if args.panel_report else "",
   208	    }
   209	    if campaign_file_shas() != campaign_start:
   210	        raise SystemExit("campaign code changed while panels were building")
   211	    (args.out_dir / "panels_manifest.json").write_text(
   212	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   213	    )
   214	    print(f"[panels-generic] crossmatched {crossmatched:,}/{len(roster):,}")
   215	
   216	
   217	if __name__ == "__main__":
   218	    main()

