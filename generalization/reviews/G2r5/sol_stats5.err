   102	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
   103	    if not truth:
   104	        return False
   105	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   106	    return any(low <= f <= high for f in truth)
