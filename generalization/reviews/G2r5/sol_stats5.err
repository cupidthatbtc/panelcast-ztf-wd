   112	        # rule in the eligible-roster estimand
   113	        return False
   114	    if rule == "confirmed":
   115	        return status == "confirmed"
   116	    if rule == "confirmed_or_candidate":
   117	        return status in ("confirmed", "candidate")
   118	    if rule == "census":
   119	        return None if census_flag is None else bool(census_flag)
   120	    if rule == "either":
   121	        if census_flag is None:
   122	            return status == "confirmed"
   123	        return status == "confirmed" or bool(census_flag)
   124	    raise ValueError(rule)
