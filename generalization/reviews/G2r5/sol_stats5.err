    61	def wilson(k: float, n: float) -> tuple[float, float, float]:
    62	    if n <= 0:
    63	        return math.nan, math.nan, math.nan
    64	    z = 1.959963984540054
    65	    p = k / n
    66	    denom = 1.0 + z * z / n
    67	    center = (p + z * z / (2 * n)) / denom
    68	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    69	    return p, max(0.0, center - half), min(1.0, center + half)
    70	
    71	
    72	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    73	    total = float(weights.sum())
    74	    if total <= 0:
    75	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    76	    p = float((weights * successes).sum() / total)
    77	    ess = total * total / float((weights * weights).sum())
    78	    _, lo, hi = wilson(p * ess, ess)
    79	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
