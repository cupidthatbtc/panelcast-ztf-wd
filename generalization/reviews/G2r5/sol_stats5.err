   713	def fp_frequency_distribution(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   714	    if dataset == "d3":
   715	        pool = per_star[per_star["class_label"] == "dsct_flag0"]
   716	    elif dataset == "d2" and "arm" in per_star:
   717	        pool = per_star[per_star["arm"].isin(["null", "ctrl"])]
   718	    else:
   719	        pool = per_star.iloc[0:0]
   720	    triggered = pool[pool["best_status"].isin(["confirmed", "candidate"])]
   721	    columns = ["sid", "class_label", "best_status", "best_pass",
   722	               "best_frequency_per_day", "baseline_days"]
   723	    return triggered[[c for c in columns if c in triggered.columns]]
