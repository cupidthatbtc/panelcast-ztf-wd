    82	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    83	    """Evaluate EVERY (truth mode, relation) predicate — no short-circuit
    84	    (spec: hits in more than one relation class -> ambiguous)."""
    85	    classes: set[str] = set()
    86	    for f_t in truth:
    87	        if abs(freq - f_t) <= tol:
    88	            classes.add("direct")
    89	        if abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    90	            classes.add("harmonic")
    91	        for k in (1, 2):
    92	            for sign in (1.0, -1.0):
    93	                if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    94	                    classes.add("window_alias")
    95	    if not classes:
    96	        return "unmatched"
    97	    if len(classes) > 1:
    98	        return "ambiguous"
    99	    return classes.pop()
