   254	                           dtype={"campaign_id": str, "template_source_id": str})
   255	    injected = pd.read_csv(shards_dir / "injected_modes.csv",
   256	                           dtype={"campaign_id": str})
   257	    freq_lists = injected.groupby("campaign_id")["frequency_per_day"].apply(
   258	        lambda g: sorted(g.tolist())).to_dict()
   259	    dominant = {}
   260	    amp_dom = {}
   261	    for sid, group in injected.groupby("campaign_id"):
   262	        best = group.loc[group["amp_tess_ppt"].idxmax()]
   263	        dominant[sid] = float(best["frequency_per_day"])
   264	        amp_dom[sid] = float(best["amp_tess_ppt"])
   265	    rows = []
   266	    for r in manifest.itertuples(index=False):
   267	        arm = r.arm
   268	        tic = int(r.tic)
   269	        sid = r.campaign_id
   270	        truth = freq_lists.get(sid, []) if arm in ("A", "B") else []
   271	        rows.append({
   272	            "sid": sid, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   273	            "class_label": f"arm_{arm}",
   274	            "label_positive": arm in ("A", "B"),
   275	            "weight": 1.0, "cluster": str(tic) if tic else sid,
   276	            "truth_freqs": truth,
   277	            "primary_freq": dominant.get(sid) if arm in ("A", "B") else None,
   278	            "amp": float(amp_dom.get(sid, math.nan)),
   279	            "truth_period_days": (86400.0 / dominant[sid] / 86400.0)
   280	            if sid in dominant and arm in ("A", "B") else math.nan,
   281	            "freq_scorable": arm in ("A", "B") and bool(truth),
   282	            "arm": arm, "template_k": r.template_k,
   283	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   284	            "phase_draw": int(getattr(r, "phase_draw", 0)),
   285	            "amp_scale": float(getattr(r, "amp_scale", 1.0)),
   286	            "median_exp_per_night": float(getattr(r, "template_exp_per_night",
   287	                                                  math.nan)),
   288	            "template_status": getattr(r, "template_status", ""),
   289	        })
   290	    return pd.DataFrame(rows)
   291	
   292	
   293	# ---------------------------------------------------------- census providers
   294	
   295	def census_lookup_csv(path: Path) -> dict[str, dict]:
   296	    frame = pd.read_csv(path, dtype={"source_id": str})
   297	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   298	    for col in ratio_cols:
   299	        exact = frame[col] == 2.5
   300	        if exact.any():
   301	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   302	    return {
   303	        r["source_id"]: {
   304	            "census_variable": bool(r["census_variable"]),
   305	            "census_g_nightly": bool(r["census_g_nightly"]),
   306	            "median_exp_per_night": float(r["zg_median_exp_per_night"])
   307	            if "zg_median_exp_per_night" in frame.columns else math.nan,
   308	        }
   309	        for _, r in frame.iterrows()
   310	    }
   311	
   312	
   313	def census_from_shard(shard_path: Path) -> dict:
   314	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   315	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   316	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   317	                           n_variants=0, known_roster=False, wd_class="",
   318	                           paper_variable=None, paper_periodic=None)
   319	    nightly = nightly_panel(frame)
   320	    monthly = monthly_panel(nightly)
   321	    row = census_row(meta, frame, nightly, monthly)
   322	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   323	                for c in ("exposure", "nightly", "monthly")):
   324	        if row.get(key) == 2.5:
   325	            raise SystemExit(f"census ratio exactly 2.5 for {shard_path} — spec guard")
   326	    return {"census_variable": bool(row["census_variable"]),
   327	            "census_g_nightly": bool(row["census_g_nightly"])}
   328	
