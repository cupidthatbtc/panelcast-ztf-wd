   330	# ------------------------------------------------------------------ aggregates
   331	
   332	def completeness_tables(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   333	    # primary frequency-match column: D3 scores the DOMINANT Mo mode (any-mode
   334	    # is secondary/diagnostic); D2 scores the exact injected list; D1 is
   335	    # diagnostic-only either way (spec).
   336	    use_dominant = True  # headline = best_candidate_matches_dominant (spec)
   337	    rows = []
   338	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   339	    usable = positives[(positives["best_status"] != "missing")
   340	                       & positives["low_available"].fillna(False)
   341	                       & positives["high_available"].fillna(False)]
   342	    for pass_name in PASSES:
   343	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   344	        match_col = (f"{'best' if pass_name == 'best' else pass_name}_match_primary"
   345	                     if use_dominant
   346	                     else ("best_match" if pass_name == "best" else f"{pass_name}_match"))
   347	        for rule in RULES:
   348	            for scope, frame in (
   349	                ("detection_eligible_roster", positives),
   350	                ("detection_usable_lightcurve", usable),
   351	                ("freq_recovery_scorable", usable[
   352	                    usable["freq_scorable"]
   353	                    & (usable["eligible_any_pass"] if pass_name == "best"
   354	                       else usable[f"{pass_name}_eligible"])
   355	                ]),
   356	            ):
   357	                if scope == "freq_recovery_scorable" and rule in ("census", "either"):
   358	                    continue  # frequency outcomes exist only for L-S rules
   359	                if frame.empty:
   360	                    rows.append({"pass": pass_name, "rule": rule, "scope": scope,
   361	                                 "n": 0, "ess": 0.0, "p": math.nan,
   362	                                 "lo": math.nan, "hi": math.nan})
   363	                    continue
   364	                fired = frame.apply(
   365	                    lambda r: rule_fired(rule, r[status_col], r.get("census_variable")),
   366	                    axis=1,
   367	                )
   368	                ok = fired.notna()
   369	                success = fired[ok].astype(bool)
   370	                if scope == "freq_recovery_scorable":
   371	                    success = success & (frame.loc[ok, match_col] == "direct")
   372	                stats = weighted_wilson(
   373	                    success.to_numpy(dtype=float),
   374	                    frame.loc[ok, "weight"].to_numpy(dtype=float),
   375	                )
   376	                rows.append({"pass": pass_name, "rule": rule, "scope": scope, **stats})
   377	        # correct-frequency fraction among detected positives (spec):
   378	        # P(match dominant | rule-1 fired, Y=1, F=1, S_p=1)
   379	        scorable = usable[usable["freq_scorable"]
   380	                          & (usable["eligible_any_pass"] if pass_name == "best"
   381	                             else usable[f"{pass_name}_eligible"])]
   382	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   383	        detected = scorable[scorable[status_col] == "confirmed"]
   384	        if len(detected):
   385	            correct = (detected[match_col] == "direct")
   386	            stats = weighted_wilson(correct.to_numpy(dtype=float),
   387	                                    detected["weight"].to_numpy(dtype=float))
   388	        else:
   389	            stats = {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
   390	        rows.append({"pass": pass_name, "rule": "confirmed",
   391	                     "scope": "correct_frequency_fraction_detected", **stats})
   392	    return pd.DataFrame(rows)
   393	
   394	
   395	def contingency(per_star: pd.DataFrame, dataset: str = "d1") -> dict:
   396	    from scipy.stats import binomtest
   397	    frame = per_star[(per_star["label_positive"] == True)  # noqa: E712
   398	                     & per_star["census_variable"].notna()
   399	                     & (per_star["best_status"] != "missing")]
   400	    C = frame["census_variable"].astype(bool)
   401	    L = frame["best_status"] == "confirmed"
   402	    a, b = int((C & L).sum()), int((C & ~L).sum())
   403	    c, d = int((~C & L).sum()), int((~C & ~L).sum())
   404	    n = len(frame)
   405	    union_p, union_lo, union_hi = wilson(a + b + c, n) if n else (math.nan,) * 3
   406	    out = {
   407	        "n_positives_scored": n,
   408	        "table": {"census_and_ls": a, "census_only": b, "ls_only": c, "neither": d},
   409	        "union_completeness": {"p": union_p, "lo": union_lo, "hi": union_hi},
   410	        "incremental_census_only": dict(zip(("p", "lo", "hi"), wilson(b, n))) if n else {},
   418	        out["mcnemar"] = "prohibited for d2 (cluster structure); use the target-cluster paired-difference bootstrap"
   419	    return out
   420	
   421	
   422	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   423	    scorable = per_star[per_star["freq_scorable"]
   424	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   425	    if len(scorable) < 3:
   426	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   427	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   428	    rates = []
   429	    truth_lists = scorable["truth_freqs"].tolist()
   430	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   431	        perm = rng.permutation(len(truth_lists))
   432	        hits = 0
   433	        for i, row in scorable.iterrows():
   434	            if perm[i] == i:
   435	                continue
   436	            tol = 1.5 / row["baseline_days"]
   437	            if classify_match(float(row["best_frequency_per_day"]),
   438	                              truth_lists[perm[i]], tol) == "direct":
   439	                hits += 1
   440	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   441	        if denom:
   442	            rates.append(hits / denom)
   443	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   444	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   445	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
   446	
   447	
   448	def cp_one_sided_bounds(k: int, n: int) -> tuple[float, float]:
   449	    from scipy.stats import beta
   450	    lower = float(beta.ppf(0.05, k, n - k + 1)) if k > 0 else 0.0
   451	    upper = float(beta.ppf(0.95, k + 1, n - k)) if k < n else 1.0
   452	    return lower, upper
   453	
   454	
   455	def d2_cluster_bootstrap(per_star: pd.DataFrame) -> pd.DataFrame:
   456	    """P4 machinery: per (scenario, endpoint), per-stratum rates and the
   457	    equal-weight (1/3 per K stratum) scenario-standardized mean over targets;
   458	    COMMON RANDOM NUMBERS — one resample-index matrix shared by every
   459	    scenario; degenerate statistics fall back to target-level exact CP."""
   460	    if "arm" not in per_star:
   461	        return pd.DataFrame()
   462	    frame = per_star[per_star["arm"].isin(["A", "B"])]
   463	    if frame.empty:
   464	        return pd.DataFrame()
   465	    clusters = np.array(sorted(frame["cluster"].unique()))
   466	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   467	    draws = rng.integers(0, len(clusters), size=(BOOTSTRAP_B, len(clusters)))
   468	    rows = []
   469	    endpoints = {
   470	        "detection": lambda f: f["best_status"] == "confirmed",
   471	        "freq_recovery": lambda f: (f["best_status"] == "confirmed")
   472	        & (f["best_match"] == "direct"),
   473	    }
   474	    scenario_cols = ["arm", "ratio_g", "ratio_rg"]
   475	    for extra in ("phase_draw", "amp_scale"):
   476	        if extra in frame:
   477	            scenario_cols.append(extra)
   478	
   479	    def bootstrap_stats(aligned: pd.Series) -> tuple[float, float, float, str, int]:
   480	        observed = aligned.dropna()
   481	        point = float(observed.mean())
   482	        values = aligned.to_numpy(dtype=float)
   483	        boots = []
   484	        for b in range(BOOTSTRAP_B):
   485	            sample = values[draws[b]]
   486	            sample = sample[~np.isnan(sample)]
   487	            if sample.size:
   488	                boots.append(float(sample.mean()))
   489	        target_hits = observed.round(6)
   490	        degenerate = (target_hits == 0).all() or (target_hits == 1).all()
   491	        if degenerate:
   492	            k_deg = int((target_hits == 1).sum())
   493	            lo, hi = cp_one_sided_bounds(k_deg, len(observed))
   494	            return point, lo, hi, "cp_one_sided", len(observed)
   495	        return (point, float(np.quantile(boots, 0.025)),
   496	                float(np.quantile(boots, 0.975)), "cluster_bootstrap", len(observed))
   497	
   498	    for keys, scenario in frame.groupby(scenario_cols):
   499	        arm, g, r = keys[0], keys[1], keys[2]
   500	        usable_rows = scenario[scenario["best_status"] != "missing"]
   501	        for endpoint, predicate in endpoints.items():
   502	            for denom in ("usable", "eligible"):
   503	                subset = usable_rows if denom == "usable" else scenario
   504	                if subset.empty:
   505	                    continue
   506	                if denom == "eligible":
   507	                    # missing replicate = failure, fixed |K_t| = 3 (spec P4)
   508	                    success = predicate(subset) & (subset["best_status"] != "missing")
   509	                    per_ts = success.groupby(
   510	                        [subset["cluster"], subset["template_k"]]).mean()
   511	                    per_target = per_ts.groupby(level=0).sum() / 3.0
   512	                else:
   513	                    # renormalize over usable strata; a target with ZERO usable
   514	                    # strata drops from the usable estimand (counted below)
   515	                    success = predicate(subset)
   516	                    per_ts = success.groupby(
   517	                        [subset["cluster"], subset["template_k"]]).mean()
   518	                    per_target = per_ts.groupby(level=0).mean()
   519	                aligned = per_target.reindex(clusters)
   520	                if aligned.dropna().empty:
   521	                    continue
   522	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   523	                rows.append({
   524	                    "arm": arm, "ratio_g": g, "ratio_rg": r,
   525	                    "endpoint": endpoint, "denominator": denom,
   526	                    "n_targets": n_targets,
   527	                    "n_targets_zero_usable_strata": int(aligned.isna().sum()),
   528	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   529	                })
   530	        # paired census-vs-LS difference, target-clustered (nominal arm B only)
   531	        if (arm == "B" and float(g) == 1.7 and float(r) == 0.8
   532	                and "census_variable" in usable_rows
   533	                and usable_rows["census_variable"].notna().any()):
   534	            paired = usable_rows[usable_rows["census_variable"].notna()]
   535	            c_only = paired["census_variable"].astype(bool) & (
   536	                paired["best_status"] != "confirmed")
   537	            l_only = (~paired["census_variable"].astype(bool)) & (
   538	                paired["best_status"] == "confirmed")
   539	            diff = (c_only.astype(float) - l_only.astype(float)).groupby(
   540	                paired["cluster"]).mean()
   541	            aligned = diff.reindex(clusters)
   542	            if not aligned.dropna().empty:
   543	                point, lo, hi, interval, n_targets = bootstrap_stats(aligned)
   544	                rows.append({
   545	                    "arm": arm, "ratio_g": g, "ratio_rg": r,
   546	                    "endpoint": "paired_census_minus_ls_discordance",
   547	                    "denominator": "usable", "n_targets": n_targets,
   548	                    "n_targets_zero_usable_strata": int(aligned.isna().sum()),
   549	                    "p": point, "lo": lo, "hi": hi, "interval": interval,
   550	                })
   551	    return pd.DataFrame(rows)
   552	
   553	
   554	def surface_cells(frame: pd.DataFrame, success: pd.Series,
   555	                  x_values: pd.Series, edges: list[float],
   556	                  x_name: str) -> list[dict]:
   557	    """Half-open [lo, hi) bins; bin 0 = underflow, bin len(edges) = overflow;
   558	    NaN x -> bin -1 ("unknown"). Cells below MIN_CELL: counts only."""
   559	    bins = np.where(np.isfinite(x_values), np.digitize(x_values, edges), -1)
   560	    rows = []
   561	    for b, idx in frame.groupby(bins).groups.items():
   562	        k = int(success.loc[idx].sum())
   563	        n = len(idx)
   564	        entry = {x_name: int(b), "n": n, "k": k}
   565	        if n >= MIN_CELL:
   566	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   567	        rows.append(entry)
   568	    return rows
   569	
   570	
   571	def surfaces(per_star: pd.DataFrame, dataset: str) -> dict[str, pd.DataFrame]:
   572	    if dataset == "d1":
   573	        return {}  # no amplitude axis for D1 (spec)
   574	    out: dict[str, pd.DataFrame] = {}
   575	    amp_edges = AMP_EDGES[dataset]
   576	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   577	    # detection endpoint: ALL positives; unknown-amplitude stars form their
   578	    # own bin (-1) so the 154 unjoined D3 positives stay in the denominator
   579	    detection = positives["best_status"] == "confirmed"
   580	    out["detection_amplitude"] = pd.DataFrame(
   581	        surface_cells(positives, detection, positives["amp"], amp_edges, "amp_bin"))
   582	    # detection endpoint on (period, amplitude): unknowns fall in bin -1
   583	    p_bins_all = np.where(np.isfinite(positives["truth_period_days"]),
   584	                          np.digitize(positives["truth_period_days"],
   585	                                      PERIOD_EDGES_DAYS), -1)
   586	    a_bins_all = np.where(np.isfinite(positives["amp"]),
   587	                          np.digitize(positives["amp"], amp_edges), -1)
   588	    det_rows = []
   589	    for (pb, ab), idx in positives.groupby([p_bins_all, a_bins_all]).groups.items():
   590	        k = int(detection.loc[idx].sum())
   591	        n = len(idx)
   592	        entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   593	        if n >= MIN_CELL:
   594	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   595	        det_rows.append(entry)
   596	    out["detection_period_amplitude"] = pd.DataFrame(det_rows)
   597	    # frequency-recovery endpoint: scorable AND S_best subset only
   598	    scorable = positives[positives["freq_scorable"]
   599	                         & positives["eligible_any_pass"]]
   600	    if not scorable.empty:
   601	        match_col = "best_match_primary"
   602	        recovery = (scorable["best_status"] == "confirmed") & (
   603	            scorable[match_col] == "direct")
   604	        rows = []
   605	        p_bins = np.digitize(scorable["truth_period_days"], PERIOD_EDGES_DAYS)
   606	        a_bins = np.where(np.isfinite(scorable["amp"]),
   607	                          np.digitize(scorable["amp"], amp_edges), -1)
   608	        for (pb, ab), idx in scorable.groupby([p_bins, a_bins]).groups.items():
   609	            k = int(recovery.loc[idx].sum())
   610	            n = len(idx)
   611	            entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   612	            if n >= MIN_CELL:
   613	                entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   614	            rows.append(entry)
   615	        out["freq_recovery_period_amplitude"] = pd.DataFrame(rows)
   616	        if "median_exp_per_night" in scorable and \
   617	                scorable["median_exp_per_night"].notna().any():
   618	            out["freq_recovery_exposure_amplitude"] = pd.DataFrame(
   619	                surface_cells(scorable, recovery,
   620	                              scorable["median_exp_per_night"],
   621	                              EXP_PER_NIGHT_EDGES, "exp_per_night_bin"))
   622	    return out
   623	
   624	
   625	def trigger_rates(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   626	    rows = []
   627	    if dataset == "d3":
   628	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
   629	        for rule in RULES:
   630	            fired = negatives.apply(
   631	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
   632	                axis=1,
   633	            )
   634	            ok = fired.notna()
   635	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
   636	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
   637	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
   638	    if dataset == "d2" and "arm" in per_star:
   639	        nulls = per_star[per_star["arm"] == "null"]
   640	        if not nulls.empty:
   641	            completed = nulls[nulls["best_status"] != "missing"]
   642	            x = int((completed["best_status"] == "confirmed").sum())
   643	            n = len(completed)
   644	            _, upper = cp_one_sided_bounds(x, n) if n else (math.nan, math.nan)
   645	            rows.append({
   646	                "quantity": "fpr_gaussian", "rule": "confirmed",
   647	                "n_scheduled": len(nulls), "n_completed": n, "k": x,
   648	                "p": x / n if n else math.nan,
   649	                "cp_one_sided_95_upper": upper,
   650	                # the confirmatory decision requires ALL 1000 trials completed
   651	                "acceptance_u95_leq_0.005": bool(n == 1000 and upper <= 0.005),
   652	                "n_completed_is_1000": bool(n == 1000),
   653	            })
   654	        controls = per_star[per_star["arm"] == "ctrl"]
   655	        if not controls.empty:
   656	            fired = controls["best_status"] == "confirmed"
   657	            stats = weighted_wilson(fired.to_numpy(dtype=float),
   658	                                    np.ones(len(controls)))
   659	            rows.append({"quantity": "native_trigger_rate", "rule": "confirmed",
   660	                         **stats})
   661	    return pd.DataFrame(rows)
   662	
   663	
   664	def ppv_d3(per_star: pd.DataFrame) -> dict:
   665	    """Frame-specific label PPV: weighted fraction of triggered (rule-1, best
   666	    pass) roster members labeled dSct=1; dSct=2 excluded, reported separately.
   667	    Survey bootstrap: negatives resampled with replacement, positives fixed."""
   668	    # the frame keeps every sampled member — a missing light curve cannot
   669	    # trigger but remains part of the SRS (stats4: preserve all 2,314)
   670	    frame = per_star[per_star["class_label"].isin(["dsct_flag0", "dsct_flag1"])]
   671	    triggered = frame[frame["best_status"] == "confirmed"]
   672	    if triggered.empty:
   673	        return {"note": "no triggered stars in the PPV frame"}
   674	    weights = triggered["weight"].to_numpy(dtype=float)
   675	    is_pos = (triggered["class_label"] == "dsct_flag1").to_numpy()
   676	    point = float((weights * is_pos).sum() / weights.sum())
   677	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED + 1))
   678	    positives = frame[frame["class_label"] == "dsct_flag1"]
   679	    negatives = frame[frame["class_label"] == "dsct_flag0"].reset_index(drop=True)
   680	    boots = []
   681	    for _ in range(BOOTSTRAP_B):
   682	        resampled = negatives.iloc[
   683	            rng.integers(0, len(negatives), size=len(negatives))
   684	        ]
   685	        combined = pd.concat([positives, resampled])
   686	        hit = combined[combined["best_status"] == "confirmed"]
   687	        if hit.empty:
   688	            continue
   689	        w = hit["weight"].to_numpy(dtype=float)
   690	        boots.append(float(
   691	            (w * (hit["class_label"] == "dsct_flag1").to_numpy()).sum() / w.sum()
   692	        ))
   693	    triggered_ambiguous = int(
   694	        (per_star[per_star["class_label"] == "dsct_flag2"]["best_status"]
   695	         == "confirmed").sum()
   696	    )
   697	    # SRSWOR finite-population correction: sampling fraction f = 2314/7292;
   698	    # bootstrap deviations rescaled by sqrt(1 - f) about the point estimate
   699	    fpc = math.sqrt(1.0 - 2314.0 / 7292.0)
   700	    rescaled = [point + fpc * (b - point) for b in boots]
   701	    return {
   702	        "estimand": "frame_specific_label_ppv",
   703	        "p": point,
   704	        "lo": float(np.quantile(rescaled, 0.025)) if rescaled else math.nan,
   705	        "hi": float(np.quantile(rescaled, 0.975)) if rescaled else math.nan,
   706	        "interval": "survey_bootstrap_fpc_rescaled",
   707	        "n_triggered": int(len(triggered)),
   708	        "bootstrap_B_effective": len(boots),
   709	        "dsct2_triggered_reported_separately": triggered_ambiguous,
   710	    }
   711	
   712	
   760	                           & (joined["ztf_objects_in_cone"] <= 3)]
   761	            rate(clean, "positives", "crowding_clean")
   762	    return pd.DataFrame(rows)
