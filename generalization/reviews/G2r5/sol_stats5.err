   726	def sensitivity_table(per_star: pd.DataFrame, dataset: str,
   727	                      crossmatch_qc: pd.DataFrame | None) -> pd.DataFrame:
   728	    rows = []
   729	
   730	    def rate(frame: pd.DataFrame, label: str, variant: str) -> None:
   731	        if frame.empty:
   732	            return
   733	        success = (frame["best_status"] == "confirmed")
   734	        rows.append({"variant": variant, "subset": label,
   735	                     "n": len(frame), "k": int(success.sum()),
   736	                     **dict(zip(("p", "lo", "hi"), wilson(int(success.sum()), len(frame))))})
   737	
   738	    if dataset == "d2" and "arm" in per_star:
   739	        # common-subset rule: nominal recomputed on the SAME median-window
   740	        # (k=1) subset used by every non-nominal scenario
   741	        median_b = per_star[(per_star["arm"] == "B") & (per_star["template_k"] == 1)]
   742	        group_cols = ["ratio_g", "ratio_rg"]
   743	        for extra in ("phase_draw", "amp_scale"):
   744	            if extra in median_b:
   745	                group_cols.append(extra)
   746	        for keys, scenario in median_b.groupby(group_cols):
   747	            label = "_".join(f"{c}{v}" for c, v in zip(group_cols, keys))
   748	            rate(scenario, "arm_b_median_window", label)
   749	    if dataset == "d3":
   750	        positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   751	                             & (per_star["best_status"] != "missing")]
   752	        if "near_saturation" in positives:
   753	            rate(positives[positives["near_saturation"] == True], "positives", "near_saturation")  # noqa: E712
   754	            rate(positives[positives["near_saturation"] == False], "positives", "safe_magnitude")  # noqa: E712
   755	        if crossmatch_qc is not None:
   756	            qc = crossmatch_qc.set_index("source_id")
   757	            joined = positives.join(
   758	                qc[["nearest_separation_arcsec", "ztf_objects_in_cone"]], on="sid")
   759	            clean = joined[(joined["nearest_separation_arcsec"] < 1.0)
   760	                           & (joined["ztf_objects_in_cone"] <= 3)]
   761	            rate(clean, "positives", "crowding_clean")
   762	    return pd.DataFrame(rows)
   763	
   764	
   864	    attrition = {
   865	        "roster": len(truth),
   866	        "scored": len(per_star),
