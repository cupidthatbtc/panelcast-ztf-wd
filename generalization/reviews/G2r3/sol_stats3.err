   138	        "best_pass": overall["best_pass"],
   139	        "best_status": overall["blind_status"],
   140	        "best_frequency_per_day": overall["best_frequency_per_day"],
   141	        "low_available": passes["low"].get("available", True),
   142	        "high_available": passes["high"].get("available", True),
   143	    }
   144	    any_direct_top = False
   145	    for name in ("low", "high"):
   146	        p = passes[name]
   147	        freq = p.get("frequency_per_day")
   148	        row[f"{name}_status"] = p["status"]
   149	        row[f"{name}_frequency_per_day"] = freq
   150	        row[f"{name}_match"] = (
   151	            classify_match(float(freq), truth_freqs, tol)
   152	            if freq is not None and truth_freqs else "unscored"
   153	        )
   154	        row[f"{name}_eligible"] = pass_eligible(truth_freqs, name, baseline)
   155	        for peak in p.get("top_peaks", []):
   156	            f_peak = peak.get("frequency_per_day")
   157	            if f_peak is not None and truth_freqs and \
   158	               classify_match(float(f_peak), truth_freqs, tol) == "direct":
   159	                any_direct_top = True
   160	    best_freq = row["best_frequency_per_day"]
   161	    row["best_match"] = (
   162	        classify_match(float(best_freq), truth_freqs, tol)
   163	        if best_freq is not None and truth_freqs else "unscored"
   164	    )
   165	    row["best_match_primary"] = (
   166	        classify_match(float(best_freq), [primary_freq], tol)
   167	        if best_freq is not None and primary_freq is not None else "unscored"
   168	    )
   169	    row["matched_any_mode_diagnostic"] = any_direct_top
   170	    row["eligible_any_pass"] = row["low_eligible"] or row["high_eligible"]
   171	    return row
