   282	def census_lookup_csv(path: Path) -> dict[str, dict]:
   283	    frame = pd.read_csv(path, dtype={"source_id": str})
   284	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   285	    for col in ratio_cols:
   286	        exact = frame[col] == 2.5
   287	        if exact.any():
   288	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   289	    return {
   290	        r["source_id"]: {"census_variable": bool(r["census_variable"]),
   291	                         "census_g_nightly": bool(r["census_g_nightly"])}
   292	        for _, r in frame.iterrows()
   293	    }
