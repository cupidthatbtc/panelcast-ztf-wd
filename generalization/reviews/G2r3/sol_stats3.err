   240	def truth_d2(shards_dir: Path) -> pd.DataFrame:
   241	    """Truth from injected_modes.csv — the ACTUALLY injected (post-sinc-
   242	    rejection) mode set per shard, never the original mode table (G2 methods
   243	    finding 4)."""
   244	    manifest = pd.read_csv(shards_dir / "shard_manifest.csv",
   245	                           dtype={"campaign_id": str, "template_source_id": str})
   246	    injected = pd.read_csv(shards_dir / "injected_modes.csv",
   247	                           dtype={"campaign_id": str})
   248	    freq_lists = injected.groupby("campaign_id")["frequency_per_day"].apply(
   249	        lambda g: sorted(g.tolist())).to_dict()
   250	    dominant = {}
   251	    amp_dom = {}
   252	    for sid, group in injected.groupby("campaign_id"):
   253	        best = group.loc[group["amp_tess_ppt"].idxmax()]
   254	        dominant[sid] = float(best["frequency_per_day"])
   255	        amp_dom[sid] = float(best["amp_tess_ppt"])
   256	    rows = []
   257	    for r in manifest.itertuples(index=False):
   258	        arm = r.arm
   259	        tic = int(r.tic)
   260	        sid = r.campaign_id
   261	        truth = freq_lists.get(sid, []) if arm in ("A", "B") else []
   262	        rows.append({
   263	            "sid": sid, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   264	            "class_label": f"arm_{arm}",
   265	            "label_positive": arm in ("A", "B"),
   266	            "weight": 1.0, "cluster": str(tic) if tic else sid,
   267	            "truth_freqs": truth,
   268	            "primary_freq": dominant.get(sid) if arm in ("A", "B") else None,
   269	            "amp": float(amp_dom.get(sid, math.nan)),
   270	            "truth_period_days": (86400.0 / dominant[sid] / 86400.0)
   271	            if sid in dominant and arm in ("A", "B") else math.nan,
   272	            "freq_scorable": arm in ("A", "B") and bool(truth),
   273	            "arm": arm, "template_k": r.template_k,
   274	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   275	            "template_status": getattr(r, "template_status", ""),
   276	        })
   277	    return pd.DataFrame(rows)
