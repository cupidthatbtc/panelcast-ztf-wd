   315	def completeness_tables(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   316	    # primary frequency-match column: D3 scores the DOMINANT Mo mode (any-mode
   317	    # is secondary/diagnostic); D2 scores the exact injected list; D1 is
   318	    # diagnostic-only either way (spec).
   319	    primary_match = {"d1": "best_match_primary", "d2": "best_match",
   320	                     "d3": "best_match_primary"}[dataset]
   321	    rows = []
   322	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   323	    usable = positives[positives["best_status"] != "missing"]
   324	    for pass_name in PASSES:
   325	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   326	        match_col = primary_match if pass_name == "best" else f"{pass_name}_match"
   327	        for rule in RULES:
   328	            for scope, frame in (
   329	                ("detection_eligible_roster", positives),
   330	                ("detection_usable_lightcurve", usable),
   331	                ("freq_recovery_scorable", usable[
   332	                    usable["freq_scorable"]
   333	                    & (usable["eligible_any_pass"] if pass_name == "best"
   334	                       else usable[f"{pass_name}_eligible"])
   335	                ]),
   336	            ):
   337	                if frame.empty:
   338	                    rows.append({"pass": pass_name, "rule": rule, "scope": scope,
   339	                                 "n": 0, "ess": 0.0, "p": math.nan,
   340	                                 "lo": math.nan, "hi": math.nan})
   341	                    continue
   342	                fired = frame.apply(
   343	                    lambda r: rule_fired(rule, r[status_col], r.get("census_variable")),
   344	                    axis=1,
   345	                )
   346	                ok = fired.notna()
   347	                success = fired[ok].astype(bool)
   348	                if scope == "freq_recovery_scorable" and rule in (
   349	                        "confirmed", "confirmed_or_candidate", "either"):
   350	                    success = success & (frame.loc[ok, match_col] == "direct")
   351	                stats = weighted_wilson(
   352	                    success.to_numpy(dtype=float),
   353	                    frame.loc[ok, "weight"].to_numpy(dtype=float),
   354	                )
   355	                rows.append({"pass": pass_name, "rule": rule, "scope": scope, **stats})
   356	    return pd.DataFrame(rows)
   357	
   358	
   359	def contingency(per_star: pd.DataFrame) -> dict:
   360	    from scipy.stats import binomtest
   361	    frame = per_star[(per_star["label_positive"] == True)  # noqa: E712
   362	                     & per_star["census_variable"].notna()
   363	                     & (per_star["best_status"] != "missing")]
   364	    C = frame["census_variable"].astype(bool)
   365	    L = frame["best_status"] == "confirmed"
   366	    a, b = int((C & L).sum()), int((C & ~L).sum())
   367	    c, d = int((~C & L).sum()), int((~C & ~L).sum())
   368	    n = len(frame)
   369	    union_p, union_lo, union_hi = wilson(a + b + c, n) if n else (math.nan,) * 3
   370	    out = {
   371	        "n_positives_scored": n,
   372	        "table": {"census_and_ls": a, "census_only": b, "ls_only": c, "neither": d},
   373	        "union_completeness": {"p": union_p, "lo": union_lo, "hi": union_hi},
   374	        "incremental_census_only": dict(zip(("p", "lo", "hi"), wilson(b, n))) if n else {},
   375	        "incremental_ls_only": dict(zip(("p", "lo", "hi"), wilson(c, n))) if n else {},
   376	    }
   377	    if b + c:
   378	        out["mcnemar_exact_p_secondary"] = float(
   379	            binomtest(min(b, c), b + c, 0.5).pvalue * 1.0
   380	        )
   381	    return out
   382	
   383	
   384	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   385	    scorable = per_star[per_star["freq_scorable"]
   386	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   387	    if len(scorable) < 3:
   388	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   389	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   390	    rates = []
   391	    truth_lists = scorable["truth_freqs"].tolist()
   392	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   393	        perm = rng.permutation(len(truth_lists))
   394	        hits = 0
   395	        for i, row in scorable.iterrows():
   396	            if perm[i] == i:
   397	                continue
   398	            tol = 1.5 / row["baseline_days"]
   399	            if classify_match(float(row["best_frequency_per_day"]),
   400	                              truth_lists[perm[i]], tol) == "direct":
   401	                hits += 1
   402	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   403	        if denom:
   404	            rates.append(hits / denom)
   405	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   406	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   407	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
   408	
   409	
   410	def d2_cluster_bootstrap(per_star: pd.DataFrame) -> pd.DataFrame:
   411	    frame = per_star[per_star.get("arm").isin(["A", "B"])] if "arm" in per_star else per_star.iloc[0:0]
   412	    if frame.empty:
   413	        return pd.DataFrame()
   414	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   415	    rows = []
   416	    for (arm, k), stratum in frame.groupby(["arm", "template_k"]):
   417	        success = (stratum["best_status"] == "confirmed") & (stratum["best_match"] == "direct")
   418	        per_target = success.groupby(stratum["cluster"]).mean()
   419	        point = float(per_target.mean())
   420	        clusters = per_target.index.to_numpy()
   421	        boots = []
   422	        for _ in range(BOOTSTRAP_B):
   423	            sample = rng.choice(clusters, size=len(clusters), replace=True)
   424	            boots.append(float(per_target.loc[sample].mean()))
   425	        rows.append({"arm": arm, "template_k": int(k), "n_targets": len(clusters),
   426	                     "p": point, "lo": float(np.quantile(boots, 0.025)),
   427	                     "hi": float(np.quantile(boots, 0.975))})
   428	    return pd.DataFrame(rows)
   429	
   430	
   431	def surfaces(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   432	    positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   433	                         & per_star["freq_scorable"]]
   434	    if positives.empty:
   435	        return pd.DataFrame()
   436	    amp_edges = AMP_EDGES[dataset]
   437	    rows = []
   438	    p_bins = np.digitize(positives["truth_period_days"], PERIOD_EDGES_DAYS)
   439	    a_bins = np.digitize(positives["amp"], amp_edges)
   440	    success = (positives["best_status"] == "confirmed") & (positives["best_match"] == "direct")

codex
The v3 prose does close most of the statistical ambiguities, but the implementation is not a literal realization of it. Early mismatches include missing binding estimator columns, a frequency-recovery row for the frequencyless census rule, and taxonomy logic that still short-circuits relation checks within a truth mode. I’m tracing these through outputs and tests before assigning statuses.
