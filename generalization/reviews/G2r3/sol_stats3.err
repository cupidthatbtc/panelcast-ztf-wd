   193	        truth = freqs.get(r.source_id, [])
   194	        # 2833849800205759360 is the frozen pipeline's eclipsing-system sanity
   195	        # control (expected confirmed at 6.1464 / d): a known variable, so it
   196	        # can be neither a paper-constant negative nor a roster positive.
   197	        is_control = r.source_id == "2833849800205759360"
   198	        rows.append({
