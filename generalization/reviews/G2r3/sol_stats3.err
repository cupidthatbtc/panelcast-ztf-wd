   122	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None,
   123	               truth_quantum: float = 0.0) -> dict:
   124	    result = json.loads(json_path.read_text(encoding="utf-8"))
   125	    if not result.get("complete"):
   126	        raise SystemExit(f"{json_path} is not complete")
   127	    passes = result["passes"]
   128	    if set(passes) != {"low", "high"}:
   129	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   130	    baseline = float(result["baseline_days"])
   131	    tol = 1.5 / baseline + truth_quantum
   132	    overall = overall_result(result)
   133	
   134	    row: dict = {
   135	        "baseline_days": baseline,
   136	        "n_exp_zg": result["n_exp_zg"],
