   296	def census_from_shard(shard_path: Path) -> dict:
   297	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   298	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   299	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   300	                           n_variants=0, known_roster=False, wd_class="",
   301	                           paper_variable=None, paper_periodic=None)
   302	    nightly = nightly_panel(frame)
   303	    monthly = monthly_panel(nightly)
   304	    row = census_row(meta, frame, nightly, monthly)
   305	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   306	                for c in ("exposure", "nightly", "monthly")):
   307	        if row.get(key) == 2.5:
   308	            raise SystemExit(f"census ratio exactly 2.5 for {shard_path} — spec guard")
   309	    return {"census_variable": bool(row["census_variable"]),
   310	            "census_g_nightly": bool(row["census_g_nightly"])}
