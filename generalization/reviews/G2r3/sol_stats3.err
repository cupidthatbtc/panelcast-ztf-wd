    59	
    60	def wilson(k: float, n: float) -> tuple[float, float, float]:
    61	    if n <= 0:
    62	        return math.nan, math.nan, math.nan
    63	    z = 1.959963984540054
    64	    p = k / n
    65	    denom = 1.0 + z * z / n
    66	    center = (p + z * z / (2 * n)) / denom
    67	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    68	    return p, max(0.0, center - half), min(1.0, center + half)
    69	
    70	
    71	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    72	    total = float(weights.sum())
    73	    if total <= 0:
    74	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    75	    p = float((weights * successes).sum() / total)
    76	    ess = total * total / float((weights * weights).sum())
    77	    _, lo, hi = wilson(p * ess, ess)
    78	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
    79	
    80	
    81	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    82	    classes: set[str] = set()
    83	    for f_t in truth:
    84	        if abs(freq - f_t) <= tol:
    85	            classes.add("direct")
    86	        elif abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    87	            classes.add("harmonic")
    88	        else:
    89	            for k in (1, 2):
    90	                for sign in (1.0, -1.0):
    91	                    if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    92	                        classes.add("window_alias")
    93	    if not classes:
    94	        return "unmatched"
    95	    if len(classes) > 1:
    96	        return "ambiguous"
    97	    return classes.pop()
    98	
    99	
   100	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
   101	    if not truth:
   102	        return False
   103	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   104	    return any(low <= f <= high for f in truth)
   105	
   106	
   107	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   108	    # status "missing" (no usable light curve) fires no L-S rule
   109	    if rule == "confirmed":
   110	        return status == "confirmed"
   111	    if rule == "confirmed_or_candidate":
   112	        return status in ("confirmed", "candidate")
   113	    if rule == "census":
   114	        return None if census_flag is None else bool(census_flag)
   115	    if rule == "either":
   116	        if census_flag is None:
   117	            return status == "confirmed"
   118	        return status == "confirmed" or bool(census_flag)
   119	    raise ValueError(rule)
   120	
