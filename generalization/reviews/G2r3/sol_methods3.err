    99	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
   100	    for tol, label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
   101	        pool = stats[(stats["median_zg"] - gmag).abs() <= tol]
   102	        if len(pool) >= 3:
   103	            break
   104	    else:
   105	        label = "nearest"
   106	    if len(pool) < 3:
   107	        pool = stats.iloc[(stats["median_zg"] - gmag).abs().argsort()[:9]]
   108	    ordered = pool.sort_values(["exp_per_night", "source_id"]).reset_index(drop=True)
   109	    picks = [
   110	        ordered.iloc[min(len(ordered) - 1, int(round(q * (len(ordered) - 1))))]["source_id"]
   111	        for q in (0.10, 0.50, 0.90)
   112	    ]
   113	    return picks, label
   114	
