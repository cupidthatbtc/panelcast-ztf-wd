     1	#!/usr/bin/env python3
     2	"""Resumable, shardable campaign driver over the frozen analyze_star.
     3	
     4	This is the ONLY way campaign Lomb-Scargle searches run. It imports
     5	analyze_star through frozen_api (SHA-gated) and never invokes the frozen CLI,
     6	whose main() would merge against the WD roster and rewrite the published
     7	catalog table. Per-star JSONs are the product; no roster merge, no CSV — the
     8	campaign metrics read the JSONs directly (METRICS_SPEC.md).
     9	
    10	Resumability is inherited from analyze_star: a complete result file is
    11	returned untouched, so re-running after a crash or shard split is safe.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import argparse
    17	import hashlib
    18	import json
    19	import shutil
    20	import time
    21	from concurrent.futures import ProcessPoolExecutor, as_completed
    22	from pathlib import Path
    23	
    24	from frozen_api import (
    25	    analyze_star,
    26	    assert_frozen,
    27	    campaign_file_shas,
    28	    campaign_id_ok,
    29	    env_versions,
    30	    frozen_file_shas,
    31	    physical_workers,
    32	)
    33	
    34	def validate_attestation(report_path: Path) -> dict:
    35	    report = json.loads(report_path.read_text(encoding="utf-8"))
    36	    if report.get("gate") != "replay_gate":
    37	        raise SystemExit(f"{report_path} is not a replay_gate report")
    38	    if report.get("passed") is not True:
    39	        raise SystemExit(f"replay attestation {report_path} is not a PASS")
    40	    if not report.get("stars"):
    41	        raise SystemExit(f"replay attestation {report_path} has an empty roster")
    42	    current = env_versions()
    43	    # the FULL environment fingerprint must match (G2 methods finding 1)
    44	    mismatched = [
    45	        key for key in current
    46	        if report["env"].get(key) != current.get(key)
    47	    ]
    48	    if mismatched:
    49	        raise SystemExit(
    50	            f"replay attestation env differs from this run: {mismatched} "
    51	            f"(attested {[report['env'].get(k) for k in mismatched]} vs "
    52	            f"current {[current.get(k) for k in mismatched]})"
    53	        )
    54	    if report.get("frozen_sha256") != frozen_file_shas():
    55	        raise SystemExit("replay attestation frozen SHAs differ from this checkout")
    56	    return report
    57	
    58	# One in-flight star holds two full-resolution float32 periodogram memmaps plus
    59	# the multiband combination on scratch; the worst published-catalog baseline
    60	# needs 0.471 GB for the three high-pass memmaps, so 0.52 adds ~10% headroom
    61	# for longer campaign baselines. Disk, not wall time, binds worker count.
    62	SCRATCH_GB_PER_WORKER = 0.52
    63	
    64	
    65	def preflight_workers(requested: int | None, work_root: Path) -> tuple[int, float]:
    66	    if requested is not None and requested < 1:
    67	        raise SystemExit(f"invalid --workers {requested}")
    68	    free_gb = shutil.disk_usage(work_root).free / 1e9
    69	    ceiling = int(free_gb * 0.5 / SCRATCH_GB_PER_WORKER)
    70	    if ceiling < 1:
    71	        raise SystemExit(
    72	            f"scratch {work_root} has {free_gb:.1f} GB free — below one worker's "
    73	            f"{SCRATCH_GB_PER_WORKER} GB requirement"
    74	        )
    75	    workers = min(requested or physical_workers(), physical_workers(), ceiling)
    76	    return workers, free_gb
    77	
    78	
    79	def shard_sha256(path: Path) -> str:
    80	    return hashlib.sha256(path.read_bytes()).hexdigest()
    81	
    82	
    83	def env_digest() -> str:
    84	    return hashlib.sha256(
    85	        json.dumps(env_versions(), sort_keys=True).encode()
    86	    ).hexdigest()
    87	
    88	
    89	def provenance_path(star_dir: Path, source_id: str) -> Path:
    90	    return star_dir / f"{source_id}.prov.json"
    91	
    92	
    93	def write_provenance(star_dir: Path, source_id: str, shard: Path) -> None:
    94	    provenance_path(star_dir, source_id).write_text(
    95	        json.dumps({
    96	            "shard_sha256": shard_sha256(shard),
    97	            "env_digest": env_digest(),
    98	            "driver": "run_generalization_ls.py",
    99	        }, indent=2) + "\n",
   100	        encoding="utf-8",
   101	    )
   102	
   103	
   104	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
   105	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
   106	    """A completed result is reused ONLY when its provenance sidecar matches
   107	    the current shard content and environment (G1 methods finding 8); stale
   108	    results are DELETED so analyze_star's internal early-return cannot
   109	    resurrect them."""
   110	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
   111	    if only is not None:
   112	        missing = only - set(source_ids)
   113	        if missing:
   114	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
   115	        source_ids = [sid for sid in source_ids if sid in only]
   116	    if limit is not None:
   117	        source_ids = source_ids[:limit]
   118	    current_env = env_digest()
   119	    pending = []
   120	    for source_id in source_ids:
   121	        result_path = star_dir / f"{source_id}.json"
   122	        prov_file = provenance_path(star_dir, source_id)
   123	        if result_path.exists() and prov_file.exists():
   124	            try:
   125	                result = json.loads(result_path.read_text(encoding="utf-8"))
   126	                prov = json.loads(prov_file.read_text(encoding="utf-8"))
   127	                if (
   128	                    result.get("complete")
   129	                    and set(result.get("passes", {})) >= set(passes)
   130	                    and prov.get("shard_sha256")
   131	                    == shard_sha256(shard_dir / f"{source_id}.csv.gz")
   132	                    and prov.get("env_digest") == current_env
   133	                ):
   134	                    continue
   135	            except json.JSONDecodeError:
   136	                pass
   137	        result_path.unlink(missing_ok=True)
   138	        prov_file.unlink(missing_ok=True)
   139	        pending.append(source_id)
   140	    return pending, len(source_ids)
   141	
   142	
   143	def write_progress(path: Path, payload: dict) -> None:
   144	    temporary = path.with_suffix(".json.part")
   145	    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
   146	    temporary.replace(path)
   147	
   148	
   149	def main() -> None:
   150	    parser = argparse.ArgumentParser(description=__doc__)
   151	    parser.add_argument("--shard-dir", type=Path, required=True)
   152	    parser.add_argument("--out-dir", type=Path, required=True)
   153	    parser.add_argument("--work-root", type=Path, default=None,
   154	                        help="scratch for periodogram memmaps; put on local NVMe "
   155	                             "or a RAM disk, NEVER inside a synced folder")
   156	    parser.add_argument("--dataset", required=True,
   157	                        help="manifest label, e.g. d3-kepler-dsct or d2-tess-dav")
   158	    parser.add_argument("--workers", type=int, default=None)
   159	    parser.add_argument("--passes", default="low,high")
   160	    parser.add_argument("--stars-file", type=Path, default=None,
   161	                        help="optional newline-separated campaign_id subset (a shard)")
   162	    parser.add_argument("--limit", type=int, default=None,
   163	                        help="pilot mode: first N stars only")
   164	    parser.add_argument("--allow-nonstandard-ids", action="store_true",
   165	                        help="permit non-campaign source_ids (replay/debug only)")
   166	    parser.add_argument("--replay-report", type=Path, required=True,
   167	                        help="replay_report.json from a PASSING replay_gate run "
   168	                             "on THIS machine+env; campaign runs refuse to start "
   169	                             "without one (G1 methods finding 1)")
   170	    args = parser.parse_args()
   171	
   172	    assert_frozen()
   173	    attestation = validate_attestation(args.replay_report)
   174	    passes = tuple(args.passes.split(","))
   175	    if passes != ("low", "high") and not args.allow_nonstandard_ids:
   176	        raise SystemExit("production runs use exactly low,high (the frozen CLI's "
   177	                         "pass set); pass --allow-nonstandard-ids for debug runs")
   178	    star_dir = args.out_dir / "stars"
   179	    work_root = args.work_root or (args.out_dir / "work")
   180	    star_dir.mkdir(parents=True, exist_ok=True)
   181	    work_root.mkdir(parents=True, exist_ok=True)
   182	
   183	    only = None
   184	    if args.stars_file:
   185	        only = {line.strip() for line in args.stars_file.read_text().splitlines() if line.strip()}
   186	    pending, total = scan_pending(args.shard_dir, star_dir, passes, only, args.limit)
   187	
   188	    if not args.allow_nonstandard_ids:
   189	        bad = [sid for sid in pending if not campaign_id_ok(sid)]
   190	        if bad:
   191	            raise SystemExit(
   192	                f"{len(bad)} shard ids violate the campaign 19-digit prefix "
   193	                f"convention (first: {bad[:3]}); refusing to run"
   194	            )
   195	
   196	    workers, free_gb = preflight_workers(args.workers, work_root)
   197	    print(
   198	        f"[{args.dataset}] sources={total:,} pending={len(pending):,} "
   199	        f"workers={workers} (free {free_gb:.0f} GB on scratch)",
   200	        flush=True,
   201	    )
   202	
   203	    progress_path = args.out_dir / "progress.json"
   204	    started = time.time()
   205	    failures: dict[str, str] = {}
   206	    completed_now = 0
   207	
   208	    def progress_payload() -> dict:
   209	        elapsed = time.time() - started
   210	        rate = completed_now / elapsed if elapsed > 0 else 0.0
   211	        return {
   212	            "dataset": args.dataset,
   213	            "total": total,
   214	            "pending_at_start": len(pending),
   215	            "completed_now": completed_now,
   216	            "failed": len(failures),
   217	            "elapsed_seconds": round(elapsed, 1),
   218	            "stars_per_hour": round(rate * 3600.0, 2),
   219	            "eta_hours": round((len(pending) - completed_now - len(failures)) / (rate * 3600.0), 2)
   220	            if rate > 0
   221	            else None,
   222	            "workers": workers,
   223	        }
   224	
   225	    write_progress(progress_path, progress_payload())
   226	    with ProcessPoolExecutor(max_workers=workers) as executor:
   227	        futures = {
   228	            executor.submit(
   229	                analyze_star,
   230	                source_id,
   231	                str(args.shard_dir / f"{source_id}.csv.gz"),
   232	                str(star_dir / f"{source_id}.json"),
   233	                str(work_root),
   234	                passes,
   235	            ): source_id
   236	            for source_id in pending
   237	        }
   238	        for future in as_completed(futures):
   239	            source_id = futures[future]
   240	            try:
   241	                future.result()
   242	                write_provenance(star_dir, source_id,
   243	                                 args.shard_dir / f"{source_id}.csv.gz")
   244	                completed_now += 1
   245	            except Exception as exc:
   246	                failures[source_id] = repr(exc)
   247	                print(f"[{args.dataset}] FAILED {source_id}: {exc}", flush=True)
   248	            if completed_now % 10 == 0 or completed_now + len(failures) == len(pending):
   249	                write_progress(progress_path, progress_payload())
   250	                print(
   251	                    f"[{args.dataset}] {completed_now:,}/{len(pending):,} "
   252	                    f"({progress_payload()['stars_per_hour']}/h)",
   253	                    flush=True,
   254	                )
   255	
   256	    manifest = {
   257	        "dataset": args.dataset,
   258	        "driver": "run_generalization_ls.py",
   259	        "source_count": total,
   260	        "pending_at_start": len(pending),
   261	        "completed_now": completed_now,
   262	        "failures": failures,
   263	        "passes": list(passes),
   264	        "workers": workers,
   265	        "wall_seconds": round(time.time() - started, 1),
   266	        "shard_dir": str(args.shard_dir),
   267	        "env": env_versions(),
   268	        "frozen_sha256": assert_frozen(),
   269	        "campaign_sha256": campaign_file_shas(),
   270	        "replay_attestation": {
