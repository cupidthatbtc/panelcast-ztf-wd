   369	            except Exception as exc:
   370	                qc["read_status"] = "error"
   371	                qc["error"] = repr(exc)
   372	                qc_rows.append(qc)
   373	                continue
   374	
   375	            for band in BANDS:
   376	                qc[f"{band}_raw_rows"] = int((raw["filtercode"] == band).sum())
   377	                qc[f"{band}_clean_rows"] = int((clean["band"] == band).sum())
   378	            is_crossmatched = all(
   379	                qc[f"{band}_clean_rows"] >= MIN_EXPOSURES_PER_BAND for band in BANDS
   380	            )
   381	            qc["crossmatched"] = is_crossmatched
   382	            qc_rows.append(qc)
   383	            if not is_crossmatched:
   384	                continue
   385	
   386	            crossmatched += 1
   387	            clean["source_id"] = meta.source_id
