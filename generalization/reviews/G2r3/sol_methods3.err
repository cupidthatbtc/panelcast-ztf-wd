   574	        "env": env_versions(),
   575	        "frozen_sha256": frozen_file_shas(),
   576	        "campaign_sha256": campaign_file_shas(),
   577	    }
   578	    (args.out_dir / "manifest.json").write_text(
   579	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
   580	    (args.out_dir / "inputs_sha256.json").write_text(
   581	        json.dumps(inputs, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   582	    (args.out_dir / "attrition.csv").write_text(
   583	        pd.DataFrame([attrition]).to_csv(index=False), encoding="utf-8")
   584	    print(json.dumps(attrition, indent=2))
