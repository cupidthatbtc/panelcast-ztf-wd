   176	def truth_d1() -> pd.DataFrame:
   177	    """Labels from the PUBLISHED master table (19 usable stars; 13
   178	    paper-variable) — the 20-row acquisition roster additionally contains
   179	    sanity controls whose paper_variable flag does not enter the published
   180	    counts. D1 truth frequencies are non-contemporaneous literature
   181	    tabulations (multi-mode DAVs wander between epochs); frequency-recovery
   182	    scoring for D1 is therefore DIAGNOSTIC ONLY (METRICS_SPEC) and D1's
   183	    estimand is detection completeness."""
   184	    master = pd.read_csv(
   185	        REPO_ROOT / "lomb-scargle/results/2026-08-01_full/master_table.csv",
   186	        dtype={"source_id": str},
   187	    )
   188	    lit = pd.read_csv(REPO_ROOT / "data/roster/literature_periods.csv",
   189	                      dtype={"source_id": str})
   190	    freqs = lit.groupby("source_id")["frequency_per_day"].apply(list).to_dict()
   191	    rows = []
   192	    for r in master.itertuples(index=False):
   193	        truth = freqs.get(r.source_id, [])
   194	        # 2833849800205759360 is the frozen pipeline's eclipsing-system sanity
   195	        # control (expected confirmed at 6.1464 / d): a known variable, so it
   196	        # can be neither a paper-constant negative nor a roster positive.
   197	        is_control = r.source_id == "2833849800205759360"
   198	        rows.append({
   199	            "sid": r.source_id, "external_id": r.wdj_name,
   200	            "class_label": "transit_control" if is_control else r.wd_class,
   201	            "label_positive": None if is_control
   202	            else str(r.paper_variable).lower() == "true",
   203	            "weight": 1.0, "cluster": r.source_id,
   204	            "truth_freqs": truth,
   205	            "primary_freq": truth[0] if truth else None,
   206	            "amp": math.nan, "truth_period_days": 1.0 / truth[0] if truth else math.nan,
   207	            "freq_scorable": bool(truth),
   208	        })
   209	    return pd.DataFrame(rows)
