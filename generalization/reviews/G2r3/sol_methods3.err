   452	def trigger_rates(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   453	    rows = []
   454	    if dataset == "d3":
   455	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
   456	        for rule in RULES:
   457	            fired = negatives.apply(
   458	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
   459	                axis=1,
   460	            )
   461	            ok = fired.notna()
   462	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
   463	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
   464	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
   465	    if dataset == "d2" and "arm" in per_star:
   466	        for arm, name in (("null", "fpr_gaussian"), ("ctrl", "native_trigger_rate")):
   467	            subset = per_star[per_star["arm"] == arm]
   468	            if subset.empty:
   469	                continue
   470	            fired = subset["best_status"] == "confirmed"
   471	            stats = weighted_wilson(fired.to_numpy(dtype=float),
   472	                                    np.ones(len(subset)))
   473	            rows.append({"quantity": name, "rule": "confirmed", **stats})
   474	    return pd.DataFrame(rows)
