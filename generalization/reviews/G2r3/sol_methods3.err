   519	
   520	def fp_frequency_distribution(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   521	    if dataset == "d3":
   522	        pool = per_star[per_star["class_label"] == "dsct_flag0"]
   523	    elif dataset == "d2" and "arm" in per_star:
   524	        pool = per_star[per_star["arm"].isin(["null", "ctrl"])]
   525	    else:
   526	        pool = per_star.iloc[0:0]
   527	    triggered = pool[pool["best_status"].isin(["confirmed", "candidate"])]
   528	    columns = ["sid", "class_label", "best_status", "best_pass",
   529	               "best_frequency_per_day", "baseline_days"]
   530	    return triggered[[c for c in columns if c in triggered.columns]]
   531	
   532	
   533	def sensitivity_table(per_star: pd.DataFrame, dataset: str,
   534	                      crossmatch_qc: pd.DataFrame | None) -> pd.DataFrame:
   535	    rows = []
   536	
   537	    def rate(frame: pd.DataFrame, label: str, variant: str) -> None:
   538	        if frame.empty:
   539	            return
   540	        success = (frame["best_status"] == "confirmed")
   541	        rows.append({"variant": variant, "subset": label,
   542	                     "n": len(frame), "k": int(success.sum()),
   543	                     **dict(zip(("p", "lo", "hi"), wilson(int(success.sum()), len(frame))))})
   544	
   545	    if dataset == "d2" and "arm" in per_star:
   546	        # common-subset rule: nominal recomputed on the SAME median-window
   547	        # (k=1) subset used by every non-nominal scenario
   548	        median_b = per_star[(per_star["arm"] == "B") & (per_star["template_k"] == 1)]
   549	        for (g, r), scenario in median_b.groupby(["ratio_g", "ratio_rg"]):
   550	            rate(scenario, "arm_b_median_window", f"ladder_g{g}_rg{r}")
   551	    if dataset == "d3":
   552	        positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   553	                             & (per_star["best_status"] != "missing")]
   554	        if "near_saturation" in positives:
   555	            rate(positives[positives["near_saturation"] == True], "positives", "near_saturation")  # noqa: E712
   556	            rate(positives[positives["near_saturation"] == False], "positives", "safe_magnitude")  # noqa: E712
   557	        if crossmatch_qc is not None:
   558	            qc = crossmatch_qc.set_index("source_id")
   559	            joined = positives.join(
   560	                qc[["nearest_separation_arcsec", "ztf_objects_in_cone"]], on="sid")
   561	            clean = joined[(joined["nearest_separation_arcsec"] < 1.0)
   562	                           & (joined["ztf_objects_in_cone"] <= 3)]
   563	            rate(clean, "positives", "crowding_clean")
   564	    return pd.DataFrame(rows)
   565	
   566	
   567	def sha256_file(path: Path) -> str:
   568	    return hashlib.sha256(path.read_bytes()).hexdigest()
