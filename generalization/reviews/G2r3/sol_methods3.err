   125	def synthesize(
   126	    template: pd.DataFrame,
   127	    model,
   128	    source_id: str,
   129	    gaussian_floor: bool,
   130	    seed: int,
   131	) -> pd.DataFrame:
   132	    frame = template.copy()
   133	    frame["source_id"] = source_id
   134	    t_ref = float(frame["bjd_tdb"].min())
   135	    if gaussian_floor:
   136	        rng = np.random.Generator(np.random.PCG64(seed))
   137	        for band in ("zg", "zr"):
   138	            mask = frame["band"] == band
   139	            median = float(frame.loc[mask, "mag"].median())
   140	            noise = rng.normal(0.0, frame.loc[mask, "magerr"].to_numpy(dtype=float))
   141	            frame.loc[mask, "mag"] = median + noise
   142	    for band in ("zg", "zr"):
   143	        mask = frame["band"] == band
   144	        frame.loc[mask, "mag"] = frame.loc[mask, "mag"] + model.evaluate(
   145	            frame.loc[mask, "bjd_tdb"].to_numpy(dtype=float), band, t_ref
   146	        )
   147	    return frame
