     1	#!/usr/bin/env python3
     2	"""Resumable, shardable campaign driver over the frozen analyze_star.
     3	
     4	This is the ONLY way campaign Lomb-Scargle searches run. It imports
     5	analyze_star through frozen_api (SHA-gated) and never invokes the frozen CLI,
     6	whose main() would merge against the WD roster and rewrite the published
     7	catalog table. Per-star JSONs are the product; no roster merge, no CSV — the
     8	campaign metrics read the JSONs directly (METRICS_SPEC.md).
     9	
    10	Resumability is inherited from analyze_star: a complete result file is
    11	returned untouched, so re-running after a crash or shard split is safe.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import argparse
    17	import hashlib
    18	import json
    19	import shutil
    20	import time
    21	from concurrent.futures import ProcessPoolExecutor, as_completed
    22	from pathlib import Path
    23	
    24	from frozen_api import (
    25	    analyze_star,
    26	    assert_frozen,
    27	    campaign_file_shas,
    28	    campaign_id_ok,
    29	    env_versions,
    30	    frozen_file_shas,
    31	    physical_workers,
    32	)
    33	
    34	def validate_attestation(report_path: Path) -> dict:
    35	    report = json.loads(report_path.read_text(encoding="utf-8"))
    36	    if report.get("gate") != "replay_gate":
    37	        raise SystemExit(f"{report_path} is not a replay_gate report")
    38	    if report.get("passed") is not True:
    39	        raise SystemExit(f"replay attestation {report_path} is not a PASS")
    40	    if not report.get("stars"):
    41	        raise SystemExit(f"replay attestation {report_path} has an empty roster")
    42	    current = env_versions()
    43	    # the FULL environment fingerprint must match (G2 methods finding 1)
    44	    mismatched = [
    45	        key for key in current
    46	        if report["env"].get(key) != current.get(key)
    47	    ]
    48	    if mismatched:
    49	        raise SystemExit(
    50	            f"replay attestation env differs from this run: {mismatched} "
    51	            f"(attested {[report['env'].get(k) for k in mismatched]} vs "
    52	            f"current {[current.get(k) for k in mismatched]})"
    53	        )
    54	    if report.get("frozen_sha256") != frozen_file_shas():
    55	        raise SystemExit("replay attestation frozen SHAs differ from this checkout")
    56	    return report
    57	
    58	# One in-flight star holds two full-resolution float32 periodogram memmaps plus
    59	# the multiband combination on scratch; the worst published-catalog baseline
    60	# needs 0.471 GB for the three high-pass memmaps, so 0.52 adds ~10% headroom
    61	# for longer campaign baselines. Disk, not wall time, binds worker count.
    62	SCRATCH_GB_PER_WORKER = 0.52
    63	
    64	
    65	def preflight_workers(requested: int | None, work_root: Path) -> tuple[int, float]:
    66	    if requested is not None and requested < 1:
    67	        raise SystemExit(f"invalid --workers {requested}")
    68	    free_gb = shutil.disk_usage(work_root).free / 1e9
    69	    ceiling = int(free_gb * 0.5 / SCRATCH_GB_PER_WORKER)
    70	    if ceiling < 1:
    71	        raise SystemExit(
    72	            f"scratch {work_root} has {free_gb:.1f} GB free — below one worker's "
    73	            f"{SCRATCH_GB_PER_WORKER} GB requirement"
    74	        )
    75	    workers = min(requested or physical_workers(), physical_workers(), ceiling)
    76	    return workers, free_gb
    77	
    78	
    79	def shard_sha256(path: Path) -> str:
    80	    return hashlib.sha256(path.read_bytes()).hexdigest()
    81	
    82	
    83	def env_digest() -> str:
    84	    return hashlib.sha256(
    85	        json.dumps(env_versions(), sort_keys=True).encode()
    86	    ).hexdigest()
    87	
    88	
    89	def provenance_path(star_dir: Path, source_id: str) -> Path:
    90	    return star_dir / f"{source_id}.prov.json"
    91	
    92	
    93	def write_provenance(star_dir: Path, source_id: str, shard: Path) -> None:
    94	    provenance_path(star_dir, source_id).write_text(
    95	        json.dumps({
    96	            "shard_sha256": shard_sha256(shard),
    97	            "env_digest": env_digest(),
    98	            "driver": "run_generalization_ls.py",
    99	        }, indent=2) + "\n",
   100	        encoding="utf-8",
   101	    )
   102	
   103	
   104	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
   105	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
   106	    """A completed result is reused ONLY when its provenance sidecar matches
   107	    the current shard content and environment (G1 methods finding 8); stale
   108	    results are DELETED so analyze_star's internal early-return cannot
   109	    resurrect them."""
   110	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
   111	    if only is not None:
   112	        missing = only - set(source_ids)
   113	        if missing:
   114	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
   115	        source_ids = [sid for sid in source_ids if sid in only]
   116	    if limit is not None:
   117	        source_ids = source_ids[:limit]
   118	    current_env = env_digest()
   119	    pending = []
   120	    for source_id in source_ids:
   121	        result_path = star_dir / f"{source_id}.json"
   122	        prov_file = provenance_path(star_dir, source_id)
   123	        if result_path.exists() and prov_file.exists():
   124	            try:
   125	                result = json.loads(result_path.read_text(encoding="utf-8"))
   126	                prov = json.loads(prov_file.read_text(encoding="utf-8"))
   127	                if (
   128	                    result.get("complete")
   129	                    and set(result.get("passes", {})) >= set(passes)
   130	                    and prov.get("shard_sha256")
   131	                    == shard_sha256(shard_dir / f"{source_id}.csv.gz")
   132	                    and prov.get("env_digest") == current_env
   133	                ):
   134	                    continue
   135	            except json.JSONDecodeError:
   136	                pass
   137	        result_path.unlink(missing_ok=True)
   138	        prov_file.unlink(missing_ok=True)
   139	        pending.append(source_id)
   140	    return pending, len(source_ids)
   141	
   142	
   143	def write_progress(path: Path, payload: dict) -> None:
   144	    temporary = path.with_suffix(".json.part")
   145	    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
   146	    temporary.replace(path)
