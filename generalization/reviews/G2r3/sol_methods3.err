   481	def main() -> None:
   482	    parser = argparse.ArgumentParser(description=__doc__)
   483	    parser.add_argument("--dataset", choices=("d1", "d2", "d3"), required=True)
   484	    parser.add_argument("--stars-dir", type=Path, required=True)
   485	    parser.add_argument("--census-csv", type=Path, default=None)
   486	    parser.add_argument("--shards-dir", type=Path, default=None,
   487	                        help="d2: shard dir with shard_manifest.csv; census "
   488	                             "computed from shards when --census-csv absent")
   489	    parser.add_argument("--out-dir", type=Path, required=True)
   490	    args = parser.parse_args()
   491	
   492	    assert_frozen()
