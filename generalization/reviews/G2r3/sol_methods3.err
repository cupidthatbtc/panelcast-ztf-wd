   201	            "label_positive": None if is_control
   202	            else str(r.paper_variable).lower() == "true",
   203	            "weight": 1.0, "cluster": r.source_id,
   204	            "truth_freqs": truth,
   205	            "primary_freq": truth[0] if truth else None,
   206	            "amp": math.nan, "truth_period_days": 1.0 / truth[0] if truth else math.nan,
   207	            "freq_scorable": bool(truth),
