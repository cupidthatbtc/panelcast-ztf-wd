    72	def load_templates(exposures_path: Path, catalog_path: Path) -> tuple[pd.DataFrame, dict]:
    73	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
    74	    if len(catalog) != 928:
    75	        raise SystemExit(f"published catalog has {len(catalog)} rows, expected 928")
    76	    pool_ids = set(catalog["source_id"])
    77	    status = catalog.set_index("source_id")["blind_status"].to_dict()
    78	    exposures = pd.read_csv(
    79	        exposures_path,
    80	        dtype={"source_id": str, "band": str},
    81	        usecols=EXPOSURE_COLUMNS,
    82	    )
    83	    exposures = exposures[exposures["source_id"].isin(pool_ids)]
    84	    zg = exposures[exposures["band"] == "zg"]
    85	    stats = zg.groupby("source_id").agg(
    86	        median_zg=("mag", "median"),
    87	        n_zg=("mag", "size"),
    88	    )
    89	    epn = (
    90	        zg.groupby(["source_id", "night_mjd"]).size().groupby("source_id").median()
    91	        .rename("exp_per_night")
    92	    )
    93	    stats = stats.join(epn)
    94	    stats["blind_status"] = [status[sid] for sid in stats.index]
    95	    frames = {sid: frame for sid, frame in exposures.groupby("source_id")}
    96	    return stats.reset_index(), frames
    97	
