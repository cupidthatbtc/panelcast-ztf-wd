   276	    (args.out_dir / "manifest.json").write_text(
   277	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   278	    )
   279	    write_progress(progress_path, progress_payload())
   280	    print(f"[{args.dataset}] done: {completed_now:,} completed, {len(failures)} failed", flush=True)
   281	    if failures:
   282	        raise SystemExit(1)
