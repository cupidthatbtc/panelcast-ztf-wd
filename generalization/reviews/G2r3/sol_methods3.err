     1	#!/usr/bin/env python3
     2	"""Single import surface for the frozen 2026-08-01 pipeline.
     3	
     4	The generalization campaign (branch generalization/campaign-1) never edits the
     5	scripts that produced the published 2026-08-01_full bundle. Campaign code
     6	imports frozen callables ONLY through this module, which verifies the SHA-256
     7	of every frozen file against the values recorded at tag `frozen-2026-08-01`
     8	before any import happens. `assert_frozen()` is also called explicitly at the
     9	top of every campaign script.
    10	
    11	Referee defense: `git diff frozen-2026-08-01 -- <frozen files>` is empty, and
    12	scripts/generalization/replay_gate.py reproduces published per-star results
    13	under these imports.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import hashlib
    19	import os
    20	import platform
    21	import sys
    22	from pathlib import Path
    23	
    24	REPO_ROOT = Path(
    25	    os.environ.get("GENERALIZATION_REPO_ROOT", Path(__file__).resolve().parents[2])
    26	)
    27	SCRIPTS_DIR = REPO_ROOT / "scripts"
    28	
    29	FROZEN_TAG = "frozen-2026-08-01"
    30	
    31	# SHA-256 of every frozen file at tag frozen-2026-08-01 (== branch point of
    32	# generalization/campaign-1). Recorded 2026-08-28; never update these values —
    33	# a mismatch means the frozen pipeline was edited and all campaign results are void.
    34	FROZEN_SHA256 = {
    35	    "scripts/run_catalog_lomb_scargle.py": "34a4de5d234cab07dc3231e5671f4220f5c4ab1bdd4b3d92183bb7e443da6c46",
    36	    "scripts/run_lomb_scargle.py": "ce9211254949969b5d2e7a93f350eb387014aaf0a15f939753c599c1261a4e78",
    37	    "scripts/lomb_scargle_common.py": "5ed3983e6a9b91f86b4ba2afc37025ba97fee4ef8a0086259140618927bfef7d",
    38	    "scripts/build_catalog_panels.py": "1fb659cfdf6997751bc7589b70bdd26fa0d210f49e0e9da5da82bcbb1a5d9794",
    39	    "scripts/fetch_catalog_lightcurves.py": "e28f4ade76fedf78e056b26b62549a4c5dfc1e0c76d5d127876cce7b3cb3ed82",
    40	}
    41	
    42	# Campaign source_id convention: 19-digit numeric strings, dataset-prefixed.
    43	# All prefixes chosen so ids cannot collide with real Gaia DR3 source_ids used
    44	# in the 2026-08-01 run and so int(source_id[-9:]) (the frozen bootstrap's seed
    45	# convention) is always a valid int.
    46	CAMPAIGN_ID_PREFIXES = {
    47	    "90": "D3 ZTF x Kepler delta Scuti (real ZTF light curves)",
    48	    "92": "D2 arm B (TESS-truth signal + real ZTF photometry)",
    49	    "93": "D2 arm A (TESS-truth signal + synthetic Gaussian floor)",
    50	    "94": "D2 Gaussian nulls (zero amplitude, arm-A floor)",
    51	    "95": "D2 paired real-window controls (uninjected template windows)",
    52	}
    53	
    54	
    55	class FrozenIntegrityError(RuntimeError):
    56	    """A frozen file's content no longer matches tag frozen-2026-08-01."""
    57	
    58	
    59	def frozen_file_shas() -> dict[str, str]:
    60	    shas: dict[str, str] = {}
    61	    for rel in FROZEN_SHA256:
    62	        path = REPO_ROOT / rel
    63	        shas[rel] = hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "MISSING"
    64	    return shas
    65	
    66	
    67	def assert_frozen() -> dict[str, str]:
    68	    actual = frozen_file_shas()
    69	    mismatches = [
    70	        f"{rel}: expected {expected[:12]}..., found {actual[rel][:12]}..."
    71	        for rel, expected in FROZEN_SHA256.items()
    72	        if actual[rel] != expected
    73	    ]
    74	    if mismatches:
    75	        raise FrozenIntegrityError(
    76	            "frozen pipeline files modified since tag "
    77	            f"{FROZEN_TAG}:\n" + "\n".join(mismatches)
    78	        )
    79	    return actual
    80	
    81	
    82	def env_versions() -> dict[str, str]:
    83	    import astropy
    84	    import astropy_iers_data
    85	    import erfa
    86	    import numpy
    87	    import pandas
    88	    import scipy
    89	
    90	    blas = ""
    91	    try:
    92	        config = numpy.__config__.CONFIG["Build Dependencies"]["blas"]
    93	        blas = f"{config.get('name', '')} {config.get('version', '')}".strip()
    94	    except Exception:
    95	        pass
    96	    return {
    97	        "python": platform.python_version(),
    98	        "platform": platform.platform(),
    99	        "machine": platform.node(),
   100	        "numpy": numpy.__version__,
   101	        "numpy_blas": blas,
   102	        "scipy": scipy.__version__,
   103	        "astropy": astropy.__version__,
   104	        "astropy_iers_data": astropy_iers_data.__version__,
   105	        "pyerfa": erfa.__version__,
   106	        "pandas": pandas.__version__,
   107	        "omp_num_threads": os.environ.get("OMP_NUM_THREADS", ""),
   108	        "openblas_num_threads": os.environ.get("OPENBLAS_NUM_THREADS", ""),
   109	    }
   110	
   111	
   112	def campaign_file_shas() -> dict[str, str]:
   113	    """SHA-256 of every campaign script + spec, recorded in every manifest so
   114	    adapter-shell drift is visible (G1 methods finding 9)."""
   115	    shas: dict[str, str] = {}
   116	    for path in sorted((REPO_ROOT / "scripts/generalization").glob("*.py")):
   117	        shas[f"scripts/generalization/{path.name}"] = hashlib.sha256(
   118	            path.read_bytes()
   119	        ).hexdigest()
   120	    for rel in ("generalization/GENERALIZATION_PLAN.md", "generalization/METRICS_SPEC.md"):
   121	        path = REPO_ROOT / rel
   122	        if path.exists():
   123	            shas[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
   124	    return shas
   125	
   126	
   127	def campaign_id_ok(source_id: str) -> bool:
   128	    return (
   129	        isinstance(source_id, str)
   130	        and len(source_id) == 19
   131	        and source_id.isdigit()
   132	        and source_id[:2] in CAMPAIGN_ID_PREFIXES
   133	    )
   134	
   135	
   136	assert_frozen()
   137	_FROZEN_MODULES = (
   138	    "run_catalog_lomb_scargle",
   139	    "run_lomb_scargle",
   140	    "lomb_scargle_common",
   141	    "build_catalog_panels",
   142	)
   143	for _name in _FROZEN_MODULES:
   144	    if _name in sys.modules:
   145	        raise FrozenIntegrityError(
   146	            f"{_name} was imported before frozen_api verified it"
   147	        )
   148	sys.path.insert(0, str(SCRIPTS_DIR))
   149	
   150	from build_catalog_panels import (  # noqa: E402
   151	    BANDS,
   152	    EXPOSURE_COLUMNS,
   153	    MIN_EXPOSURES_PER_BAND,
   154	    MONTHLY_COLUMNS,
   155	    NIGHTLY_COLUMNS,
   156	    OID_CLUSTER_ARCSEC,
   157	    PALOMAR,
   158	    add_bjd,
   159	    angular_separation_arcsec,
   160	    census_row,
   161	    clean_rows,
   162	    monthly_panel,
   163	    nightly_panel,
   164	    read_cache,
   165	    scatter_over_error,
   166	    select_nearest_source,
   167	)
   168	from lomb_scargle_common import (  # noqa: E402
   169	    FrequencyGrid,
   170	    SAMPLES_PER_PEAK,
   171	    SIDEREAL_FREQUENCY,
   172	    WINDOW_POWER_THRESHOLD,
   173	    prepare_series,
   174	)
   175	from run_catalog_lomb_scargle import (  # noqa: E402
   176	    analyze_star,
   177	    load_star,
   178	    overall_result,
   179	    physical_workers,
   180	    unavailable_pass_result,
   181	)
   182	from run_lomb_scargle import (  # noqa: E402
   183	    PASS_BOUNDS,
   184	    grid_for,
   185	    json_ready,
   186	)
   187	
   188	for _name in _FROZEN_MODULES:
   189	    _file = Path(sys.modules[_name].__file__).resolve()
   190	    if _file != (SCRIPTS_DIR / f"{_name}.py").resolve():
   191	        raise FrozenIntegrityError(
   192	            f"{_name} resolved to {_file}, not the SHA-verified copy"
   193	        )
   194	
   195	__all__ = [
   196	    "REPO_ROOT",
   197	    "SCRIPTS_DIR",
   198	    "FROZEN_TAG",
   199	    "FROZEN_SHA256",
