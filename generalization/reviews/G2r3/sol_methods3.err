    64	from frozen_api import EXPOSURE_COLUMNS, REPO_ROOT, assert_frozen, campaign_id_ok
    65	
    66	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
    67	MATCH_TOL_MAG = 0.25
    68	MATCH_TOL_WIDE = 0.5
    69	N_NULLS = 1000
