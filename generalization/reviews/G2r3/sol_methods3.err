     1	#!/usr/bin/env python3
     2	"""Panel-stage golden gate: the frozen crossmatch/QC/BJD chain reproduces the
     3	published exposure panel on THIS machine and environment.
     4	
     5	The L-S replay gate consumes already-generated bjd_tdb, so it cannot detect
     6	drift in the panel stage (astropy Time/light_travel_time, IERS tables, ERFA
     7	build — G1 methods finding 6). This gate closes that hole: it re-derives the
     8	exposure rows for sampled stars from the PUBLISHED raw IRSA cache using the
     9	frozen functions exactly as build_catalog_panels.main() does (IERS
    10	auto-download disabled; the pinned astropy-iers-data package supplies the
    11	table) and compares against the published exposures.csv.gz:
    12	
    13	  SCIENCE columns except bjd_tdb (source_id, band, mjd, night_mjd, mag,
    14	  magerr) must be BYTE-identical; bjd_tdb is compared at <= 1 ulp (~40 us):
    15	  the barycentric chain sits at double rounding boundaries, so any ns-level
    16	  IERS-state difference since build time flips the last bit — measured on
    17	  the production machine itself (2026-08-28). 1 ulp is 7e-7 cycles at the
    18	  shortest searched period; the campaign pins IERS via astropy-iers-data
    19	  with auto_download disabled and records the max ulp deviation. Carried
    20	  metadata (oid, ra, dec, chi) is compared at <= 1 ulp, because the archived
    21	  cache tarball is a re-serialization of the fetch-time responses (17-digit
    22	  float strings) whose parse can differ from the original short strings by
    23	  one ulp. chi additionally must not sit within 1e-9 of the QC boundary 4.0.
    24	"""
    25	
    26	from __future__ import annotations
    27	
    28	import argparse
    29	import gzip
    30	import io
    31	import json
    32	import tarfile
    33	from pathlib import Path
    34	
    35	import pandas as pd
    36	from astropy.utils import iers
    37	
    38	iers.conf.auto_download = False
    39	
    40	from frozen_api import (  # noqa: E402
    41	    EXPOSURE_COLUMNS,
    42	    REPO_ROOT,
    43	    add_bjd,
    44	    assert_frozen,
    45	    clean_rows,
    46	    env_versions,
    47	    read_cache,
    48	    select_nearest_source,
    49	)
    50	
    51	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
    52	
    53	
    54	SCIENCE_COLUMNS = ["source_id", "band", "mjd", "night_mjd", "mag", "magerr"]
    55	META_COLUMNS = ["ra", "dec", "chi"]
    56	
    57	
    58	def rebuild_star(cache_bytes: bytes, ra: float, dec: float, source_id: str) -> pd.DataFrame:
    59	    raw = read_cache(io.BytesIO(cache_bytes))
    60	    selected, _, _, _ = select_nearest_source(raw, ra, dec)
    61	    clean, _ = clean_rows(selected)
    62	    clean["source_id"] = source_id
    63	    clean = add_bjd(clean, ra, dec)
    64	    clean = clean.sort_values(["band", "bjd_tdb"])
    65	    return clean[EXPOSURE_COLUMNS].reset_index(drop=True)
    66	
    67	
    68	def compare_star(rebuilt: pd.DataFrame, reference: pd.DataFrame) -> dict:
    69	    if len(rebuilt) != len(reference):
    70	        return {"verdict": "MISMATCH", "reason": f"row count {len(rebuilt)} != {len(reference)}"}
    71	    sci_a = rebuilt[SCIENCE_COLUMNS].to_csv(index=False, lineterminator="\n")
    72	    sci_b = reference[SCIENCE_COLUMNS].to_csv(index=False, lineterminator="\n")
    73	    if sci_a != sci_b:
    74	        for line_no, (a, b) in enumerate(zip(sci_a.splitlines(), sci_b.splitlines())):
    75	            if a != b:
    76	                return {"verdict": "MISMATCH", "reason": "science columns differ",
    77	                        "first_diff_line": line_no, "rebuilt": a[:160], "published": b[:160]}
    78	    import numpy as np
    79	    bjd_a = rebuilt["bjd_tdb"].to_numpy(dtype=float)
    80	    bjd_b = reference["bjd_tdb"].to_numpy(dtype=float)
    81	    bjd_ulp = np.abs(bjd_a - bjd_b) / np.spacing(np.abs(bjd_b))
    82	    if (bjd_ulp > 1.0).any():
    83	        worst = int(np.argmax(bjd_ulp))
    84	        return {"verdict": "MISMATCH", "reason": "bjd_tdb beyond 1 ulp",
    85	                "row": worst, "max_ulp": float(bjd_ulp.max())}
    86	    if not (rebuilt["oid"].astype(str) == reference["oid"].astype(str)).all():
    87	        return {"verdict": "MISMATCH", "reason": "oid differs"}
    88	    chi = reference["chi"].to_numpy(dtype=float)
    89	    if (abs(chi - 4.0) < 1e-9).any():
    90	        return {"verdict": "MISMATCH", "reason": "chi within 1e-9 of QC boundary 4.0"}
    91	    for col in META_COLUMNS:
    92	        a = rebuilt[col].to_numpy(dtype=float)
    93	        b = reference[col].to_numpy(dtype=float)
    94	        ulp = np.spacing(np.abs(b))
    95	        if (np.abs(a - b) > ulp).any():
    96	            worst = int(np.argmax(np.abs(a - b) / np.maximum(ulp, 1e-300)))
    97	            return {"verdict": "MISMATCH", "reason": f"{col} beyond 1 ulp",
    98	                    "row": worst, "rebuilt": float(a[worst]), "published": float(b[worst])}
    99	    all_exact = (bjd_ulp == 0.0).all() and all(
   100	        (rebuilt[c].to_numpy(dtype=float) == reference[c].to_numpy(dtype=float)).all()
   101	        for c in ("ra", "dec", "chi")
   102	    )
   103	    return {"verdict": "identical" if all_exact else "identical_1ulp",
   104	            "bjd_max_ulp": float(bjd_ulp.max()),
   105	            "bjd_rows_off_by_1ulp": int((bjd_ulp > 0).sum())}
   106	
   107	
   108	def main() -> None:
   109	    parser = argparse.ArgumentParser(description=__doc__)
   110	    parser.add_argument("--count", type=int, default=5)
   111	    parser.add_argument("--out", type=Path,
   112	                        default=REPO_ROOT / "outputs/generalization/panel_golden_report.json")
   113	    args = parser.parse_args()
   114	    assert_frozen()
   115	
   116	    roster = pd.read_csv(REPO_ROOT / "data/roster/jestin2026_rebuilt_candidates.csv",
   117	                         dtype={"source_id": str})
   118	    coords = roster.set_index("source_id")[["ra", "dec"]]
   119	
   120	    published = pd.read_csv(PUBLISHED / "data/exposures.csv.gz",
   121	                            dtype={"source_id": str, "band": str})
   122	    star_ids = sorted(published["source_id"].unique())
   123	    stride = max(1, len(star_ids) // args.count)
   124	    sample = star_ids[::stride][: args.count]
   125	
   126	    records = []
   127	    with tarfile.open(PUBLISHED / "data/irsa_raw_cache.tar.gz") as archive:
   128	        for source_id in sample:
   129	            member = archive.extractfile(f"catalog_lc_cache/{source_id}.csv")
   130	            if member is None:
   131	                records.append({"source_id": source_id, "verdict": "MISSING_CACHE"})
   132	                continue
   133	            rebuilt = rebuild_star(
   134	                member.read(),
   135	                float(coords.loc[source_id, "ra"]),
   136	                float(coords.loc[source_id, "dec"]),
   137	                source_id,
   138	            )
   139	            reference = published[published["source_id"] == source_id][
   140	                EXPOSURE_COLUMNS
   141	            ].reset_index(drop=True)
   142	            record = {"source_id": source_id, "rows": len(reference),
   143	                      **compare_star(rebuilt, reference)}
   144	            records.append(record)
   145	            print(f"[panel-golden] {source_id}: {record['verdict']}", flush=True)
   146	
   147	    passed = all(
   148	        r["verdict"] in ("identical", "identical_1ulp") for r in records
   149	    )
   150	    report = {"gate": "panel_golden_gate", "passed": passed, "stars": records,
   151	              "env": env_versions()}
   152	    args.out.parent.mkdir(parents=True, exist_ok=True)
   153	    args.out.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
   154	    print(f"[panel-golden] {'PASS' if passed else 'FAIL'} -> {args.out}")
   155	    raise SystemExit(0 if passed else 1)
   156	
   157	
   158	if __name__ == "__main__":
   159	    main()

