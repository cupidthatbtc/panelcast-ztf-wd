    58	
    59	def frozen_file_shas() -> dict[str, str]:
    60	    shas: dict[str, str] = {}
    61	    for rel in FROZEN_SHA256:
    62	        path = REPO_ROOT / rel
    63	        shas[rel] = hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "MISSING"
    64	    return shas
    65	
