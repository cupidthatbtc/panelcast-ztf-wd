    78	    assert abs(frozen_api.SIDEREAL_FREQUENCY - 1.00273790935) < 1e-12
    79	    assert frozen_api.MIN_EXPOSURES_PER_BAND == 20
    80	    assert frozen_api.OID_CLUSTER_ARCSEC == 1.5
    81	
