   494	        truth = truth_d1()
   495	    elif args.dataset == "d3":
   496	        truth = truth_d3()
   497	    else:
   498	        if args.shards_dir is None:
   499	            raise SystemExit("d2 needs --shards-dir")
   500	        truth = truth_d2(args.shards_dir)
   501	
   502	    census = census_lookup_csv(args.census_csv) if args.census_csv else {}
   503	    inputs: dict[str, str] = {}
   504	    if args.census_csv:
   505	        inputs[str(args.census_csv)] = sha256_file(args.census_csv)
   506	
   507	    rows = []
   508	    missing = []
   509	    for r in truth.itertuples(index=False):
   510	        json_path = args.stars_dir / f"{r.sid}.json"
   511	        if not json_path.exists():
   512	            # eligible roster target with no usable light curve: counts as a
   513	            # non-detection in the eligible-roster estimand, excluded from the
   514	            # usable-light-curve estimand (G2 stats finding 2)
   515	            missing.append(r.sid)
   516	            record = {**r._asdict(),
   517	                      "best_status": "missing", "low_status": "missing",
   518	                      "high_status": "missing", "best_match": "unscored",
   519	                      "best_match_primary": "unscored", "low_match": "unscored",
   520	                      "high_match": "unscored", "low_eligible": False,
   521	                      "high_eligible": False, "eligible_any_pass": False,
   522	                      "best_frequency_per_day": None, "baseline_days": math.nan,
   523	                      "matched_any_mode_diagnostic": False,
   524	                      "census_variable": census.get(r.sid, {}).get("census_variable")}
   525	            rows.append(record)
   526	            continue
   527	        inputs[str(json_path)] = sha256_file(json_path)
   528	        scored = score_star(json_path, list(r.truth_freqs), r.primary_freq,
   529	                            TRUTH_QUANTUM_PER_DAY[args.dataset])
   530	        record = {**r._asdict(), **scored}
   531	        if r.sid in census:
   532	            record.update(census[r.sid])
   533	        elif args.dataset == "d2" and args.shards_dir is not None:
   534	            record.update(census_from_shard(args.shards_dir / f"{r.sid}.csv.gz"))
   535	        else:
   536	            record["census_variable"] = None
   537	        rows.append(record)
   538	    per_star = pd.DataFrame(rows)
   539	    if per_star.empty:
   540	        raise SystemExit("no stars scored")
