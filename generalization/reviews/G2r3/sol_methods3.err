    41	def test_amplitude_chain_nominal():
    42	    model = build_truth_model(42, [240.0], [10.0], cadence_s=120.0)
    43	    mode = model.modes[0]
    44	    intrinsic_mag = (10.0 * 1e-3 / (2.0 / math.pi)) * 1.0857
    45	    assert abs(mode.amp_g_mag - intrinsic_mag * 1.7) < 1e-12
    46	    assert abs(mode.amp_r_mag - intrinsic_mag * 1.7 * 0.80) < 1e-12
    47	    # ZTF 30-s integration barely attenuates a 240-s mode
