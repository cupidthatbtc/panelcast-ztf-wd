   431	def surfaces(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   432	    positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   433	                         & per_star["freq_scorable"]]
   434	    if positives.empty:
   435	        return pd.DataFrame()
   436	    amp_edges = AMP_EDGES[dataset]
   437	    rows = []
   438	    p_bins = np.digitize(positives["truth_period_days"], PERIOD_EDGES_DAYS)
   439	    a_bins = np.digitize(positives["amp"], amp_edges)
   440	    success = (positives["best_status"] == "confirmed") & (positives["best_match"] == "direct")
   441	    for (pb, ab), idx in positives.groupby([p_bins, a_bins]).groups.items():
   442	        cell = positives.loc[idx]
   443	        k = int(success.loc[idx].sum())
   444	        n = len(cell)
   445	        entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   446	        if n >= MIN_CELL:
   447	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   448	        rows.append(entry)
   449	    return pd.DataFrame(rows)
   450	
   451	
   452	def trigger_rates(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   453	    rows = []
   454	    if dataset == "d3":
   455	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
   456	        for rule in RULES:
   457	            fired = negatives.apply(
   458	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
   459	                axis=1,
   460	            )
   461	            ok = fired.notna()
   462	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
   463	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
   464	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
   465	    if dataset == "d2" and "arm" in per_star:
   466	        for arm, name in (("null", "fpr_gaussian"), ("ctrl", "native_trigger_rate")):
   467	            subset = per_star[per_star["arm"] == arm]
   468	            if subset.empty:
   469	                continue
   470	            fired = subset["best_status"] == "confirmed"
   471	            stats = weighted_wilson(fired.to_numpy(dtype=float),
   472	                                    np.ones(len(subset)))
   473	            rows.append({"quantity": name, "rule": "confirmed", **stats})
   474	    return pd.DataFrame(rows)
   475	
