   571	def main() -> None:
   572	    parser = argparse.ArgumentParser(description=__doc__)
   573	    parser.add_argument("--dataset", choices=("d1", "d2", "d3"), required=True)
   574	    parser.add_argument("--stars-dir", type=Path, required=True)
   575	    parser.add_argument("--census-csv", type=Path, default=None)
   576	    parser.add_argument("--shards-dir", type=Path, default=None,
   577	                        help="d2: shard dir with shard_manifest.csv; census "
   578	                             "computed from shards when --census-csv absent")
   579	    parser.add_argument("--out-dir", type=Path, required=True)
   580	    parser.add_argument("--crossmatch-qc", type=Path, default=None,
   581	                        help="d3: crossmatch_qc.csv from build_panels_generic "
   582	                             "(enables the crowding sensitivity subset)")
   583	    args = parser.parse_args()
   584	
   585	    assert_frozen()
   586	    if args.dataset == "d1":
   587	        truth = truth_d1()
   588	    elif args.dataset == "d3":
   589	        truth = truth_d3()
   590	    else:
   591	        if args.shards_dir is None:
   592	            raise SystemExit("d2 needs --shards-dir")
   593	        truth = truth_d2(args.shards_dir)
   594	
   595	    census = census_lookup_csv(args.census_csv) if args.census_csv else {}
   596	    inputs: dict[str, str] = {}
   597	    if args.census_csv:
   598	        inputs[str(args.census_csv)] = sha256_file(args.census_csv)
   599	
   600	    rows = []
   601	    missing = []
   602	    for r in truth.itertuples(index=False):
   603	        json_path = args.stars_dir / f"{r.sid}.json"
   604	        if not json_path.exists():
   605	            # eligible roster target with no usable light curve: counts as a
   606	            # non-detection in the eligible-roster estimand, excluded from the
   607	            # usable-light-curve estimand (G2 stats finding 2)
   608	            missing.append(r.sid)
   609	            record = {**r._asdict(),
   610	                      "best_status": "missing", "low_status": "missing",
   611	                      "high_status": "missing", "best_match": "unscored",
   612	                      "best_match_primary": "unscored", "low_match": "unscored",
   613	                      "high_match": "unscored", "low_eligible": False,
   614	                      "high_eligible": False, "eligible_any_pass": False,
   615	                      "best_frequency_per_day": None, "baseline_days": math.nan,
   616	                      "matched_any_mode_diagnostic": False,
   617	                      "census_variable": census.get(r.sid, {}).get("census_variable")}
   618	            rows.append(record)
   619	            continue
   620	        inputs[str(json_path)] = sha256_file(json_path)
   621	        scored = score_star(json_path, list(r.truth_freqs), r.primary_freq,
   622	                            TRUTH_QUANTUM_PER_DAY[args.dataset])
   623	        record = {**r._asdict(), **scored}
   624	        if r.sid in census:
   625	            record.update(census[r.sid])
   626	        elif args.dataset == "d2" and args.shards_dir is not None:
   627	            record.update(census_from_shard(args.shards_dir / f"{r.sid}.csv.gz"))
   628	        else:
   629	            record["census_variable"] = None
   630	        rows.append(record)
   631	    per_star = pd.DataFrame(rows)
   632	    if per_star.empty:
   633	        raise SystemExit("no stars scored")
   634	
   635	    args.out_dir.mkdir(parents=True, exist_ok=True)
   636	    per_star.drop(columns=["truth_freqs"]).to_csv(
   637	        args.out_dir / "per_star.csv", index=False)
   638	    completeness_tables(per_star, args.dataset).to_csv(
   639	        args.out_dir / "completeness_by_class_pass_rule.csv", index=False)
   640	    (args.out_dir / "contingency_complementarity.json").write_text(
   641	        json.dumps(contingency(per_star), indent=2) + "\n", encoding="utf-8")
   642	    trigger_rates(per_star, args.dataset).to_csv(
   643	        args.out_dir / "trigger_rates.csv", index=False)
   644	    (args.out_dir / "chance_match.json").write_text(
   645	        json.dumps(chance_match_rate(per_star), indent=2) + "\n", encoding="utf-8")
   646	    surface = surfaces(per_star, args.dataset)
   647	    (args.out_dir / "surfaces").mkdir(exist_ok=True)
   648	    surface.to_csv(args.out_dir / "surfaces" / "period_amplitude.csv", index=False)
   649	    if args.dataset == "d2":
   650	        d2_cluster_bootstrap(per_star).to_csv(
