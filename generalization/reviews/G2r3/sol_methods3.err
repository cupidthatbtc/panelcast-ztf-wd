    44	CHANCE_MATCH_PERMUTATIONS = 100
    45	CHANCE_MATCH_SEED = 20260829
    46	BOOTSTRAP_B = 2000
    47	BOOTSTRAP_SEED = 20260830
    48	MIN_CELL = 5
    49	# added to the pipeline 1.5/baseline tolerance: truth-table quantization
    50	# (D1 literature frequencies are tabulated to 2 decimals; Mo/injected truth
    51	# is effectively exact)
    52	TRUTH_QUANTUM_PER_DAY = {"d1": 0.0025, "d2": 0.0, "d3": 0.0}
    53	PERIOD_EDGES_DAYS = [100 / 86400, 200 / 86400, 500 / 86400, 1000 / 86400,
    54	                     2000 / 86400, 0.05, 0.2, 1.0, 10.0, 100.0]
    55	AMP_EDGES = {"d1": [0.5, 1, 2, 5, 10, 20, 50, 200],
    56	             "d3": [0.5, 1, 2, 5, 10, 20, 50, 200],
    57	             "d2": [0.5, 2, 5, 10, 30, 100]}
