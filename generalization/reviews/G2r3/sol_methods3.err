     1	#!/usr/bin/env python3
     2	"""Generic panel/census builder: frozen QC chain over a campaign roster.
     3	
     4	Re-implements ONLY the roster/paths plumbing of build_catalog_panels.main();
     5	every scientific operation (nearest-cluster crossmatch, row QC, BJD_TDB
     6	conversion, nightly/monthly binning, 2.5-ratio census) is the frozen function
     7	imported through frozen_api, applied verbatim.
     8	
     9	Roster CSV contract (build_d3_roster.py writes this):
    10	  source_id     19-digit campaign id (prefix 90/92/93/94)
    11	  external_id   upstream name (e.g. KIC 8462852)
    12	  ra, dec       ICRS degrees for the ZTF cone
    13	  class_label   truth class (e.g. dsct_flag1, notdsct_flag0)
    14	  label_variable, label_periodic   truth booleans (may be empty)
    15	  gaia_g_mag    optional; empty allowed
    16	Census output maps the frozen column names onto campaign semantics:
    17	wdj_name<-external_id, wd_class<-class_label, paper_variable<-label_variable,
    18	paper_periodic<-label_periodic, known_roster<-False, in_core<-True,
    19	n_variants<-0, bp_rp<-NaN unless provided.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import argparse
    25	import json
    26	import math
    27	from pathlib import Path
    28	from types import SimpleNamespace
    29	
    30	import pandas as pd
    31	from astropy.utils import iers
    32	
    33	# BJD generation must not depend on a live IERS download (G1 methods finding 6);
    34	# the pinned astropy-iers-data package supplies the table, recorded in the
    35	# manifest via env_versions().
    36	iers.conf.auto_download = False
    37	
    38	from frozen_api import (
    39	    BANDS,
    40	    campaign_file_shas,
    41	    EXPOSURE_COLUMNS,
    42	    MIN_EXPOSURES_PER_BAND,
    43	    MONTHLY_COLUMNS,
    44	    NIGHTLY_COLUMNS,
    45	    add_bjd,
    46	    assert_frozen,
    47	    campaign_id_ok,
    48	    census_row,
    49	    clean_rows,
    50	    env_versions,
    51	    frozen_file_shas,
    52	    monthly_panel,
    53	    nightly_panel,
    54	    read_cache,
    55	    select_nearest_source,
    56	)
    57	
    58	
    59	def roster_meta(row: pd.Series) -> SimpleNamespace:
    60	    def opt_float(name: str) -> float:
    61	        value = row.get(name)
    62	        try:
    63	            return float(value)
    64	        except (TypeError, ValueError):
    65	            return math.nan
    66	
    67	    def opt_bool(name: str):
    68	        value = row.get(name)
    69	        if pd.isna(value) or value == "":
    70	            return None
    71	        if isinstance(value, str):
    72	            return value.lower() == "true"
    73	        return bool(value)
    74	
    75	    return SimpleNamespace(
    76	        source_id=str(row["source_id"]),
    77	        wdj_name=str(row.get("external_id", "")),
    78	        gaia_g_mag=opt_float("gaia_g_mag"),
    79	        bp_rp=opt_float("bp_rp"),
    80	        in_core=True,
    81	        n_variants=0,
    82	        known_roster=False,
    83	        wd_class=str(row.get("class_label", "")),
    84	        paper_variable=opt_bool("label_variable"),
    85	        paper_periodic=opt_bool("label_periodic"),
    86	    )
    87	
    88	
    89	def main() -> None:
    90	    parser = argparse.ArgumentParser(description=__doc__)
    91	    parser.add_argument("--roster", type=Path, required=True)
    92	    parser.add_argument("--cache-dir", type=Path, required=True,
    93	                        help="IRSA response cache: <source_id>.csv per target")
    94	    parser.add_argument("--out-dir", type=Path, required=True)
    95	    parser.add_argument("--allow-nonstandard-ids", action="store_true")
    96	    args = parser.parse_args()
    97	
    98	    assert_frozen()
    99	    args.out_dir.mkdir(parents=True, exist_ok=True)
   100	    exposure_star_dir = args.out_dir / "exposure_stars"
   101	    exposure_star_dir.mkdir(parents=True, exist_ok=True)
   102	
   103	    roster = pd.read_csv(args.roster, dtype={"source_id": str})
   104	    if not args.allow_nonstandard_ids:
   105	        bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
   106	        if bad:
   107	            raise SystemExit(f"{len(bad)} roster ids violate the campaign convention: {bad[:3]}")
   108	
   109	    qc_rows: list[dict[str, object]] = []
   110	    census_rows: list[dict[str, object]] = []
   111	    crossmatched = 0
   112	
   113	    for index, (_, row) in enumerate(roster.iterrows(), 1):
   114	        meta = roster_meta(row)
   115	        cache_path = args.cache_dir / f"{meta.source_id}.csv"
   116	        qc: dict[str, object] = {
   117	            "source_id": meta.source_id,
   118	            "external_id": meta.wdj_name,
   119	            "class_label": meta.wd_class,
   120	            "cache_present": cache_path.exists() and cache_path.stat().st_size > 0,
   121	            "read_status": "ok",
   122	        }
   123	        if not qc["cache_present"]:
   124	            qc["read_status"] = "missing"
   125	            qc_rows.append(qc)
   126	            continue
   127	        try:
   128	            raw = read_cache(cache_path)
   129	            qc["raw_rows"] = len(raw)
   130	            selected, separation, n_objects, n_selected = select_nearest_source(
   131	                raw, float(row["ra"]), float(row["dec"])
   132	            )
   133	            clean, drop_counts = clean_rows(selected)
   134	            qc.update(drop_counts)
   135	            qc["nearest_separation_arcsec"] = separation
   136	            qc["ztf_objects_in_cone"] = n_objects
   137	            qc["selected_ztf_objects"] = n_selected
   138	        except Exception as exc:
   139	            qc["read_status"] = "error"
   140	            qc["error"] = repr(exc)
   141	            qc_rows.append(qc)
   142	            continue
   143	
   144	        for band in BANDS:
   145	            qc[f"{band}_raw_rows"] = int((raw["filtercode"] == band).sum())
   146	            qc[f"{band}_clean_rows"] = int((clean["band"] == band).sum())
   147	        is_crossmatched = all(
   148	            qc[f"{band}_clean_rows"] >= MIN_EXPOSURES_PER_BAND for band in BANDS
   149	        )
   150	        qc["crossmatched"] = is_crossmatched
   151	        qc_rows.append(qc)
   152	        if not is_crossmatched:
   153	            continue
   154	
   155	        crossmatched += 1
   156	        clean["source_id"] = meta.source_id
   157	        clean = add_bjd(clean, float(row["ra"]), float(row["dec"]))
   158	        clean = clean.sort_values(["band", "bjd_tdb"])
   159	        clean[EXPOSURE_COLUMNS].to_csv(
   160	            exposure_star_dir / f"{meta.source_id}.csv.gz", index=False
   161	        )
   162	        nightly = nightly_panel(clean)
   163	        monthly = monthly_panel(nightly)
   164	        census_rows.append(census_row(meta, clean, nightly, monthly))
   165	        if index % 50 == 0 or index == len(roster):
   166	            print(f"[panels-generic] {index:,}/{len(roster):,}; crossmatched={crossmatched:,}",
   167	                  flush=True)
   168	
   169	    pd.DataFrame(qc_rows).to_csv(args.out_dir / "crossmatch_qc.csv", index=False)
   170	    pd.DataFrame(census_rows).to_csv(args.out_dir / "census_generic.csv", index=False)
   171	    manifest = {
   172	        "builder": "build_panels_generic.py",
   173	        "roster": str(args.roster),
   174	        "roster_rows": len(roster),
   175	        "crossmatched_count": crossmatched,
   176	        "crossmatch_rule": "frozen: nearest ZTF coordinate cluster; "
   177	                           f">={MIN_EXPOSURES_PER_BAND} QC-passing exposures in zg and zr",
   178	        "row_qc": "frozen: catflags == 0; finite mag; finite magerr > 0; chi < 4; finite MJD",
   179	        "census_threshold": 2.5,
   180	        "env": env_versions(),
   181	        "frozen_sha256": frozen_file_shas(),
   182	        "campaign_sha256": campaign_file_shas(),
   183	    }
   184	    (args.out_dir / "panels_manifest.json").write_text(
   185	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   186	    )
   187	    print(f"[panels-generic] crossmatched {crossmatched:,}/{len(roster):,}")
   188	
   189	
   190	if __name__ == "__main__":
   191	    main()

