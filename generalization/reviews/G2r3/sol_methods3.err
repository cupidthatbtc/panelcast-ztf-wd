    33	def validate_attestation(report_path: Path) -> dict:
    34	    report = json.loads(report_path.read_text(encoding="utf-8"))
    35	    if report.get("gate") != "replay_gate":
    36	        raise SystemExit(f"{report_path} is not a replay_gate report")
    37	    if report.get("passed") is not True:
    38	        raise SystemExit(f"replay attestation {report_path} is not a PASS")
    39	    if not report.get("stars"):
    40	        raise SystemExit(f"replay attestation {report_path} has an empty roster")
    41	    current = env_versions()
    42	    # the FULL environment fingerprint must match (G2 methods finding 1)
    43	    mismatched = [
    44	        key for key in current
    45	        if report["env"].get(key) != current.get(key)
    46	    ]
    47	    if mismatched:
    48	        raise SystemExit(
    49	            f"replay attestation env differs from this run: {mismatched} "
    50	            f"(attested {[report['env'].get(k) for k in mismatched]} vs "
    51	            f"current {[current.get(k) for k in mismatched]})"
    52	        )
    53	    if report.get("frozen_sha256") != frozen_file_shas():
    54	        raise SystemExit("replay attestation frozen SHAs differ from this checkout")
    55	    return report
    56	
    57	# One in-flight star holds two full-resolution float32 periodogram memmaps plus
    58	# the multiband combination on scratch; the worst published-catalog baseline
    59	# needs 0.471 GB for the three high-pass memmaps, so 0.52 adds ~10% headroom
    60	# for longer campaign baselines. Disk, not wall time, binds worker count.
    61	SCRATCH_GB_PER_WORKER = 0.52
    62	
    63	
    64	def preflight_workers(requested: int | None, work_root: Path) -> tuple[int, float]:
    65	    if requested is not None and requested < 1:
    66	        raise SystemExit(f"invalid --workers {requested}")
    67	    free_gb = shutil.disk_usage(work_root).free / 1e9
    68	    ceiling = int(free_gb * 0.5 / SCRATCH_GB_PER_WORKER)
    69	    if ceiling < 1:
    70	        raise SystemExit(
    71	            f"scratch {work_root} has {free_gb:.1f} GB free — below one worker's "
    72	            f"{SCRATCH_GB_PER_WORKER} GB requirement"
    73	        )
    74	    workers = min(requested or physical_workers(), physical_workers(), ceiling)
    75	    return workers, free_gb
    76	
    77	
    78	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
    79	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
    80	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
    81	    if only is not None:
    82	        missing = only - set(source_ids)
    83	        if missing:
    84	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
    85	        source_ids = [sid for sid in source_ids if sid in only]
    86	    if limit is not None:
    87	        source_ids = source_ids[:limit]
    88	    pending = []
    89	    for source_id in source_ids:
    90	        result_path = star_dir / f"{source_id}.json"
    91	        if result_path.exists():
    92	            try:
    93	                result = json.loads(result_path.read_text(encoding="utf-8"))
    94	                if result.get("complete") and set(result.get("passes", {})) >= set(passes):
    95	                    continue
    96	            except json.JSONDecodeError:
    97	                pass
    98	        pending.append(source_id)
    99	    return pending, len(source_ids)
