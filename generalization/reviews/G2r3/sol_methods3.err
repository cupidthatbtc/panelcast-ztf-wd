   477	def ppv_d3(per_star: pd.DataFrame) -> dict:
   478	    """Frame-specific label PPV: weighted fraction of triggered (rule-1, best
   479	    pass) roster members labeled dSct=1; dSct=2 excluded, reported separately.
   480	    Survey bootstrap: negatives resampled with replacement, positives fixed."""

