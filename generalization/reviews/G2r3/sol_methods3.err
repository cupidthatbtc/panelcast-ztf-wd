    80	
    81	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    82	    classes: set[str] = set()
    83	    for f_t in truth:
    84	        if abs(freq - f_t) <= tol:
    85	            classes.add("direct")
    86	        elif abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    87	            classes.add("harmonic")
    88	        else:
    89	            for k in (1, 2):
    90	                for sign in (1.0, -1.0):
    91	                    if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    92	                        classes.add("window_alias")
    93	    if not classes:
    94	        return "unmatched"
    95	    if len(classes) > 1:
    96	        return "ambiguous"
    97	    return classes.pop()
    98	
    99	
   100	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
   101	    if not truth:
   102	        return False
   103	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   104	    return any(low <= f <= high for f in truth)
   105	
   106	
   107	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   108	    # status "missing" (no usable light curve) fires no L-S rule
   109	    if rule == "confirmed":
   110	        return status == "confirmed"
   111	    if rule == "confirmed_or_candidate":
   112	        return status in ("confirmed", "candidate")
   113	    if rule == "census":
   114	        return None if census_flag is None else bool(census_flag)
   115	    if rule == "either":
   116	        if census_flag is None:
   117	            return status == "confirmed"
   118	        return status == "confirmed" or bool(census_flag)
   119	    raise ValueError(rule)
   120	
   121	
   122	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None,
   123	               truth_quantum: float = 0.0) -> dict:
   124	    result = json.loads(json_path.read_text(encoding="utf-8"))
   125	    if not result.get("complete"):
   126	        raise SystemExit(f"{json_path} is not complete")
   127	    passes = result["passes"]
   128	    if set(passes) != {"low", "high"}:
   129	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   130	    baseline = float(result["baseline_days"])
   131	    tol = 1.5 / baseline + truth_quantum
   132	    overall = overall_result(result)
   133	
   134	    row: dict = {
   135	        "baseline_days": baseline,
   136	        "n_exp_zg": result["n_exp_zg"],
   137	        "n_exp_zr": result["n_exp_zr"],
   138	        "best_pass": overall["best_pass"],
   139	        "best_status": overall["blind_status"],
   140	        "best_frequency_per_day": overall["best_frequency_per_day"],
   141	        "low_available": passes["low"].get("available", True),
   142	        "high_available": passes["high"].get("available", True),
   143	    }
   144	    any_direct_top = False
   145	    for name in ("low", "high"):
   146	        p = passes[name]
   147	        freq = p.get("frequency_per_day")
   148	        row[f"{name}_status"] = p["status"]
   149	        row[f"{name}_frequency_per_day"] = freq
   150	        row[f"{name}_match"] = (
   151	            classify_match(float(freq), truth_freqs, tol)
   152	            if freq is not None and truth_freqs else "unscored"
   153	        )
   154	        row[f"{name}_eligible"] = pass_eligible(truth_freqs, name, baseline)
   155	        for peak in p.get("top_peaks", []):
   156	            f_peak = peak.get("frequency_per_day")
   157	            if f_peak is not None and truth_freqs and \
   158	               classify_match(float(f_peak), truth_freqs, tol) == "direct":
   159	                any_direct_top = True
   160	    best_freq = row["best_frequency_per_day"]
   161	    row["best_match"] = (
   162	        classify_match(float(best_freq), truth_freqs, tol)
   163	        if best_freq is not None and truth_freqs else "unscored"
   164	    )
   165	    row["best_match_primary"] = (
   166	        classify_match(float(best_freq), [primary_freq], tol)
   167	        if best_freq is not None and primary_freq is not None else "unscored"
   168	    )
   169	    row["matched_any_mode_diagnostic"] = any_direct_top
   170	    row["eligible_any_pass"] = row["low_eligible"] or row["high_eligible"]
   171	    return row
