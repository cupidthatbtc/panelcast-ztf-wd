     1	#!/usr/bin/env python3
     2	"""Replay gate: reproduce published 2026-08-01 per-star results byte-for-byte.
     3	
     4	Re-runs the frozen `analyze_star` (imported through frozen_api, exactly as the
     5	campaign driver will) on a deterministic sample of published stars and compares
     6	the fresh output against the committed bundle files.
     7	
     8	Comparison tiers, strongest first:
     9	  identical                  raw bytes equal
    10	  identical_newline          equal after CRLF->LF normalization (git stored the
    11	                             bundle newline-normalized; Windows writes CRLF)
    12	  identical_v1_schema        equal after the documented v1->v2 schema transform:
    13	                             the run that produced 921/928 published files
    14	                             predates commit fa16d7f, which added sparse-input
    15	                             early-exit branches plus the `available`/
    16	                             `unavailable_reason` keys and bumped schema_version
    17	                             1->2; for any star that yields candidates the
    18	                             numeric path is unchanged (the new branches fire
    19	                             only on sparse inputs that previously crashed).
    20	                             The replayed output is re-serialized with
    21	                             schema_version=1 and those two keys dropped, then
    22	                             byte-compared against the published file.
    23	  MISMATCH                   anything else; the first differing JSON path is
    24	                             reported. The gate FAILS.
    25	
    26	The gate passes only if every sampled star lands in one of the identical tiers
    27	AND at least one schema-v2 star reproduces with no transform (proving full-byte
    28	reproduction of the final script's output). Campaign L-S runs are valid only on
    29	machine+env combinations where this gate has passed.
    30	"""
    31	
    32	from __future__ import annotations
    33	
    34	import argparse
    35	import json
    36	import time
    37	from concurrent.futures import ProcessPoolExecutor, as_completed
    38	from pathlib import Path
    39	
    40	from frozen_api import (
    41	    REPO_ROOT,
    42	    analyze_star,
    43	    assert_frozen,
    44	    env_versions,
    45	    json_ready,
    46	    physical_workers,
    47	)
    48	
    49	PUBLISHED_STARS = (
    50	    REPO_ROOT / "catalog-rebuild/results/2026-08-01_full/lomb-scargle/stars"
    51	)
    52	
    53	
    54	def normalize(raw: bytes) -> bytes:
    55	    return raw.replace(b"\r\n", b"\n")
    56	
    57	
    58	def schema_v1_bytes(replayed: dict) -> bytes:
    59	    downgraded = dict(replayed)
    60	    downgraded["schema_version"] = 1
    61	    downgraded["passes"] = {
    62	        name: {
    63	            key: value
    64	            for key, value in pass_result.items()
    65	            if key not in ("available", "unavailable_reason")
    66	        }
    67	        for name, pass_result in replayed["passes"].items()
    68	    }
    69	    text = json.dumps(downgraded, indent=2, default=json_ready) + "\n"
    70	    return text.encode("utf-8")
    71	
    72	
    73	def first_difference(published: object, replayed: object, path: str = "$") -> str:
    74	    if type(published) is not type(replayed):
    75	        return f"{path}: type {type(published).__name__} != {type(replayed).__name__}"
    76	    if isinstance(published, dict):
    77	        for key in sorted(set(published) | set(replayed)):
    78	            if key not in published:
    79	                return f"{path}.{key}: only in replay"
    80	            if key not in replayed:
    81	                return f"{path}.{key}: only in published"
    82	            diff = first_difference(published[key], replayed[key], f"{path}.{key}")
    83	            if diff:
    84	                return diff
    85	        return ""
    86	    if isinstance(published, list):
    87	        if len(published) != len(replayed):
    88	            return f"{path}: length {len(published)} != {len(replayed)}"
    89	        for index, (left, right) in enumerate(zip(published, replayed)):
    90	            diff = first_difference(left, right, f"{path}[{index}]")
    91	            if diff:
    92	                return diff
    93	        return ""
    94	    if published != replayed:
    95	        return f"{path}: {published!r} != {replayed!r}"
    96	    return ""
    97	
    98	
    99	def published_schema_version(path: Path) -> int:
   100	    return int(json.loads(path.read_text(encoding="utf-8"))["schema_version"])
   101	
   102	
   103	def select_stars(published_dir: Path, shard_dir: Path, count: int) -> list[str]:
   104	    available = {
   105	        path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz")
   106	    }
   107	    stars = sorted(
   108	        path.stem
   109	        for path in published_dir.glob("*.json")
   110	        if not path.name.endswith(".error.json") and path.stem in available
   111	    )
   112	    if not stars:
   113	        raise SystemExit(f"no published stars have shards in {shard_dir}")
   114	    v2 = [star for star in stars if published_schema_version(published_dir / f"{star}.json") == 2]
   115	    v1 = [star for star in stars if star not in set(v2)]
   116	    selected = list(v2)[:count]
   117	    remaining = count - len(selected)
   118	    if remaining > 0 and v1:
   119	        stride = max(1, len(v1) // remaining)
   120	        selected.extend(v1[::stride][:remaining])
   121	    return sorted(selected)
   122	
   123	
   124	def compare_star(star: str, published_dir: Path, replay_dir: Path) -> dict[str, object]:
   125	    published_path = published_dir / f"{star}.json"
   126	    replay_path = replay_dir / f"{star}.json"
   127	    published_raw = published_path.read_bytes()
   128	    replay_raw = replay_path.read_bytes()
   129	    record: dict[str, object] = {
   130	        "source_id": star,
   131	        "published_schema_version": published_schema_version(published_path),
   132	    }
   133	    if published_raw == replay_raw:
   134	        record["verdict"] = "identical"
   135	        return record
   136	    published_norm = normalize(published_raw)
   137	    replay_norm = normalize(replay_raw)
   138	    if published_norm == replay_norm:
   139	        record["verdict"] = "identical_newline"
   140	        return record
   141	    replayed = json.loads(replay_norm.decode("utf-8"))
   142	    if normalize(schema_v1_bytes(replayed)) == published_norm:
   143	        record["verdict"] = "identical_v1_schema"
   144	        return record
   145	    record["verdict"] = "MISMATCH"
   146	    record["first_difference"] = first_difference(
   147	        json.loads(published_norm.decode("utf-8")), replayed
   148	    )
   149	    return record
   150	
   151	
   152	def main() -> None:
   153	    parser = argparse.ArgumentParser(description=__doc__)
   154	    parser.add_argument("--shard-dir", type=Path, required=True,
   155	                        help="directory of <source_id>.csv.gz exposure shards")
   156	    parser.add_argument("--published-stars", type=Path, default=PUBLISHED_STARS)
   157	    parser.add_argument("--out-dir", type=Path,
   158	                        default=REPO_ROOT / "outputs/generalization/replay_gate")
   159	    parser.add_argument("--count", type=int, default=25)
   160	    parser.add_argument("--stars", nargs="*", help="explicit star list (overrides --count)")
   161	    parser.add_argument("--workers", type=int, default=None)
   162	    args = parser.parse_args()
   163	
   164	    assert_frozen()
   165	    workers = args.workers or physical_workers()
   166	    replay_dir = args.out_dir / "stars"
   167	    work_dir = args.out_dir / "work"
   168	    replay_dir.mkdir(parents=True, exist_ok=True)
   169	    work_dir.mkdir(parents=True, exist_ok=True)
   170	
   171	    stars = args.stars or select_stars(args.published_stars, args.shard_dir, args.count)
   172	    missing = [s for s in stars if not (args.shard_dir / f"{s}.csv.gz").exists()]
   173	    if missing:
   174	        raise SystemExit(f"missing shards for: {missing}")
   175	    for star in stars:
   176	        (replay_dir / f"{star}.json").unlink(missing_ok=True)
   177	
   178	    print(f"[replay] {len(stars)} stars, workers={workers}", flush=True)
   179	    started = time.time()
   180	    durations: dict[str, float] = {}
   181	    with ProcessPoolExecutor(max_workers=workers) as executor:
   182	        futures = {
   183	            executor.submit(
   184	                analyze_star,
   185	                star,
   186	                str(args.shard_dir / f"{star}.csv.gz"),
   187	                str(replay_dir / f"{star}.json"),
   188	                str(work_dir),
   189	                ("low", "high"),
   190	            ): (star, time.time())
   191	            for star in stars
   192	        }
   193	        for future in as_completed(futures):
   194	            star, _ = futures[future]
   195	            future.result()
   196	            durations[star] = round(time.time() - started, 1)
   197	            print(f"[replay] finished {star} (+{durations[star]}s)", flush=True)
   198	
   199	    records = [compare_star(star, args.published_stars, replay_dir) for star in stars]
   200	    verdicts = {record["source_id"]: record["verdict"] for record in records}
   201	    counts: dict[str, int] = {}
   202	    for verdict in verdicts.values():
   203	        counts[verdict] = counts.get(verdict, 0) + 1
   204	    if not records:
   205	        raise SystemExit("empty replay roster — the gate cannot pass vacuously")
   206	    strict_v2 = any(
   207	        record["verdict"] in ("identical", "identical_newline")
   208	        and record["published_schema_version"] == 2
   209	        for record in records
   210	    )
   211	    # strict_v2 is unconditional (G1 methods finding 2): a schema-v2 star that
   212	    # reproduces with no transform is the proof of full-byte reproduction, and
   213	    # the published bundle contains 7 of them — a roster without one is invalid.
   214	    passed = all(record["verdict"] != "MISMATCH" for record in records) and strict_v2
   215	
   216	    report = {
   217	        "gate": "replay_gate",
   218	        "passed": passed,
   219	        "verdict_counts": counts,
   220	        "stars": records,
   221	        "wall_seconds": round(time.time() - started, 1),
   222	        "completion_offsets_seconds": durations,
   223	        "workers": workers,
   224	        "env": env_versions(),
   225	        "frozen_sha256": assert_frozen(),
   226	    }
   227	    report_path = args.out_dir / "replay_report.json"
   228	    report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
   229	    print(f"[replay] {'PASS' if passed else 'FAIL'} {counts} -> {report_path}", flush=True)
   230	    raise SystemExit(0 if passed else 1)
   231	
   232	
   233	if __name__ == "__main__":
   234	    main()

