     1	#!/usr/bin/env python3
     2	"""Synthesize D2 exposure shards: DAV truth signals in real ZTF windows.
     3	
     4	Template pool: ALL 928 stars of the published 2026-08-01 catalog — NOT the
     5	510 not-detected subset (G1 referee finding 1: conditioning templates on the
     6	pipeline's own non-detection is a circularity path). Native variability is
     7	handled by frequency-matched scoring plus paired controls. Every shard
     8	preserves the template's real epochs (bjd_tdb), real cadence structure and
     9	real magerr; arms differ in what carries the noise:
    10	
    11	  arm B (92…)  signal added to the REAL ZTF magnitudes — the headline arm
    12	               ("TESS-truth signals injected into real ZTF photometry").
    13	  ctrl (95…)   paired uninjected copy of every unique arm-B template window —
    14	               identifies windows that trigger natively (real variables in
    15	               the pool), so injected-recovery is scored against its own
    16	               window's baseline behavior.
    17	  arm A (93…)  signal added to a synthetic Gaussian floor (median mag +
    18	               N(0, magerr_i)) — diagnostic; separates window effects from
    19	               real-noise effects.
    20	  nulls (94…)  arm-A construction with amplitude_scale = 0 — 1,000 shards
    21	               cycling the 928 windows with distinct noise seeds (windows
    22	               repeat, noise does not). This measures the GAUSSIAN-NULL
    23	               false-alarm rate, not a real-sky FPR (G1 stats finding 11).
    24	
    25	Template matching per target: |median zg mag − target G| <= 0.25 (widened to
    26	0.5, then nearest-K, when the pool is thin — flagged in the manifest);
    27	K=3 at the 10/50/90th percentiles of median-exposures-per-night, because 75%
    28	of zg nights are single-exposure and per-night median subtraction is the
    29	pre-registered dominant penalty (plan risk 3).
    30	
    31	Run matrix (plan): nominal (1.7, 0.80) on K=3 for arms A+B; the other 8
    32	ladder points on the median template only; 1,000 nulls.
    33	
    34	Campaign id layout (19 digits): AA TTTTTTTTTT K GR 0000
    35	  AA arm prefix (92/93), T zero-padded TIC, K template index (0/1/2),
    36	  G/R ladder indices (1-3) into {1.4,1.7,2.1} x {0.70,0.80,0.90}, 22=nominal.
    37	  Nulls: 94 + 17-digit serial. Controls: 95 + 17-digit index of the template
    38	  in the SORTED FIXED 928-window pool — stable across invocations and roster
    39	  subsets (G2 methods finding 3). Full mapping in shard_manifest.csv.
    40	
    41	Truth preservation (G2 methods finding 4): every shard's actually-injected
    42	modes (post sinc rejection, with signed factors and phases) go to
    43	injected_modes.csv and the rejected ones to rejected_modes.csv; the metrics
    44	scorer consumes injected_modes.csv, never the original mode table.
    45	"""
    46	
    47	from __future__ import annotations
    48	
    49	import argparse
    50	import gzip
    51	import json
    52	from pathlib import Path
    53	
    54	import numpy as np
    55	import pandas as pd
    56	
    57	from d2_truth_model import (
    58	    BANDPASS_LADDER_G,
    59	    BANDPASS_LADDER_RG,
    60	    NOMINAL_G,
    61	    NOMINAL_RG,
    62	    build_truth_model,
    63	)
    64	from frozen_api import (
    65	    EXPOSURE_COLUMNS,
    66	    REPO_ROOT,
    67	    assert_frozen,
    68	    campaign_file_shas,
    69	    campaign_id_ok,
    70	)
    71	
    72	PUBLISHED = REPO_ROOT / "catalog-rebuild/results/2026-08-01_full"
    73	MATCH_TOL_MAG = 0.25
    74	MATCH_TOL_WIDE = 0.5
    75	N_NULLS = 1000
    76	
    77	
    78	def load_templates(exposures_path: Path, catalog_path: Path) -> tuple[pd.DataFrame, dict]:
    79	    catalog = pd.read_csv(catalog_path, dtype={"source_id": str})
    80	    if len(catalog) != 928:
    81	        raise SystemExit(f"published catalog has {len(catalog)} rows, expected 928")
    82	    pool_ids = set(catalog["source_id"])
    83	    status = catalog.set_index("source_id")["blind_status"].to_dict()
    84	    exposures = pd.read_csv(
    85	        exposures_path,
    86	        dtype={"source_id": str, "band": str},
    87	        usecols=EXPOSURE_COLUMNS,
    88	    )
    89	    exposures = exposures[exposures["source_id"].isin(pool_ids)]
    90	    zg = exposures[exposures["band"] == "zg"]
    91	    stats = zg.groupby("source_id").agg(
    92	        median_zg=("mag", "median"),
    93	        n_zg=("mag", "size"),
    94	    )
    95	    epn = (
    96	        zg.groupby(["source_id", "night_mjd"]).size().groupby("source_id").median()
    97	        .rename("exp_per_night")
    98	    )
    99	    stats = stats.join(epn)
   100	    stats["blind_status"] = [status[sid] for sid in stats.index]
   101	    frames = {sid: frame for sid, frame in exposures.groupby("source_id")}
   102	    return stats.reset_index(), frames
   103	
   104	
   105	def match_templates(stats: pd.DataFrame, gmag: float) -> tuple[list[str], str]:
   106	    for tol, label in ((MATCH_TOL_MAG, "tol_0.25"), (MATCH_TOL_WIDE, "tol_0.5")):
   107	        pool = stats[(stats["median_zg"] - gmag).abs() <= tol]
   108	        if len(pool) >= 3:
   109	            break
   110	    else:
   111	        label = "nearest"
   112	    if len(pool) < 3:
   113	        pool = stats.iloc[(stats["median_zg"] - gmag).abs().argsort()[:9]]
   114	    ordered = pool.sort_values(["exp_per_night", "source_id"]).reset_index(drop=True)
   115	    picks = [
   116	        ordered.iloc[min(len(ordered) - 1, int(round(q * (len(ordered) - 1))))]["source_id"]
   117	        for q in (0.10, 0.50, 0.90)
   118	    ]
   119	    return picks, label
   120	
   121	
   122	def campaign_id(arm_prefix: str, tic: int, k: int, g_idx: int, r_idx: int) -> str:
   123	    return f"{arm_prefix}{tic:010d}{k}{g_idx}{r_idx}0000"
   124	
   125	
   126	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   127	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   128	        frame[EXPOSURE_COLUMNS].to_csv(handle, index=False, lineterminator="\n")
   129	
   130	
   131	def synthesize(
   132	    template: pd.DataFrame,
   133	    model,
   134	    source_id: str,
   135	    gaussian_floor: bool,
   136	    seed: int,
   137	) -> pd.DataFrame:
   138	    frame = template.copy()
   139	    frame["source_id"] = source_id
   140	    t_ref = float(frame["bjd_tdb"].min())
   141	    if gaussian_floor:
   142	        rng = np.random.Generator(np.random.PCG64(seed))
   143	        for band in ("zg", "zr"):
   144	            mask = frame["band"] == band
   145	            median = float(frame.loc[mask, "mag"].median())
   146	            noise = rng.normal(0.0, frame.loc[mask, "magerr"].to_numpy(dtype=float))
   147	            frame.loc[mask, "mag"] = median + noise
   148	    for band in ("zg", "zr"):
   149	        mask = frame["band"] == band
   150	        frame.loc[mask, "mag"] = frame.loc[mask, "mag"] + model.evaluate(
   151	            frame.loc[mask, "bjd_tdb"].to_numpy(dtype=float), band, t_ref
   152	        )
   153	    return frame
   154	
   155	
   156	def main() -> None:
   157	    parser = argparse.ArgumentParser(description=__doc__)
   158	    parser.add_argument("--d2-dir", type=Path, default=REPO_ROOT / "generalization/data/d2")
   159	    parser.add_argument("--out-dir", type=Path,
   160	                        default=REPO_ROOT / "generalization/data/d2/shards")
   161	    parser.add_argument("--exposures", type=Path, default=PUBLISHED / "data/exposures.csv.gz")
   162	    parser.add_argument("--catalog", type=Path,
   163	                        default=PUBLISHED / "catalog/ls_full_catalog.csv")
   164	    parser.add_argument("--arms", default="b,ctrl,a,ladder,nulls")
   165	    parser.add_argument("--limit", type=int, default=None, help="pilot: first N targets")
   166	    args = parser.parse_args()
   167	
   168	    assert_frozen()
   169	    arms = set(args.arms.split(","))
   170	    args.out_dir.mkdir(parents=True, exist_ok=True)
   171	    targets = pd.read_csv(args.d2_dir / "d2_targets.csv")
   172	    modes = pd.read_csv(args.d2_dir / "d2_modes.csv")
   173	    if args.limit:
   174	        targets = targets.head(args.limit)
   175	    stats, frames = load_templates(args.exposures, args.catalog)
   176	
   177	    pool_index = {sid: i for i, sid in enumerate(sorted(stats["source_id"]))}
   178	
   179	    def control_id(template_id: str) -> str:
   180	        return "95" + str(pool_index[template_id]).zfill(17)
   181	
   182	    injected_rows: list[dict] = []
   183	    rejected_rows: list[dict] = []
   184	    ladder = [
   185	        (gi + 1, ri + 1, g, r)
   186	        for gi, g in enumerate(BANDPASS_LADDER_G)
   187	        for ri, r in enumerate(BANDPASS_LADDER_RG)
   188	    ]
   189	    nominal = next(
   190	        (gi, ri, g, r) for gi, ri, g, r in ladder if g == NOMINAL_G and r == NOMINAL_RG
   191	    )
   192	    manifest: list[dict] = []
   193	
   194	    for target in targets.itertuples(index=False):
   195	        star_modes = modes[modes["tic"] == target.tic]
   196	        periods = star_modes["period_s"].tolist()
   197	        amps = star_modes["amp_ppt"].tolist()
   198	        picks, match_label = match_templates(stats, float(target.gmag))
   199	        variants = []
   200	        if "b" in arms or "a" in arms:
   201	            variants.append((*nominal, (0, 1, 2)))
   202	        if "ladder" in arms:
   203	            variants.extend((gi, ri, g, r, (1,)) for gi, ri, g, r in ladder
   204	                            if not (g == NOMINAL_G and r == NOMINAL_RG))
   205	        for gi, ri, g, r, template_ks in variants:
   206	            model = build_truth_model(
   207	                int(target.tic), periods, amps, float(target.cadence_s),
   208	                ratio_g=g, ratio_rg=r,
   209	            )
   210	            for k in template_ks:
   211	                template_id = picks[k]
   212	                template = frames[template_id]
   213	                arm_list = []
   214	                if g == NOMINAL_G and r == NOMINAL_RG:
   215	                    if "b" in arms:
   216	                        arm_list.append(("92", False))
   217	                    if "a" in arms:
   218	                        arm_list.append(("93", True))
   219	                else:
   220	                    arm_list.append(("92", False))
   221	                for prefix, gaussian in arm_list:
   222	                    sid = campaign_id(prefix, int(target.tic), k, gi, ri)
   223	                    if not campaign_id_ok(sid):
   224	                        raise SystemExit(f"bad campaign id {sid}")
   225	                    shard = synthesize(template, model, sid, gaussian, seed=int(sid[2:]))
   226	                    write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   227	                    for mode in model.modes:
   228	                        injected_rows.append({
   229	                            "campaign_id": sid, "period_s": mode.period_s,
   230	                            "frequency_per_day": mode.frequency_per_day,
   231	                            "amp_tess_ppt": mode.amp_tess_ppt,
   232	                            "tess_sinc": mode.tess_sinc,
   233	                            "ztf_sinc": mode.ztf_sinc,
   234	                            "amp_g_mag": mode.amp_g_mag,
   235	                            "amp_r_mag": mode.amp_r_mag,
   236	                            "phase_rad": mode.phase_rad,
   237	                        })
   238	                    for rejected in model.rejected:
   239	                        rejected_rows.append({"campaign_id": sid, **rejected})
   240	                    manifest.append({
   241	                        "campaign_id": sid, "arm": "A" if gaussian else "B",
   242	                        "tic": int(target.tic), "template_source_id": template_id,
   243	                        "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   244	                        "template_k": k, "ratio_g": g, "ratio_rg": r,
   245	                        "match": match_label,
   246	                        "control_campaign_id": control_id(template_id) if not gaussian else "",
   247	                        "n_modes_injected": len(model.modes),
   248	                        "n_modes_rejected": len(model.rejected),
   249	                    })
   250	        print(f"[d2-shards] TIC {target.tic}: {len(manifest)} shards so far", flush=True)
   251	
   252	    if "ctrl" in arms:
   253	        used = sorted({
   254	            row["template_source_id"] for row in manifest if row["arm"] == "B"
   255	        })
   256	        null_model = build_truth_model(0, [], [], 120.0)
   257	        for template_id in used:
   258	            sid = control_id(template_id)
   259	            shard = frames[template_id].copy()
   260	            shard["source_id"] = sid
   261	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   262	            manifest.append({
   263	                "campaign_id": sid, "arm": "ctrl", "tic": 0,
   264	                "template_source_id": template_id,
   265	                "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   266	                "template_k": -1, "ratio_g": 0.0, "ratio_rg": 0.0, "match": "",
   267	                "n_modes_injected": 0, "n_modes_rejected": 0,
   268	            })
   269	        print(f"[d2-shards] {len(used)} paired controls", flush=True)
   270	
   271	    if "nulls" in arms:
   272	        pool = stats.sort_values("source_id")["source_id"].tolist()
   273	        null_model = build_truth_model(0, [], [], 120.0)
   274	        for serial in range(N_NULLS):
   275	            template_id = pool[serial % len(pool)]
   276	            sid = "94" + str(serial).zfill(17)
   277	            shard = synthesize(frames[template_id], null_model, sid, True, seed=serial)
   278	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   279	            manifest.append({
   280	                "campaign_id": sid, "arm": "null", "tic": 0,
   281	                "template_source_id": template_id,
   282	                "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   283	                "template_k": serial % len(pool),
   284	                "ratio_g": 0.0, "ratio_rg": 0.0, "match": "",
   285	                "n_modes_injected": 0, "n_modes_rejected": 0,
   286	            })
   287	            if (serial + 1) % 200 == 0:
   288	                print(f"[d2-shards] nulls {serial + 1}/{N_NULLS}", flush=True)
   289	
   290	    frame = pd.DataFrame(manifest)
   291	    frame.to_csv(args.out_dir / "shard_manifest.csv", index=False)
   292	    pd.DataFrame(injected_rows).to_csv(args.out_dir / "injected_modes.csv", index=False)
   293	    pd.DataFrame(rejected_rows).to_csv(args.out_dir / "rejected_modes.csv", index=False)
   294	    unique_rejected = {
