   123	               truth_quantum: float = 0.0) -> dict:
   124	    result = json.loads(json_path.read_text(encoding="utf-8"))
   125	    if not result.get("complete"):
   126	        raise SystemExit(f"{json_path} is not complete")
   127	    passes = result["passes"]
   128	    if set(passes) != {"low", "high"}:
   129	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   130	    baseline = float(result["baseline_days"])
   131	    tol = 1.5 / baseline + truth_quantum
   132	    overall = overall_result(result)
   133	
   134	    row: dict = {
   135	        "baseline_days": baseline,
   136	        "n_exp_zg": result["n_exp_zg"],
   137	        "n_exp_zr": result["n_exp_zr"],
   138	        "best_pass": overall["best_pass"],
   139	        "best_status": overall["blind_status"],
   140	        "best_frequency_per_day": overall["best_frequency_per_day"],
   141	        "low_available": passes["low"].get("available", True),
   142	        "high_available": passes["high"].get("available", True),
   143	    }
   144	    any_direct_top = False
   145	    for name in ("low", "high"):
   146	        p = passes[name]
   147	        freq = p.get("frequency_per_day")
   148	        row[f"{name}_status"] = p["status"]
   149	        row[f"{name}_frequency_per_day"] = freq
   150	        row[f"{name}_match"] = (
   151	            classify_match(float(freq), truth_freqs, tol)
   152	            if freq is not None and truth_freqs else "unscored"
   153	        )
   154	        row[f"{name}_eligible"] = pass_eligible(truth_freqs, name, baseline)
   155	        for peak in p.get("top_peaks", []):
   156	            f_peak = peak.get("frequency_per_day")
   157	            if f_peak is not None and truth_freqs and \
   158	               classify_match(float(f_peak), truth_freqs, tol) == "direct":
   159	                any_direct_top = True
   160	    best_freq = row["best_frequency_per_day"]
   161	    row["best_match"] = (
   162	        classify_match(float(best_freq), truth_freqs, tol)
   163	        if best_freq is not None and truth_freqs else "unscored"
   164	    )
   165	    row["best_match_primary"] = (
   166	        classify_match(float(best_freq), [primary_freq], tol)
   167	        if best_freq is not None and primary_freq is not None else "unscored"
   168	    )
   169	    row["matched_any_mode_diagnostic"] = any_direct_top
   170	    row["eligible_any_pass"] = row["low_eligible"] or row["high_eligible"]
   171	    return row
   172	
   173	
   174	# ---------------------------------------------------------------- truth loaders
   175	
   176	def truth_d1() -> pd.DataFrame:
   177	    """Labels from the PUBLISHED master table (19 usable stars; 13
   178	    paper-variable) — the 20-row acquisition roster additionally contains
   179	    sanity controls whose paper_variable flag does not enter the published
   180	    counts. D1 truth frequencies are non-contemporaneous literature
   181	    tabulations (multi-mode DAVs wander between epochs); frequency-recovery
   182	    scoring for D1 is therefore DIAGNOSTIC ONLY (METRICS_SPEC) and D1's
   183	    estimand is detection completeness."""
   184	    master = pd.read_csv(
   185	        REPO_ROOT / "lomb-scargle/results/2026-08-01_full/master_table.csv",
   186	        dtype={"source_id": str},
   187	    )
   188	    lit = pd.read_csv(REPO_ROOT / "data/roster/literature_periods.csv",
   189	                      dtype={"source_id": str})
   190	    freqs = lit.groupby("source_id")["frequency_per_day"].apply(list).to_dict()
   191	    rows = []
   192	    for r in master.itertuples(index=False):
   193	        truth = freqs.get(r.source_id, [])
   194	        # 2833849800205759360 is the frozen pipeline's eclipsing-system sanity
   195	        # control (expected confirmed at 6.1464 / d): a known variable, so it
   196	        # can be neither a paper-constant negative nor a roster positive.
   197	        is_control = r.source_id == "2833849800205759360"
   198	        rows.append({
   199	            "sid": r.source_id, "external_id": r.wdj_name,
   200	            "class_label": "transit_control" if is_control else r.wd_class,
   201	            "label_positive": None if is_control
   202	            else str(r.paper_variable).lower() == "true",
   203	            "weight": 1.0, "cluster": r.source_id,
   204	            "truth_freqs": truth,
   205	            "primary_freq": truth[0] if truth else None,
   206	            "amp": math.nan, "truth_period_days": 1.0 / truth[0] if truth else math.nan,
   207	            "freq_scorable": bool(truth),
   208	        })
   209	    return pd.DataFrame(rows)
   210	
   211	
   212	def truth_d3() -> pd.DataFrame:
   213	    roster = pd.read_csv(REPO_ROOT / "generalization/data/d3/roster_d3.csv",
   214	                         dtype={"source_id": str})
   215	    mo = pd.read_csv(REPO_ROOT / "generalization/data/d3/raw/mo2026_table2.csv")
   216	    mo["freq_per_day"] = mo["Freq"] * 86400.0 / 1e6
   217	    freq_lists = mo.groupby("KIC")["freq_per_day"].apply(list).to_dict()
   218	    rows = []
   219	    for r in roster.itertuples(index=False):
   220	        kic = int(r.KIC)
   221	        truth = freq_lists.get(kic, [])
   222	        label = None if r.dSct == 2 else bool(r.dSct == 1)
   223	        rows.append({
   224	            "sid": r.source_id, "external_id": r.external_id,
   225	            "class_label": r.class_label, "label_positive": label,
   226	            "weight": float(r.sampling_weight), "cluster": r.source_id,
   227	            "truth_freqs": truth,
   228	            "primary_freq": float(r.dom_freq_per_day)
   229	            if np.isfinite(r.dom_freq_per_day) else None,
   230	            "amp": float(r.amp_mmag),
   231	            "truth_period_days": 1.0 / float(r.dom_freq_per_day)
   232	            if np.isfinite(r.dom_freq_per_day) and r.dom_freq_per_day > 0 else math.nan,
   233	            "freq_scorable": bool(truth) and bool(label),
   234	            "stratum": r.stratum, "near_saturation": bool(r.near_saturation),
   235	            "subhour": bool(r.subhour),
   236	        })
   237	    return pd.DataFrame(rows)
   238	
   239	
   240	def truth_d2(shards_dir: Path) -> pd.DataFrame:
   241	    """Truth from injected_modes.csv — the ACTUALLY injected (post-sinc-
   242	    rejection) mode set per shard, never the original mode table (G2 methods
   243	    finding 4)."""
   244	    manifest = pd.read_csv(shards_dir / "shard_manifest.csv",
   245	                           dtype={"campaign_id": str, "template_source_id": str})
   246	    injected = pd.read_csv(shards_dir / "injected_modes.csv",
   247	                           dtype={"campaign_id": str})
   248	    freq_lists = injected.groupby("campaign_id")["frequency_per_day"].apply(
   249	        lambda g: sorted(g.tolist())).to_dict()
   250	    dominant = {}
   251	    amp_dom = {}
   252	    for sid, group in injected.groupby("campaign_id"):
   253	        best = group.loc[group["amp_tess_ppt"].idxmax()]
   254	        dominant[sid] = float(best["frequency_per_day"])
   255	        amp_dom[sid] = float(best["amp_tess_ppt"])
   256	    rows = []
   257	    for r in manifest.itertuples(index=False):
   258	        arm = r.arm
   259	        tic = int(r.tic)
   260	        sid = r.campaign_id
   261	        truth = freq_lists.get(sid, []) if arm in ("A", "B") else []
   262	        rows.append({
   263	            "sid": sid, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   264	            "class_label": f"arm_{arm}",
   265	            "label_positive": arm in ("A", "B"),
   266	            "weight": 1.0, "cluster": str(tic) if tic else sid,
   267	            "truth_freqs": truth,
   268	            "primary_freq": dominant.get(sid) if arm in ("A", "B") else None,
   269	            "amp": float(amp_dom.get(sid, math.nan)),
   270	            "truth_period_days": (86400.0 / dominant[sid] / 86400.0)
   271	            if sid in dominant and arm in ("A", "B") else math.nan,
   272	            "freq_scorable": arm in ("A", "B") and bool(truth),
   273	            "arm": arm, "template_k": r.template_k,
   274	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   275	            "template_status": getattr(r, "template_status", ""),
   276	        })
   277	    return pd.DataFrame(rows)
   278	
   279	
   280	# ---------------------------------------------------------- census providers
   281	
   282	def census_lookup_csv(path: Path) -> dict[str, dict]:
   283	    frame = pd.read_csv(path, dtype={"source_id": str})
   284	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   285	    for col in ratio_cols:
   286	        exact = frame[col] == 2.5
   287	        if exact.any():
   288	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   289	    return {
   290	        r["source_id"]: {"census_variable": bool(r["census_variable"]),
   291	                         "census_g_nightly": bool(r["census_g_nightly"])}
   292	        for _, r in frame.iterrows()
   293	    }
   294	
   295	
   296	def census_from_shard(shard_path: Path) -> dict:
   297	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   298	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   299	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   300	                           n_variants=0, known_roster=False, wd_class="",
   301	                           paper_variable=None, paper_periodic=None)
   302	    nightly = nightly_panel(frame)
   303	    monthly = monthly_panel(nightly)
   304	    row = census_row(meta, frame, nightly, monthly)
   305	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   306	                for c in ("exposure", "nightly", "monthly")):
   307	        if row.get(key) == 2.5:
   308	            raise SystemExit(f"census ratio exactly 2.5 for {shard_path} — spec guard")
   309	    return {"census_variable": bool(row["census_variable"]),
   310	            "census_g_nightly": bool(row["census_g_nightly"])}
   311	
   312	
   313	# ------------------------------------------------------------------ aggregates
   314	
   315	def completeness_tables(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   316	    # primary frequency-match column: D3 scores the DOMINANT Mo mode (any-mode
   317	    # is secondary/diagnostic); D2 scores the exact injected list; D1 is
   318	    # diagnostic-only either way (spec).
   319	    primary_match = {"d1": "best_match_primary", "d2": "best_match",
   320	                     "d3": "best_match_primary"}[dataset]
   321	    rows = []
   322	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   323	    usable = positives[positives["best_status"] != "missing"]
   324	    for pass_name in PASSES:
   325	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   326	        match_col = primary_match if pass_name == "best" else f"{pass_name}_match"
   327	        for rule in RULES:
   328	            for scope, frame in (
   329	                ("detection_eligible_roster", positives),
   330	                ("detection_usable_lightcurve", usable),
   331	                ("freq_recovery_scorable", usable[
   332	                    usable["freq_scorable"]
   333	                    & (usable["eligible_any_pass"] if pass_name == "best"
   334	                       else usable[f"{pass_name}_eligible"])
   335	                ]),
   336	            ):
   337	                if frame.empty:
   338	                    rows.append({"pass": pass_name, "rule": rule, "scope": scope,
   339	                                 "n": 0, "ess": 0.0, "p": math.nan,
   340	                                 "lo": math.nan, "hi": math.nan})
   341	                    continue
   342	                fired = frame.apply(
   343	                    lambda r: rule_fired(rule, r[status_col], r.get("census_variable")),
   344	                    axis=1,
   345	                )
   346	                ok = fired.notna()
   347	                success = fired[ok].astype(bool)
   348	                if scope == "freq_recovery_scorable" and rule in (
   349	                        "confirmed", "confirmed_or_candidate", "either"):
   350	                    success = success & (frame.loc[ok, match_col] == "direct")
   351	                stats = weighted_wilson(
   352	                    success.to_numpy(dtype=float),
   353	                    frame.loc[ok, "weight"].to_numpy(dtype=float),
   354	                )
   355	                rows.append({"pass": pass_name, "rule": rule, "scope": scope, **stats})
   356	    return pd.DataFrame(rows)
   357	
   358	
   359	def contingency(per_star: pd.DataFrame) -> dict:
   360	    from scipy.stats import binomtest
   361	    frame = per_star[(per_star["label_positive"] == True)  # noqa: E712
   362	                     & per_star["census_variable"].notna()
   363	                     & (per_star["best_status"] != "missing")]
   364	    C = frame["census_variable"].astype(bool)
   365	    L = frame["best_status"] == "confirmed"
   366	    a, b = int((C & L).sum()), int((C & ~L).sum())
   367	    c, d = int((~C & L).sum()), int((~C & ~L).sum())
   368	    n = len(frame)
   369	    union_p, union_lo, union_hi = wilson(a + b + c, n) if n else (math.nan,) * 3
   370	    out = {
   371	        "n_positives_scored": n,
   372	        "table": {"census_and_ls": a, "census_only": b, "ls_only": c, "neither": d},
   373	        "union_completeness": {"p": union_p, "lo": union_lo, "hi": union_hi},
   374	        "incremental_census_only": dict(zip(("p", "lo", "hi"), wilson(b, n))) if n else {},
   375	        "incremental_ls_only": dict(zip(("p", "lo", "hi"), wilson(c, n))) if n else {},
   376	    }
   377	    if b + c:
   378	        out["mcnemar_exact_p_secondary"] = float(
   379	            binomtest(min(b, c), b + c, 0.5).pvalue * 1.0
   380	        )
   381	    return out
   382	
   383	
   384	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   385	    scorable = per_star[per_star["freq_scorable"]
   386	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   387	    if len(scorable) < 3:
   388	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   389	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   390	    rates = []
   391	    truth_lists = scorable["truth_freqs"].tolist()
   392	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   393	        perm = rng.permutation(len(truth_lists))
   394	        hits = 0
   395	        for i, row in scorable.iterrows():
   396	            if perm[i] == i:
   397	                continue
   398	            tol = 1.5 / row["baseline_days"]
   399	            if classify_match(float(row["best_frequency_per_day"]),
   400	                              truth_lists[perm[i]], tol) == "direct":
   401	                hits += 1
   402	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   403	        if denom:
   404	            rates.append(hits / denom)
   405	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   406	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   407	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
   408	
   409	
   410	def d2_cluster_bootstrap(per_star: pd.DataFrame) -> pd.DataFrame:
   411	    frame = per_star[per_star.get("arm").isin(["A", "B"])] if "arm" in per_star else per_star.iloc[0:0]
   412	    if frame.empty:
   413	        return pd.DataFrame()
   414	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   415	    rows = []
   416	    for (arm, k), stratum in frame.groupby(["arm", "template_k"]):
   417	        success = (stratum["best_status"] == "confirmed") & (stratum["best_match"] == "direct")
   418	        per_target = success.groupby(stratum["cluster"]).mean()
   419	        point = float(per_target.mean())
   420	        clusters = per_target.index.to_numpy()
   421	        boots = []
   422	        for _ in range(BOOTSTRAP_B):
   423	            sample = rng.choice(clusters, size=len(clusters), replace=True)
   424	            boots.append(float(per_target.loc[sample].mean()))
   425	        rows.append({"arm": arm, "template_k": int(k), "n_targets": len(clusters),
   426	                     "p": point, "lo": float(np.quantile(boots, 0.025)),
   427	                     "hi": float(np.quantile(boots, 0.975))})
   428	    return pd.DataFrame(rows)
   429	
   430	
   431	def surfaces(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   432	    positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   433	                         & per_star["freq_scorable"]]
   434	    if positives.empty:
   435	        return pd.DataFrame()
   436	    amp_edges = AMP_EDGES[dataset]
   437	    rows = []
   438	    p_bins = np.digitize(positives["truth_period_days"], PERIOD_EDGES_DAYS)
   439	    a_bins = np.digitize(positives["amp"], amp_edges)
   440	    success = (positives["best_status"] == "confirmed") & (positives["best_match"] == "direct")
   441	    for (pb, ab), idx in positives.groupby([p_bins, a_bins]).groups.items():
   442	        cell = positives.loc[idx]
   443	        k = int(success.loc[idx].sum())
   444	        n = len(cell)
   445	        entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   446	        if n >= MIN_CELL:
   447	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   448	        rows.append(entry)
   449	    return pd.DataFrame(rows)
   450	
   451	
   452	def trigger_rates(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   453	    rows = []
   454	    if dataset == "d3":
   455	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
   456	        for rule in RULES:
   457	            fired = negatives.apply(
   458	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
   459	                axis=1,
   460	            )
   461	            ok = fired.notna()
   462	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
   463	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
   464	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
   465	    if dataset == "d2" and "arm" in per_star:
   466	        for arm, name in (("null", "fpr_gaussian"), ("ctrl", "native_trigger_rate")):
   467	            subset = per_star[per_star["arm"] == arm]
   468	            if subset.empty:
   469	                continue
   470	            fired = subset["best_status"] == "confirmed"
   471	            stats = weighted_wilson(fired.to_numpy(dtype=float),
   472	                                    np.ones(len(subset)))
   473	            rows.append({"quantity": name, "rule": "confirmed", **stats})
   474	    return pd.DataFrame(rows)
   475	
   476	
   477	def sha256_file(path: Path) -> str:
   478	    return hashlib.sha256(path.read_bytes()).hexdigest()
   479	
   480	
   481	def main() -> None:
   482	    parser = argparse.ArgumentParser(description=__doc__)
   483	    parser.add_argument("--dataset", choices=("d1", "d2", "d3"), required=True)
   484	    parser.add_argument("--stars-dir", type=Path, required=True)
   485	    parser.add_argument("--census-csv", type=Path, default=None)
   486	    parser.add_argument("--shards-dir", type=Path, default=None,
   487	                        help="d2: shard dir with shard_manifest.csv; census "
   488	                             "computed from shards when --census-csv absent")
   489	    parser.add_argument("--out-dir", type=Path, required=True)
   490	    args = parser.parse_args()
   491	
   492	    assert_frozen()
   493	    if args.dataset == "d1":
   494	        truth = truth_d1()
   495	    elif args.dataset == "d3":
   496	        truth = truth_d3()
   497	    else:
   498	        if args.shards_dir is None:
   499	            raise SystemExit("d2 needs --shards-dir")
   500	        truth = truth_d2(args.shards_dir)
   501	
   502	    census = census_lookup_csv(args.census_csv) if args.census_csv else {}
   503	    inputs: dict[str, str] = {}
   504	    if args.census_csv:
   505	        inputs[str(args.census_csv)] = sha256_file(args.census_csv)
   506	
   507	    rows = []
   508	    missing = []
   509	    for r in truth.itertuples(index=False):
   510	        json_path = args.stars_dir / f"{r.sid}.json"
   511	        if not json_path.exists():
   512	            # eligible roster target with no usable light curve: counts as a
   513	            # non-detection in the eligible-roster estimand, excluded from the
   514	            # usable-light-curve estimand (G2 stats finding 2)
   515	            missing.append(r.sid)
   516	            record = {**r._asdict(),
   517	                      "best_status": "missing", "low_status": "missing",
   518	                      "high_status": "missing", "best_match": "unscored",
   519	                      "best_match_primary": "unscored", "low_match": "unscored",
   520	                      "high_match": "unscored", "low_eligible": False,
   521	                      "high_eligible": False, "eligible_any_pass": False,
   522	                      "best_frequency_per_day": None, "baseline_days": math.nan,
   523	                      "matched_any_mode_diagnostic": False,
   524	                      "census_variable": census.get(r.sid, {}).get("census_variable")}
   525	            rows.append(record)
   526	            continue
   527	        inputs[str(json_path)] = sha256_file(json_path)
   528	        scored = score_star(json_path, list(r.truth_freqs), r.primary_freq,
   529	                            TRUTH_QUANTUM_PER_DAY[args.dataset])
   530	        record = {**r._asdict(), **scored}
   531	        if r.sid in census:
   532	            record.update(census[r.sid])
   533	        elif args.dataset == "d2" and args.shards_dir is not None:
   534	            record.update(census_from_shard(args.shards_dir / f"{r.sid}.csv.gz"))
   535	        else:
   536	            record["census_variable"] = None
   537	        rows.append(record)
   538	    per_star = pd.DataFrame(rows)
   539	    if per_star.empty:
   540	        raise SystemExit("no stars scored")
   541	
   542	    args.out_dir.mkdir(parents=True, exist_ok=True)
   543	    per_star.drop(columns=["truth_freqs"]).to_csv(
   544	        args.out_dir / "per_star.csv", index=False)
   545	    completeness_tables(per_star, args.dataset).to_csv(
   546	        args.out_dir / "completeness_by_class_pass_rule.csv", index=False)
   547	    (args.out_dir / "contingency_complementarity.json").write_text(
   548	        json.dumps(contingency(per_star), indent=2) + "\n", encoding="utf-8")
   549	    trigger_rates(per_star, args.dataset).to_csv(
   550	        args.out_dir / "trigger_rates.csv", index=False)
   551	    (args.out_dir / "chance_match.json").write_text(
   552	        json.dumps(chance_match_rate(per_star), indent=2) + "\n", encoding="utf-8")
