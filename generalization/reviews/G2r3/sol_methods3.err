     1	"""Pin the frozen pipeline's constants and its known, provably-benign quirks.
     2	
     3	These tests do not fix anything (the pipeline is frozen); they make silent
     4	drift impossible. If any test here fails, the frozen premise of the
     5	generalization campaign is broken and every campaign result is void.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import ast
    11	import sys
    12	from pathlib import Path
    13	
    14	REPO_ROOT = Path(__file__).resolve().parents[1]
    15	sys.path.insert(0, str(REPO_ROOT / "scripts" / "generalization"))
    16	
    17	import frozen_api  # noqa: E402
    18	
    19	
    20	def test_frozen_shas_match_tag():
    21	    assert frozen_api.assert_frozen() == frozen_api.FROZEN_SHA256
    22	
    23	
    24	def test_pass_bounds_canonical():
    25	    assert frozen_api.PASS_BOUNDS == {"low": (None, 48.0), "high": (24.0, 1440.0)}
    26	
    27	
    28	def test_pass_bounds_duplicates_agree():
    29	    """The bootstrap scripts re-derive the pass bounds as bare literals instead
    30	    of importing PASS_BOUNDS. Frozen policy: no refactor; this AST scan asserts
    31	    every float literal 24.0/48.0/1440.0 in those files matches the canonical
    32	    bounds, so the duplication cannot drift."""
    33	    canonical = {24.0, 48.0, 1440.0}
    34	    for name in (
    35	        "run_bootstrap_fap.py",
    36	        "run_catalog_bootstrap.py",
    37	        "run_catalog_stratified_bootstrap.py",
    38	    ):
    39	        tree = ast.parse((REPO_ROOT / "scripts" / name).read_text(encoding="utf-8"))
    40	        found = {
    41	            node.value
    42	            for node in ast.walk(tree)
    43	            if isinstance(node, ast.Constant)
    44	            and isinstance(node.value, float)
    45	            and node.value in canonical
    46	        }
    47	        assert found == canonical, f"{name}: pass-bound literals {found} != {canonical}"
    48	
    49	
    50	def test_census_threshold_is_geq_2p5():
    51	    """census_row uses >= 2.5 on all six ratios. The frozen code base also
    52	    contains a > 2.5 comparison elsewhere; that inconsistency is provably
    53	    non-affecting (0 of 5,568 published ratios are within 1e-4 of 2.5) and is
    54	    NOT fixed. Campaign metrics use >= and assert no campaign ratio equals 2.5
    55	    exactly (metrics_generalization.py)."""
    56	    source = (REPO_ROOT / "scripts" / "build_catalog_panels.py").read_text(encoding="utf-8")
    57	    tree = ast.parse(source)
    58	    census = next(
    59	        node
    60	        for node in ast.walk(tree)
    61	        if isinstance(node, ast.FunctionDef) and node.name == "census_row"
    62	    )
    63	    comparisons = [
    64	        type(node.ops[0]).__name__
    65	        for node in ast.walk(census)
    66	        if isinstance(node, ast.Compare)
    67	        and any(
    68	            isinstance(comp, ast.Constant) and comp.value == 2.5
    69	            for comp in node.comparators
    70	        )
    71	    ]
    72	    assert comparisons and set(comparisons) == {"GtE"}, comparisons
    73	
    74	
