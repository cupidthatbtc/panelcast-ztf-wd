   347	                "in_core": meta.in_core,
   348	                "cache_present": cache_path.exists() and cache_path.stat().st_size > 0,
   349	                "cache_bytes": cache_path.stat().st_size if cache_path.exists() else 0,
   350	                "read_status": "ok",
   351	            }
   352	            if not qc["cache_present"]:
   353	                qc["read_status"] = "missing"
   354	                qc_rows.append(qc)
   355	                continue
   356	            try:
   357	                raw = read_cache(cache_path)
   358	                qc["raw_rows"] = len(raw)
   359	                selected, separation, n_objects, n_selected_objects = select_nearest_source(
   360	                    raw,
   361	                    float(meta.ra),
   362	                    float(meta.dec),
   363	                )
   364	                clean, drop_counts = clean_rows(selected)
   365	                qc.update(drop_counts)
