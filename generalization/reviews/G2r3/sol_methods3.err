   120	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   121	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   122	        frame[EXPOSURE_COLUMNS].to_csv(handle, index=False, lineterminator="\n")
