   493	    for _ in range(BOOTSTRAP_B):
   494	        resampled = negatives.iloc[
   495	            rng.integers(0, len(negatives), size=len(negatives))
   496	        ]
   497	        combined = pd.concat([positives, resampled])
   498	        hit = combined[combined["best_status"] == "confirmed"]
   499	        if hit.empty:
