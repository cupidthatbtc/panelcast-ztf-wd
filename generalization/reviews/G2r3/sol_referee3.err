   113	        pool = stats.iloc[(stats["median_zg"] - gmag).abs().argsort()[:9]]
   114	    ordered = pool.sort_values(["exp_per_night", "source_id"]).reset_index(drop=True)
   115	    picks = [
   116	        ordered.iloc[min(len(ordered) - 1, int(round(q * (len(ordered) - 1))))]["source_id"]
   117	        for q in (0.10, 0.50, 0.90)
   118	    ]
   119	    return picks, label
   120	
   121	
   122	def campaign_id(arm_prefix: str, tic: int, k: int, g_idx: int, r_idx: int) -> str:
   123	    return f"{arm_prefix}{tic:010d}{k}{g_idx}{r_idx}0000"
   124	
   125	
   126	def write_shard(path: Path, frame: pd.DataFrame) -> None:
   127	    with gzip.open(path, "wt", encoding="utf-8", newline="") as handle:
   128	        frame[EXPOSURE_COLUMNS].to_csv(handle, index=False, lineterminator="\n")
   129	
   130	
   131	def synthesize(
   132	    template: pd.DataFrame,
   133	    model,
   134	    source_id: str,
   135	    gaussian_floor: bool,
   136	    seed: int,
   137	) -> pd.DataFrame:
   138	    frame = template.copy()
   139	    frame["source_id"] = source_id
   140	    t_ref = float(frame["bjd_tdb"].min())
   141	    if gaussian_floor:
   142	        rng = np.random.Generator(np.random.PCG64(seed))
   143	        for band in ("zg", "zr"):
   144	            mask = frame["band"] == band
   145	            median = float(frame.loc[mask, "mag"].median())
   146	            noise = rng.normal(0.0, frame.loc[mask, "magerr"].to_numpy(dtype=float))
   147	            frame.loc[mask, "mag"] = median + noise
   148	    for band in ("zg", "zr"):
   149	        mask = frame["band"] == band
   150	        frame.loc[mask, "mag"] = frame.loc[mask, "mag"] + model.evaluate(
   151	            frame.loc[mask, "bjd_tdb"].to_numpy(dtype=float), band, t_ref
   152	        )
   153	    return frame
   154	
   155	

