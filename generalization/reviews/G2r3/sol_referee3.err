     1	#!/usr/bin/env python3
     2	"""D2 truth model: analytic DAV signals for injection into real ZTF windows.
     3	
     4	Why a truth model and not interpolation: DAV periods reach below twice the
     5	TESS 120-s cadence (super-Nyquist) and below the first sinc null; interpolated
     6	TESS photometry is undefined there. The published mode solution (period,
     7	amplitude) IS the measurement — we evaluate it analytically at the template's
     8	real BJD_TDB epochs.
     9	
    10	Amplitude chain (GENERALIZATION_PLAN.md, D2):
    11	  A_ppt (published, TESS-integrated)
    12	    -> fractional flux (x 1e-3)
    13	    -> de-dilution OFF by default (SPOC PDCSAP is crowding-corrected;
    14	       ON = prespecified variant, divides by the published dilution if given)
    15	    -> de-integrate the TESS exposure: divide by sinc(pi f T_cad);
    16	       REJECT modes with |sinc| < 0.3 (do not amplify model error > 3.3x).
    17	       Note: at T=120 s this cutoff is P < ~160.1 s (the plan text said
    18	       "197 s", which is the |sinc| = 0.5 point — arithmetic slip, criterion
    19	       |sinc| >= 0.3 is what was prespecified and is what runs).
    20	    -> magnitudes (x 1.0857)
    21	    -> bandpass ladder: A_g = R_g * A_TESS_intrinsic, A_r = R_rg * A_g with
    22	       R_g in {1.4, 1.7, 2.1}, R_rg in {0.70, 0.80, 0.90}; blackbody T-derivative
    23	       ratios at Teff ~ 11,500 K give (1.43, 0.80) — the ladder's low rung;
    24	       empirical DAV multi-band ratios (limb darkening + nonadiabatic boost in
    25	       the blue) motivate the upper rungs. Nominal (1.7, 0.80). Headline
    26	       numbers are quoted as the band across the ladder.
    27	    -> re-integrate the ZTF 30-s exposure: multiply by sinc(pi f 30s).
    28	
    29	Phases are unpublished: drawn once per star from PCG64(seed=TIC), shared
    30	across bands and across every ladder variant (variant-stable), with a shared
    31	t_ref so the two-band evidence rule keeps its meaning.
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	import math
    37	from dataclasses import dataclass, field
    38	
    39	import numpy as np
    40	
    41	PPT_TO_FRAC = 1.0e-3
    42	FRAC_TO_MAG = 1.0857
    43	ZTF_EXPOSURE_S = 30.0
    44	SINC_REJECT_BELOW = 0.3
    45	BANDPASS_LADDER_G = (1.4, 1.7, 2.1)
    46	BANDPASS_LADDER_RG = (0.70, 0.80, 0.90)
    47	NOMINAL_G = 1.7
    48	NOMINAL_RG = 0.80
    49	
    50	# band-effective wavelengths [nm] for the blackbody-derivative check
    51	LAMBDA_NM = {"zg": 472.0, "zr": 642.0, "tess": 786.0}
    52	HC_OVER_K_NM_K = 1.43877688e7  # h c / k_B in nm*K
    53	
    54	
    55	def integration_sinc(period_s: float, t_int_s: float) -> float:
    56	    """Signed attenuation of a sinusoid amplitude under boxcar integration."""
    57	    x = math.pi * t_int_s / period_s
    58	    return 1.0 if x == 0.0 else math.sin(x) / x
    59	
    60	
    61	def blackbody_dlnB_dlnT(wavelength_nm: float, teff_k: float) -> float:
    62	    x = HC_OVER_K_NM_K / (wavelength_nm * teff_k)
    63	    return x / (1.0 - math.exp(-x))
    64	
    65	
    66	def blackbody_amplitude_ratios(teff_k: float = 11500.0) -> tuple[float, float]:
    67	    """(A_g/A_TESS, A_r/A_g) for pure temperature perturbations."""
    68	    g = blackbody_dlnB_dlnT(LAMBDA_NM["zg"], teff_k)
    69	    r = blackbody_dlnB_dlnT(LAMBDA_NM["zr"], teff_k)
    70	    tess = blackbody_dlnB_dlnT(LAMBDA_NM["tess"], teff_k)
    71	    return g / tess, r / g
    72	
    73	
    74	@dataclass(frozen=True)
    75	class TruthMode:
    76	    period_s: float
    77	    frequency_per_day: float
    78	    amp_tess_ppt: float
    79	    tess_sinc: float
    80	    amp_g_mag: float          # intrinsic zg amplitude after ladder, before ZTF sinc
    81	    amp_r_mag: float
    82	    ztf_sinc: float
    83	    phase_rad: float
    84	
    85	
    86	@dataclass(frozen=True)
    87	class TruthModel:
    88	    tic: int
    89	    cadence_s: float
    90	    ratio_g: float
    91	    ratio_rg: float
    92	    dedilution: float | None
    93	    modes: tuple[TruthMode, ...]
    94	    rejected: tuple[dict, ...] = field(default=())
    95	
    96	    def evaluate(self, bjd_tdb: np.ndarray, band: str, t_ref: float) -> np.ndarray:
    97	        """Delta-mag time series at the template's real epochs (days)."""
    98	        if band not in ("zg", "zr"):
    99	            raise ValueError(band)
   100	        delta = np.zeros_like(np.asarray(bjd_tdb, dtype=float))
   101	        for mode in self.modes:
   102	            amp = mode.amp_g_mag if band == "zg" else mode.amp_r_mag
   103	            amp *= mode.ztf_sinc
   104	            phase = 2.0 * np.pi * mode.frequency_per_day * (bjd_tdb - t_ref)
   105	            delta += amp * np.cos(phase + mode.phase_rad)
   106	        return delta
   107	
   108	
   109	def build_truth_model(
   110	    tic: int,
   111	    periods_s: list[float],
   112	    amps_ppt: list[float],
   113	    cadence_s: float,
   114	    ratio_g: float = NOMINAL_G,
   115	    ratio_rg: float = NOMINAL_RG,
   116	    dedilution: float | None = None,
   117	    amplitude_scale: float = 1.0,
   118	) -> TruthModel:
   119	    """amplitude_scale=0.0 builds a zero-amplitude null with the same modes."""
   120	    if len(periods_s) != len(amps_ppt):
   121	        raise ValueError("periods and amplitudes must align")
   122	    rng = np.random.Generator(np.random.PCG64(int(tic)))
   123	    phases = rng.uniform(0.0, 2.0 * np.pi, size=len(periods_s))
   124	    modes: list[TruthMode] = []
   125	    rejected: list[dict] = []
   126	    for period, amp_ppt, phase in zip(periods_s, amps_ppt, phases):
   127	        tess_sinc = integration_sinc(period, cadence_s)
   128	        if abs(tess_sinc) < SINC_REJECT_BELOW:
   129	            rejected.append(
   130	                {"period_s": period, "amp_ppt": amp_ppt, "tess_sinc": tess_sinc}
   131	            )
   132	            continue
   133	        frac = amp_ppt * PPT_TO_FRAC * amplitude_scale
   134	        if dedilution is not None:
   135	            frac /= dedilution
   136	        intrinsic_frac = frac / tess_sinc  # signed: negative sinc = pi phase flip
   137	        amp_tess_mag = intrinsic_frac * FRAC_TO_MAG
   138	        modes.append(
   139	            TruthMode(
   140	                period_s=period,
   141	                frequency_per_day=86400.0 / period,
   142	                amp_tess_ppt=amp_ppt,
   143	                tess_sinc=tess_sinc,
   144	                amp_g_mag=amp_tess_mag * ratio_g,
   145	                amp_r_mag=amp_tess_mag * ratio_g * ratio_rg,
   146	                ztf_sinc=integration_sinc(period, ZTF_EXPOSURE_S),
   147	                phase_rad=float(phase),
   148	            )
   149	        )
   150	    return TruthModel(
   151	        tic=tic,
   152	        cadence_s=cadence_s,
   153	        ratio_g=ratio_g,
   154	        ratio_rg=ratio_rg,
   155	        dedilution=dedilution,
   156	        modes=tuple(modes),
   157	        rejected=tuple(rejected),
   158	    )

