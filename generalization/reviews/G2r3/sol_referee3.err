   486	    weights = triggered["weight"].to_numpy(dtype=float)
   487	    is_pos = (triggered["class_label"] == "dsct_flag1").to_numpy()
   488	    point = float((weights * is_pos).sum() / weights.sum())
   489	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED + 1))
