    60	def wilson(k: float, n: float) -> tuple[float, float, float]:
    61	    if n <= 0:
    62	        return math.nan, math.nan, math.nan
    63	    z = 1.959963984540054
    64	    p = k / n
    65	    denom = 1.0 + z * z / n
    66	    center = (p + z * z / (2 * n)) / denom
    67	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    68	    return p, max(0.0, center - half), min(1.0, center + half)
