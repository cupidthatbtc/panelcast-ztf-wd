/bin/zsh -lc "python - <<'PY'
import math
for p in (240,197,160,120):
    x=math.pi*120/p
    print(p, abs(math.sin(x)/x))
lo, hi = 120.0, 197.0
for _ in range(80):
    mid=(lo+hi)/2
    v=abs(math.sin(math.pi*120/mid)/(math.pi*120/mid))
    if v < 0.3:
        lo=mid
    else:
        hi=mid
print('P at |sinc|=0.3:', (lo+hi)/2)
PY
