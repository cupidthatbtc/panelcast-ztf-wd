   291	def rebuild_table(star_dir: Path, output: Path, roster: pd.DataFrame) -> pd.DataFrame:
   292	    rows = []
   293	    for path in sorted(star_dir.glob("*.json")):
   294	        if path.name.endswith(".error.json"):
   295	            continue
   296	        result = json.loads(path.read_text(encoding="utf-8"))
   297	        if result.get("complete"):
   298	            rows.append(overall_result(result))
   299	    table = pd.DataFrame(rows)
   300	    if not table.empty:
   301	        metadata = roster[
   302	            [
   303	                "source_id",
   304	                "wdj_name",
   305	                "wd_class",
   306	                "known_roster",
   307	                "in_core",
   308	                "n_variants",
   309	            ]
   310	        ]
   311	        table = metadata.merge(table, on="source_id", how="inner", validate="one_to_one")
   312	        table.sort_values("source_id").to_csv(output, index=False)
   313	    return table
   314	
   315	
   316	def verify_sanity(results: dict[str, dict[str, object]]) -> dict[str, object]:
   317	    failures: list[str] = []
   318	    checks: dict[str, dict[str, object]] = {}
   319	    for source_id in SANITY_IDS:
   320	        if results[source_id].get("unavailable"):
   321	            checks[source_id] = {
   322	                "passed": None,
   323	                "available": False,
   324	                "expected": "confirmed RR Lyrae, 0.2–1.0 d",
   325	                "status": "unavailable_no_ztf_rows",
   326	                "reason": "IRSA returned zero rows within both 10 and 30 arcsec cones",
   327	            }
   328	            continue
   329	        low = results[source_id]["passes"]["low"]
   330	        period = float(low["period_days"])
   331	        frequency = float(low["frequency_per_day"])
   332	        if source_id in SANITY_IDS[:2]:
   333	            passed = low["status"] == "confirmed" and 0.2 <= period <= 1.0
   334	            expected = "confirmed RR Lyrae, 0.2–1.0 d"
   335	        elif source_id == "103999471976858496":
   336	            passed = low["status"] == "confirmed" and abs(period - 0.44977) <= 0.005
   337	            expected = "0.44977 ± 0.005 d"
   338	        else:
   339	            passed = low["status"] == "confirmed" and abs(frequency - 6.1464) <= 0.01
   340	            expected = "6.1464 ± 0.01 d^-1"
   341	        checks[source_id] = {
   342	            "passed": passed,
   343	            "available": True,
   344	            "expected": expected,
   345	            "status": low["status"],
   346	            "period_days": period,
   347	            "frequency_per_day": frequency,
   348	        }
   349	        if not passed:
   350	            failures.append(f"{source_id}: {checks[source_id]}")
   351	    if failures:
   352	        raise RuntimeError("catalog sanity gates failed:\n" + "\n".join(failures))
   353	    return {
   354	        "all_available_passed": True,
   355	        "available_checks": sum(check["available"] for check in checks.values()),
   356	        "unavailable_checks": sum(not check["available"] for check in checks.values()),
   357	        "checks": checks,
   358	    }
