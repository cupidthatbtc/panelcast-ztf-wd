    45	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
    46	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
    47	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
    48	    if only is not None:
    49	        missing = only - set(source_ids)
    50	        if missing:
    51	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
    52	        source_ids = [sid for sid in source_ids if sid in only]
    53	    if limit is not None:
    54	        source_ids = source_ids[:limit]
    55	    pending = []
    56	    for source_id in source_ids:
    57	        result_path = star_dir / f"{source_id}.json"
    58	        if result_path.exists():
    59	            try:
    60	                result = json.loads(result_path.read_text(encoding="utf-8"))
    61	                if result.get("complete") and set(result.get("passes", {})) >= set(passes):
    62	                    continue
    63	            except json.JSONDecodeError:
    64	                pass
    65	        pending.append(source_id)
    66	    return pending, len(source_ids)
