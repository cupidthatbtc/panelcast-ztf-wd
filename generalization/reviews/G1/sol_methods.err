   457	                        roster,
   458	                    )
   459	                    print(
   460	                        f"[catalog-ls] completed {completed_now:,}/{len(pending):,}; "
   461	                        f"table rows={len(table):,}",
   462	                        flush=True,
   463	                    )
   464	            except Exception as exc:
   465	                failures[source_id] = repr(exc)
   466	                print(f"[catalog-ls] FAILED {source_id}: {exc}", flush=True)
   467	
   468	    table = rebuild_table(star_dir, args.run_dir / "ls_full_catalog.csv", roster)
   469	    manifest = {
   470	        "source_count": len(source_ids),
   471	        "completed": len(table),
   472	        "pending_at_start": len(pending),
