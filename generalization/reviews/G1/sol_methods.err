   520	        )
   521	        shutil.rmtree(control_dir)
   522	        print("positive controls passed")
   523	
   524	    summaries: list[dict[str, object]] = []
   525	    with ProcessPoolExecutor(max_workers=args.workers) as executor:
   526	        futures = {
   527	            executor.submit(
   528	                analyze_star,
   529	                source_id,
   530	                str(args.exposures),
   531	                str(run_dir),
   532	                tuple(args.passes),
   533	                args.keep_power,
   534	            ): source_id
   535	            for source_id in source_ids
   536	        }
   537	        for future in as_completed(futures):
   538	            summary = future.result()
   539	            summaries.append(summary)
   540	            print(f"finished {summary['source_id']}", flush=True)
   541	
   542	    collect_outputs(run_dir, source_ids)
   543	    manifest = {
