    42	            if not retryable or attempt == retries:
    43	                raise
    44	        except (TimeoutError, urllib.error.URLError):
    45	            if attempt == retries:
    46	                raise
    47	        delay = min(60.0, 2.0 ** attempt) + random.uniform(0.0, 0.5)
    48	        time.sleep(delay)
    49	    raise RuntimeError("unreachable retry loop")
