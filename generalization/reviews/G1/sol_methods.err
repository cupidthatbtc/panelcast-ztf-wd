    50	    "mo2026_table2.csv": 'SELECT KIC, Freq, Amp FROM "J/A+A/710/A245/table2"',
    51	    "mo2026_table1.csv": 'SELECT KIC, Freq, Amp, fR, C, SC FROM "J/A+A/710/A245/table1"',
    52	}
    53	
    54	
    55	def tap_fetch(query: str, retries: int = 4) -> str:
    56	    payload = urllib.parse.urlencode(
    57	        {"REQUEST": "doQuery", "LANG": "ADQL", "FORMAT": "csv", "QUERY": query}
    58	    ).encode()
    59	    for attempt in range(retries + 1):
    60	        try:
    61	            request = urllib.request.Request(TAP_SYNC, data=payload)
    62	            with urllib.request.urlopen(request, timeout=300) as response:
    63	                text = response.read().decode("utf-8")
    64	            if text.lstrip().startswith("<?xml"):
    65	                raise RuntimeError(f"TAP error response: {text[:300]}")
    66	            return text
    67	        except Exception:
    68	            if attempt == retries:
    69	                raise
    70	            time.sleep(5.0 * (attempt + 1))
    71	    raise RuntimeError("unreachable")
    72	
    73	
    74	def cached_pull(raw_dir: Path, name: str, provenance: dict) -> pd.DataFrame:
    75	    path = raw_dir / name
    76	    if not path.exists():
    77	        text = tap_fetch(QUERIES[name])
    78	        path.write_text(text, encoding="utf-8", newline="")
    79	    raw = path.read_bytes()
    80	    provenance[name] = {
    81	        "query": QUERIES[name],
    82	        "sha256": hashlib.sha256(raw).hexdigest(),
    83	        "bytes": len(raw),
    84	    }
    85	    return pd.read_csv(io.BytesIO(raw))
