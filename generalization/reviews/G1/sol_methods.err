     3	
     4	Re-implements ONLY the roster/paths plumbing of build_catalog_panels.main();
     5	every scientific operation (nearest-cluster crossmatch, row QC, BJD_TDB
     6	conversion, nightly/monthly binning, 2.5-ratio census) is the frozen function
     7	imported through frozen_api, applied verbatim.
     8	
     9	Roster CSV contract (build_d3_roster.py writes this):
    10	  source_id     19-digit campaign id (prefix 90/92/93/94)
    11	  external_id   upstream name (e.g. KIC 8462852)
    12	  ra, dec       ICRS degrees for the ZTF cone
    13	  class_label   truth class (e.g. dsct_flag1, notdsct_flag0)
    14	  label_variable, label_periodic   truth booleans (may be empty)
    15	  gaia_g_mag    optional; empty allowed
    16	Census output maps the frozen column names onto campaign semantics:
    17	wdj_name<-external_id, wd_class<-class_label, paper_variable<-label_variable,
    18	paper_periodic<-label_periodic, known_roster<-False, in_core<-True,
    19	n_variants<-0, bp_rp<-NaN unless provided.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import argparse
    25	import json
    26	import math
    27	from pathlib import Path
    28	from types import SimpleNamespace
    29	
    30	import pandas as pd
    31	
    32	from frozen_api import (
    33	    BANDS,
    34	    EXPOSURE_COLUMNS,
    35	    MIN_EXPOSURES_PER_BAND,
    36	    MONTHLY_COLUMNS,
    37	    NIGHTLY_COLUMNS,
    38	    add_bjd,
    39	    assert_frozen,
    40	    campaign_id_ok,
    41	    census_row,
    42	    clean_rows,
    43	    env_versions,
    44	    frozen_file_shas,
    45	    monthly_panel,
    46	    nightly_panel,
    47	    read_cache,
    48	    select_nearest_source,
    49	)
    50	
    51	
    52	def roster_meta(row: pd.Series) -> SimpleNamespace:
    53	    def opt_float(name: str) -> float:
    54	        value = row.get(name)
    55	        try:
    56	            return float(value)
    57	        except (TypeError, ValueError):
    58	            return math.nan
    59	
    60	    def opt_bool(name: str):
    61	        value = row.get(name)
    62	        if pd.isna(value) or value == "":
    63	            return None
    64	        if isinstance(value, str):
    65	            return value.lower() == "true"
    66	        return bool(value)
    67	
    68	    return SimpleNamespace(
    69	        source_id=str(row["source_id"]),
    70	        wdj_name=str(row.get("external_id", "")),
    71	        gaia_g_mag=opt_float("gaia_g_mag"),
    72	        bp_rp=opt_float("bp_rp"),
    73	        in_core=True,
    74	        n_variants=0,
    75	        known_roster=False,
    76	        wd_class=str(row.get("class_label", "")),
    77	        paper_variable=opt_bool("label_variable"),
    78	        paper_periodic=opt_bool("label_periodic"),
    79	    )
    80	
    81	
    82	def main() -> None:
    83	    parser = argparse.ArgumentParser(description=__doc__)
    84	    parser.add_argument("--roster", type=Path, required=True)
    85	    parser.add_argument("--cache-dir", type=Path, required=True,
    86	                        help="IRSA response cache: <source_id>.csv per target")
    87	    parser.add_argument("--out-dir", type=Path, required=True)
    88	    parser.add_argument("--allow-nonstandard-ids", action="store_true")
    89	    args = parser.parse_args()
    90	
    91	    assert_frozen()
    92	    args.out_dir.mkdir(parents=True, exist_ok=True)
    93	    exposure_star_dir = args.out_dir / "exposure_stars"
    94	    exposure_star_dir.mkdir(parents=True, exist_ok=True)
    95	
    96	    roster = pd.read_csv(args.roster, dtype={"source_id": str})
    97	    if not args.allow_nonstandard_ids:
    98	        bad = [sid for sid in roster["source_id"] if not campaign_id_ok(sid)]
    99	        if bad:
   100	            raise SystemExit(f"{len(bad)} roster ids violate the campaign convention: {bad[:3]}")
   101	
   102	    qc_rows: list[dict[str, object]] = []
   103	    census_rows: list[dict[str, object]] = []
   104	    crossmatched = 0
   105	
   106	    for index, (_, row) in enumerate(roster.iterrows(), 1):
   107	        meta = roster_meta(row)
   108	        cache_path = args.cache_dir / f"{meta.source_id}.csv"
   109	        qc: dict[str, object] = {
   110	            "source_id": meta.source_id,
   111	            "external_id": meta.wdj_name,
   112	            "class_label": meta.wd_class,
   113	            "cache_present": cache_path.exists() and cache_path.stat().st_size > 0,
   114	            "read_status": "ok",
   115	        }
   116	        if not qc["cache_present"]:
   117	            qc["read_status"] = "missing"
   118	            qc_rows.append(qc)
   119	            continue
   120	        try:
   121	            raw = read_cache(cache_path)
   122	            qc["raw_rows"] = len(raw)
   123	            selected, separation, n_objects, n_selected = select_nearest_source(
   124	                raw, float(row["ra"]), float(row["dec"])
   125	            )
   126	            clean, drop_counts = clean_rows(selected)
   127	            qc.update(drop_counts)
   128	            qc["nearest_separation_arcsec"] = separation
   129	            qc["ztf_objects_in_cone"] = n_objects
   130	            qc["selected_ztf_objects"] = n_selected
   131	        except Exception as exc:
   132	            qc["read_status"] = "error"
   133	            qc["error"] = repr(exc)
   134	            qc_rows.append(qc)
   135	            continue
   136	
   137	        for band in BANDS:
   138	            qc[f"{band}_raw_rows"] = int((raw["filtercode"] == band).sum())
   139	            qc[f"{band}_clean_rows"] = int((clean["band"] == band).sum())
   140	        is_crossmatched = all(
   141	            qc[f"{band}_clean_rows"] >= MIN_EXPOSURES_PER_BAND for band in BANDS
   142	        )
   143	        qc["crossmatched"] = is_crossmatched
   144	        qc_rows.append(qc)
   145	        if not is_crossmatched:
   146	            continue
   147	
   148	        crossmatched += 1
   149	        clean["source_id"] = meta.source_id
   150	        clean = add_bjd(clean, float(row["ra"]), float(row["dec"]))
   151	        clean = clean.sort_values(["band", "bjd_tdb"])
   152	        clean[EXPOSURE_COLUMNS].to_csv(
   153	            exposure_star_dir / f"{meta.source_id}.csv.gz", index=False
   154	        )
   155	        nightly = nightly_panel(clean)
   156	        monthly = monthly_panel(nightly)
   157	        census_rows.append(census_row(meta, clean, nightly, monthly))
   158	        if index % 50 == 0 or index == len(roster):
   159	            print(f"[panels-generic] {index:,}/{len(roster):,}; crossmatched={crossmatched:,}",
   160	                  flush=True)
   161	
   162	    pd.DataFrame(qc_rows).to_csv(args.out_dir / "crossmatch_qc.csv", index=False)
   163	    pd.DataFrame(census_rows).to_csv(args.out_dir / "census_generic.csv", index=False)
   164	    manifest = {
   165	        "builder": "build_panels_generic.py",
   166	        "roster": str(args.roster),
   167	        "roster_rows": len(roster),
   168	        "crossmatched_count": crossmatched,
   169	        "crossmatch_rule": "frozen: nearest ZTF coordinate cluster; "
   170	                           f">={MIN_EXPOSURES_PER_BAND} QC-passing exposures in zg and zr",
   171	        "row_qc": "frozen: catflags == 0; finite mag; finite magerr > 0; chi < 4; finite MJD",
   172	        "census_threshold": 2.5,
   173	        "env": env_versions(),
   174	        "frozen_sha256": frozen_file_shas(),
   175	    }
   176	    (args.out_dir / "panels_manifest.json").write_text(
   177	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   178	    )
   179	    print(f"[panels-generic] crossmatched {crossmatched:,}/{len(roster):,}")
   180	
   181	
   182	if __name__ == "__main__":
   183	    main()

