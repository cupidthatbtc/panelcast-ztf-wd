     1	#!/usr/bin/env python3
     2	"""Build the D2 truth roster from the Romero TESS DAV papers.
     3	
     4	Parses the published per-mode tables (period [s], amplitude [ppt]) from the
     5	arXiv LaTeX sources cached in generalization/data/d2/raw:
     6	  Romero+2022  arXiv:2201.04158 (MNRAS 511, 1574)  74 new DAVs, Cycles 1-3
     7	  Romero+2025  arXiv:2407.07260 (ApJ 984, 112)     32 new DAVs, Cycles 4-5
     8	               + Table "old": revised mode lists for re-observed 2022 DAVs,
     9	               including NOV retractions.
    10	
    11	Supersede policy (prespecified): the latest published solution per TIC wins —
    12	2025 "old" table over 2022; NOV objects are dropped from the roster entirely.
    13	
    14	The LaTeX tables contain human typos (comma decimals `356,09`, stray unit
    15	`503.99s`, one missing close-paren, missing list commas). The parser
    16	normalizes these mechanically and then enforces hard range/count asserts;
    17	G3 reviews the parsed output against the paper PDFs.
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	import argparse
    23	import hashlib
    24	import json
    25	import re
    26	from pathlib import Path
    27	
    28	import pandas as pd
    29	
    30	from frozen_api import REPO_ROOT, assert_frozen
    31	
    32	RAW = REPO_ROOT / "generalization/data/d2/raw"
    33	NOV_TICS = {261400271, 804835539, 317620456}
    34	MODE_PAIR = re.compile(r"(\d+\.\d+)\s*s?\s*\(\s*(\d+\.?\d*)\s*[)}]?")
    35	
    36	
    37	def strip_row(line: str) -> str:
    38	    # drop unescaped % comments, row terminator, italics markup, math mode
    39	    out = []
    40	    for index, char in enumerate(line):
    41	        if char == "%" and (index == 0 or line[index - 1] != "\\"):
    42	            break
    43	        out.append(char)
    44	    text = "".join(out)
    45	    text = text.replace("\\\\", "").replace("{\\it", " ").replace("\\textit{", " ")
    46	    text = text.replace("{", " ").replace("}", " ").replace("$", "")
    47	    return text.strip()
    48	
    49	
    50	def table_rows(source: str, header_pattern: str, count: int = 1) -> list[list[str]]:
    51	    """All `&`-separated rows from tables whose header matches header_pattern."""
    52	    rows: list[list[str]] = []
    53	    seen = 0
    54	    for block in re.split(r"\\begin\{table\*?\}", source)[1:]:
    55	        body = block.split("\\end{table")[0]
    56	        if not re.search(header_pattern, body):
    57	            continue
    58	        seen += 1
    59	        for line in body.splitlines():
    60	            if "&" not in line or "\\hline" in line:
    61	                continue
    62	            cleaned = strip_row(line)
    63	            if not cleaned or re.search(header_pattern, line):
    64	                continue
    65	            rows.append([cell.strip() for cell in cleaned.split("&")])
    66	    if seen < count:
    67	        raise SystemExit(f"found {seen} tables matching {header_pattern!r}, expected >= {count}")
    68	    return rows
    69	
    70	
    71	def merge_continuations(rows: list[list[str]]) -> dict[int, list[list[str]]]:
    72	    """Group rows by TIC; a leading-cdots row continues the previous TIC."""
    73	    grouped: dict[int, list[list[str]]] = {}
    74	    current: int | None = None
    75	    for row in rows:
    76	        first = row[0].replace("\\cdots", "").strip()
    77	        if first.isdigit():
    78	            current = int(first)
    79	            grouped.setdefault(current, []).append(row)
    80	        elif current is not None:
    81	            grouped[current].append(row)
    82	    return grouped
    83	
    84	
    85	def parse_modes(cells: list[str]) -> list[tuple[float, float]]:
    86	    text = " , ".join(cells)
    87	    text = re.sub(r"(\d),(\d)", r"\1.\2", text)  # comma decimals -> dots
    88	    return [(float(p), float(a)) for p, a in MODE_PAIR.findall(text)]
    89	
    90	
    91	def parse_mode_table(source: str, paper: str) -> tuple[pd.DataFrame, pd.DataFrame]:
    92	    rows = table_rows(source, r"FAP\(1/1000\)\s*\[ppt\]")
    93	    modes: list[dict] = []
    94	    stars: list[dict] = []
    95	    for tic, group in merge_continuations(rows).items():
    96	        sectors = group[0][1]
    97	        fap_text = group[0][2].strip()
    98	        mode_cells = [row[3] for row in group if len(row) > 3]
    99	        extra_sectors = [
   100	            row[1] for row in group[1:]
   101	            if len(row) > 1 and re.search(r"\d", row[1].replace("\\cdots", ""))
   102	        ]
   103	        if extra_sectors:
   104	            sectors = sectors.rstrip(", ") + "," + ",".join(extra_sectors)
   105	        is_nov = any("NOV" in cell for cell in mode_cells)
   106	        pairs = [] if is_nov else parse_modes(mode_cells)
   107	        if not is_nov and not pairs:
   108	            raise SystemExit(f"{paper} TIC {tic}: no modes parsed from {mode_cells!r}")
   109	        stars.append(
   110	            {
   111	                "tic": tic,
   112	                "paper": paper,
   113	                "sectors": re.sub(r"\s+", "", sectors),
   114	                "fap_ppt": float(fap_text),
   115	                "cadence_s": 20 if "f" in sectors else 120,
   116	                "nov": is_nov,
   117	                "n_modes": len(pairs),
   118	            }
   119	        )
   120	        for period, amp in pairs:
   121	            modes.append({"tic": tic, "paper": paper, "period_s": period, "amp_ppt": amp})
   122	    return pd.DataFrame(stars), pd.DataFrame(modes)
   123	
   124	
   125	def sexagesimal_to_deg(ra_text: str, dec_text: str) -> tuple[float, float]:
   126	    ra_text = ra_text.replace("\\", "").strip()
   127	    dec_text = dec_text.replace("\\", "").replace("−", "-").strip()
   128	    def split3(text: str) -> list[float]:
   129	        parts = text.split(":")
   130	        if len(parts) == 4:  # paper typo: colon used as the decimal point
   131	            parts = parts[:2] + [parts[2] + "." + parts[3]]
   132	        return [float(x) for x in parts]
   133	
   134	    if ":" in ra_text:
   135	        h, m, s = split3(ra_text)
   136	        dd, dm, ds = split3(dec_text.replace("+", ""))
   137	        sign = -1.0 if dec_text.lstrip().startswith("-") else 1.0
   138	    else:
   139	        h, m, s = float(ra_text[0:2]), float(ra_text[2:4]), float(ra_text[4:])
   140	        stripped = dec_text.lstrip("+-")
   141	        dd, dm, ds = float(stripped[0:2]), float(stripped[2:4]), float(stripped[4:])
   142	        sign = -1.0 if dec_text.startswith("-") else 1.0
   143	    return 15.0 * (h + m / 60.0 + s / 3600.0), sign * (abs(dd) + dm / 60.0 + ds / 3600.0)
   144	
   145	
   146	def parse_star_table(source: str, paper: str) -> pd.DataFrame:
   147	    rows = table_rows(source, r"RA\s*&\s*DEC")
   148	    records = []
   149	    for tic, group in merge_continuations(rows).items():
   150	        row = group[0]
   151	        ra, dec = sexagesimal_to_deg(row[1], row[2])
   152	        records.append(
   153	            {"tic": tic, "paper": paper, "ra": ra, "dec": dec, "gmag": float(row[3])}
   154	        )
   155	    return pd.DataFrame(records)
   156	
   157	
   158	def main() -> None:
   159	    parser = argparse.ArgumentParser(description=__doc__)
   160	    parser.add_argument("--out-dir", type=Path, default=REPO_ROOT / "generalization/data/d2")
   161	    args = parser.parse_args()
   162	    assert_frozen()
   163	
   164	    provenance = {
   165	        name: hashlib.sha256((RAW / name).read_bytes()).hexdigest()
   166	        for name in ("romero2022_src.tar.gz", "romero2025_src.tar.gz")
   167	    }
   168	    src2022 = (RAW / "romero2022_src/NewTess.tex").read_text(encoding="utf-8", errors="replace")
   169	    src2025 = (RAW / "romero2025_src/NewTESS.tex").read_text(encoding="utf-8", errors="replace")
   170	
   171	    # the 2025 file holds two mode tables: "new" (32) then "old" (revised
   172	    # R22); slice at the old table's begin marker (its caption sits inside
   173	    # the block, so slicing at the caption text would orphan the rows)
   174	    old_caption = src2025.find("showing a change in the period list")
   175	    if old_caption < 0:
   176	        raise SystemExit("2025 old-table caption not found")
   177	    old_start = src2025.rfind("\\begin{table", 0, old_caption)
   178	    stars22, modes22 = parse_mode_table(src2022, "romero2022")
   179	    stars25, modes25 = parse_mode_table(src2025[:old_start], "romero2025")
   180	    stars25old, modes25old = parse_mode_table(src2025[old_start:], "romero2025old")
   181	
   182	    if len(stars22) != 74:
   183	        raise SystemExit(f"2022 mode table: {len(stars22)} stars, expected 74")
   184	    if len(stars25) != 32:
   185	        raise SystemExit(f"2025 new mode table: {len(stars25)} stars, expected 32")
   186	    nov_found = set(stars25old.loc[stars25old["nov"], "tic"])
   187	    if nov_found != NOV_TICS:
   188	        raise SystemExit(f"NOV set {nov_found} != expected {NOV_TICS}")
   189	
   190	    meta22 = parse_star_table(src2022, "romero2022")
   191	    meta25 = parse_star_table(src2025, "romero2025")
   192	    meta = pd.concat([meta25, meta22], ignore_index=True).drop_duplicates("tic", keep="first")
   193	
   194	    # supersede: 2025old > 2022; drop NOV
   195	    solutions = {}
   196	    for frame in (stars22, stars25, stars25old):
   197	        for record in frame.to_dict("records"):
   198	            if record["paper"] == "romero2025old" or record["tic"] not in solutions:
   199	                solutions[record["tic"]] = record
   200	    targets = pd.DataFrame(
   201	        record for record in solutions.values() if not record["nov"]
   202	    ).sort_values("tic")
   203	    modes = pd.concat([modes22, modes25, modes25old], ignore_index=True)
   204	    chosen = modes.merge(
   205	        targets[["tic", "paper"]], on=["tic", "paper"], how="inner"
   206	    ).sort_values(["tic", "period_s"])
   207	
   208	    if not ((chosen["period_s"] >= 70.0) & (chosen["period_s"] <= 2200.0)).all():
   209	        bad = chosen[(chosen["period_s"] < 70.0) | (chosen["period_s"] > 2200.0)]
   210	        raise SystemExit(f"periods out of DAV range:\n{bad}")
   211	    if not ((chosen["amp_ppt"] > 0.0) & (chosen["amp_ppt"] <= 400.0)).all():
   212	        raise SystemExit("amplitudes out of range")
   213	    missing_meta = set(targets["tic"]) - set(meta["tic"])
   214	    if missing_meta:
   215	        raise SystemExit(f"targets missing star metadata: {sorted(missing_meta)[:5]}")
   216	
   217	    targets = targets.merge(meta[["tic", "ra", "dec", "gmag"]], on="tic", how="left")
   218	    args.out_dir.mkdir(parents=True, exist_ok=True)
   219	    targets.to_csv(args.out_dir / "d2_targets.csv", index=False)
   220	    chosen.to_csv(args.out_dir / "d2_modes.csv", index=False)
   221	    modes.to_csv(args.out_dir / "d2_modes_all_solutions.csv", index=False)
   222	
   223	    report = {
   224	        "targets": len(targets),
   225	        "from_2022_only": int((targets["paper"] == "romero2022").sum()),
   226	        "from_2025_new": int((targets["paper"] == "romero2025").sum()),
   227	        "superseded_by_2025old": int((targets["paper"] == "romero2025old").sum()),
   228	        "nov_dropped": sorted(NOV_TICS),
   229	        "modes_total": len(chosen),
   230	        "modes_per_star_median": float(targets["n_modes"].median()),
   231	        "period_s_range": [float(chosen["period_s"].min()), float(chosen["period_s"].max())],
   232	        "amp_ppt_range": [float(chosen["amp_ppt"].min()), float(chosen["amp_ppt"].max())],
   233	        "stars_with_20s_cadence": int((targets["cadence_s"] == 20).sum()),
   234	        "gmag_range": [float(targets["gmag"].min()), float(targets["gmag"].max())],
   235	        "provenance_sha256": provenance,
   236	    }
   237	    (args.out_dir / "d2_roster_report.json").write_text(
   238	        json.dumps(report, indent=2) + "\n", encoding="utf-8"
   239	    )
   240	    print(json.dumps(report, indent=2))
   241	
   242	
   243	if __name__ == "__main__":
   244	    main()

