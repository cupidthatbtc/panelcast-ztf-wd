    38	def load_exposures(path: Path) -> pd.DataFrame:
    39	    columns = [
    40	        "source_id",
    41	        "band",
    42	        "mjd",
    43	        "bjd_tdb",
    44	        "night_mjd",
    45	        "mag",
    46	        "magerr",
    47	        "wdj_name",
    48	        "wd_class",
    49	        "paper_variable",
    50	        "paper_periodic",
    51	    ]
    52	    frame = pd.read_csv(path, usecols=columns, dtype={"source_id": str, "band": str}, low_memory=False)
    53	    numeric = ["mjd", "bjd_tdb", "night_mjd", "mag", "magerr"]
    54	    frame[numeric] = frame[numeric].apply(pd.to_numeric, errors="raise")
    55	    return frame
    56	
    57	
    58	def prepare_series(frame: pd.DataFrame, high_frequency: bool) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    59	    ordered = frame.sort_values("bjd_tdb")
    60	    time = ordered["bjd_tdb"].to_numpy(dtype=float)
    61	    time -= time.min()
    62	    mag = ordered["mag"].to_numpy(dtype=float)
    63	    if high_frequency:
    64	        nightly = ordered.groupby("night_mjd")["mag"].transform("median").to_numpy(dtype=float)
    65	        mag = mag - nightly
    66	    else:
    67	        weights = 1.0 / np.square(ordered["magerr"].to_numpy(dtype=float))
    68	        mag = mag - np.average(mag, weights=weights)
    69	    error = ordered["magerr"].to_numpy(dtype=float)
    70	    return time, mag, error
    71	
    72	
    73	def periodogram_to_memmap(
    74	    time: np.ndarray,
    75	    values: np.ndarray,
    76	    errors: np.ndarray,
    77	    grid: FrequencyGrid,
    78	    path: Path,
    79	    chunk_size: int = 500_000,
    80	) -> np.memmap:
    81	    periodogram = np.memmap(path, dtype="float32", mode="w+", shape=(grid.size,))
    82	    model = LombScargle(time, values, errors, fit_mean=True, center_data=True)
    83	    for start in range(0, grid.size, chunk_size):
    84	        stop = min(start + chunk_size, grid.size)
    85	        frequency = grid.values(start, stop)
    86	        power = model.power(
    87	            frequency,
    88	            method="fast",
    89	            assume_regular_frequency=True,
    90	            method_kwds=FAST_KWDS,
    91	        )
    92	        periodogram[start:stop] = np.asarray(power, dtype="float32")
    93	    periodogram.flush()
    94	    return periodogram
    95	
    96	
    97	def extract_peaks(
    98	    power: np.ndarray,
    99	    grid: FrequencyGrid,
   100	    count: int = 20,
   101	    chunk_size: int = 500_000,
   102	) -> tuple[list[tuple[float, int]], np.ndarray]:
   103	    candidates: list[tuple[float, int]] = []
   104	    noise_indices: list[np.ndarray] = []
   105	    separation = max(2, int(math.ceil(1.5 * SAMPLES_PER_PEAK)))
   106	
   107	    for start in range(0, grid.size, chunk_size):
   108	        stop = min(start + chunk_size, grid.size)
   109	        read_start = max(0, start - separation)
   110	        read_stop = min(grid.size, stop + separation)
   111	        chunk = np.asarray(power[read_start:read_stop])
   112	        peaks, _ = find_peaks(chunk, distance=separation)
   113	        global_peaks = read_start + peaks
   114	        global_peaks = global_peaks[(global_peaks >= start) & (global_peaks < stop)]
   115	        if not global_peaks.size:
   116	            continue
   117	        local_power = np.asarray(power[global_peaks])
   118	        keep = min(max(count * 5, 100), global_peaks.size)
   119	        chosen = np.argpartition(local_power, -keep)[-keep:]
   120	        candidates.extend(
   121	            (float(local_power[index]), int(global_peaks[index])) for index in chosen
   122	        )
   123	        noise_indices.append(global_peaks[::20])
   124	
   125	    candidates.sort(reverse=True)
   126	    selected: list[tuple[float, int]] = []
   127	    for peak_power, index in candidates:
   128	        if all(abs(index - prior_index) >= separation for _, prior_index in selected):
   129	            selected.append((peak_power, index))
   130	            if len(selected) == count:
   131	                break
   132	    noise = np.concatenate(noise_indices) if noise_indices else np.array([], dtype=np.int64)
   133	    return selected, noise
   134	
   135	
   136	def decimate_periodogram(power: np.ndarray, grid: FrequencyGrid, points: int = 12_000) -> tuple[np.ndarray, np.ndarray]:
   137	    stride = max(1, grid.size // points)
   138	    indices = np.arange(0, grid.size, stride, dtype=np.int64)
   139	    return grid.minimum + grid.step * indices, np.asarray(power[indices], dtype=float)
   140	
   141	
   142	def exact_power_and_amplitude(
   143	    time: np.ndarray,
   144	    values: np.ndarray,
   145	    errors: np.ndarray,
   146	    frequency: float,
   147	) -> tuple[float, float, float]:
   148	    model = LombScargle(time, values, errors, fit_mean=True, center_data=True)
   149	    power = float(model.power(frequency, method="chi2"))
   150	
   151	    phase = 2.0 * np.pi * frequency * time
   152	    design = np.column_stack((np.ones_like(time), np.sin(phase), np.cos(phase)))
   153	    inv_var = 1.0 / np.square(errors)
   154	    normal = design.T @ (inv_var[:, None] * design)
   155	    covariance = np.linalg.inv(normal)
   156	    beta = np.linalg.solve(normal, design.T @ (inv_var * values))
   157	    amplitude = float(np.hypot(beta[1], beta[2]))
   158	    if amplitude == 0:
   159	        amplitude_error = float(np.sqrt(covariance[1, 1] + covariance[2, 2]))
   160	    else:
   161	        gradient = np.array([beta[1], beta[2]]) / amplitude
   162	        amplitude_error = float(np.sqrt(gradient @ covariance[1:, 1:] @ gradient))
   163	    return power, amplitude, amplitude_error
   164	
   165	
   166	def baluev_fap(
   167	    time: np.ndarray,
   168	    values: np.ndarray,
   169	    errors: np.ndarray,
   170	    power: float,
   171	    grid: FrequencyGrid,
   172	) -> float:
   173	    model = LombScargle(time, values, errors, fit_mean=True, center_data=True)
   174	    return float(
   175	        model.false_alarm_probability(
   176	            power,
   177	            method="baluev",
   178	            samples_per_peak=SAMPLES_PER_PEAK,
   179	            minimum_frequency=grid.minimum,
   180	            maximum_frequency=grid.maximum,
   181	        )
   182	    )
   183	
   184	
   185	def window_strength(time: np.ndarray, frequency: np.ndarray | float) -> np.ndarray:
   186	    frequency_array = np.atleast_1d(frequency).astype(float)
   187	    centered = time - np.mean(time)
   188	    phase = -2j * np.pi * frequency_array[:, None] * centered[None, :]
   189	    return np.square(np.abs(np.mean(np.exp(phase), axis=1)))
   190	
   191	
   192	def is_window_alias(time: np.ndarray, frequency: float, tolerance: float) -> tuple[bool, float]:
   193	    offsets = np.linspace(-tolerance, tolerance, 21)
   194	    strengths = window_strength(time, frequency + offsets)
   195	    near_sidereal = abs(frequency / SIDEREAL_FREQUENCY - round(frequency / SIDEREAL_FREQUENCY)) * SIDEREAL_FREQUENCY
   196	    nearby_window_peak = np.max(strengths) >= WINDOW_POWER_THRESHOLD
   197	    return bool(nearby_window_peak or near_sidereal <= tolerance), float(np.max(strengths))
   198	
   199	
   200	def is_alias_of_stronger(
   201	    frequency: float,
   202	    stronger_frequencies: list[float],
   203	    tolerance: float,
   204	) -> bool:
   205	    for stronger in stronger_frequencies:
   206	        delta = abs(frequency - stronger)
   207	        nearest_alias = round(delta / SIDEREAL_FREQUENCY) * SIDEREAL_FREQUENCY
   208	        if nearest_alias > 0 and abs(delta - nearest_alias) <= tolerance:
   209	            return True
   210	    return False
   211	
   212	
   213	def approximate_peak_amplitude(
   214	    time: np.ndarray,
   215	    values: np.ndarray,
   216	    errors: np.ndarray,
   217	    power: float,
   218	) -> float:
   219	    weights = 1.0 / np.square(errors)
   220	    centered = values - np.average(values, weights=weights)
   221	    chi2_ref = float(np.sum(weights * centered**2))
   222	    return math.sqrt(max(0.0, 4.0 * power * chi2_ref / np.sum(weights)))

