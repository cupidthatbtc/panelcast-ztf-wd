   114	
   115	def multiband_power(
   116	    zg: np.memmap,
   117	    zr: np.memmap,
   118	    out_path: Path,
   119	    chunk_size: int = 500_000,
   120	) -> tuple[np.memmap, tuple[float, float]]:
   121	    sums = []
   122	    for power in (zg, zr):
   123	        total = 0.0
   124	        for start in range(0, power.size, chunk_size):
   125	            chunk = np.asarray(power[start : start + chunk_size], dtype=float)
   126	            total += float(np.dot(chunk, chunk))
   127	        sums.append(total)
   128	    total = sums[0] + sums[1]
   129	    weights = (sums[0] / total, sums[1] / total)
   130	
   131	    combined = np.memmap(out_path, dtype="float32", mode="w+", shape=zg.shape)
   132	    for start in range(0, zg.size, chunk_size):
   133	        stop = min(start + chunk_size, zg.size)
   134	        combined[start:stop] = weights[0] * zg[start:stop] + weights[1] * zr[start:stop]
   135	    combined.flush()
   136	    return combined, weights
