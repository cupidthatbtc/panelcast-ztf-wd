    31	def fetch(url: str, retries: int) -> tuple[str, int]:
    32	    for attempt in range(retries + 1):
    33	        try:
    34	            request = urllib.request.Request(
    35	                url,
    36	                headers={"User-Agent": "panelcast-ztf-wd-catalog/1.0"},
    37	            )
