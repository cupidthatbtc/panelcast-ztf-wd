   492	        encoding="utf-8",
   493	    )
   494	    print(f"[catalog-ls] wrote {args.run_dir / 'ls_full_catalog.csv'} ({len(table):,} rows)")
   495	    if failures or len(table) != len(source_ids):
   496	        raise SystemExit(1)
