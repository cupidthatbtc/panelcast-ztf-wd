   361	def main() -> None:
   362	    parser = argparse.ArgumentParser()
   363	    parser.add_argument(
   364	        "--run-dir",
   365	        type=Path,
   366	        default=ROOT / "outputs/catalog/2026-08-01_full",
   367	    )
   368	    parser.add_argument("--workers", type=int, default=physical_workers())
   369	    parser.add_argument("--stars", nargs="*")
   370	    parser.add_argument("--skip-sanity", action="store_true")
   371	    args = parser.parse_args()
   372	
   373	    exposure_star_dir = args.run_dir / "exposure_stars"
   374	    ls_dir = args.run_dir / "ls"
   375	    star_dir = ls_dir / "stars"
   376	    sanity_dir = ls_dir / "sanity"
   377	    work_dir = ls_dir / "work"
   378	    for path in (star_dir, sanity_dir, work_dir):
   379	        path.mkdir(parents=True, exist_ok=True)
   380	
   381	    roster = pd.read_csv(
   382	        ROOT / "data/roster/jestin2026_rebuilt_candidates.csv",
   383	        dtype={"source_id": str},
   384	    )
   385	    source_ids = sorted(path.stem.split(".csv")[0] for path in exposure_star_dir.glob("*.csv.gz"))
   386	    if args.stars:
   387	        requested = set(args.stars)
   388	        source_ids = [source_id for source_id in source_ids if source_id in requested]
   389	        missing = requested - set(source_ids)
   390	        if missing:
   391	            raise ValueError(f"requested stars absent from exposure shards: {sorted(missing)}")
   392	
   393	    if not args.skip_sanity and not args.stars:
   394	        sanity_results = {}
   395	        for source_id in SANITY_IDS:
   396	            shard = exposure_star_dir / f"{source_id}.csv.gz"
   397	            if not shard.exists():
   398	                if source_id != "6555925496084361344":
   399	                    raise ValueError(f"sanity source is not crossmatched: {source_id}")
   400	                sanity_results[source_id] = {"unavailable": True}
   401	                print(f"[sanity] unavailable with zero ZTF rows: {source_id}", flush=True)
   402	                continue
   403	            sanity_results[source_id] = analyze_star(
   404	                source_id,
   405	                str(shard),
   406	                str(sanity_dir / f"{source_id}.json"),
   407	                str(work_dir / "sanity"),
   408	                ("low",),
   409	            )
   410	            print(f"[sanity] finished {source_id}", flush=True)
   411	        sanity = verify_sanity(sanity_results)
   412	        (ls_dir / "sanity_gates.json").write_text(
   413	            json.dumps(sanity, indent=2, default=json_ready) + "\n",
   414	            encoding="utf-8",
   415	        )
   416	        print("[sanity] all three available known-period gates passed; one RR Lyrae has no ZTF rows", flush=True)
   417	
   418	    pending = []
   419	    for source_id in source_ids:
   420	        result_path = star_dir / f"{source_id}.json"
   421	        if result_path.exists():
   422	            try:
   423	                result = json.loads(result_path.read_text(encoding="utf-8"))
   424	                if result.get("complete") and set(result.get("passes", {})) >= set(PASS_BOUNDS):
   425	                    continue
   426	            except json.JSONDecodeError:
   427	                pass
   428	        pending.append(source_id)
   429	
   430	    print(
   431	        f"[catalog-ls] sources={len(source_ids):,} pending={len(pending):,} workers={args.workers}",
   432	        flush=True,
   433	    )
   434	    failures: dict[str, str] = {}
   435	    completed_now = 0
   436	    with ProcessPoolExecutor(max_workers=args.workers) as executor:
   437	        futures = {
   438	            executor.submit(
   439	                analyze_star,
   440	                source_id,
   441	                str(exposure_star_dir / f"{source_id}.csv.gz"),
   442	                str(star_dir / f"{source_id}.json"),
   443	                str(work_dir),
   444	                tuple(PASS_BOUNDS),
   445	            ): source_id
   446	            for source_id in pending
   447	        }
   448	        for future in as_completed(futures):
   449	            source_id = futures[future]
   450	            try:
   451	                future.result()
   452	                completed_now += 1
   453	                if completed_now % 10 == 0 or completed_now == len(pending):
   454	                    table = rebuild_table(
   455	                        star_dir,
