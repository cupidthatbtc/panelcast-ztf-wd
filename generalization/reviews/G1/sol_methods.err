   451	
   452	def verify_controls(summaries: list[dict[str, object]]) -> None:
   453	    by_id = {str(summary["source_id"]): summary for summary in summaries}
   454	    rr = by_id[CONTROL_IDS[0]]["passes"]["low"]
   455	    double = by_id[CONTROL_IDS[1]]["passes"]["low"]
   456	    rr_period = float(rr["period_days"])
   457	    failures = []
   458	    if rr["status"] != "confirmed" or not 0.2 <= rr_period <= 1.0:
   459	        failures.append(f"RR Lyrae control: {rr}")
   460	    if double["status"] != "confirmed" or double["basis"] != "zg+zr":
   461	        failures.append(f"double-band control: {double}")
   462	    if failures:
   463	        raise RuntimeError("positive controls failed; stopping before full search\n" + "\n".join(failures))
   464	
   465	
   466	def collect_outputs(run_dir: Path, source_ids: list[str]) -> None:
   467	    tables = {"peaks": [], "candidates": [], "upper_limits": []}
   468	    summaries = []
   469	    for source_id in source_ids:
   470	        star_dir = run_dir / "stars" / source_id
   471	        summaries.append(json.loads((star_dir / "summary.json").read_text(encoding="utf-8")))
   472	        for pass_name in PASS_BOUNDS:
   473	            peak_path = star_dir / f"peaks_{pass_name}.csv"
   474	            candidate_path = star_dir / f"candidates_{pass_name}.csv"
   475	            if peak_path.exists():
   476	                tables["peaks"].append(pd.read_csv(peak_path, dtype={"source_id": str}))
   477	            if candidate_path.exists():
   478	                tables["candidates"].append(pd.read_csv(candidate_path, dtype={"source_id": str}))
   479	        tables["upper_limits"].append(pd.read_csv(star_dir / "upper_limits.csv", dtype={"source_id": str}))
   480	
   481	    for name, frames in tables.items():
   482	        pd.concat(frames, ignore_index=True).to_csv(run_dir / f"{name}.csv", index=False)
   483	    (run_dir / "summaries.json").write_text(
   484	        json.dumps(summaries, indent=2, default=json_ready) + "\n", encoding="utf-8"
   485	    )
   486	
   487	
   488	def main() -> None:
   489	    parser = argparse.ArgumentParser()
   490	    parser.add_argument("--exposures", type=Path, default=ROOT / "data/raw/ztf_wd_exposures.csv")
   491	    parser.add_argument("--out-dir", type=Path)
   492	    parser.add_argument("--workers", type=int, default=min(4, os.cpu_count() or 1))
   493	    parser.add_argument("--stars", nargs="*")
   494	    parser.add_argument("--passes", nargs="+", choices=tuple(PASS_BOUNDS), default=tuple(PASS_BOUNDS))
   495	    parser.add_argument("--skip-controls", action="store_true")
   496	    parser.add_argument("--keep-power", action="store_true")
   497	    args = parser.parse_args()
   498	
   499	    timestamp = datetime.now().strftime("%Y-%m-%d_%H%M%S")
   500	    run_dir = args.out_dir or ROOT / "outputs/ls" / timestamp
   501	    run_dir.mkdir(parents=True, exist_ok=True)
   502	    exposures = load_exposures(args.exposures)
   503	    source_ids = sorted(exposures["source_id"].unique())
   504	    if args.stars:
   505	        requested = set(args.stars)
   506	        source_ids = [source_id for source_id in source_ids if source_id in requested]
   507	        missing = requested - set(source_ids)
   508	        if missing:
   509	            raise ValueError(f"requested stars absent from exposures: {sorted(missing)}")
   510	
   511	    if not args.skip_controls and not args.stars:
   512	        control_dir = run_dir / "positive_controls"
