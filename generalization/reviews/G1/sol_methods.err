   292	def run_bls(star: pd.DataFrame, out_path: Path) -> dict[str, object]:
   293	    pieces = []
   294	    for band, frame in star.groupby("band"):
   295	        median_mag = float(frame["mag"].median())
   296	        flux = np.power(10.0, -0.4 * (frame["mag"].to_numpy(dtype=float) - median_mag))
   297	        flux_error = 0.4 * np.log(10.0) * flux * frame["magerr"].to_numpy(dtype=float)
   298	        pieces.append(
   299	            pd.DataFrame(
   300	                {"time": frame["bjd_tdb"].to_numpy(dtype=float), "flux": flux, "error": flux_error}
   301	            )
   302	        )
   303	    combined = pd.concat(pieces).sort_values("time")
   304	    time = combined["time"].to_numpy(dtype=float)
   305	    time -= time.min()
   306	    model = BoxLeastSquares(time, combined["flux"].to_numpy(), dy=combined["error"].to_numpy())
   307	    durations = np.array([2, 5, 10, 20], dtype=float) / 1440.0
   308	    coarse_periods = np.geomspace(1.0 / 24.0, 30.0, 200_000)
   309	    coarse = model.power(coarse_periods, durations, method="fast", oversample=5)
   310	    coarse_peaks, _ = find_peaks(coarse.power, distance=5)
   311	    if coarse_peaks.size:
   312	        keep = min(20, len(coarse_peaks))
   313	        top = coarse_peaks[np.argpartition(coarse.power[coarse_peaks], -keep)[-keep:]]
   314	    else:
   315	        top = np.array([int(np.argmax(coarse.power))])
   316	    log_step = math.log(30.0 * 24.0) / (len(coarse_periods) - 1)
   317	
   318	    refinements = []
   319	    for index in top:
   320	        center = float(coarse.period[index])
   321	        periods = np.geomspace(center * math.exp(-5 * log_step), center * math.exp(5 * log_step), 2001)
   322	        refinements.append(model.power(periods, durations, method="fast", oversample=5))
   323	    result = max(refinements, key=lambda item: float(np.max(item.power)))
   324	    index = int(np.argmax(result.power))
   325	    summary = {
   326	        "source_id": TRANSIT_ID,
   327	        "period_days": float(result.period[index]),
