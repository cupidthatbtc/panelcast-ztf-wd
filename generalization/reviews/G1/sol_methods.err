    60	
    61	def angular_separation_arcsec(
    62	    ra1: np.ndarray | float,
    63	    dec1: np.ndarray | float,
    64	    ra2: np.ndarray | float,
    65	    dec2: np.ndarray | float,
    66	) -> np.ndarray:
    67	    ra1_rad = np.deg2rad(ra1)
    68	    dec1_rad = np.deg2rad(dec1)
    69	    ra2_rad = np.deg2rad(ra2)
    70	    dec2_rad = np.deg2rad(dec2)
    71	    delta_ra = ra1_rad - ra2_rad
    72	    cos_angle = (
    73	        np.sin(dec1_rad) * np.sin(dec2_rad)
    74	        + np.cos(dec1_rad) * np.cos(dec2_rad) * np.cos(delta_ra)
    75	    )
    76	    return np.rad2deg(np.arccos(np.clip(cos_angle, -1.0, 1.0))) * 3600.0
    77	
    78	
    79	def read_cache(path: Path) -> pd.DataFrame:
    80	    required = {
    81	        "oid",
    82	        "mjd",
    83	        "mag",
    84	        "magerr",
    85	        "catflags",
    86	        "filtercode",
    87	        "ra",
    88	        "dec",
    89	        "chi",
    90	    }
    91	    try:
    92	        frame = pd.read_csv(path, low_memory=False)
    93	    except pd.errors.EmptyDataError:
    94	        return pd.DataFrame(columns=sorted(required))
    95	    missing = required - set(frame.columns)
    96	    if missing:
    97	        raise ValueError(f"missing cache columns: {sorted(missing)}")
    98	    return frame
    99	
   100	
   101	def select_nearest_source(
   102	    frame: pd.DataFrame,
   103	    target_ra: float,
   104	    target_dec: float,
   105	) -> tuple[pd.DataFrame, float, int, int]:
   106	    coordinates = frame.dropna(subset=["oid", "ra", "dec"]).copy()
   107	    if coordinates.empty:
   108	        return frame.iloc[0:0].copy(), math.nan, 0, 0
   109	    coordinates["oid"] = coordinates["oid"].astype(str)
   110	    objects = coordinates.groupby("oid", as_index=False).agg(
   111	        object_ra=("ra", "median"),
   112	        object_dec=("dec", "median"),
   113	    )
   114	    objects["target_separation_arcsec"] = angular_separation_arcsec(
   115	        objects["object_ra"].to_numpy(),
   116	        objects["object_dec"].to_numpy(),
   117	        target_ra,
   118	        target_dec,
   119	    )
   120	    nearest = objects.loc[objects["target_separation_arcsec"].idxmin()]
   121	    objects["nearest_object_separation_arcsec"] = angular_separation_arcsec(
   122	        objects["object_ra"].to_numpy(),
   123	        objects["object_dec"].to_numpy(),
   124	        float(nearest["object_ra"]),
   125	        float(nearest["object_dec"]),
   126	    )
   127	    selected_oids = set(
   128	        objects.loc[
   129	            objects["nearest_object_separation_arcsec"] <= OID_CLUSTER_ARCSEC,
   130	            "oid",
   131	        ]
   132	    )
   133	    selected = frame[frame["oid"].astype(str).isin(selected_oids)].copy()
   134	    return selected, float(nearest["target_separation_arcsec"]), len(objects), len(selected_oids)
   135	
   136	
   137	def clean_rows(frame: pd.DataFrame) -> tuple[pd.DataFrame, dict[str, int]]:
   138	    band_ok = frame["filtercode"].isin(BANDS)
   139	    catflags = pd.to_numeric(frame["catflags"], errors="coerce")
   140	    mag = pd.to_numeric(frame["mag"], errors="coerce")
   141	    magerr = pd.to_numeric(frame["magerr"], errors="coerce")
   142	    chi = pd.to_numeric(frame["chi"], errors="coerce")
   143	    mjd = pd.to_numeric(frame["mjd"], errors="coerce")
   144	
   145	    valid_catflags = catflags.eq(0)
   146	    valid_mag = np.isfinite(mag)
   147	    valid_magerr = np.isfinite(magerr) & magerr.gt(0)
   148	    valid_chi = np.isfinite(chi) & chi.lt(4)
   149	    valid_mjd = np.isfinite(mjd)
   150	    keep = band_ok & valid_catflags & valid_mag & valid_magerr & valid_chi & valid_mjd
   151	    counts = {
   152	        "selected_rows": len(frame),
   153	        "drop_unsupported_band": int((~band_ok).sum()),
   154	        "drop_catflags": int((band_ok & ~valid_catflags).sum()),
   155	        "drop_invalid_mag": int((band_ok & valid_catflags & ~valid_mag).sum()),
   156	        "drop_invalid_magerr": int(
   157	            (band_ok & valid_catflags & valid_mag & ~valid_magerr).sum()
   158	        ),
   159	        "drop_chi": int(
   160	            (band_ok & valid_catflags & valid_mag & valid_magerr & ~valid_chi).sum()
   161	        ),
   162	        "drop_invalid_mjd": int(
   163	            (
   164	                band_ok
   165	                & valid_catflags
   166	                & valid_mag
   167	                & valid_magerr
   168	                & valid_chi
   169	                & ~valid_mjd
   170	            ).sum()
   171	        ),
   172	    }
   173	    cleaned = frame.loc[keep].copy()
   174	    cleaned["band"] = cleaned["filtercode"]
   175	    for column, values in (("mag", mag), ("magerr", magerr), ("chi", chi), ("mjd", mjd)):
   176	        cleaned[column] = values.loc[cleaned.index].astype(float)
   177	    cleaned["oid"] = cleaned["oid"].astype(str)
   178	    cleaned["night_mjd"] = np.floor(cleaned["mjd"]).astype(int)
   179	    return cleaned, counts
   180	
   181	
   182	def add_bjd(frame: pd.DataFrame, ra: float, dec: float) -> pd.DataFrame:
   183	    times = Time(
   184	        frame["mjd"].to_numpy(),
   185	        format="mjd",
   186	        scale="utc",
   187	        location=PALOMAR,
   188	    )
   189	    coordinate = SkyCoord(ra * u.deg, dec * u.deg, frame="icrs")
   190	    frame = frame.copy()
   191	    frame["bjd_tdb"] = (
   192	        times.tdb + times.light_travel_time(coordinate, kind="barycentric")
   193	    ).jd
   194	    return frame
   195	
   196	
   197	def nightly_panel(frame: pd.DataFrame) -> pd.DataFrame:
   198	    rows: list[dict[str, object]] = []
   199	    for (source_id, band, night), group in frame.groupby(
   200	        ["source_id", "band", "night_mjd"], sort=True
   201	    ):
   202	        magnitudes = group["mag"].to_numpy(dtype=float)
   203	        errors = group["magerr"].to_numpy(dtype=float)
   204	        n_exp = len(group)
   205	        if n_exp >= 3:
   206	            scatter = float(np.std(magnitudes, ddof=1))
   207	        elif n_exp == 2:
   208	            scatter = float(np.std(magnitudes, ddof=0))
   209	        else:
   210	            scatter = 0.0
   211	        mag_err = max(
   212	            scatter / math.sqrt(n_exp),
   213	            float(np.median(errors)) / math.sqrt(n_exp),
   214	        )
   215	        rows.append(
   216	            {
   217	                "source_id": source_id,
   218	                "band": band,
   219	                "night_mjd": int(night),
   220	                "night_date": pd.Timestamp("1858-11-17")
   221	                + pd.to_timedelta(int(night), unit="D"),
   222	                "mag_binned": float(np.median(magnitudes)),
   223	                "mag_err": mag_err,
   224	                "n_exp": n_exp,
   225	            }
   226	        )
   227	    return pd.DataFrame(rows, columns=NIGHTLY_COLUMNS)
   228	
