    42	# Campaign source_id convention: 19-digit numeric strings, dataset-prefixed.
    43	# All prefixes chosen so ids cannot collide with real Gaia DR3 source_ids used
    44	# in the 2026-08-01 run and so int(source_id[-9:]) (the frozen bootstrap's seed
    45	# convention) is always a valid int.
    46	CAMPAIGN_ID_PREFIXES = {
    47	    "90": "D3 ZTF x Kepler delta Scuti (real ZTF light curves)",
    48	    "92": "D2 arm B (TESS-truth signal + real ZTF photometry)",
    49	    "93": "D2 arm A (TESS-truth signal + synthetic Gaussian floor)",
    50	    "94": "D2 statistical nulls (zero amplitude, arm-A floor)",
    51	}
    52	
    53	
    54	class FrozenIntegrityError(RuntimeError):
    55	    """A frozen file's content no longer matches tag frozen-2026-08-01."""
    56	
    57	
    58	def frozen_file_shas() -> dict[str, str]:
    59	    shas: dict[str, str] = {}
    60	    for rel in FROZEN_SHA256:
    61	        path = REPO_ROOT / rel
    62	        shas[rel] = hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "MISSING"
    63	    return shas
    64	
    65	
    66	def assert_frozen() -> dict[str, str]:
    67	    actual = frozen_file_shas()
    68	    mismatches = [
    69	        f"{rel}: expected {expected[:12]}..., found {actual[rel][:12]}..."
    70	        for rel, expected in FROZEN_SHA256.items()
    71	        if actual[rel] != expected
    72	    ]
    73	    if mismatches:
    74	        raise FrozenIntegrityError(
    75	            "frozen pipeline files modified since tag "
    76	            f"{FROZEN_TAG}:\n" + "\n".join(mismatches)
    77	        )
    78	    return actual
    79	
    80	
    81	def env_versions() -> dict[str, str]:
    82	    import astropy
    83	    import astropy_iers_data
    84	    import erfa
    85	    import numpy
    86	    import pandas
    87	    import scipy
    88	
    89	    return {
    90	        "python": platform.python_version(),
    91	        "platform": platform.platform(),
    92	        "machine": platform.node(),
    93	        "numpy": numpy.__version__,
    94	        "scipy": scipy.__version__,
    95	        "astropy": astropy.__version__,
    96	        "astropy_iers_data": astropy_iers_data.__version__,
    97	        "pyerfa": erfa.__version__,
    98	        "pandas": pandas.__version__,
    99	    }
   100	
   101	
   102	def campaign_id_ok(source_id: str) -> bool:
   103	    return (
   104	        isinstance(source_id, str)
   105	        and len(source_id) == 19
   106	        and source_id.isdigit()
   107	        and source_id[:2] in CAMPAIGN_ID_PREFIXES
   108	    )
   109	
   110	
