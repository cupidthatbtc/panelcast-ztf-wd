   254	def overall_result(result: dict[str, object]) -> dict[str, object]:
   255	    passes = result["passes"]
   256	    order = {"confirmed": 0, "candidate": 1, "not_detected": 2}
   257	    best_pass, best = min(
   258	        passes.items(),
   259	        key=lambda item: (order[item[1]["status"]], float(item[1]["best_band_fap"])),
   260	    )
   261	    return {
   262	        "source_id": result["source_id"],
   263	        "ls_complete": bool(result["complete"]),
   264	        "blind_status": best["status"],
   265	        "best_pass": best_pass,
   266	        "best_frequency_per_day": best["frequency_per_day"],
   267	        "best_period_days": best["period_days"],
   268	        "best_period_seconds": best["period_seconds"],
   269	        "basis": best["basis"],
   270	        "best_band_fap": best["best_band_fap"],
   271	        "zg_fap": best["zg_fap"],
   272	        "zr_fap": best["zr_fap"],
   273	        "zg_amplitude_mmag": best["zg_amplitude_mmag"],
   274	        "zr_amplitude_mmag": best["zr_amplitude_mmag"],
   275	        "zg_alias": best["zg_alias"],
   276	        "zr_alias": best["zr_alias"],
   277	        "low_zg_a95_mmag": passes.get("low", {}).get("zg_a95_mmag"),
   278	        "low_zr_a95_mmag": passes.get("low", {}).get("zr_a95_mmag"),
   279	        "high_zg_a95_mmag": passes.get("high", {}).get("zg_a95_mmag"),
   280	        "high_zr_a95_mmag": passes.get("high", {}).get("zr_a95_mmag"),
   281	        "low_pass_available": passes.get("low", {}).get("available", True),
   282	        "high_pass_available": passes.get("high", {}).get("available", True),
   283	        "low_unavailable_reason": passes.get("low", {}).get("unavailable_reason", ""),
   284	        "high_unavailable_reason": passes.get("high", {}).get("unavailable_reason", ""),
   285	        "n_exp_zg": result["n_exp_zg"],
   286	        "n_exp_zr": result["n_exp_zr"],
   287	        "baseline_days": result["baseline_days"],
   288	    }
