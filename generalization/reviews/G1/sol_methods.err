    32	# One in-flight star holds two full-resolution float32 periodogram memmaps plus
    33	# the multiband combination on scratch; 0.47 GB covers the worst observed
    34	# baseline at samples_per_peak=10. Disk, not wall time, binds worker count.
    35	SCRATCH_GB_PER_WORKER = 0.47
    36	
    37	
    38	def preflight_workers(requested: int | None, work_root: Path) -> tuple[int, float]:
    39	    free_gb = shutil.disk_usage(work_root).free / 1e9
    40	    ceiling = max(1, int(free_gb * 0.5 / SCRATCH_GB_PER_WORKER))
    41	    workers = min(requested or physical_workers(), ceiling)
    42	    return workers, free_gb
    43	
