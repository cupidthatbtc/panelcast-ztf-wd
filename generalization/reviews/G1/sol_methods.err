   179	        futures = {
   180	            executor.submit(
   181	                analyze_star,
   182	                star,
   183	                str(args.shard_dir / f"{star}.csv.gz"),
   184	                str(replay_dir / f"{star}.json"),
   185	                str(work_dir),
