     9	import numpy as np
    10	import pandas as pd
    11	from astropy.timeseries import LombScargle
    12	from scipy.signal import find_peaks
    13	
    14	SIDEREAL_FREQUENCY = 1.00273790935
    15	SAMPLES_PER_PEAK = 10
    16	WINDOW_POWER_THRESHOLD = 0.1
    17	FAST_KWDS = {"trig_sum_kwds": {"eps": 1e-6}}
    18	
    19	
    20	@dataclass(frozen=True)
    21	class FrequencyGrid:
    22	    minimum: float
    23	    maximum: float
    24	    step: float
    25	    size: int
    26	
    27	    @classmethod
    28	    def create(cls, minimum: float, maximum: float, baseline: float) -> "FrequencyGrid":
    29	        step = 1.0 / (SAMPLES_PER_PEAK * baseline)
    30	        size = int(math.floor((maximum - minimum) / step)) + 1
    31	        return cls(minimum, maximum, step, size)
    32	
    33	    def values(self, start: int = 0, stop: int | None = None) -> np.ndarray:
    34	        stop = self.size if stop is None else min(stop, self.size)
    35	        return self.minimum + self.step * np.arange(start, stop, dtype=np.float64)
