   258	                            "frequency_per_day": mode.frequency_per_day,
   259	                            "amp_tess_ppt": mode.amp_tess_ppt,
   260	                            "tess_sinc": mode.tess_sinc,
   261	                            "ztf_sinc": mode.ztf_sinc,
   262	                            "amp_g_mag": mode.amp_g_mag,
   263	                            "amp_r_mag": mode.amp_r_mag,
   264	                            "phase_rad": mode.phase_rad,
   265	                        })
   266	                    for rejected in model.rejected:
   267	                        rejected_rows.append({"campaign_id": sid, **rejected})
   268	                    manifest.append({
   269	                        "campaign_id": sid, "arm": "A" if gaussian else "B",
   270	                        "tic": int(target.tic), "template_source_id": template_id,
   271	                        "template_status": stats.set_index("source_id")["blind_status"].get(template_id, ""),
   272	                        "template_k": k, "ratio_g": g, "ratio_rg": r,
   273	                        "phase_draw": phase_draw, "amp_scale": amp_scale,
   274	                        "match": match_label,
   275	                        "control_campaign_id": control_id(template_id) if not gaussian else "",
   276	                        "n_modes_injected": len(model.modes),
   277	                        "n_modes_rejected": len(model.rejected),
   278	                    })
   279	        print(f"[d2-shards] TIC {target.tic}: {len(manifest)} shards so far", flush=True)
   280	
   281	    if "ctrl" in arms:
   282	        used = sorted({
   283	            row["template_source_id"] for row in manifest if row["arm"] == "B"
   284	        })
   285	        null_model = build_truth_model(0, [], [], 120.0)
   286	        for template_id in used:
   287	            sid = control_id(template_id)
   288	            shard = frames[template_id].copy()
   289	            shard["source_id"] = sid
   290	            write_shard(args.out_dir / f"{sid}.csv.gz", shard)
