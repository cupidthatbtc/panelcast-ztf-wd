    83	
    84	def shard_sha256(path: Path) -> str:
    85	    return hashlib.sha256(path.read_bytes()).hexdigest()
    86	
    87	
    88	def env_digest() -> str:
    89	    return hashlib.sha256(
    90	        json.dumps(env_versions(), sort_keys=True).encode()
    91	    ).hexdigest()
    92	
    93	
    94	def provenance_path(star_dir: Path, source_id: str) -> Path:
    95	    return star_dir / f"{source_id}.prov.json"
    96	
    97	
    98	def write_provenance(star_dir: Path, source_id: str, shard: Path) -> None:
    99	    provenance_path(star_dir, source_id).write_text(
   100	        json.dumps({
   101	            "shard_sha256": shard_sha256(shard),
   102	            "env_digest": env_digest(),
   103	            "driver": "run_generalization_ls.py",
   104	        }, indent=2) + "\n",
   105	        encoding="utf-8",
   106	    )
   107	
   108	
   109	def scan_pending(shard_dir: Path, star_dir: Path, passes: tuple[str, ...],
   110	                 only: set[str] | None, limit: int | None) -> tuple[list[str], int]:
   111	    """A completed result is reused ONLY when its provenance sidecar matches
   112	    the current shard content and environment (G1 methods finding 8); stale
   113	    results are DELETED so analyze_star's internal early-return cannot
   114	    resurrect them."""
   115	    source_ids = sorted(path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz"))
   116	    if only is not None:
   117	        missing = only - set(source_ids)
   118	        if missing:
   119	            raise SystemExit(f"requested stars absent from shards: {sorted(missing)[:5]}...")
   120	        source_ids = [sid for sid in source_ids if sid in only]
   121	    if limit is not None:
   122	        source_ids = source_ids[:limit]
   123	    current_env = env_digest()
   124	    pending = []
   125	    for source_id in source_ids:
   126	        result_path = star_dir / f"{source_id}.json"
   127	        prov_file = provenance_path(star_dir, source_id)
   128	        if result_path.exists() and prov_file.exists():
   129	            try:
   130	                result = json.loads(result_path.read_text(encoding="utf-8"))
   131	                prov = json.loads(prov_file.read_text(encoding="utf-8"))
   132	                if (
   133	                    result.get("complete")
   134	                    and set(result.get("passes", {})) >= set(passes)
   135	                    and prov.get("shard_sha256")
   136	                    == shard_sha256(shard_dir / f"{source_id}.csv.gz")
   137	                    and prov.get("env_digest") == current_env
   138	                ):
   139	                    continue
   140	            except json.JSONDecodeError:
   141	                pass
   142	        result_path.unlink(missing_ok=True)
   143	        prov_file.unlink(missing_ok=True)
   144	        pending.append(source_id)
   145	    return pending, len(source_ids)
   146	
   147	
   148	def write_progress(path: Path, payload: dict) -> None:
   149	    temporary = path.with_suffix(".json.part")
   150	    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
   151	    temporary.replace(path)
   152	
   153	
   154	def main() -> None:
   155	    parser = argparse.ArgumentParser(description=__doc__)
   156	    parser.add_argument("--shard-dir", type=Path, required=True)
   157	    parser.add_argument("--out-dir", type=Path, required=True)
   158	    parser.add_argument("--work-root", type=Path, default=None,
   159	                        help="scratch for periodogram memmaps; put on local NVMe "
   160	                             "or a RAM disk, NEVER inside a synced folder")
   161	    parser.add_argument("--dataset", required=True,
   162	                        help="manifest label, e.g. d3-kepler-dsct or d2-tess-dav")
   163	    parser.add_argument("--workers", type=int, default=None)
   164	    parser.add_argument("--passes", default="low,high")
   165	    parser.add_argument("--stars-file", type=Path, default=None,
   166	                        help="optional newline-separated campaign_id subset (a shard)")
   167	    parser.add_argument("--limit", type=int, default=None,
   168	                        help="pilot mode: first N stars only")
   169	    parser.add_argument("--expect-count", type=int, default=None,
   170	                        help="assert the shard dir holds exactly N shards "
   171	                             "(stale-directory guard)")
   172	    parser.add_argument("--allow-nonstandard-ids", action="store_true",
   173	                        help="permit non-campaign source_ids (replay/debug only)")
   174	    parser.add_argument("--replay-report", type=Path, required=True,
   175	                        help="replay_report.json from a PASSING replay_gate run "
   176	                             "on THIS machine+env; campaign runs refuse to start "
   177	                             "without one (G1 methods finding 1)")
   178	    args = parser.parse_args()
   179	
   180	    assert_frozen()
   181	    campaign_shas_start = campaign_file_shas()
   182	    attestation = validate_attestation(args.replay_report)
   183	    passes = tuple(args.passes.split(","))
   184	    if passes != ("low", "high") and not args.allow_nonstandard_ids:
   185	        raise SystemExit("production runs use exactly low,high (the frozen CLI's "
   186	                         "pass set); pass --allow-nonstandard-ids for debug runs")
   187	    star_dir = args.out_dir / "stars"
   188	    work_root = args.work_root or (args.out_dir / "work")
   189	    star_dir.mkdir(parents=True, exist_ok=True)
   190	    work_root.mkdir(parents=True, exist_ok=True)
   191	
   192	    if args.expect_count is not None:
   193	        found = len(list(args.shard_dir.glob("*.csv.gz")))
   194	        if found != args.expect_count:
   195	            raise SystemExit(
   196	                f"shard dir holds {found} shards, expected {args.expect_count} "
   197	                f"— stale or incomplete directory"
   198	            )
   199	    only = None
   200	    if args.stars_file:
   201	        only = {line.strip() for line in args.stars_file.read_text().splitlines() if line.strip()}
   202	    pending, total = scan_pending(args.shard_dir, star_dir, passes, only, args.limit)
   203	
   204	    if not args.allow_nonstandard_ids:
   205	        bad = [sid for sid in pending if not campaign_id_ok(sid)]
   206	        if bad:
   207	            raise SystemExit(
   208	                f"{len(bad)} shard ids violate the campaign 19-digit prefix "
   209	                f"convention (first: {bad[:3]}); refusing to run"
   210	            )
   211	
   212	    workers, free_gb = preflight_workers(args.workers, work_root)
   213	    print(
   214	        f"[{args.dataset}] sources={total:,} pending={len(pending):,} "
   215	        f"workers={workers} (free {free_gb:.0f} GB on scratch)",
   216	        flush=True,
   217	    )
   218	
   219	    progress_path = args.out_dir / "progress.json"
   220	    started = time.time()
   221	    failures: dict[str, str] = {}
   222	    completed_now = 0
   223	
   224	    def progress_payload() -> dict:
   225	        elapsed = time.time() - started
   226	        rate = completed_now / elapsed if elapsed > 0 else 0.0
   227	        return {
   228	            "dataset": args.dataset,
   229	            "total": total,
   230	            "pending_at_start": len(pending),
   231	            "completed_now": completed_now,
   232	            "failed": len(failures),
   233	            "elapsed_seconds": round(elapsed, 1),
   234	            "stars_per_hour": round(rate * 3600.0, 2),
   235	            "eta_hours": round((len(pending) - completed_now - len(failures)) / (rate * 3600.0), 2)
   236	            if rate > 0
   237	            else None,
   238	            "workers": workers,
   239	        }
   240	
   241	    write_progress(progress_path, progress_payload())
   242	    with ProcessPoolExecutor(max_workers=workers) as executor:
   243	        futures = {
   244	            executor.submit(
   245	                analyze_star,
   246	                source_id,
   247	                str(args.shard_dir / f"{source_id}.csv.gz"),
   248	                str(star_dir / f"{source_id}.json"),
   249	                str(work_root),
   250	                passes,
   251	            ): source_id
   252	            for source_id in pending
   253	        }
   254	        for future in as_completed(futures):
   255	            source_id = futures[future]
   256	            try:
   257	                future.result()
   258	                write_provenance(star_dir, source_id,
   259	                                 args.shard_dir / f"{source_id}.csv.gz")
   260	                completed_now += 1
   261	            except Exception as exc:
   262	                failures[source_id] = repr(exc)
   263	                print(f"[{args.dataset}] FAILED {source_id}: {exc}", flush=True)
   264	            if completed_now % 10 == 0 or completed_now + len(failures) == len(pending):
   265	                write_progress(progress_path, progress_payload())
   266	                print(
   267	                    f"[{args.dataset}] {completed_now:,}/{len(pending):,} "
   268	                    f"({progress_payload()['stars_per_hour']}/h)",
   269	                    flush=True,
   270	                )
   271	
   272	    manifest = {
   273	        "dataset": args.dataset,
   274	        "driver": "run_generalization_ls.py",
   275	        "source_count": total,
   276	        "pending_at_start": len(pending),
   277	        "completed_now": completed_now,
   278	        "failures": failures,
   279	        "passes": list(passes),
   280	        "workers": workers,
   281	        "wall_seconds": round(time.time() - started, 1),
   282	        "shard_dir": str(args.shard_dir),
   283	        "env": env_versions(),
   284	        "frozen_sha256": assert_frozen(),
   285	        "campaign_sha256": campaign_file_shas(),
   286	        "replay_attestation": {
   287	            "path": str(args.replay_report),
   288	            "wall_seconds": attestation.get("wall_seconds"),
   289	            "verdict_counts": attestation.get("verdict_counts"),
   290	        },
   291	    }
   292	    if campaign_file_shas() != campaign_shas_start:
   293	        raise SystemExit("campaign code changed mid-run — results void")
   294	    (args.out_dir / "manifest.json").write_text(
   295	        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
   296	    )
   297	    write_progress(progress_path, progress_payload())
   298	    print(f"[{args.dataset}] done: {completed_now:,} completed, {len(failures)} failed", flush=True)
   299	    if failures:
   300	        raise SystemExit(1)
   301	
   302	
   303	if __name__ == "__main__":
   304	    main()

