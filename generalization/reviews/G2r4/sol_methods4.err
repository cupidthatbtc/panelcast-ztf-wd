     1	#!/usr/bin/env python3
     2	"""Replay gate: reproduce published 2026-08-01 per-star results byte-for-byte.
     3	
     4	Re-runs the frozen `analyze_star` (imported through frozen_api, exactly as the
     5	campaign driver will) on a deterministic sample of published stars and compares
     6	the fresh output against the committed bundle files.
     7	
     8	Comparison tiers, strongest first:
     9	  identical                  raw bytes equal
    10	  identical_newline          equal after CRLF->LF normalization (git stored the
    11	                             bundle newline-normalized; Windows writes CRLF)
    12	  identical_v1_schema        equal after the documented v1->v2 schema transform:
    13	                             the run that produced 921/928 published files
    14	                             predates commit fa16d7f, which added sparse-input
    15	                             early-exit branches plus the `available`/
    16	                             `unavailable_reason` keys and bumped schema_version
    17	                             1->2; for any star that yields candidates the
    18	                             numeric path is unchanged (the new branches fire
    19	                             only on sparse inputs that previously crashed).
    20	                             The replayed output is re-serialized with
    21	                             schema_version=1 and those two keys dropped, then
    22	                             byte-compared against the published file.
    23	  MISMATCH                   anything else; the first differing JSON path is
    24	                             reported. The gate FAILS.
    25	
    26	The gate passes only if every sampled star lands in one of the identical tiers
    27	AND at least one schema-v2 star reproduces with no transform (proving full-byte
    28	reproduction of the final script's output). Campaign L-S runs are valid only on
    29	machine+env combinations where this gate has passed.
    30	"""
    31	
    32	from __future__ import annotations
    33	
    34	import argparse
    35	import json
    36	import time
    37	from concurrent.futures import ProcessPoolExecutor, as_completed
    38	from pathlib import Path
    39	
    40	from frozen_api import (
    41	    REPO_ROOT,
    42	    analyze_star,
    43	    assert_frozen,
    44	    campaign_file_shas,
    45	    env_versions,
    46	    json_ready,
    47	    physical_workers,
    48	)
    49	
    50	PUBLISHED_STARS = (
    51	    REPO_ROOT / "catalog-rebuild/results/2026-08-01_full/lomb-scargle/stars"
    52	)
    53	
    54	
    55	def normalize(raw: bytes) -> bytes:
    56	    return raw.replace(b"\r\n", b"\n")
    57	
    58	
    59	def schema_v1_bytes(replayed: dict) -> bytes:
    60	    downgraded = dict(replayed)
    61	    downgraded["schema_version"] = 1
    62	    downgraded["passes"] = {
    63	        name: {
    64	            key: value
    65	            for key, value in pass_result.items()
    66	            if key not in ("available", "unavailable_reason")
    67	        }
    68	        for name, pass_result in replayed["passes"].items()
    69	    }
    70	    text = json.dumps(downgraded, indent=2, default=json_ready) + "\n"
    71	    return text.encode("utf-8")
    72	
    73	
    74	def first_difference(published: object, replayed: object, path: str = "$") -> str:
    75	    if type(published) is not type(replayed):
    76	        return f"{path}: type {type(published).__name__} != {type(replayed).__name__}"
    77	    if isinstance(published, dict):
    78	        for key in sorted(set(published) | set(replayed)):
    79	            if key not in published:
    80	                return f"{path}.{key}: only in replay"
    81	            if key not in replayed:
    82	                return f"{path}.{key}: only in published"
    83	            diff = first_difference(published[key], replayed[key], f"{path}.{key}")
    84	            if diff:
    85	                return diff
    86	        return ""
    87	    if isinstance(published, list):
    88	        if len(published) != len(replayed):
    89	            return f"{path}: length {len(published)} != {len(replayed)}"
    90	        for index, (left, right) in enumerate(zip(published, replayed)):
    91	            diff = first_difference(left, right, f"{path}[{index}]")
    92	            if diff:
    93	                return diff
    94	        return ""
    95	    if published != replayed:
    96	        return f"{path}: {published!r} != {replayed!r}"
    97	    return ""
    98	
    99	
   100	def published_schema_version(path: Path) -> int:
   101	    return int(json.loads(path.read_text(encoding="utf-8"))["schema_version"])
   102	
   103	
   104	def select_stars(published_dir: Path, shard_dir: Path, count: int) -> list[str]:
   105	    available = {
   106	        path.name.split(".csv")[0] for path in shard_dir.glob("*.csv.gz")
   107	    }
   108	    stars = sorted(
   109	        path.stem
   110	        for path in published_dir.glob("*.json")
   111	        if not path.name.endswith(".error.json") and path.stem in available
   112	    )
   113	    if not stars:
   114	        raise SystemExit(f"no published stars have shards in {shard_dir}")
   115	    v2 = [star for star in stars if published_schema_version(published_dir / f"{star}.json") == 2]
   116	    v1 = [star for star in stars if star not in set(v2)]
   117	    selected = list(v2)[:count]
   118	    remaining = count - len(selected)
   119	    if remaining > 0 and v1:
   120	        stride = max(1, len(v1) // remaining)
   121	        selected.extend(v1[::stride][:remaining])
   122	    return sorted(selected)
   123	
   124	
   125	def compare_star(star: str, published_dir: Path, replay_dir: Path) -> dict[str, object]:
   126	    published_path = published_dir / f"{star}.json"
   127	    replay_path = replay_dir / f"{star}.json"
   128	    published_raw = published_path.read_bytes()
   129	    replay_raw = replay_path.read_bytes()
   130	    record: dict[str, object] = {
   131	        "source_id": star,
   132	        "published_schema_version": published_schema_version(published_path),
   133	    }
   134	    if published_raw == replay_raw:
   135	        record["verdict"] = "identical"
   136	        return record
   137	    published_norm = normalize(published_raw)
   138	    replay_norm = normalize(replay_raw)
   139	    if published_norm == replay_norm:
   140	        record["verdict"] = "identical_newline"
   141	        return record
   142	    replayed = json.loads(replay_norm.decode("utf-8"))
   143	    if normalize(schema_v1_bytes(replayed)) == published_norm:
   144	        record["verdict"] = "identical_v1_schema"
   145	        return record
   146	    record["verdict"] = "MISMATCH"
   147	    record["first_difference"] = first_difference(
   148	        json.loads(published_norm.decode("utf-8")), replayed
   149	    )
   150	    return record
   151	
   152	
   153	def main() -> None:
   154	    parser = argparse.ArgumentParser(description=__doc__)
   155	    parser.add_argument("--shard-dir", type=Path, required=True,
   156	                        help="directory of <source_id>.csv.gz exposure shards")
   157	    parser.add_argument("--published-stars", type=Path, default=PUBLISHED_STARS)
   158	    parser.add_argument("--out-dir", type=Path,
   159	                        default=REPO_ROOT / "outputs/generalization/replay_gate")
   160	    parser.add_argument("--count", type=int, default=25)
   161	    parser.add_argument("--stars", nargs="*", help="explicit star list (overrides --count)")
   162	    parser.add_argument("--workers", type=int, default=None)
   163	    args = parser.parse_args()
   164	
   165	    assert_frozen()
   166	    workers = args.workers or physical_workers()
   167	    replay_dir = args.out_dir / "stars"
   168	    work_dir = args.out_dir / "work"
   169	    replay_dir.mkdir(parents=True, exist_ok=True)
   170	    work_dir.mkdir(parents=True, exist_ok=True)
   171	
   172	    stars = args.stars or select_stars(args.published_stars, args.shard_dir, args.count)
   173	    missing = [s for s in stars if not (args.shard_dir / f"{s}.csv.gz").exists()]
   174	    if missing:
   175	        raise SystemExit(f"missing shards for: {missing}")
   176	    for star in stars:
   177	        (replay_dir / f"{star}.json").unlink(missing_ok=True)
   178	
   179	    print(f"[replay] {len(stars)} stars, workers={workers}", flush=True)
   180	    started = time.time()
   181	    durations: dict[str, float] = {}
   182	    with ProcessPoolExecutor(max_workers=workers) as executor:
   183	        futures = {
   184	            executor.submit(
   185	                analyze_star,
   186	                star,
   187	                str(args.shard_dir / f"{star}.csv.gz"),
   188	                str(replay_dir / f"{star}.json"),
   189	                str(work_dir),
   190	                ("low", "high"),
   191	            ): (star, time.time())
   192	            for star in stars
   193	        }
   194	        for future in as_completed(futures):
   195	            star, _ = futures[future]
   196	            future.result()
   197	            durations[star] = round(time.time() - started, 1)
   198	            print(f"[replay] finished {star} (+{durations[star]}s)", flush=True)
   199	
   200	    records = [compare_star(star, args.published_stars, replay_dir) for star in stars]
   201	    verdicts = {record["source_id"]: record["verdict"] for record in records}
   202	    counts: dict[str, int] = {}
   203	    for verdict in verdicts.values():
   204	        counts[verdict] = counts.get(verdict, 0) + 1
   205	    if not records:
