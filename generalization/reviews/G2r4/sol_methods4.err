   213	        picks, match_label = match_templates(stats, float(target.gmag))
   214	        variants = []
   215	        if "b" in arms or "a" in arms:
   216	            variants.append((*nominal, (0, 1, 2)))
   217	        if "ladder" in arms:
   218	            variants.extend((gi, ri, g, r, (1,)) for gi, ri, g, r in ladder
   219	                            if not (g == NOMINAL_G and r == NOMINAL_RG))
   220	        if "phase" in arms:
   221	            variants.extend((nominal[0], nominal[1], nominal[2], nominal[3], (1,),
   222	                             d, 1.0) for d in (1, 2))
   223	        if "ampscale" in arms:
   224	            variants.extend((nominal[0], nominal[1], nominal[2], nominal[3], (1,),
   225	                             0, sc) for sc in (0.7, 1.3))
   226	        for entry in variants:
   227	            gi, ri, g, r, template_ks = entry[:5]
   228	            phase_draw = entry[5] if len(entry) > 5 else 0
   229	            amp_scale = entry[6] if len(entry) > 6 else 1.0
   230	            model = build_truth_model(
   231	                int(target.tic), periods, amps, float(target.cadence_s),
   232	                ratio_g=g, ratio_rg=r, amplitude_scale=amp_scale,
   233	                phase_draw=phase_draw,
   234	            )
   235	            for k in template_ks:
   236	                template_id = picks[k]
   237	                template = frames[template_id]
   238	                arm_list = []
   239	                nominal_scenario = (g == NOMINAL_G and r == NOMINAL_RG
   240	                                    and phase_draw == 0 and amp_scale == 1.0)
   241	                if nominal_scenario:
   242	                    if "b" in arms:
   243	                        arm_list.append(("92", False))
   244	                    if "a" in arms:
   245	                        arm_list.append(("93", True))
   246	                else:
   247	                    arm_list.append(("92", False))
   248	                for prefix, gaussian in arm_list:
   249	                    sid = campaign_id(prefix, int(target.tic), k, gi, ri,
   250	                                      phase_draw, amp_scale)
   251	                    if not campaign_id_ok(sid):
   252	                        raise SystemExit(f"bad campaign id {sid}")
   253	                    shard = synthesize(template, model, sid, gaussian, seed=int(sid[2:]))
   254	                    write_shard(args.out_dir / f"{sid}.csv.gz", shard)
   255	                    for mode in model.modes:
   256	                        injected_rows.append({
