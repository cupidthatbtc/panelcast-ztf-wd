    42	        x = range(len(subset))
    43	        axis.errorbar(
    44	            x, subset["p"],
    45	            yerr=[subset["p"] - subset["lo"], subset["hi"] - subset["p"]],
    46	            fmt="o", color=INK, ecolor=ACCENT, capsize=3, markersize=5,
    47	        )
    48	        for i, (_, row) in enumerate(subset.iterrows()):
    49	            if row["n"] > 0:
    50	                axis.annotate(f"n={int(row['n'])}", (i, 0.02), ha="center", fontsize=7,
    51	                              color=INK)
    52	        axis.set_xticks(list(x))
    53	        labels = {"confirmed": "confirmed", "confirmed_or_candidate": "conf. |\ncand.",
    54	                  "census": "census", "either": "either"}
    55	        axis.set_xticklabels([labels.get(r, r) for r in subset.index], fontsize=7)
    56	        axis.set_title(scope.replace("_", " "), fontsize=9)
    57	        axis.set_ylim(0, 1.05)
    58	        axis.axhline(1.0, color=MUTED, linewidth=0.8, linestyle=":")
    59	        style(axis)
