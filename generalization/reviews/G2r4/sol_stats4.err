   495	def surface_cells(frame: pd.DataFrame, success: pd.Series,
   496	                  x_values: pd.Series, edges: list[float],
   497	                  x_name: str) -> list[dict]:
   498	    """Half-open [lo, hi) bins; bin 0 = underflow, bin len(edges) = overflow;
   499	    NaN x -> bin -1 ("unknown"). Cells below MIN_CELL: counts only."""
   500	    bins = np.where(np.isfinite(x_values), np.digitize(x_values, edges), -1)
   501	    rows = []
   502	    for b, idx in frame.groupby(bins).groups.items():
   503	        k = int(success.loc[idx].sum())
   504	        n = len(idx)
   505	        entry = {x_name: int(b), "n": n, "k": k}
   506	        if n >= MIN_CELL:
   507	            entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   508	        rows.append(entry)
   509	    return rows
   510	
