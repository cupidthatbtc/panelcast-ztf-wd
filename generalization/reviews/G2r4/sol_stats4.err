   434	def d2_cluster_bootstrap(per_star: pd.DataFrame) -> pd.DataFrame:
   435	    """P4 machinery: per (scenario, endpoint), per-stratum rates and the
   436	    equal-weight (1/3 per K stratum) scenario-standardized mean over targets;
   437	    COMMON RANDOM NUMBERS — one resample-index matrix shared by every
   438	    scenario; degenerate statistics fall back to target-level exact CP."""
   439	    if "arm" not in per_star:
   440	        return pd.DataFrame()
   441	    frame = per_star[per_star["arm"].isin(["A", "B"])]
   442	    if frame.empty:
   443	        return pd.DataFrame()
   444	    clusters = np.array(sorted(frame["cluster"].unique()))
   445	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED))
   446	    draws = rng.integers(0, len(clusters), size=(BOOTSTRAP_B, len(clusters)))
   447	    rows = []
   448	    endpoints = {
   449	        "detection": lambda f: f["best_status"] == "confirmed",
   450	        "freq_recovery": lambda f: (f["best_status"] == "confirmed")
   451	        & (f["best_match"] == "direct"),
   452	    }
   453	    scenario_cols = ["arm", "ratio_g", "ratio_rg"]
   454	    for extra in ("phase_draw", "amp_scale"):
   455	        if extra in frame:
   456	            scenario_cols.append(extra)
   457	    for keys, scenario in frame.groupby(scenario_cols):
   458	        arm, g, r = keys[0], keys[1], keys[2]
   459	        for endpoint, predicate in endpoints.items():
   460	            success = predicate(scenario)
   461	            # per (target, stratum) rates, then equal-weight stratum mean
   462	            per_ts = success.groupby(
   463	                [scenario["cluster"], scenario["template_k"]]).mean()
   464	            per_target = per_ts.groupby(level=0).mean()
   465	            aligned = per_target.reindex(clusters)
   466	            observed = aligned.dropna()
   467	            if observed.empty:
   468	                continue
   469	            point = float(observed.mean())
   470	            values = aligned.to_numpy(dtype=float)
   471	            boots = []
   472	            for b in range(BOOTSTRAP_B):
   473	                sample = values[draws[b]]
   474	                sample = sample[~np.isnan(sample)]
   475	                if sample.size:
   476	                    boots.append(float(sample.mean()))
   477	            target_hits = observed.round(6)
   478	            degenerate = (target_hits == 0).all() or (target_hits == 1).all()
   479	            if degenerate:
   480	                k_deg = int((target_hits == 1).sum())
   481	                lo, hi = cp_one_sided_bounds(k_deg, len(observed))
   482	            else:
   483	                lo = float(np.quantile(boots, 0.025))
   484	                hi = float(np.quantile(boots, 0.975))
   485	            rows.append({
   486	                "arm": arm, "ratio_g": g, "ratio_rg": r, "endpoint": endpoint,
   487	                "n_targets": int(len(observed)),
   488	                "n_strata_mean": float(per_ts.groupby(level=0).size().mean()),
   489	                "p": point, "lo": lo, "hi": hi,
   490	                "interval": "cp_one_sided" if degenerate else "cluster_bootstrap",
   491	            })
   492	    return pd.DataFrame(rows)
