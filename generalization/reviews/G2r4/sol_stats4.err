   647	def sensitivity_table(per_star: pd.DataFrame, dataset: str,
   648	                      crossmatch_qc: pd.DataFrame | None) -> pd.DataFrame:
   649	    rows = []
   650	
   651	    def rate(frame: pd.DataFrame, label: str, variant: str) -> None:
   652	        if frame.empty:
   653	            return
   654	        success = (frame["best_status"] == "confirmed")
   655	        rows.append({"variant": variant, "subset": label,
   656	                     "n": len(frame), "k": int(success.sum()),
   657	                     **dict(zip(("p", "lo", "hi"), wilson(int(success.sum()), len(frame))))})
   658	
   659	    if dataset == "d2" and "arm" in per_star:
   660	        # common-subset rule: nominal recomputed on the SAME median-window
   661	        # (k=1) subset used by every non-nominal scenario
   662	        median_b = per_star[(per_star["arm"] == "B") & (per_star["template_k"] == 1)]
   663	        group_cols = ["ratio_g", "ratio_rg"]
   664	        for extra in ("phase_draw", "amp_scale"):
   665	            if extra in median_b:
   666	                group_cols.append(extra)
   667	        for keys, scenario in median_b.groupby(group_cols):
   668	            label = "_".join(f"{c}{v}" for c, v in zip(group_cols, keys))
   669	            rate(scenario, "arm_b_median_window", label)
   670	    if dataset == "d3":
   671	        positives = per_star[(per_star["label_positive"] == True)  # noqa: E712
   672	                             & (per_star["best_status"] != "missing")]
   673	        if "near_saturation" in positives:
   674	            rate(positives[positives["near_saturation"] == True], "positives", "near_saturation")  # noqa: E712
   675	            rate(positives[positives["near_saturation"] == False], "positives", "safe_magnitude")  # noqa: E712
   676	        if crossmatch_qc is not None:
   677	            qc = crossmatch_qc.set_index("source_id")
   678	            joined = positives.join(
   679	                qc[["nearest_separation_arcsec", "ztf_objects_in_cone"]], on="sid")
   680	            clean = joined[(joined["nearest_separation_arcsec"] < 1.0)
   681	                           & (joined["ztf_objects_in_cone"] <= 3)]
   682	            rate(clean, "positives", "crowding_clean")
   683	    return pd.DataFrame(rows)
