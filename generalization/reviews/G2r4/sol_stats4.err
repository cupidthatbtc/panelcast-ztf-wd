   634	def fp_frequency_distribution(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   635	    if dataset == "d3":
   636	        pool = per_star[per_star["class_label"] == "dsct_flag0"]
   637	    elif dataset == "d2" and "arm" in per_star:
   638	        pool = per_star[per_star["arm"].isin(["null", "ctrl"])]
   639	    else:
   640	        pool = per_star.iloc[0:0]
   641	    triggered = pool[pool["best_status"].isin(["confirmed", "candidate"])]
   642	    columns = ["sid", "class_label", "best_status", "best_pass",
   643	               "best_frequency_per_day", "baseline_days"]
   644	    return triggered[[c for c in columns if c in triggered.columns]]
