    60	
    61	def wilson(k: float, n: float) -> tuple[float, float, float]:
    62	    if n <= 0:
    63	        return math.nan, math.nan, math.nan
    64	    z = 1.959963984540054
    65	    p = k / n
    66	    denom = 1.0 + z * z / n
    67	    center = (p + z * z / (2 * n)) / denom
    68	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    69	    return p, max(0.0, center - half), min(1.0, center + half)
    70	
    71	
    72	def weighted_wilson(successes: np.ndarray, weights: np.ndarray) -> dict:
    73	    total = float(weights.sum())
    74	    if total <= 0:
    75	        return {"n": 0, "ess": 0.0, "p": math.nan, "lo": math.nan, "hi": math.nan}
    76	    p = float((weights * successes).sum() / total)
    77	    ess = total * total / float((weights * weights).sum())
    78	    _, lo, hi = wilson(p * ess, ess)
    79	    return {"n": int(len(successes)), "ess": round(ess, 1), "p": p, "lo": lo, "hi": hi}
    80	
    81	
    82	def classify_match(freq: float, truth: list[float], tol: float) -> str:
    83	    """Evaluate EVERY (truth mode, relation) predicate — no short-circuit
    84	    (spec: hits in more than one relation class -> ambiguous)."""
    85	    classes: set[str] = set()
    86	    for f_t in truth:
    87	        if abs(freq - f_t) <= tol:
    88	            classes.add("direct")
    89	        if abs(freq - 2.0 * f_t) <= tol or abs(freq - 0.5 * f_t) <= tol:
    90	            classes.add("harmonic")
    91	        for k in (1, 2):
    92	            for sign in (1.0, -1.0):
    93	                if abs(freq - abs(f_t + sign * k * SIDEREAL_FREQUENCY)) <= tol:
    94	                    classes.add("window_alias")
    95	    if not classes:
    96	        return "unmatched"
    97	    if len(classes) > 1:
    98	        return "ambiguous"
    99	    return classes.pop()
   100	
   101	
   102	def pass_eligible(truth: list[float], pass_name: str, baseline: float) -> bool:
   103	    if not truth:
   104	        return False
   105	    low, high = (2.0 / baseline, 48.0) if pass_name == "low" else (24.0, 1440.0)
   106	    return any(low <= f <= high for f in truth)
   107	
   108	
   109	def rule_fired(rule: str, status: str, census_flag) -> bool | None:
   110	    if status == "missing":
   111	        # no usable light curve: unconditionally a non-detection under every
   112	        # rule in the eligible-roster estimand
   113	        return False
   114	    if rule == "confirmed":
   115	        return status == "confirmed"
   116	    if rule == "confirmed_or_candidate":
   117	        return status in ("confirmed", "candidate")
   118	    if rule == "census":
   119	        return None if census_flag is None else bool(census_flag)
   120	    if rule == "either":
   121	        if census_flag is None:
   122	            return status == "confirmed"
   123	        return status == "confirmed" or bool(census_flag)
   124	    raise ValueError(rule)
   125	
   126	
   127	def score_star(json_path: Path, truth_freqs: list[float], primary_freq: float | None,
   128	               truth_quantum: float = 0.0) -> dict:
   129	    result = json.loads(json_path.read_text(encoding="utf-8"))
   130	    if not result.get("complete"):
   131	        raise SystemExit(f"{json_path} is not complete")
   132	    passes = result["passes"]
   133	    if set(passes) != {"low", "high"}:
   134	        raise SystemExit(f"{json_path} passes {set(passes)} != low/high")
   135	    baseline = float(result["baseline_days"])
   136	    tol = 1.5 / baseline + truth_quantum
   137	    overall = overall_result(result)
   138	
   139	    row: dict = {
