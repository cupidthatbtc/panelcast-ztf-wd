   242	            "freq_scorable": bool(truth) and bool(label),
   243	            "stratum": r.stratum, "near_saturation": bool(r.near_saturation),
   244	            "subhour": bool(r.subhour),
   245	        })
   246	    return pd.DataFrame(rows)
   247	
   248	
   249	def truth_d2(shards_dir: Path) -> pd.DataFrame:
   250	    """Truth from injected_modes.csv — the ACTUALLY injected (post-sinc-
   251	    rejection) mode set per shard, never the original mode table (G2 methods
   252	    finding 4)."""
   253	    manifest = pd.read_csv(shards_dir / "shard_manifest.csv",
   254	                           dtype={"campaign_id": str, "template_source_id": str})
   255	    injected = pd.read_csv(shards_dir / "injected_modes.csv",
   256	                           dtype={"campaign_id": str})
   257	    freq_lists = injected.groupby("campaign_id")["frequency_per_day"].apply(
   258	        lambda g: sorted(g.tolist())).to_dict()
   259	    dominant = {}
   260	    amp_dom = {}
   261	    for sid, group in injected.groupby("campaign_id"):
   262	        best = group.loc[group["amp_tess_ppt"].idxmax()]
   263	        dominant[sid] = float(best["frequency_per_day"])
   264	        amp_dom[sid] = float(best["amp_tess_ppt"])
   265	    rows = []
   266	    for r in manifest.itertuples(index=False):
   267	        arm = r.arm
   268	        tic = int(r.tic)
   269	        sid = r.campaign_id
   270	        truth = freq_lists.get(sid, []) if arm in ("A", "B") else []
   271	        rows.append({
   272	            "sid": sid, "external_id": f"TIC {tic}" if tic else r.template_source_id,
   273	            "class_label": f"arm_{arm}",
   274	            "label_positive": arm in ("A", "B"),
   275	            "weight": 1.0, "cluster": str(tic) if tic else sid,
   276	            "truth_freqs": truth,
   277	            "primary_freq": dominant.get(sid) if arm in ("A", "B") else None,
   278	            "amp": float(amp_dom.get(sid, math.nan)),
   279	            "truth_period_days": (86400.0 / dominant[sid] / 86400.0)
   280	            if sid in dominant and arm in ("A", "B") else math.nan,
   281	            "freq_scorable": arm in ("A", "B") and bool(truth),
   282	            "arm": arm, "template_k": r.template_k,
   283	            "ratio_g": float(r.ratio_g), "ratio_rg": float(r.ratio_rg),
   284	            "phase_draw": int(getattr(r, "phase_draw", 0)),
   285	            "amp_scale": float(getattr(r, "amp_scale", 1.0)),
   286	            "template_status": getattr(r, "template_status", ""),
   287	        })
   288	    return pd.DataFrame(rows)
   289	
   290	
   291	# ---------------------------------------------------------- census providers
   292	
   293	def census_lookup_csv(path: Path) -> dict[str, dict]:
   294	    frame = pd.read_csv(path, dtype={"source_id": str})
   295	    ratio_cols = [c for c in frame.columns if c.endswith("_ratio")]
   296	    for col in ratio_cols:
   297	        exact = frame[col] == 2.5
   298	        if exact.any():
   299	            raise SystemExit(f"census ratio exactly 2.5 in {path}:{col} — spec guard")
   300	    return {
   301	        r["source_id"]: {"census_variable": bool(r["census_variable"]),
   302	                         "census_g_nightly": bool(r["census_g_nightly"])}
   303	        for _, r in frame.iterrows()
   304	    }
   305	
   306	
   307	def census_from_shard(shard_path: Path) -> dict:
   308	    frame = pd.read_csv(gzip.open(shard_path, "rt"), dtype={"source_id": str, "band": str})
   309	    meta = SimpleNamespace(source_id=frame["source_id"].iloc[0], wdj_name="",
   310	                           gaia_g_mag=math.nan, bp_rp=math.nan, in_core=True,
   311	                           n_variants=0, known_roster=False, wd_class="",
   312	                           paper_variable=None, paper_periodic=None)
   313	    nightly = nightly_panel(frame)
   314	    monthly = monthly_panel(nightly)
   315	    row = census_row(meta, frame, nightly, monthly)
   316	    for key in (f"{b}_{c}_ratio" for b in ("zg", "zr")
   317	                for c in ("exposure", "nightly", "monthly")):
   318	        if row.get(key) == 2.5:
   319	            raise SystemExit(f"census ratio exactly 2.5 for {shard_path} — spec guard")
   320	    return {"census_variable": bool(row["census_variable"]),
   321	            "census_g_nightly": bool(row["census_g_nightly"])}
   322	
   323	
   324	# ------------------------------------------------------------------ aggregates
   325	
   326	def completeness_tables(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   327	    # primary frequency-match column: D3 scores the DOMINANT Mo mode (any-mode
   328	    # is secondary/diagnostic); D2 scores the exact injected list; D1 is
   329	    # diagnostic-only either way (spec).
   330	    use_dominant = dataset in ("d1", "d3")
   331	    rows = []
   332	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   333	    usable = positives[(positives["best_status"] != "missing")
   334	                       & positives["low_available"].fillna(False)
   335	                       & positives["high_available"].fillna(False)]
   336	    for pass_name in PASSES:
   337	        status_col = "best_status" if pass_name == "best" else f"{pass_name}_status"
   338	        match_col = (f"{'best' if pass_name == 'best' else pass_name}_match_primary"
   339	                     if use_dominant
   340	                     else ("best_match" if pass_name == "best" else f"{pass_name}_match"))
   341	        for rule in RULES:
   342	            for scope, frame in (
   343	                ("detection_eligible_roster", positives),
   344	                ("detection_usable_lightcurve", usable),
   345	                ("freq_recovery_scorable", usable[
   346	                    usable["freq_scorable"]
   347	                    & (usable["eligible_any_pass"] if pass_name == "best"
   348	                       else usable[f"{pass_name}_eligible"])
   349	                ]),
   350	            ):
   351	                if scope == "freq_recovery_scorable" and rule in ("census", "either"):
   352	                    continue  # frequency outcomes exist only for L-S rules
   353	                if frame.empty:
   354	                    rows.append({"pass": pass_name, "rule": rule, "scope": scope,
   355	                                 "n": 0, "ess": 0.0, "p": math.nan,
   356	                                 "lo": math.nan, "hi": math.nan})
   357	                    continue
   358	                fired = frame.apply(
   359	                    lambda r: rule_fired(rule, r[status_col], r.get("census_variable")),
   360	                    axis=1,
   361	                )
   362	                ok = fired.notna()
   363	                success = fired[ok].astype(bool)
   364	                if scope == "freq_recovery_scorable":
   365	                    success = success & (frame.loc[ok, match_col] == "direct")
   366	                stats = weighted_wilson(
   367	                    success.to_numpy(dtype=float),
   368	                    frame.loc[ok, "weight"].to_numpy(dtype=float),
   369	                )
   370	                rows.append({"pass": pass_name, "rule": rule, "scope": scope, **stats})
   371	    return pd.DataFrame(rows)
   372	
   373	
   374	def contingency(per_star: pd.DataFrame, dataset: str = "d1") -> dict:
   375	    from scipy.stats import binomtest
   376	    frame = per_star[(per_star["label_positive"] == True)  # noqa: E712
   377	                     & per_star["census_variable"].notna()
   378	                     & (per_star["best_status"] != "missing")]
   379	    C = frame["census_variable"].astype(bool)
   380	    L = frame["best_status"] == "confirmed"
   381	    a, b = int((C & L).sum()), int((C & ~L).sum())
   382	    c, d = int((~C & L).sum()), int((~C & ~L).sum())
   383	    n = len(frame)
   384	    union_p, union_lo, union_hi = wilson(a + b + c, n) if n else (math.nan,) * 3
   385	    out = {
   386	        "n_positives_scored": n,
   387	        "table": {"census_and_ls": a, "census_only": b, "ls_only": c, "neither": d},
   388	        "union_completeness": {"p": union_p, "lo": union_lo, "hi": union_hi},
   389	        "incremental_census_only": dict(zip(("p", "lo", "hi"), wilson(b, n))) if n else {},
   390	        "incremental_ls_only": dict(zip(("p", "lo", "hi"), wilson(c, n))) if n else {},
   391	    }
   392	    if b + c and dataset != "d2":
   393	        out["mcnemar_exact_p_secondary"] = float(
   394	            binomtest(min(b, c), b + c, 0.5).pvalue * 1.0
   395	        )
   396	    if dataset == "d2":
   397	        out["mcnemar"] = "prohibited for d2 (cluster structure); use the target-cluster paired-difference bootstrap"
   398	    return out
   399	
   400	
   401	def chance_match_rate(per_star: pd.DataFrame) -> dict:
   402	    scorable = per_star[per_star["freq_scorable"]
   403	                        & per_star["best_frequency_per_day"].notna()].reset_index()
   404	    if len(scorable) < 3:
   405	        return {"permutations": 0, "note": "fewer than 3 scorable stars"}
   406	    rng = np.random.Generator(np.random.PCG64(CHANCE_MATCH_SEED))
   407	    rates = []
   408	    truth_lists = scorable["truth_freqs"].tolist()
   409	    for _ in range(CHANCE_MATCH_PERMUTATIONS):
   410	        perm = rng.permutation(len(truth_lists))
   411	        hits = 0
   412	        for i, row in scorable.iterrows():
   413	            if perm[i] == i:
   414	                continue
   415	            tol = 1.5 / row["baseline_days"]
   416	            if classify_match(float(row["best_frequency_per_day"]),
   417	                              truth_lists[perm[i]], tol) == "direct":
   418	                hits += 1
   419	        denom = int((np.arange(len(truth_lists)) != perm).sum())
   420	        if denom:
   421	            rates.append(hits / denom)
   422	    return {"permutations": CHANCE_MATCH_PERMUTATIONS,
   423	            "accidental_direct_match_rate_mean": float(np.mean(rates)),
   424	            "accidental_direct_match_rate_p95": float(np.quantile(rates, 0.95))}
   425	
   426	
   427	def cp_one_sided_bounds(k: int, n: int) -> tuple[float, float]:
   428	    from scipy.stats import beta
   429	    lower = float(beta.ppf(0.05, k, n - k + 1)) if k > 0 else 0.0
   430	    upper = float(beta.ppf(0.95, k + 1, n - k)) if k < n else 1.0

