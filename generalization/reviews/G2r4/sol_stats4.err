   512	def surfaces(per_star: pd.DataFrame, dataset: str) -> dict[str, pd.DataFrame]:
   513	    if dataset == "d1":
   514	        return {}  # no amplitude axis for D1 (spec)
   515	    out: dict[str, pd.DataFrame] = {}
   516	    amp_edges = AMP_EDGES[dataset]
   517	    positives = per_star[per_star["label_positive"] == True]  # noqa: E712
   518	    # detection endpoint: ALL positives; unknown-amplitude stars form their
   519	    # own bin (-1) so the 154 unjoined D3 positives stay in the denominator
   520	    detection = positives["best_status"] == "confirmed"
   521	    out["detection_amplitude"] = pd.DataFrame(
   522	        surface_cells(positives, detection, positives["amp"], amp_edges, "amp_bin"))
   523	    # frequency-recovery endpoint: scorable subset only
   524	    use_dominant = dataset in ("d1", "d3")
   525	    scorable = positives[positives["freq_scorable"]]
   526	    if not scorable.empty:
   527	        match_col = "best_match_primary" if use_dominant else "best_match"
   528	        recovery = (scorable["best_status"] == "confirmed") & (
   529	            scorable[match_col] == "direct")
   530	        rows = []
   531	        p_bins = np.digitize(scorable["truth_period_days"], PERIOD_EDGES_DAYS)
   532	        a_bins = np.where(np.isfinite(scorable["amp"]),
   533	                          np.digitize(scorable["amp"], amp_edges), -1)
   534	        for (pb, ab), idx in scorable.groupby([p_bins, a_bins]).groups.items():
   535	            k = int(recovery.loc[idx].sum())
   536	            n = len(idx)
   537	            entry = {"period_bin": int(pb), "amp_bin": int(ab), "n": n, "k": k}
   538	            if n >= MIN_CELL:
   539	                entry.update(dict(zip(("p", "lo", "hi"), wilson(k, n))))
   540	            rows.append(entry)
   541	        out["freq_recovery_period_amplitude"] = pd.DataFrame(rows)
   542	        if "n_exp_zg" in scorable and "baseline_days" in scorable:
   543	            epn = scorable["n_exp_zg"] / scorable["baseline_days"].clip(lower=1)
   544	            out["freq_recovery_exposure_amplitude"] = pd.DataFrame(
   545	                surface_cells(scorable, recovery, epn,
   546	                              EXP_PER_NIGHT_EDGES, "exp_per_night_bin"))
   547	    return out
