   586	def ppv_d3(per_star: pd.DataFrame) -> dict:
   587	    """Frame-specific label PPV: weighted fraction of triggered (rule-1, best
   588	    pass) roster members labeled dSct=1; dSct=2 excluded, reported separately.
   589	    Survey bootstrap: negatives resampled with replacement, positives fixed."""
   590	    frame = per_star[(per_star["best_status"] != "missing")
   591	                     & per_star["class_label"].isin(["dsct_flag0", "dsct_flag1"])]
   592	    triggered = frame[frame["best_status"] == "confirmed"]
   593	    if triggered.empty:
   594	        return {"note": "no triggered stars in the PPV frame"}
   595	    weights = triggered["weight"].to_numpy(dtype=float)
   596	    is_pos = (triggered["class_label"] == "dsct_flag1").to_numpy()
   597	    point = float((weights * is_pos).sum() / weights.sum())
   598	    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_SEED + 1))
   599	    positives = frame[frame["class_label"] == "dsct_flag1"]
   600	    negatives = frame[frame["class_label"] == "dsct_flag0"].reset_index(drop=True)
   601	    boots = []
   602	    for _ in range(BOOTSTRAP_B):
   603	        resampled = negatives.iloc[
   604	            rng.integers(0, len(negatives), size=len(negatives))
   605	        ]
   606	        combined = pd.concat([positives, resampled])
   607	        hit = combined[combined["best_status"] == "confirmed"]
   608	        if hit.empty:
   609	            continue
   610	        w = hit["weight"].to_numpy(dtype=float)
   611	        boots.append(float(
   612	            (w * (hit["class_label"] == "dsct_flag1").to_numpy()).sum() / w.sum()
   613	        ))
   614	    triggered_ambiguous = int(
   615	        (per_star[per_star["class_label"] == "dsct_flag2"]["best_status"]
   616	         == "confirmed").sum()
   617	    )
   618	    # SRSWOR finite-population correction: sampling fraction f = 2314/7292;
   619	    # bootstrap deviations rescaled by sqrt(1 - f) about the point estimate
   620	    fpc = math.sqrt(1.0 - 2314.0 / 7292.0)
   621	    rescaled = [point + fpc * (b - point) for b in boots]
   622	    return {
   623	        "estimand": "frame_specific_label_ppv",
   624	        "p": point,
   625	        "lo": float(np.quantile(rescaled, 0.025)) if rescaled else math.nan,
   626	        "hi": float(np.quantile(rescaled, 0.975)) if rescaled else math.nan,
   627	        "interval": "survey_bootstrap_fpc_rescaled",
   628	        "n_triggered": int(len(triggered)),
   629	        "bootstrap_B_effective": len(boots),
   630	        "dsct2_triggered_reported_separately": triggered_ambiguous,
   631	    }
