   550	def trigger_rates(per_star: pd.DataFrame, dataset: str) -> pd.DataFrame:
   551	    rows = []
   552	    if dataset == "d3":
   553	        negatives = per_star[per_star["class_label"] == "dsct_flag0"]
   554	        for rule in RULES:
   555	            fired = negatives.apply(
   556	                lambda r: rule_fired(rule, r["best_status"], r.get("census_variable")),
   557	                axis=1,
   558	            )
   559	            ok = fired.notna()
   560	            stats = weighted_wilson(fired[ok].astype(bool).to_numpy(dtype=float),
   561	                                    negatives.loc[ok, "weight"].to_numpy(dtype=float))
   562	            rows.append({"quantity": "negative_class_trigger_rate", "rule": rule, **stats})
   563	    if dataset == "d2" and "arm" in per_star:
   564	        nulls = per_star[per_star["arm"] == "null"]
   565	        if not nulls.empty:
   566	            x = int((nulls["best_status"] == "confirmed").sum())
   567	            n = len(nulls)
   568	            _, upper = cp_one_sided_bounds(x, n)
   569	            rows.append({
   570	                "quantity": "fpr_gaussian", "rule": "confirmed",
   571	                "n": n, "k": x, "p": x / n,
   572	                "cp_one_sided_95_upper": upper,
   573	                "acceptance_u95_leq_0.005": bool(upper <= 0.005),
   574	                "n_is_1000": bool(n == 1000),
   575	            })
   576	        controls = per_star[per_star["arm"] == "ctrl"]
   577	        if not controls.empty:
   578	            fired = controls["best_status"] == "confirmed"
   579	            stats = weighted_wilson(fired.to_numpy(dtype=float),
   580	                                    np.ones(len(controls)))
   581	            rows.append({"quantity": "native_trigger_rate", "rule": "confirmed",
   582	                         **stats})
   583	    return pd.DataFrame(rows)
