    37	    fig, axes = plt.subplots(1, 3, figsize=(10.5, 3.2), sharey=True)
    38	    scopes = ["detection_eligible_roster", "detection_usable_lightcurve",
    39	              "freq_recovery_scorable"]
    40	    for axis, scope in zip(axes, scopes):
