   221	def truth_d3() -> pd.DataFrame:
   222	    roster = pd.read_csv(REPO_ROOT / "generalization/data/d3/roster_d3.csv",
   223	                         dtype={"source_id": str})
   224	    mo = pd.read_csv(REPO_ROOT / "generalization/data/d3/raw/mo2026_table2.csv")
   225	    mo["freq_per_day"] = mo["Freq"] * 86400.0 / 1e6
   226	    freq_lists = mo.groupby("KIC")["freq_per_day"].apply(list).to_dict()
   227	    rows = []
   228	    for r in roster.itertuples(index=False):
   229	        kic = int(r.KIC)
   230	        truth = freq_lists.get(kic, [])
   231	        label = None if r.dSct == 2 else bool(r.dSct == 1)
   232	        rows.append({
   233	            "sid": r.source_id, "external_id": r.external_id,
   234	            "class_label": r.class_label, "label_positive": label,
   235	            "weight": float(r.sampling_weight), "cluster": r.source_id,
   236	            "truth_freqs": truth,
   237	            "primary_freq": float(r.dom_freq_per_day)
   238	            if np.isfinite(r.dom_freq_per_day) else None,
   239	            "amp": float(r.amp_mmag),
   240	            "truth_period_days": 1.0 / float(r.dom_freq_per_day)
   241	            if np.isfinite(r.dom_freq_per_day) and r.dom_freq_per_day > 0 else math.nan,
   242	            "freq_scorable": bool(truth) and bool(label),
