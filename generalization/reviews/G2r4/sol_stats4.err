   185	def truth_d1() -> pd.DataFrame:
   186	    """Labels from the PUBLISHED master table (19 usable stars; 13
   187	    paper-variable) — the 20-row acquisition roster additionally contains
   188	    sanity controls whose paper_variable flag does not enter the published
   189	    counts. D1 truth frequencies are non-contemporaneous literature
   190	    tabulations (multi-mode DAVs wander between epochs); frequency-recovery
   191	    scoring for D1 is therefore DIAGNOSTIC ONLY (METRICS_SPEC) and D1's
   192	    estimand is detection completeness."""
   193	    master = pd.read_csv(
   194	        REPO_ROOT / "lomb-scargle/results/2026-08-01_full/master_table.csv",
   195	        dtype={"source_id": str},
   196	    )
   197	    lit = pd.read_csv(REPO_ROOT / "data/roster/literature_periods.csv",
   198	                      dtype={"source_id": str})
   199	    freqs = lit.groupby("source_id")["frequency_per_day"].apply(list).to_dict()
   200	    rows = []
   201	    for r in master.itertuples(index=False):
   202	        truth = freqs.get(r.source_id, [])
   203	        # 2833849800205759360 is the frozen pipeline's eclipsing-system sanity
   204	        # control (expected confirmed at 6.1464 / d): a known variable, so it
   205	        # can be neither a paper-constant negative nor a roster positive.
   206	        is_control = r.source_id == "2833849800205759360"
   207	        rows.append({
   208	            "sid": r.source_id, "external_id": r.wdj_name,
   209	            "class_label": "transit_control" if is_control else r.wd_class,
   210	            "label_positive": None if is_control
   211	            else str(r.paper_variable).lower() == "true",
   212	            "weight": 1.0, "cluster": r.source_id,
   213	            "truth_freqs": truth,
   214	            "primary_freq": truth[0] if truth else None,
   215	            "amp": math.nan, "truth_period_days": 1.0 / truth[0] if truth else math.nan,
   216	            "freq_scorable": bool(truth),
   217	        })
   218	    return pd.DataFrame(rows)
